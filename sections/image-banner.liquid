{% liquid
  assign hero_id = 'kapisa-hero-' | append: section.id
  assign media_setting = section.settings.media_type | default: 'video'
  assign video = section.settings.video | default: section.settings.video_1
  assign mobile_video = section.settings.mobile_video

  assign has_video = false
  if video != blank or section.settings.external_video_url != blank
    assign has_video = true
  endif

  assign has_images = false
  if section.settings.image_1 != blank or section.settings.image_2 != blank or section.settings.image_3 != blank
    assign has_images = true
  endif

  # Smart media detection & auto-fallback:
  # 1. Explicit 'video': Show video.
  # 2. Explicit 'images' AND real uploaded images exist: Show image slider.
  # 3. Explicit 'images' BUT NO real images AND video IS uploaded: Auto-fallback to video so user sees their video immediately!
  # 4. If has_video is true: Show video.
  # 5. If has_images is true: Show images slider.
  # 6. Fallback based on setting.
  assign show_video = false
  if media_setting == 'video'
    assign show_video = true
  elsif media_setting == 'images' and has_images
    assign show_video = false
  elsif has_video
    assign show_video = true
  elsif has_images
    assign show_video = false
  elsif media_setting == 'images'
    assign show_video = false
  else
    assign show_video = true
  endif

  assign desktop_video_ratio = video.aspect_ratio | default: 2.33
  assign mobile_video_ratio = mobile_video.aspect_ratio | default: desktop_video_ratio

  assign aspect_ratio_desktop = section.settings.image_1.aspect_ratio | default: 2.33
  if section.settings.mobile_image_1 != blank
    assign aspect_ratio_mobile = section.settings.mobile_image_1.aspect_ratio
  elsif section.settings.image_1 != blank
    assign aspect_ratio_mobile = section.settings.image_1.aspect_ratio
  else
    assign aspect_ratio_mobile = 1.2
  endif
%}

<section
  id="{{ hero_id }}"
  class="kapisa-hero kapisa-hero--{{ section.settings.height | default: 'small' }} kapisa-hero--mobile-{{ section.settings.mobile_height | default: 'adapt' }}{% if show_video %} kapisa-hero--video{% endif %}"
  data-section-id="{{ section.id }}"
  data-media-type="{% if show_video %}video{% else %}images{% endif %}"
  data-speed="{{ section.settings.autoplay_speed | default: 4500 }}"
  data-pause-hover="{{ section.settings.pause_on_hover | default: false }}"
>
  {%- if show_video -%}
    {%- comment -%}
      ============================================================
      VIDEO HERO — 1 Video playing infinitely on a loop
      Plays automatically, muted, no controls, looping forever.
      Click anywhere redirects to video_link when configured.
      Zero overlay text/layer as requested.
      ============================================================
    {%- endcomment -%}
    <div class="kapisa-hero__media-container">
      {%- if has_video -%}
        <div class="kapisa-hero__media-link{% if section.settings.video_link == blank %} is-not-clickable{% endif %}">
          {%- if video != blank -%}
            {{
              video
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                class: 'kapisa-hero__video kapisa-hero__video--desktop'
            }}
          {%- elsif section.settings.external_video_url != blank -%}
            <video
              class="kapisa-hero__video kapisa-hero__video--desktop"
              autoplay
              muted
              loop
              playsinline
              webkit-playsinline
              disablepictureinpicture
              disableremoteplayback
              preload="auto"
              aria-hidden="true"
              tabindex="-1"
              {% if section.settings.video_poster != blank %}
                poster="{{ section.settings.video_poster | image_url: width: 2400 }}"
              {% endif %}
            >
              <source src="{{ section.settings.external_video_url }}" type="video/mp4">
            </video>
          {%- endif -%}

          {%- if mobile_video != blank -%}
            {{
              mobile_video
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                class: 'kapisa-hero__video kapisa-hero__video--mobile'
            }}
          {%- endif -%}

          {%- if section.settings.video_link != blank -%}
            <a href="{{ section.settings.video_link }}" class="kapisa-hero__media-link-overlay" aria-label="Hero link"></a>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="kapisa-hero__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'kapisa-hero__placeholder-svg' }}
          <span class="kapisa-hero__placeholder-text">Upload a video in theme settings</span>
        </div>
      {%- endif -%}
    </div>

  {%- else -%}
    {%- comment -%}
      ============================================================
      IMAGE SLIDER — Up to 3 images with automatic sliding
      Each image has its own separate redirect link
      Click anywhere on each image redirects to its link
      ============================================================
    {%- endcomment -%}
    {%- assign slide_count = 0 -%}
    {%- if section.settings.image_1 != blank -%}
      {%- assign slide_count = slide_count | plus: 1 -%}
    {%- endif -%}
    {%- if section.settings.image_2 != blank -%}
      {%- assign slide_count = slide_count | plus: 1 -%}
    {%- endif -%}
    {%- if section.settings.image_3 != blank -%}
      {%- assign slide_count = slide_count | plus: 1 -%}
    {%- endif -%}

    {%- if slide_count > 0 -%}
      <div class="kapisa-hero__slider-container">
        <div class="kapisa-hero__track" data-track>
          {%- for i in (1..3) -%}
            {%- liquid
              assign image_key = 'image_' | append: i
              assign mobile_key = 'mobile_image_' | append: i
              assign link_key = 'image_link_' | append: i

              assign image = section.settings[image_key]
              assign mobile_image = section.settings[mobile_key]
              assign link = section.settings[link_key]
            -%}

            {%- if image != blank -%}
              {%- if link != blank -%}
                <a
                  href="{{ link }}"
                  class="kapisa-hero__slide kapisa-hero__slide--link"
                  data-slide-index="{{ forloop.index0 }}"
                  aria-label="Hero slide {{ i }}"
                >
                  <picture class="kapisa-hero__picture">
                    {%- if mobile_image != blank -%}
                      <source
                        media="(max-width: 749px)"
                        srcset="
                          {{ mobile_image | image_url: width: 600 }} 600w,
                          {{ mobile_image | image_url: width: 900 }} 900w,
                          {{ mobile_image | image_url: width: 1200 }} 1200w
                        "
                      >
                    {%- endif -%}
                    {{
                      image
                      | image_url: width: 2400
                      | image_tag:
                        class: 'kapisa-hero__image',
                        loading: 'eager',
                        fetchpriority: 'high',
                        widths: '600, 900, 1200, 1600, 2000, 2400'
                    }}
                  </picture>
                </a>
              {%- else -%}
                <div
                  class="kapisa-hero__slide"
                  data-slide-index="{{ forloop.index0 }}"
                >
                  <picture class="kapisa-hero__picture">
                    {%- if mobile_image != blank -%}
                      <source
                        media="(max-width: 749px)"
                        srcset="
                          {{ mobile_image | image_url: width: 600 }} 600w,
                          {{ mobile_image | image_url: width: 900 }} 900w,
                          {{ mobile_image | image_url: width: 1200 }} 1200w
                        "
                      >
                    {%- endif -%}
                    {{
                      image
                      | image_url: width: 2400
                      | image_tag:
                        class: 'kapisa-hero__image',
                        loading: 'eager',
                        fetchpriority: 'high',
                        widths: '600, 900, 1200, 1600, 2000, 2400'
                    }}
                  </picture>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="kapisa-hero__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'kapisa-hero__placeholder-svg' }}
        <span class="kapisa-hero__placeholder-text">Upload hero images in theme settings</span>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<style>
  #{{ hero_id }} {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius | default: 0 }}px;
    background: #0e1f3c;
    line-height: 0;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Desktop Heights */
  #{{ hero_id }}.kapisa-hero--small { min-height: 520px; height: 520px; }
  #{{ hero_id }}.kapisa-hero--medium { min-height: 660px; height: 660px; }
  #{{ hero_id }}.kapisa-hero--large { min-height: 800px; height: 800px; }
  #{{ hero_id }}.kapisa-hero--screen { min-height: 100svh; height: 100svh; }
  #{{ hero_id }}.kapisa-hero--adapt { min-height: 0; height: auto; aspect-ratio: {{ aspect_ratio_desktop }}; }

  /* Video Hero Adaptive Heights */
  #{{ hero_id }}.kapisa-hero--video {
    min-height: 480px;
  }
  {% if section.settings.height == 'adapt' %}
    #{{ hero_id }}.kapisa-hero--video {
      min-height: 0;
      height: auto;
      aspect-ratio: var(--kapisa-video-desktop-ratio, {{ desktop_video_ratio }});
    }
  {% endif %}

  /* Mobile Heights (<= 749px) */
  @media screen and (max-width: 749px) {
    #{{ hero_id }}.kapisa-hero--mobile-small { min-height: 320px; height: 320px; aspect-ratio: auto; }
    #{{ hero_id }}.kapisa-hero--mobile-medium { min-height: 420px; height: 420px; aspect-ratio: auto; }
    #{{ hero_id }}.kapisa-hero--mobile-large { min-height: 520px; height: 520px; aspect-ratio: auto; }
    #{{ hero_id }}.kapisa-hero--mobile-screen { min-height: 100svh; height: 100svh; aspect-ratio: auto; }
    #{{ hero_id }}.kapisa-hero--mobile-adapt { min-height: 0; height: auto; aspect-ratio: {{ aspect_ratio_mobile }}; }

    #{{ hero_id }}.kapisa-hero--video {
      min-height: 260px;
    }
    {% if section.settings.mobile_height == 'adapt' %}
      #{{ hero_id }}.kapisa-hero--video {
        min-height: 0;
        height: auto;
        aspect-ratio: var(--kapisa-video-mobile-ratio, {{ mobile_video_ratio }});
      }
    {% endif %}

    {% if mobile_video != blank %}
      #{{ hero_id }} .kapisa-hero__video--desktop { display: none !important; }
      #{{ hero_id }} .kapisa-hero__video--mobile { display: block !important; }
    {% endif %}
  }

  #{{ hero_id }} .kapisa-hero__slider-container,
  #{{ hero_id }} .kapisa-hero__media-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
    overflow: hidden;
  }

  #{{ hero_id }} .kapisa-hero__track {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    will-change: transform;
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1);
  }

  #{{ hero_id }} .kapisa-hero__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    min-height: inherit;
    position: relative;
    display: block;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-decoration: none;
  }

  #{{ hero_id }} .kapisa-hero__slide--link,
  #{{ hero_id }} .kapisa-hero__media-link:not(.is-not-clickable) {
    cursor: pointer;
  }

  #{{ hero_id }} .kapisa-hero__slide:not(.kapisa-hero__slide--link),
  #{{ hero_id }} .kapisa-hero__media-link.is-not-clickable {
    cursor: default;
  }

  #{{ hero_id }} .kapisa-hero__media-link {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    position: relative;
    text-decoration: none;
  }

  #{{ hero_id }} .kapisa-hero__media-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    cursor: pointer;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  #{{ hero_id }} .kapisa-hero__picture {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  #{{ hero_id }} .kapisa-hero__image,
  #{{ hero_id }} .kapisa-hero__video {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: {{ section.settings.image_position | default: 'center center' }};
    opacity: 1;
  }

  #{{ hero_id }} .kapisa-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    background: #0e1f3c;
  }

  #{{ hero_id }} .kapisa-hero__video--mobile {
    display: none;
  }

  #{{ hero_id }} .kapisa-hero__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 480px;
    background: #0e1f3c;
    color: #FAF7F0;
    padding: 40px 20px;
  }

  #{{ hero_id }} .kapisa-hero__placeholder-svg {
    width: 100%;
    max-width: 500px;
    height: auto;
    opacity: 0.35;
  }

  #{{ hero_id }} .kapisa-hero__placeholder-text {
    margin-top: 16px;
    font-size: 14px;
    letter-spacing: 0.05em;
    color: #FAF7F0;
    opacity: 0.7;
    font-family: inherit;
  }
</style>

<script>
  (() => {
    const root = document.getElementById('{{ hero_id }}');
    if (!root) return;

    const mediaType = root.dataset.mediaType;

    // -----------------------------------------------------------
    // VIDEO INITIALIZATION (INFINITE LOOP AUTOPLAY)
    // -----------------------------------------------------------
    const initVideo = () => {
      const desktopVideo = root.querySelector('.kapisa-hero__video--desktop');
      const mobileVideo = root.querySelector('.kapisa-hero__video--mobile');
      const allVideos = [desktopVideo, mobileVideo].filter(Boolean);
      if (allVideos.length === 0) return;

      const mobileBreakpoint = window.matchMedia('(max-width: 749px)');
      const getActiveVideo = () => (mobileVideo && mobileBreakpoint.matches ? mobileVideo : desktopVideo);

      const updateVideoRatio = (vid) => {
        if (!vid || !vid.videoWidth || !vid.videoHeight) return;
        const ratio = `${vid.videoWidth} / ${vid.videoHeight}`;
        const ratioProperty = vid === mobileVideo
          ? '--kapisa-video-mobile-ratio'
          : '--kapisa-video-desktop-ratio';
        root.style.setProperty(ratioProperty, ratio);
      };

      const playActiveVideo = () => {
        const active = getActiveVideo();
        allVideos.forEach((vid) => {
          if (vid !== active) {
            vid.pause();
            return;
          }
          vid.muted = true;
          vid.defaultMuted = true;
          vid.playsInline = true;
          vid.loop = true;
          vid.setAttribute('muted', '');
          vid.setAttribute('playsinline', '');
          vid.setAttribute('webkit-playsinline', '');
          const p = vid.play();
          if (p !== undefined) {
            p.catch(() => {
              const resume = () => {
                if (getActiveVideo() === vid) vid.play().catch(() => {});
              };
              window.addEventListener('pointerdown', resume, { once: true });
              window.addEventListener('touchstart', resume, { once: true });
              window.addEventListener('keydown', resume, { once: true });
            });
          }
        });
      };

      allVideos.forEach((vid) => {
        vid.addEventListener('loadedmetadata', () => updateVideoRatio(vid), { once: true });
        if (vid.readyState >= 1) updateVideoRatio(vid);
      });

      if (mobileBreakpoint.addEventListener) {
        mobileBreakpoint.addEventListener('change', playActiveVideo);
      } else {
        mobileBreakpoint.addListener(playActiveVideo);
      }

      playActiveVideo();
    };

    // -----------------------------------------------------------
    // IMAGE SLIDER INITIALIZATION (AUTOMATIC SLIDING)
    // -----------------------------------------------------------
    const initSlider = () => {
      const track = root.querySelector('[data-track]');
      if (!track) return;

      const slides = Array.from(track.querySelectorAll('.kapisa-hero__slide'));
      const totalSlides = slides.length;
      if (totalSlides <= 1) return;

      // Clone first slide for seamless infinite forward looping
      if (!track.querySelector('[data-is-clone="true"]')) {
        const firstClone = slides[0].cloneNode(true);
        firstClone.setAttribute('data-is-clone', 'true');
        track.appendChild(firstClone);
      }

      let currentIndex = 0;
      let timer = null;
      let isTransitioning = false;
      const speed = Number(root.dataset.speed) || 4500;
      const pauseOnHover = root.dataset.pauseHover === 'true';

      const updateSlide = (index, animate = true) => {
        if (animate) {
          isTransitioning = true;
          track.style.transition = 'transform 0.65s cubic-bezier(0.25, 1, 0.5, 1)';
        } else {
          track.style.transition = 'none';
        }
        track.style.transform = `translateX(-${index * 100}%)`;
      };

      const nextSlide = () => {
        if (isTransitioning) return;
        currentIndex++;
        updateSlide(currentIndex, true);
      };

      const prevSlide = () => {
        if (isTransitioning) return;
        if (currentIndex === 0) {
          updateSlide(totalSlides, false);
          void track.offsetWidth;
          currentIndex = totalSlides - 1;
          updateSlide(currentIndex, true);
        } else {
          currentIndex--;
          updateSlide(currentIndex, true);
        }
      };

      track.addEventListener('transitionend', (e) => {
        if (e.target !== track) return;
        isTransitioning = false;
        if (currentIndex === totalSlides) {
          currentIndex = 0;
          updateSlide(0, false);
          void track.offsetWidth;
        }
      });

      const startAutoplay = () => {
        stopAutoplay();
        timer = window.setInterval(nextSlide, speed);
      };

      const stopAutoplay = () => {
        if (timer) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      if (pauseOnHover) {
        root.addEventListener('mouseenter', stopAutoplay);
        root.addEventListener('mouseleave', startAutoplay);
      }

      let touchStartX = 0;
      let touchStartY = 0;
      let hasSwiped = false;
      let isTouchActive = false;

      track.addEventListener('touchstart', (e) => {
        if (!e.touches || e.touches.length === 0) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        hasSwiped = false;
        isTouchActive = true;
        stopAutoplay();
      }, { passive: true });

      track.addEventListener('touchmove', (e) => {
        if (!isTouchActive || !e.touches || e.touches.length === 0) return;
        const diffX = e.touches[0].clientX - touchStartX;
        const diffY = e.touches[0].clientY - touchStartY;
        if (Math.abs(diffX) > 20 && Math.abs(diffX) > Math.abs(diffY)) {
          hasSwiped = true;
        }
      }, { passive: true });

      track.addEventListener('touchend', (e) => {
        if (!isTouchActive) return;
        isTouchActive = false;
        if (hasSwiped && e.changedTouches && e.changedTouches.length > 0) {
          const diffX = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(diffX) > 40) {
            if (diffX < 0) nextSlide();
            else prevSlide();
          }
        }
        startAutoplay();
      }, { passive: true });

      track.addEventListener('click', (e) => {
        if (hasSwiped) {
          e.preventDefault();
          e.stopPropagation();
          hasSwiped = false;
        }
      }, true);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });

      startAutoplay();
    };

    if (mediaType === 'video') {
      initVideo();
    } else {
      initSlider();
    }

    // Theme Editor Lifecycle Support
    const onThemeEditorUpdate = (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        if (root.dataset.mediaType === 'video') {
          initVideo();
        } else {
          initSlider();
        }
      }
    };
    document.addEventListener('shopify:section:load', onThemeEditorUpdate);
    document.addEventListener('shopify:section:select', onThemeEditorUpdate);
  })();
</script>

{% schema %}
{
  "name": "Kapisa Hero",
  "tag": "section",
  "class": "section-kapisa-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media Type"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Choose hero media",
      "default": "video",
      "options": [
        {
          "value": "auto",
          "label": "Auto-Detect (Video or Slider)"
        },
        {
          "value": "video",
          "label": "Video (Single video in loop)"
        },
        {
          "value": "images",
          "label": "Images (Slider up to 3 images)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Video Hero"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hero video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile hero video (optional)",
      "info": "Upload a portrait version for mobile. If omitted, desktop video is shown without cropping."
    },
    {
      "type": "text",
      "id": "external_video_url",
      "label": "External video MP4 URL (optional)",
      "info": "Use if you host the MP4 video externally"
    },
    {
      "type": "url",
      "id": "video_link",
      "label": "Video redirect link",
      "info": "Clicking anywhere on the hero video will redirect here"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video poster / preview image (optional)"
    },
    {
      "type": "header",
      "content": "Slide 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Desktop image 1"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_1",
      "label": "Mobile image 1 (optional)"
    },
    {
      "type": "url",
      "id": "image_link_1",
      "label": "Slide 1 redirect link",
      "info": "Clicking anywhere on slide 1 will redirect here"
    },
    {
      "type": "header",
      "content": "Slide 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Desktop image 2"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "Mobile image 2 (optional)"
    },
    {
      "type": "url",
      "id": "image_link_2",
      "label": "Slide 2 redirect link",
      "info": "Clicking anywhere on slide 2 will redirect here"
    },
    {
      "type": "header",
      "content": "Slide 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Desktop image 3"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_3",
      "label": "Mobile image 3 (optional)"
    },
    {
      "type": "url",
      "id": "image_link_3",
      "label": "Slide 3 redirect link",
      "info": "Clicking anywhere on slide 3 will redirect here"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide duration",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4500
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause sliding on mouse hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Hero height (Desktop)",
      "default": "small",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image ratio (no crop)"
        },
        {
          "value": "small",
          "label": "Small (520px)"
        },
        {
          "value": "medium",
          "label": "Medium (660px)"
        },
        {
          "value": "large",
          "label": "Large (800px)"
        },
