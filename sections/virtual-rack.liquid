{% comment %}
  -----------------------------------------------------------------------------
  KAPISA - VIRTUAL RACK (v2)
  A straight metal rail with evenly spaced hangers. Garments overlap like a real
  rack; hover lifts one out with a glow + "Quick View / Shop Now" pill; click opens
  a focus view (others blur away) with Front/Back toggle - like the reference reel.
  Tip: transparent PNG cut-outs look best. Plain white/light photo backgrounds are
  removed automatically in the browser so garments can overlap like a real rack.
  -----------------------------------------------------------------------------
{% endcomment %}

{% liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAF8F5'
  assign subheading = section.settings.subheading | default: 'KAPISA EXPERIENCE'
  assign heading = section.settings.heading | default: 'Virtual Rack'
  assign button_text = section.settings.button_text | default: 'Quick View / Shop Now'
  assign source_type = section.settings.source_type | default: 'collection'
  assign product_limit = section.settings.product_limit | default: 16
  assign show_price = section.settings.show_price
  assign repeat_products = section.settings.repeat_products
  assign rod_preset = section.settings.rod_color_preset | default: 'dark_chrome'

  if rod_preset == 'brass_gold'
    assign rod_css = 'linear-gradient(180deg,#F5E59C 0%,#D4A338 35%,#9E7418 70%,#5E430B 100%)'
  elsif rod_preset == 'silver'
    assign rod_css = 'linear-gradient(180deg,#FFFFFF 0%,#D1D5DB 35%,#9CA3AF 70%,#4B5563 100%)'
  else
    assign rod_css = 'linear-gradient(180deg,#6a6a6a 0%,#303030 40%,#151515 80%,#050505 100%)'
  endif

  if section.settings.collection != blank and section.settings.collection.products_count > 0
    assign pool = section.settings.collection.products
  else
    assign pool = collections.all.products
  endif
%}

{% style %}
  #shopify-section-{{ sec_id }} { background: {{ bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #ai-rack-{{ sec_id }} { --rod: {{ rod_css }}; }
{% endstyle %}

<div class="ai-rack" id="ai-rack-{{ sec_id }}" role="region" aria-label="{{ heading | escape }}">
  <style>
    #ai-rack-{{ sec_id }}{--slot:64px;--card:140px;max-width:1400px;margin:0 auto;padding:0 20px;box-sizing:border-box;position:relative;font-family:inherit;-webkit-font-smoothing:antialiased}
    #ai-rack-{{ sec_id }} *{box-sizing:border-box}
    #ai-rack-{{ sec_id }} .ai-rack__header{margin-bottom:18px;text-align:left}
    #ai-rack-{{ sec_id }} .ai-rack__sub{display:block;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#D4A338;margin-bottom:4px}
    #ai-rack-{{ sec_id }} .ai-rack__heading{font-size:clamp(26px,3.6vw,36px);font-weight:800;color:#0F1E36;margin:0;line-height:1.15;letter-spacing:-.02em}

    /* stage + rail */
    #ai-rack-{{ sec_id }} .ai-rack__stage{position:relative;min-height:calc(var(--card)*1.62 + 110px);transition:min-height .5s cubic-bezier(.22,1,.36,1)}
    #ai-rack-{{ sec_id }}.is-focus .ai-rack__stage{min-height:440px}
    #ai-rack-{{ sec_id }} .ai-rack__rail{position:absolute;left:0;right:0;top:15px;height:14px;border-radius:7px;background:var(--rod);box-shadow:inset 0 2px 2px rgba(255,255,255,.28),0 6px 14px rgba(0,0,0,.25);z-index:1}
    #ai-rack-{{ sec_id }} .ai-rack__rail::before,#ai-rack-{{ sec_id }} .ai-rack__rail::after{content:"";position:absolute;top:-4px;width:22px;height:22px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#8a8a8a 0%,#2a2a2a 60%,#0a0a0a 100%);box-shadow:0 3px 8px rgba(0,0,0,.4)}
    #ai-rack-{{ sec_id }} .ai-rack__rail::before{left:-6px}
    #ai-rack-{{ sec_id }} .ai-rack__rail::after{right:-6px}
    #ai-rack-{{ sec_id }} .ai-rack__scroller{position:relative;overflow-x:auto;overflow-y:hidden;overflow-y:clip;padding:10px 0 70px;scrollbar-width:none;transition:filter .45s ease,opacity .45s ease}
    #ai-rack-{{ sec_id }} .ai-rack__scroller::-webkit-scrollbar{display:none}
    #ai-rack-{{ sec_id }} .ai-rack__track{display:flex;justify-content:center;width:max-content;min-width:100%;padding:0 30px}
    #ai-rack-{{ sec_id }}.is-focus .ai-rack__scroller{filter:blur(7px) saturate(.8);opacity:.45;pointer-events:none}

    /* item */
    #ai-rack-{{ sec_id }} .ai-rack__item{position:relative;flex:0 0 var(--slot);width:var(--slot);height:calc(var(--card)*1.62 + 34px);display:block;text-decoration:none;color:inherit;outline:none;cursor:pointer;transition:transform .45s cubic-bezier(.22,1,.36,1);-webkit-tap-highlight-color:transparent;z-index:2}
    #ai-rack-{{ sec_id }} .ai-rack__hanger{pointer-events:none;position:absolute;top:0;left:50%;width:calc(var(--card)*.62);max-width:84px;height:auto;transform:translateX(-50%);transform-origin:50% 12px;z-index:5;filter:drop-shadow(0 2px 2px rgba(0,0,0,.28));transition:filter .3s ease,transform .45s cubic-bezier(.22,1,.36,1)}
    #ai-rack-{{ sec_id }} .ai-rack__garment{pointer-events:none;position:absolute;top:calc(var(--card)*.22 + 4px);left:50%;width:var(--card);height:calc(var(--card)*1.55);transform:translateX(-50%);transform-origin:50% 0;transition:transform .45s cubic-bezier(.22,1,.36,1)}
    #ai-rack-{{ sec_id }} .ai-rack__garment img{width:100%;height:100%;object-fit:contain;object-position:top center;display:block;user-select:none;pointer-events:none}

    /* hover: lift one out, neighbours make room */
    #ai-rack-{{ sec_id }} .ai-rack__item:hover,#ai-rack-{{ sec_id }} .ai-rack__item:focus-visible{z-index:30}
    #ai-rack-{{ sec_id }} .ai-rack__item:hover .ai-rack__garment,#ai-rack-{{ sec_id }} .ai-rack__item:focus-visible .ai-rack__garment{transform:translateX(-50%) scale(1.28)}
    #ai-rack-{{ sec_id }} .ai-rack__item:hover .ai-rack__hanger,#ai-rack-{{ sec_id }} .ai-rack__item:focus-visible .ai-rack__hanger{transform:translateX(-50%) scale(1.12);filter:drop-shadow(0 -2px 14px rgba(212,163,56,.95)) drop-shadow(0 3px 8px rgba(212,163,56,.6))}
    #ai-rack-{{ sec_id }} .ai-rack__item:hover + .ai-rack__item{transform:translateX(calc(var(--card)*.32))}
    #ai-rack-{{ sec_id }} .ai-rack__item:has(+ .ai-rack__item:hover){transform:translateX(calc(var(--card)*-.32))}
    #ai-rack-{{ sec_id }} .ai-rack__pill{position:absolute;left:50%;top:calc(var(--card)*.22 + var(--card)*1.55*1.28 + 14px);transform:translate(-50%,8px) scale(.92);opacity:0;pointer-events:none;background:#fff;color:#0F1E36;font-size:12px;font-weight:700;padding:8px 16px;border-radius:999px;white-space:nowrap;box-shadow:0 6px 18px rgba(15,30,54,.2);border:1px solid rgba(212,163,56,.35);transition:opacity .25s ease,transform .25s ease;z-index:40}
    #ai-rack-{{ sec_id }} .ai-rack__pill em{font-style:normal;color:#64748B}
    #ai-rack-{{ sec_id }} .ai-rack__item:hover .ai-rack__pill,#ai-rack-{{ sec_id }} .ai-rack__item:focus-visible .ai-rack__pill{opacity:1;pointer-events:auto;transform:translate(-50%,0) scale(1)}

    /* focus view (reel style) - visible without hanger, fully visible in one screen */
    #ai-rack-{{ sec_id }} .ai-rack__focus{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;opacity:0;pointer-events:none;transition:opacity .4s ease;z-index:50;text-align:center}
    #ai-rack-{{ sec_id }}.is-focus .ai-rack__focus{opacity:1;pointer-events:auto}
    #ai-rack-{{ sec_id }} .ai-rack__f-hanger{display:none!important}
    #ai-rack-{{ sec_id }} .ai-rack__f-img{width:auto;max-width:min(320px,80vw);height:min(290px,38vh);max-height:300px;min-height:180px;margin-top:0;object-fit:contain;object-position:top center;transition:opacity .25s ease,transform .35s cubic-bezier(.22,1,.36,1)}
    #ai-rack-{{ sec_id }} .ai-rack__f-img.is-swap{opacity:0;transform:translateY(6px) scale(.98)}
    #ai-rack-{{ sec_id }} .ai-rack__f-title{margin:10px 0 8px;font-size:14px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#0F1E36;line-height:1.25;max-width:90%}
    #ai-rack-{{ sec_id }} .ai-rack__toggle{display:inline-flex;padding:3px;border-radius:999px;background:#fff;border:1px solid rgba(15,30,54,.12);margin-bottom:10px;box-shadow:0 2px 6px rgba(15,30,54,.04)}
    #ai-rack-{{ sec_id }} .ai-rack__toggle button{border:0;background:transparent;font:inherit;font-size:11px;font-weight:700;padding:5px 16px;border-radius:999px;cursor:pointer;color:#64748B;transition:background .2s,color .2s}
    #ai-rack-{{ sec_id }} .ai-rack__toggle button.is-on{background:#0F1E36;color:#fff}
    #ai-rack-{{ sec_id }} .ai-rack__shop{display:inline-flex;align-items:center;justify-content:center;padding:9px 24px;border-radius:999px;border:1.5px solid #0F1E36;color:#0F1E36;font-size:12px;font-weight:800;letter-spacing:.04em;text-decoration:none;background:transparent;transition:background .2s,color .2s,transform .2s}
    #ai-rack-{{ sec_id }} .ai-rack__shop:hover{background:#0F1E36;color:#fff;transform:translateY(-1px)}
    #ai-rack-{{ sec_id }} .ai-rack__nav,#ai-rack-{{ sec_id }} .ai-rack__close{position:absolute;border:1px solid rgba(15,30,54,.14);background:#fff;color:#0F1E36;width:40px;height:40px;border-radius:50%;cursor:pointer;display:grid;place-items:center;font-size:16px;box-shadow:0 6px 16px rgba(15,30,54,.12);transition:transform .2s,background .2s,color .2s;z-index:55}
    #ai-rack-{{ sec_id }} .ai-rack__nav:hover,#ai-rack-{{ sec_id }} .ai-rack__close:hover{background:#0F1E36;color:#fff;transform:scale(1.06)}
    #ai-rack-{{ sec_id }} .ai-rack__nav--prev{left:clamp(10px,4vw,50px);top:38%;transform:translateY(-50%)}
    #ai-rack-{{ sec_id }} .ai-rack__nav--next{right:clamp(10px,4vw,50px);top:38%;transform:translateY(-50%)}
    #ai-rack-{{ sec_id }} .ai-rack__close{right:clamp(10px,2.5vw,24px);top:8px;width:34px;height:34px;font-size:14px;z-index:60}

    @media (max-width:768px){
      #ai-rack-{{ sec_id }}{padding:0 12px}
      #ai-rack-{{ sec_id }}.is-focus{padding-bottom:calc(84px + env(safe-area-inset-bottom, 0px))}
      #ai-rack-{{ sec_id }}.is-focus .ai-rack__header{margin-bottom:6px}
      #ai-rack-{{ sec_id }}.is-focus .ai-rack__heading{font-size:20px}
      #ai-rack-{{ sec_id }}.is-focus .ai-rack__sub{font-size:10px;margin-bottom:2px}
      #ai-rack-{{ sec_id }} .ai-rack__track{justify-content:flex-start}
      #ai-rack-{{ sec_id }} .ai-rack__scroller{scroll-snap-type:x proximity}
      #ai-rack-{{ sec_id }} .ai-rack__item{scroll-snap-align:center}
      #ai-rack-{{ sec_id }}.is-focus .ai-rack__stage{min-height:380px}
      #ai-rack-{{ sec_id }} .ai-rack__f-img{height:min(210px,30vh);max-height:220px;min-height:150px;max-width:70vw;margin-top:0}
      #ai-rack-{{ sec_id }} .ai-rack__f-title{font-size:12px;margin:6px 0 6px;letter-spacing:.04em;max-width:86%;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
      #ai-rack-{{ sec_id }} .ai-rack__toggle{margin-bottom:8px;padding:2px}
      #ai-rack-{{ sec_id }} .ai-rack__toggle button{font-size:10px;padding:4px 12px}
      #ai-rack-{{ sec_id }} .ai-rack__shop{padding:8px 20px;font-size:11px}
      #ai-rack-{{ sec_id }} .ai-rack__nav{width:32px;height:32px;font-size:13px;top:35%;transform:translateY(-50%)}
      #ai-rack-{{ sec_id }} .ai-rack__nav--prev{left:2px}
      #ai-rack-{{ sec_id }} .ai-rack__nav--next{right:2px}
      #ai-rack-{{ sec_id }} .ai-rack__close{right:4px;top:4px;width:30px;height:30px;font-size:12px}
    }
    @media (hover:none){
      #ai-rack-{{ sec_id }} .ai-rack__pill{display:none}
      #ai-rack-{{ sec_id }} .ai-rack__item:hover + .ai-rack__item,#ai-rack-{{ sec_id }} .ai-rack__item:has(+ .ai-rack__item:hover){transform:none}
    }
    @media (prefers-reduced-motion:reduce){#ai-rack-{{ sec_id }} *{transition:none!important}}
  </style>

  <div class="ai-rack__header">
    {% if subheading != blank %}<span class="ai-rack__sub">{{ subheading }}</span>{% endif %}
    {% if heading != blank %}<h2 class="ai-rack__heading">{{ heading }}</h2>{% endif %}
  </div>

  <div class="ai-rack__stage">
    <div class="ai-rack__rail" aria-hidden="true"></div>

    <div class="ai-rack__scroller">
      <div class="ai-rack__track">
        {%- assign n = 0 -%}
        {%- if source_type == 'blocks' and section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign bp = block.settings.product -%}
            {%- assign t = block.settings.custom_title | default: bp.title | default: 'Kapisa Scrub' -%}
            {%- assign f = block.settings.custom_front_image | default: bp.featured_image -%}
            {%- assign b = block.settings.custom_side_image | default: bp.images[1] -%}
            {%- assign bp_url = bp.url | default: '/collections/all' -%}
            {%- if f != blank -%}
              {%- assign n = n | plus: 1 -%}
              {% render 'virtual-rack-item', uid: forloop.index, href: bp_url, title: t, price: bp.price, front: f, back: b, attrs: block.shopify_attributes, button_text: button_text, show_price: show_price %}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign passes = 1 -%}
          {%- if repeat_products -%}{%- assign passes = 4 -%}{%- endif -%}
          {%- for pass in (1..passes) -%}
            {%- for prod in pool -%}
              {%- if n < product_limit -%}
                {%- assign h = prod.handle | downcase -%}
                {%- unless h contains 'gift-card' or h contains 'embroidery' or h contains 'snowboard' -%}
                  {%- if prod.featured_image != blank -%}
                    {%- assign n = n | plus: 1 -%}
                    {% render 'virtual-rack-item', uid: n, href: prod.url, title: prod.title, price: prod.price, front: prod.featured_image, back: prod.images[1], attrs: '', button_text: button_text, show_price: show_price %}
                  {%- endif -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
          {%- comment -%} Last resort: nothing matched the filter, show whatever exists {%- endcomment -%}
          {%- if n == 0 -%}
            {%- for prod in collections.all.products limit: product_limit -%}
              {%- if prod.featured_image != blank -%}
                {%- assign n = n | plus: 1 -%}
                {% render 'virtual-rack-item', uid: n, href: prod.url, title: prod.title, price: prod.price, front: prod.featured_image, back: prod.images[1], attrs: '', button_text: button_text, show_price: show_price %}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

    <!-- Focus view (click a hanger) -->
    <div class="ai-rack__focus" aria-live="polite">
      <button type="button" class="ai-rack__close" aria-label="Close">&#10005;</button>
      <button type="button" class="ai-rack__nav ai-rack__nav--prev" aria-label="Previous">&#8592;</button>
      <button type="button" class="ai-rack__nav ai-rack__nav--next" aria-label="Next">&#8594;</button>
      <svg class="ai-rack__f-hanger" viewBox="0 0 100 56" aria-hidden="true">
        <defs><linearGradient id="rk-f-{{ sec_id }}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9aa0aa"/><stop offset="1" stop-color="#3a3f48"/></linearGradient></defs>
        <path d="M50 30 L50 22 C50 14 61 12 61 6 C61 1 54 0 51.5 4" fill="none" stroke="#7b818b" stroke-width="2.6" stroke-linecap="round"/>
        <path d="M50 28 L6 50 Q3 52 6 53 L94 53 Q97 52 94 50 Z" fill="url(#rk-f-{{ sec_id }})"/>
      </svg>
      <img class="ai-rack__f-img" alt="">
      <h3 class="ai-rack__f-title"></h3>
      <div class="ai-rack__toggle" role="group" aria-label="Garment view">
        <button type="button" data-view="front" class="is-on">Front</button>
        <button type="button" data-view="back">Back</button>
      </div>
      <a class="ai-rack__shop" href="#">{{ button_text }}</a>
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('ai-rack-{{ sec_id }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  var scroller = root.querySelector('.ai-rack__scroller');
  var items = Array.prototype.slice.call(root.querySelectorAll('.ai-rack__item'));
  if (!items.length) return;

  var focus = root.querySelector('.ai-rack__focus');
  var img = focus.querySelector('.ai-rack__f-img');
  var title = focus.querySelector('.ai-rack__f-title');
  var shop = focus.querySelector('.ai-rack__shop');
  var toggle = focus.querySelector('.ai-rack__toggle');
  var current = -1;

  /* Remove plain studio backgrounds -> transparent cut-out (edge flood-fill, cached) */
  var cache = {};
  function cutout(url) {
    if (cache[url]) return cache[url];
    cache[url] = new Promise(function (resolve) {
      var im = new Image(); im.crossOrigin = 'anonymous';
      im.onload = function () {
        try {
          var w = im.naturalWidth, h = im.naturalHeight, c = document.createElement('canvas');
          c.width = w; c.height = h;
          var x = c.getContext('2d', { willReadFrequently: true }); x.drawImage(im, 0, 0);
          var id = x.getImageData(0, 0, w, h), d = id.data;
          function px(i) { return i * 4; }
          var cs = [0, w - 1, (h - 1) * w, h * w - 1], r = 0, g = 0, b = 0;
          cs.forEach(function (i) { r += d[px(i)]; g += d[px(i) + 1]; b += d[px(i) + 2]; });
          r /= 4; g /= 4; b /= 4;
          if (Math.min(r, g, b) < 200) { resolve(url); return; }    /* not a light studio bg: leave as is */
          var TOL = 34, seen = new Uint8Array(w * h), stack = [];
          function isBg(i) { var k = px(i); return d[k + 3] < 8 || (Math.abs(d[k] - r) < TOL && Math.abs(d[k + 1] - g) < TOL && Math.abs(d[k + 2] - b) < TOL); }
          function push(i) { if (!seen[i] && isBg(i)) { seen[i] = 1; stack.push(i); } }
          for (var i = 0; i < w; i++) { push(i); push((h - 1) * w + i); }
          for (var j = 0; j < h; j++) { push(j * w); push(j * w + w - 1); }
          while (stack.length) {
            var q = stack.pop(), qx = q % w, qy = (q - qx) / w;
            if (qx > 0) push(q - 1); if (qx < w - 1) push(q + 1);
            if (qy > 0) push(q - w); if (qy < h - 1) push(q + w);
          }
          for (var k = 0; k < w * h; k++) {
            if (seen[k]) d[px(k) + 3] = 0;
          }
          /* 1px feather on the cut edge */
          for (var y = 1; y < h - 1; y++) for (var xx = 1; xx < w - 1; xx++) {
            var m = y * w + xx;
            if (!seen[m] && (seen[m - 1] || seen[m + 1] || seen[m - w] || seen[m + w])) d[px(m) + 3] = 150;
          }
          x.putImageData(id, 0, 0);
          resolve(c.toDataURL('image/png'));
        } catch (e) { resolve(url); }
      };
      im.onerror = function () { resolve(url); };
      im.src = url;
    });
    return cache[url];
  }
  items.forEach(function (it) {
    var el = it.querySelector('.ai-rack__garment img');
    cutout(it.dataset.front).then(function (u) { if (u !== it.dataset.front) { el.src = u; it.dataset.cut = u; } });
  });

  /* Spread the garments across the rail like the reference mockup */
  function fit() {
    var w = root.clientWidth - 40, count = items.length;
    var mobile = window.innerWidth <= 768;
    var slot = mobile ? 62 : Math.max(52, Math.min(96, w / (count + 1.6)));
    root.style.setProperty('--slot', slot + 'px');
    root.style.setProperty('--card', Math.round(slot * (mobile ? 2.25 : 2.15)) + 'px');
  }
  fit();
  var t; window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(fit, 120); });

  function show(i, swap) {
    current = (i + items.length) % items.length;
    var d = items[current].dataset;
    function apply() {
      img.src = d.front; img.alt = d.title;
      cutout(d.front).then(function (u) { if (current > -1 && items[current].dataset === d) img.src = u; });
      title.textContent = d.title;
      shop.href = d.url;
      toggle.style.display = d.back ? '' : 'none';
      toggle.querySelectorAll('button').forEach(function (b) { b.classList.toggle('is-on', b.dataset.view === 'front'); });
      img.classList.remove('is-swap');
    }
    if (swap) { img.classList.add('is-swap'); setTimeout(apply, 180); } else { apply(); }
  }
  function close() { root.classList.remove('is-focus'); current = -1; }

  items.forEach(function (it, i) {
    it.addEventListener('click', function (e) {
      if (e.target.closest('.ai-rack__pill')) return;       /* pill = go straight to product */
      e.preventDefault();
      root.classList.add('is-focus');
      show(i, false);
      var rect = root.getBoundingClientRect();
      var topOffset = window.innerWidth <= 768 ? 70 : 85;
      if (rect.top < topOffset || (rect.top + 420) > window.innerHeight) {
        window.scrollTo({
          top: window.pageYOffset + rect.top - topOffset,
          behavior: 'smooth'
        });
      }
    });
  });
  focus.querySelector('.ai-rack__close').addEventListener('click', close);
  focus.querySelector('.ai-rack__nav--prev').addEventListener('click', function () { show(current - 1, true); });
  focus.querySelector('.ai-rack__nav--next').addEventListener('click', function () { show(current + 1, true); });
  toggle.addEventListener('click', function (e) {
    var b = e.target.closest('button'); if (!b) return;
    var d = items[current].dataset, v = b.dataset.view;
    toggle.querySelectorAll('button').forEach(function (x) { x.classList.toggle('is-on', x === b); });
    img.classList.add('is-swap');
    var target = (v === 'back' && d.back) ? d.back : d.front;
    setTimeout(function () { img.src = target; cutout(target).then(function (u) { if (current > -1 && items[current].dataset === d) img.src = u; }); img.classList.remove('is-swap'); }, 180);
  });
  document.addEventListener('keydown', function (e) {
    if (!root.classList.contains('is-focus')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') show(current + 1, true);
    if (e.key === 'ArrowLeft') show(current - 1, true);
  });
  focus.addEventListener('click', function (e) { if (e.target === focus) close(); });

  if (scroller.scrollWidth > scroller.clientWidth) scroller.scrollLeft = (scroller.scrollWidth - scroller.clientWidth) / 2;
})();
</script>

