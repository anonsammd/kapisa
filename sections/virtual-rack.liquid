  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "KAPISA EXPERIENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Virtual Rack"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "source_type",
      "label": "Product Source",
      "options": [
        {
          "value": "blocks",
          "label": "Manual Blocks"
        },
        {
          "value": "collection",
          "label": "Collection"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 6,
      "max": 20,
      "step": 1,
      "label": "Product Limit",
      "default": 14
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Quick View / Shop Now"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price in Pill",
      "default": false
    },
    {
      "type": "select",
      "id": "rod_color_preset",
      "label": "Rod Finish",
      "options": [
        {
          "value": "dark_chrome",
          "label": "Dark Gunmetal / Black Chrome"
        },
        {
          "value": "brass_gold",
          "label": "Brushed Brass / Gold"
        },
        {
          "value": "silver",
          "label": "Polished Silver / Stainless"
        }
      ],
      "default": "dark_chrome"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "scrub_item",
      "name": "Scrub Hanger",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_front_image",
          "label": "Custom Front Image (Transparent PNG)"
        },
        {
          "type": "image_picker",
          "id": "custom_side_image",
          "label": "Custom Side Profile Image (Optional)"
        },
        {
          "type": "color",
          "id": "garment_color",
          "label": "Fallback / Tint Color"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title Override (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Virtual Scrubs Rack"
    }
  ]
}
