{% doc %}
  @prompt
    Kapisa Healthcare - Shop by Colours (Knya Med Style)
    A high-converting, aesthetic visual discovery section featuring landscape color cards
    with folded scrub sets, matching medical accessories, and direct collection filtering.
{% enddoc %}

{% assign id = block.id | replace: '_', '' | downcase %}

{% style %}
  .kapisa-color-section-{{ id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color | default: '#FAF9F6' }};
    padding: {{ block.settings.padding_top | default: 56 }}px 0 {{ block.settings.padding_bottom | default: 56 }}px;
    font-family: inherit;
    color: {{ block.settings.text_color | default: '#1E293B' }};
  }

  .kapisa-color-container-{{ id }} {
    width: min(1360px, calc(100% - 40px));
    margin: 0 auto;
  }

  .kapisa-color-header-{{ id }} {
    margin-bottom: {{ block.settings.heading_spacing | default: 28 }}px;
    text-align: {{ block.settings.heading_align | default: 'left' }};
  }

  .kapisa-color-eyebrow-{{ id }} {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    margin-bottom: 8px;
  }

  .kapisa-color-title-{{ id }} {
    margin: 0;
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 700;
    line-height: 1.2;
    color: {{ block.settings.heading_color | default: '#0E1F3C' }};
    letter-spacing: -0.02em;
  }

  .kapisa-color-subtitle-{{ id }} {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: {{ block.settings.subtitle_color | default: '#64748B' }};
    max-width: 600px;
  }

  /* Grid of Color Cards */
  .kapisa-color-grid-{{ id }} {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 18px;
  }

  .kapisa-color-card-{{ id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .kapisa-color-card-{{ id }}:hover {
    transform: translateY(-4px);
  }

  /* Image / Visual Stage */
  .kapisa-color-thumb-{{ id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: 14px;
    overflow: hidden;
    background: #1E293B;
    box-shadow: 0 4px 14px rgba(14, 31, 60, 0.08);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    border: 1px solid rgba(14, 31, 60, 0.06);
  }

  .kapisa-color-card-{{ id }}:hover .kapisa-color-thumb-{{ id }} {
    box-shadow: 0 10px 26px rgba(14, 31, 60, 0.16);
  }

  .kapisa-color-img-{{ id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .kapisa-color-card-{{ id }}:hover .kapisa-color-img-{{ id }} {
    transform: scale(1.05);
  }

  /* Default CSS Mockup Artwork if no image is uploaded */
  .kapisa-color-fallback-{{ id }} {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 16px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .kapisa-color-fallback-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.8) 1px, transparent 0);
    background-size: 16px 16px;
  }

  .kapisa-color-fallback-fold {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .kapisa-color-card-{{ id }}:hover .kapisa-color-fallback-fold {
    transform: scale(1.08);
  }

  .kapisa-color-fallback-fold svg {
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.3));
  }

  /* Color Label */
  .kapisa-color-meta-{{ id }} {
    padding-top: 12px;
    text-align: left;
  }

  .kapisa-color-name-{{ id }} {
    font-size: 14px;
    font-weight: 700;
    color: {{ block.settings.heading_color | default: '#0E1F3C' }};
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .kapisa-color-arrow-{{ id }} {
    font-size: 13px;
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .kapisa-color-card-{{ id }}:hover .kapisa-color-arrow-{{ id }} {
    opacity: 1;
    transform: translateX(0);
  }

  .kapisa-color-count-{{ id }} {
    font-size: 12px;
    color: {{ block.settings.subtitle_color | default: '#64748B' }};
    margin-top: 2px;
  }

  /* Responsive Behavior: Smooth horizontal scrolling on mobile/tablet */
  @media screen and (max-width: 1024px) {
    .kapisa-color-grid-{{ id }} {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media screen and (max-width: 749px) {
    .kapisa-color-section-{{ id }} {
      padding: {{ block.settings.mobile_padding | default: 38 }}px 0;
    }

    .kapisa-color-container-{{ id }} {
      width: 100%;
      padding: 0 16px;
    }

    .kapisa-color-grid-{{ id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      gap: 14px;
      padding-bottom: 8px;
    }

    .kapisa-color-grid-{{ id }}::-webkit-scrollbar {
      display: none;
    }

    .kapisa-color-card-{{ id }} {
      flex: 0 0 160px;
      scroll-snap-align: start;
    }

    .kapisa-color-thumb-{{ id }} {
      aspect-ratio: 16 / 12;
    }

    .kapisa-color-name-{{ id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

