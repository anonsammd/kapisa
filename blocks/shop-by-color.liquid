{% schema %}
{
  "name": "Shop by Colours",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "KAPISA PALETTE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Colours"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Find your signature shade in our classic medical collection"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors & Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0E1F3C"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#64748B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C9A227"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding (px)",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding (px)",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile Padding (px)",
      "min": 15,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Color 1: All Blues"
    },
    {
      "type": "checkbox",
      "id": "color_1_enabled",
      "label": "Enable Color 1",
      "default": true
    },
    {
      "type": "text",
      "id": "color_1_name",
      "label": "Title",
      "default": "All Blues"
    },
    {
      "type": "text",
      "id": "color_1_sub",
      "label": "Subtext (e.g. Royal & Navy)",
      "default": "Royal & Navy"
    },
    {
      "type": "image_picker",
      "id": "color_1_image",
      "label": "Card Image"
    },
    {
      "type": "color",
      "id": "color_1_bg",
      "label": "Card Background Tint",
      "default": "#1B3B6F"
    },
    {
      "type": "url",
      "id": "color_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Color 2: All Blacks"
    },
    {
      "type": "checkbox",
      "id": "color_2_enabled",
      "label": "Enable Color 2",
      "default": true
    },
    {
      "type": "text",
      "id": "color_2_name",
      "label": "Title",
      "default": "All Blacks"
    },
    {
      "type": "text",
      "id": "color_2_sub",
      "label": "Subtext (e.g. Midnight Onyx)",
      "default": "Midnight Onyx"
    },
    {
      "type": "image_picker",
      "id": "color_2_image",
      "label": "Card Image"
    },
    {
      "type": "color",
      "id": "color_2_bg",
      "label": "Card Background Tint",
      "default": "#18191C"
    },
    {
