    {"type":"text","id":"card_5_title","label":"Title","default":"Google Maps / Get Directions"},{"type":"textarea","id":"card_5_info","label":"Information","default":"Visit our headquarters & showroom"},{"type":"url","id":"card_5_link","label":"Link"},{"type":"text","id":"card_5_action","label":"Action text","default":"Get Directions"}
  ],
  "presets": [{"name":"Contact information"}],
  "tag": null,
  "class": "contact-information-block"
