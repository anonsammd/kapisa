{% doc %}
  Elevated enterprise Contact Hub for Kapisa Healthcare.
  Features:
  1. Fast-Response Direct Line Cards with 1-click clipboard copy, WhatsApp direct launch, and SLA badges.
  2. Interactive Hospital & Bulk Order Concierge Calculator with real-time tier discount calculations and 1-click inquiry prefill.
  3. Fully functional native Shopify Contact Form with live validation feel, topic routing pills, and clinical luxury aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-hub-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: #F0F4F7;
    padding: clamp(64px, 7vw, 104px) 24px;
    color: #2B2B2E;
    position: relative;
    overflow: hidden;
  }

  .ai-contact-hub-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent | default: 100 }}%;
    max-width: 1220px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .ai-contact-hub-{{ ai_gen_id }}__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(32px, 4vw, 48px);
  }

  .ai-contact-hub-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: #C9A227;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__heading {
    margin: 0 0 16px;
    color: #0E1F3C;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(32px, 3.8vw, 46px);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .ai-contact-hub-{{ ai_gen_id }}__subheading {
    margin: 0 0 28px;
    color: #475569;
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.6;
  }

  /* Interactive Main Hub Mode Switcher */
  .ai-contact-hub-{{ ai_gen_id }}__tabs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 999px;
    padding: 6px;
    box-shadow: 0 4px 16px rgba(14, 31, 60, 0.06);
    margin-bottom: clamp(32px, 4vw, 48px);
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-contact-hub-{{ ai_gen_id }}__tab-btn {
    background: transparent;
    border: none;
    color: #475569;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 220ms ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .ai-contact-hub-{{ ai_gen_id }}__tab-btn svg {
    color: #C9A227;
    width: 16px;
    height: 16px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__tab-btn.is-active,
  .ai-contact-hub-{{ ai_gen_id }}__tab-btn:hover {
    background: #0E1F3C;
    color: #FAF7F0;
  }

  .ai-contact-hub-{{ ai_gen_id }}__tab-btn.is-active svg {
    color: #C9A227;
  }

  /* PANEL 1: Direct Line Cards Grid */
  .ai-contact-hub-{{ ai_gen_id }}__direct-panel {
    display: block;
    animation: ai-contact-panel-in-{{ ai_gen_id }} 300ms ease;
  }

  .ai-contact-hub-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }

  .ai-contact-hub-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 190px;
    padding: 26px;
    background: #FAF7F0;
    border: 1px solid rgba(14, 31, 60, 0.08);
    border-radius: 18px;
    color: #2B2B2E;
    text-decoration: none;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(14, 31, 60, 0.04);
    transition: all 250ms cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .ai-contact-hub-{{ ai_gen_id }}__card:hover {
    transform: translateY(-4px);
    border-color: #C9A227;
    box-shadow: 0 16px 36px rgba(14, 31, 60, 0.1);
    background: #FFFFFF;
  }

  .ai-contact-hub-{{ ai_gen_id }}__card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(201, 162, 39, 0.12);
    color: #C9A227;
    flex-shrink: 0;
  }

  .ai-contact-hub-{{ ai_gen_id }}__icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-contact-hub-{{ ai_gen_id }}__sla-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(14, 31, 60, 0.06);
    color: #0E1F3C;
    letter-spacing: 0.05em;
  }

  .ai-contact-hub-{{ ai_gen_id }}__title {
    margin: 0 0 6px;
    color: #0E1F3C;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
  }

  .ai-contact-hub-{{ ai_gen_id }}__info {
    margin: 0 0 16px;
    color: #475569;
    font-size: 15px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .ai-contact-hub-{{ ai_gen_id }}__action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid rgba(14, 31, 60, 0.08);
  }

  .ai-contact-hub-{{ ai_gen_id }}__action {
    color: #0E1F3C;
    font-size: 13px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 180ms ease;
  }

  .ai-contact-hub-{{ ai_gen_id }}__card:hover .ai-contact-hub-{{ ai_gen_id }}__action {
    color: #C9A227;
  }

  .ai-contact-hub-{{ ai_gen_id }}__copy-btn {
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.15);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
    color: #0E1F3C;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .ai-contact-hub-{{ ai_gen_id }}__copy-btn:hover {
    background: #0E1F3C;
    color: #FAF7F0;
  }

  /* PANEL 2: Bulk Order & Hospital Concierge Calculator */
  .ai-contact-hub-{{ ai_gen_id }}__calc-panel {
    display: none;
    animation: ai-contact-panel-in-{{ ai_gen_id }} 300ms ease;
  }

  .ai-contact-hub-{{ ai_gen_id }}__calc-card {
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 24px;
    padding: clamp(28px, 4vw, 48px);
    box-shadow: 0 16px 48px rgba(14, 31, 60, 0.08);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 4vw, 56px);
  }

  .ai-contact-hub-{{ ai_gen_id }}__calc-ctrls {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__calc-slider-box {
    background: #FAF7F0;
    border: 1px solid rgba(14, 31, 60, 0.08);
    border-radius: 16px;
    padding: 24px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__slider-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__slider-head label {
    font-weight: 700;
    color: #0E1F3C;
    font-size: 15px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__slider-val-badge {
    background: #0E1F3C;
    color: #FAF7F0;
    padding: 4px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
  }

  .ai-contact-hub-{{ ai_gen_id }}__slider {
    width: 100%;
    accent-color: #0E1F3C;
    cursor: pointer;
    height: 8px;
    border-radius: 4px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__slider-ticks {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    font-size: 11px;
    color: #8FA3B8;
    font-weight: 600;
  }

  /* Customizer Checkboxes */
  .ai-contact-hub-{{ ai_gen_id }}__options-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__opt-label {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: #FAF7F0;
    border: 1px solid rgba(14, 31, 60, 0.08);
    border-radius: 12px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: #0E1F3C;
    transition: all 180ms ease;
  }

  .ai-contact-hub-{{ ai_gen_id }}__opt-label:hover {
    border-color: #C9A227;
    background: #FFFFFF;
  }

  .ai-contact-hub-{{ ai_gen_id }}__opt-label input[type="checkbox"] {
    accent-color: #0E1F3C;
    width: 18px;
    height: 18px;
  }

  /* Calc Output Side */
  .ai-contact-hub-{{ ai_gen_id }}__calc-summary {
    background: #0E1F3C;
    color: #FAF7F0;
    border-radius: 20px;
    padding: clamp(24px, 3.5vw, 36px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .ai-contact-hub-{{ ai_gen_id }}__calc-summary::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(201, 162, 39, 0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .ai-contact-hub-{{ ai_gen_id }}__tier-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: rgba(201, 162, 39, 0.2);
    border: 1px solid rgba(201, 162, 39, 0.4);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    color: #C9A227;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__summary-rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 10px;
    font-size: 14px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__summary-row strong {
    font-size: 16px;
    color: #FFFFFF;
  }

  .ai-contact-hub-{{ ai_gen_id }}__savings-highlight {
    background: rgba(201, 162, 39, 0.15);
    border-radius: 12px;
    padding: 16px;
    text-align: center;
    margin-bottom: 24px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__savings-amount {
    font-family: Georgia, serif;
    font-size: 32px;
    font-weight: 700;
    color: #C9A227;
    line-height: 1.1;
  }

  .ai-contact-hub-{{ ai_gen_id }}__savings-label {
    font-size: 12px;
    color: rgba(250, 247, 240, 0.8);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-contact-hub-{{ ai_gen_id }}__apply-calc-btn {
    width: 100%;
    min-height: 52px;
    background: #C9A227;
    color: #0E1F3C;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 220ms ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__apply-calc-btn:hover {
    background: #FAF7F0;
    color: #0E1F3C;
    box-shadow: 0 8px 24px rgba(201, 162, 39, 0.4);
  }

  /* PANEL 3: Modern Clinical Contact Form */
  .ai-contact-hub-{{ ai_gen_id }}__form-panel {
    display: none;
    animation: ai-contact-panel-in-{{ ai_gen_id }} 300ms ease;
  }

  .ai-contact-hub-{{ ai_gen_id }}__form-card {
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 24px;
    padding: clamp(28px, 4vw, 48px);
    max-width: 820px;
    margin: 0 auto;
    box-shadow: 0 16px 48px rgba(14, 31, 60, 0.08);
  }

  .ai-contact-hub-{{ ai_gen_id }}__topics {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__topic-chip {
    background: #FAF7F0;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 600;
    color: #0E1F3C;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .ai-contact-hub-{{ ai_gen_id }}__topic-chip.is-active,
  .ai-contact-hub-{{ ai_gen_id }}__topic-chip:hover {
    background: #0E1F3C;
    color: #FAF7F0;
    border-color: #0E1F3C;
  }

  .ai-contact-hub-{{ ai_gen_id }}__fields-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 18px;
  }

  .ai-contact-hub-{{ ai_gen_id }}__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
  }

  .ai-contact-hub-{{ ai_gen_id }}__field--full {
    grid-column: 1 / -1;
  }

  .ai-contact-hub-{{ ai_gen_id }}__field label {
    font-size: 13px;
    font-weight: 700;
    color: #0E1F3C;
  }

  .ai-contact-hub-{{ ai_gen_id }}__field input,
  .ai-contact-hub-{{ ai_gen_id }}__field textarea {
    width: 100%;
    padding: 14px 16px;
    background: #FAF7F0;
    border: 1px solid rgba(14, 31, 60, 0.14);
    border-radius: 8px;
    font-family: inherit;
    font-size: 15px;
    color: #0E1F3C;
    box-sizing: border-box;
    transition: all 200ms ease;
  }

  .ai-contact-hub-{{ ai_gen_id }}__field input:focus,
  .ai-contact-hub-{{ ai_gen_id }}__field textarea:focus {
    outline: none;
    background: #FFFFFF;
    border-color: #C9A227;
    box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.2);
  }

  .ai-contact-hub-{{ ai_gen_id }}__submit-btn {
    width: 100%;
    min-height: 52px;
    background: #0E1F3C;
    color: #FAF7F0;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 220ms ease;
    margin-top: 10px;
    box-shadow: 0 4px 16px rgba(14, 31, 60, 0.2);
  }

  .ai-contact-hub-{{ ai_gen_id }}__submit-btn:hover {
    background: #C9A227;
    color: #0E1F3C;
    box-shadow: 0 8px 24px rgba(201, 162, 39, 0.4);
  }

  /* Form Post Success / Error Notification */
  .ai-contact-hub-{{ ai_gen_id }}__alert {
    padding: 16px 20px;
    border-radius: 10px;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-contact-hub-{{ ai_gen_id }}__alert--success {
    background: rgba(5, 150, 105, 0.1);
    border: 1px solid #059669;
    color: #065F46;
  }

  .ai-contact-hub-{{ ai_gen_id }}__alert--error {
    background: rgba(220, 38, 38, 0.1);
    border: 1px solid #DC2626;
    color: #991B1B;
  }

  @keyframes ai-contact-panel-in-{{ ai_gen_id }} {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media screen and (max-width: 991px) {
    .ai-contact-hub-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .ai-contact-hub-{{ ai_gen_id }}__calc-card {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-contact-hub-{{ ai_gen_id }} {
      padding: 48px 20px 60px;
    }
    .ai-contact-hub-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }
    .ai-contact-hub-{{ ai_gen_id }}__fields-grid {
      grid-template-columns: 1fr;
    }
    .ai-contact-hub-{{ ai_gen_id }}__calc-card,
    .ai-contact-hub-{{ ai_gen_id }}__form-card {
      padding: 24px 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-contact-hub-{{ ai_gen_id }}__direct-panel,
    .ai-contact-hub-{{ ai_gen_id }}__calc-panel,
    .ai-contact-hub-{{ ai_gen_id }}__form-panel {
      animation: none !important;
    }
  }
{% endstyle %}

<div class="ai-contact-hub-{{ ai_gen_id }} ai-contact-hub" {{ block.shopify_attributes }}>
  <div class="ai-contact-hub-{{ ai_gen_id }}__inner">
    
    <div class="ai-contact-hub-{{ ai_gen_id }}__header">
      <div class="ai-contact-hub-{{ ai_gen_id }}__eyebrow">
        <span>&#10022;</span>
        Direct Healthcare Concierge
      </div>
      {% if block.settings.heading != blank %}
        <h2 class="ai-contact-hub-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      <p class="ai-contact-hub-{{ ai_gen_id }}__subheading">
        Choose your preferred channel below. Access fast-response direct lines, calculate enterprise bulk procurement, or send a secure clinical inquiry.
      </p>

      <!-- Hub Mode Switcher -->
      <div class="ai-contact-hub-{{ ai_gen_id }}__tabs" role="tablist">
        <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__tab-btn is-active" id="direct-lines-tab-trigger" data-panel="direct" role="tab" aria-selected="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Direct Channels &amp; Lines
        </button>
        <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__tab-btn" id="bulk-calc-tab-trigger" data-panel="calc" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01"/></svg>
          Hospital Bulk Order Calculator
        </button>
        <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__tab-btn" id="contact-form-tab-trigger" data-panel="form" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          Priority Message Form
        </button>
      </div>
    </div>

    <!-- PANEL 1: Direct Line Cards -->
    <div class="ai-contact-hub-{{ ai_gen_id }}__direct-panel ai-contact-direct-lines" id="panel-direct-{{ ai_gen_id }}" role="tabpanel">
      <div class="ai-contact-hub-{{ ai_gen_id }}__grid">
        {% for i in (1..5) %}
          {% liquid
            assign title_key = 'card_' | append: i | append: '_title'
            assign info_key = 'card_' | append: i | append: '_info'
            assign link_key = 'card_' | append: i | append: '_link'
            assign action_key = 'card_' | append: i | append: '_action'
            assign icon_key = 'card_' | append: i | append: '_icon'
            assign title = block.settings[title_key]
            assign info = block.settings[info_key]
            assign link = block.settings[link_key]
            assign action = block.settings[action_key]
            assign icon = block.settings[icon_key]
          %}
          {% if title != blank and info != blank %}
            <div class="ai-contact-hub-{{ ai_gen_id }}__card">
              <div>
                <div class="ai-contact-hub-{{ ai_gen_id }}__card-header">
                  <span class="ai-contact-hub-{{ ai_gen_id }}__icon" aria-hidden="true">
                    {% case icon %}
                      {% when 'phone' %}<svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a14 14 0 0 0 5 5L15 13l5 2v4c0 1-1 2-2 2C10.3 21 3 13.7 3 5c0-1 1-2 2-2Z"/></svg>
                      {% when 'location' %}<svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                      {% when 'map' %}<svg viewBox="0 0 24 24"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z"/><path d="M9 3v15M15 6v15"/></svg>
                      {% when 'whatsapp' %}<svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-12 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"/><path d="M9 8.5c.3 2 2 3.7 4 4l1-1 1.5.7c.3.2.4.6.2.9-.5.7-1.3 1-2.1.8-3.4-.8-5.2-2.6-6-6-.2-.8.1-1.6.8-2.1.3-.2.7-.1.9.2L10 7.5l-1 1Z"/></svg>
                      {% else %}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                    {% endcase %}
                  </span>
                  <span class="ai-contact-hub-{{ ai_gen_id }}__sla-badge">
                    {% if icon == 'whatsapp' %}Live &bull; &lt; 15m{% elsif icon == 'phone' %}Direct Line{% elsif icon == 'email' %}Within 2h{% else %}HQ Desk{% endif %}
                  </span>
                </div>
                <h3 class="ai-contact-hub-{{ ai_gen_id }}__title">{{ title | escape }}</h3>
                <p class="ai-contact-hub-{{ ai_gen_id }}__info">{{ info | escape | newline_to_br }}</p>
              </div>

              <div class="ai-contact-hub-{{ ai_gen_id }}__action-row">
                {% if link != blank %}
                  <a class="ai-contact-hub-{{ ai_gen_id }}__action" href="{{ link }}"{% if link contains 'http' %} target="_blank" rel="noopener"{% endif %}>
                    {{ action | default: 'Connect Now' | escape }} &rarr;
                  </a>
                {% else %}
                  <span class="ai-contact-hub-{{ ai_gen_id }}__action">Verified Channel</span>
                {% endif %}

                {% if icon == 'email' or icon == 'phone' %}
                  <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__copy-btn" data-copy="{{ info | escape }}">
                    Copy
                  </button>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- PANEL 2: Hospital & Bulk Order Concierge Calculator -->
    <div class="ai-contact-hub-{{ ai_gen_id }}__calc-panel kapisa-bulk-concierge" id="panel-calc-{{ ai_gen_id }}" role="tabpanel">
      <div class="ai-contact-hub-{{ ai_gen_id }}__calc-card">
        
        <div class="ai-contact-hub-{{ ai_gen_id }}__calc-ctrls">
          <div>
            <h3 style="margin:0 0 8px; font-family:Georgia,serif; font-size:24px; color:#0E1F3C;">Hospital &amp; Department Volume Estimator</h3>
            <p style="margin:0; font-size:14px; color:#475569;">Tailored institutional pricing for clinics, surgical teams, and hospital networks.</p>
          </div>

          <!-- Staff Quantity Slider -->
          <div class="ai-contact-hub-{{ ai_gen_id }}__calc-slider-box">
            <div class="ai-contact-hub-{{ ai_gen_id }}__slider-head">
              <label for="staff-slider-{{ ai_gen_id }}">Medical Personnel / Sets:</label>
              <span class="ai-contact-hub-{{ ai_gen_id }}__slider-val-badge" id="slider-val-display-{{ ai_gen_id }}">50 Sets</span>
            </div>
            <input type="range" min="10" max="300" step="5" value="50" id="staff-slider-{{ ai_gen_id }}" class="ai-contact-hub-{{ ai_gen_id }}__slider">
            <div class="ai-contact-hub-{{ ai_gen_id }}__slider-ticks">
              <span>10 (Clinic)</span>
              <span>50 (Department)</span>
              <span>150 (Surgical Wing)</span>
              <span>300+ (Hospital)</span>
            </div>
          </div>

          <!-- Add-ons Checkboxes -->
          <div class="ai-contact-hub-{{ ai_gen_id }}__options-box">
            <label class="ai-contact-hub-{{ ai_gen_id }}__opt-label">
              <input type="checkbox" id="opt-embroidery-{{ ai_gen_id }}" checked>
              <span>Custom Institutional Hospital &amp; Crest Embroidery (+ complimentary digitization)</span>
            </label>
            <label class="ai-contact-hub-{{ ai_gen_id }}__opt-label">
              <input type="checkbox" id="opt-names-{{ ai_gen_id }}">
              <span>Individual Clinician Name &amp; Title Personalization</span>
            </label>
            <label class="ai-contact-hub-{{ ai_gen_id }}__opt-label">
              <input type="checkbox" id="opt-expedited-{{ ai_gen_id }}" checked>
              <span>Expedited Clinical Delivery &amp; Dedicated Concierge Manager</span>
            </label>
          </div>
        </div>

        <!-- Calculated Summary Box -->
        <div class="ai-contact-hub-{{ ai_gen_id }}__calc-summary">
          <div>
            <span class="ai-contact-hub-{{ ai_gen_id }}__tier-badge" id="calc-tier-badge-{{ ai_gen_id }}">
              Department Tier &bull; 25% Off
            </span>

            <div class="ai-contact-hub-{{ ai_gen_id }}__summary-rows">
              <div class="ai-contact-hub-{{ ai_gen_id }}__summary-row">
                <span>Base Retail Value</span>
                <span id="calc-retail-val-{{ ai_gen_id }}">$6,000</span>
              </div>
              <div class="ai-contact-hub-{{ ai_gen_id }}__summary-row">
                <span>Effective Set Price</span>
                <strong id="calc-set-price-{{ ai_gen_id }}">$90 / set</strong>
              </div>
              <div class="ai-contact-hub-{{ ai_gen_id }}__summary-row">
                <span>Estimated Turnaround</span>
                <span id="calc-lead-time-{{ ai_gen_id }}">5–7 Business Days</span>
              </div>
            </div>

            <div class="ai-contact-hub-{{ ai_gen_id }}__savings-highlight">
              <div class="ai-contact-hub-{{ ai_gen_id }}__savings-amount" id="calc-savings-amount-{{ ai_gen_id }}">$1,500.00</div>
              <div class="ai-contact-hub-{{ ai_gen_id }}__savings-label">Institutional Savings</div>
            </div>
          </div>

          <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__apply-calc-btn" id="apply-quote-btn-{{ ai_gen_id }}">
            Request Institutional Proposal &rarr;
          </button>
        </div>

      </div>
    </div>

    <!-- PANEL 3: Priority Clinical Message Form -->
    <div class="ai-contact-hub-{{ ai_gen_id }}__form-panel kapisa-contact-form-wrapper" id="panel-form-{{ ai_gen_id }}" role="tabpanel">
      <div class="ai-contact-hub-{{ ai_gen_id }}__form-card">
        
        <h3 style="margin:0 0 10px; font-family:Georgia,serif; font-size:26px; color:#0E1F3C; text-align:center;">
          Send a Clinical Message
        </h3>
        <p style="margin:0 0 24px; font-size:14px; color:#475569; text-align:center;">
          Our surgical concierge team typically responds within 15 minutes during clinical hours.
        </p>

        <!-- Topic Selection Pills -->
        <div class="ai-contact-hub-{{ ai_gen_id }}__topics" role="group" aria-label="Inquiry Topic">
          <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__topic-chip is-active" data-topic="Hospital &amp; Bulk Procurement">Hospital Procurement</button>
          <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__topic-chip" data-topic="Sizing &amp; Tailoring Consultation">Sizing Advisory</button>
          <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__topic-chip" data-topic="Custom Institutional Embroidery">Custom Embroidery</button>
          <button type="button" class="ai-contact-hub-{{ ai_gen_id }}__topic-chip" data-topic="General Clinical Support">General Support</button>
        </div>

        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="ai-contact-hub-{{ ai_gen_id }}__alert ai-contact-hub-{{ ai_gen_id }}__alert--success" role="status" tabindex="-1">
              <strong>Thank you for contacting Kapisa Healthcare.</strong> Your message has been routed to our senior concierge team. We will review your requirements and respond promptly.
            </div>
          {%- elsif form.errors -%}
            <div class="ai-contact-hub-{{ ai_gen_id }}__alert ai-contact-hub-{{ ai_gen_id }}__alert--error" role="alert" tabindex="-1">
              Please correct the following errors: {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <input type="hidden" name="contact[Inquiry Topic]" id="form-topic-input-{{ ai_gen_id }}" value="Hospital &amp; Bulk Procurement">

          <div class="ai-contact-hub-{{ ai_gen_id }}__fields-grid">
            
            <div class="ai-contact-hub-{{ ai_gen_id }}__field">
              <label for="ContactForm-name-{{ ai_gen_id }}">Full Name *</label>
              <input type="text" id="ContactForm-name-{{ ai_gen_id }}" name="contact[name]" required autocomplete="name" placeholder="Dr. Jane Doe">
            </div>

            <div class="ai-contact-hub-{{ ai_gen_id }}__field">
              <label for="ContactForm-email-{{ ai_gen_id }}">Email Address *</label>
              <input type="email" id="ContactForm-email-{{ ai_gen_id }}" name="contact[email]" required autocomplete="email" placeholder="jane.doe@hospital.org">
            </div>

            <div class="ai-contact-hub-{{ ai_gen_id }}__field">
              <label for="ContactForm-phone-{{ ai_gen_id }}">Phone Number (Optional)</label>
              <input type="tel" id="ContactForm-phone-{{ ai_gen_id }}" name="contact[phone]" autocomplete="tel" placeholder="+1 (555) 019-2834">
            </div>

            <div class="ai-contact-hub-{{ ai_gen_id }}__field">
              <label for="ContactForm-institution-{{ ai_gen_id }}">Hospital / Practice Name</label>
              <input type="text" id="ContactForm-institution-{{ ai_gen_id }}" name="contact[Institution]" placeholder="e.g. Mayo Clinic Surgical Wing">
            </div>

            <div class="ai-contact-hub-{{ ai_gen_id }}__field ai-contact-hub-{{ ai_gen_id }}__field--full">
              <label for="ContactForm-body-{{ ai_gen_id }}">Message &amp; Requirements *</label>
              <textarea id="ContactForm-body-{{ ai_gen_id }}" name="contact[body]" rows="5" required placeholder="Please describe your sizing, department volume, or question..."></textarea>
            </div>

          </div>

          <button type="submit" class="ai-contact-hub-{{ ai_gen_id }}__submit-btn">
            Submit Clinical Inquiry &rarr;
          </button>
        {%- endform -%}

      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    const root = document.querySelector('.ai-contact-hub-{{ ai_gen_id }}');
    if (!root) return;

    // Tab Switcher
    const tabs = root.querySelectorAll('.ai-contact-hub-{{ ai_gen_id }}__tab-btn');
    const panelDirect = document.getElementById('panel-direct-{{ ai_gen_id }}');
    const panelCalc = document.getElementById('panel-calc-{{ ai_gen_id }}');
    const panelForm = document.getElementById('panel-form-{{ ai_gen_id }}');

    function switchPanel(name) {
      tabs.forEach(t => {
        const active = t.dataset.panel === name;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });

      if (panelDirect) panelDirect.style.display = name === 'direct' ? 'block' : 'none';
      if (panelCalc) panelCalc.style.display = name === 'calc' ? 'block' : 'none';
      if (panelForm) panelForm.style.display = name === 'form' ? 'block' : 'none';
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => switchPanel(tab.dataset.panel));
    });

    // Copy Button Logic
    const copyBtns = root.querySelectorAll('.ai-contact-hub-{{ ai_gen_id }}__copy-btn');
    copyBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.dataset.copy;
        if (text && navigator.clipboard) {
          navigator.clipboard.writeText(text).then(() => {
            const original = btn.textContent;
            btn.textContent = '✓ Copied';
            btn.style.borderColor = '#059669';
            btn.style.color = '#059669';
            setTimeout(() => {
              btn.textContent = original;
              btn.style.borderColor = '';
              btn.style.color = '';
            }, 2000);
          });
        }
      });
    });

    // Calculator Logic
    const slider = document.getElementById('staff-slider-{{ ai_gen_id }}');
    const sliderDisplay = document.getElementById('slider-val-display-{{ ai_gen_id }}');
    const tierBadge = document.getElementById('calc-tier-badge-{{ ai_gen_id }}');
    const retailVal = document.getElementById('calc-retail-val-{{ ai_gen_id }}');
    const setPrice = document.getElementById('calc-set-price-{{ ai_gen_id }}');
    const savingsEl = document.getElementById('calc-savings-amount-{{ ai_gen_id }}');
    const leadTime = document.getElementById('calc-lead-time-{{ ai_gen_id }}');

    const optEmb = document.getElementById('opt-embroidery-{{ ai_gen_id }}');
    const optNames = document.getElementById('opt-names-{{ ai_gen_id }}');

    const BASE_RETAIL_PRICE = 120; // $120 per set retail

    function updateCalculator() {
      if (!slider) return;
      const count = parseInt(slider.value, 10);
      if (sliderDisplay) sliderDisplay.textContent = count + ' Sets';

      let discount = 0.10;
      let tierName = 'Clinic Tier • 10% Off';
      let days = '3–5 Business Days';

      if (count >= 100) {
        discount = 0.35;
        tierName = 'Hospital Network Tier • 35% Off';
        days = '7–10 Business Days';
      } else if (count >= 50) {
        discount = 0.25;
        tierName = 'Department Tier • 25% Off';
        days = '5–7 Business Days';
      } else if (count >= 25) {
        discount = 0.15;
        tierName = 'Surgical Wing Tier • 15% Off';
        days = '4–6 Business Days';
      }

      let unitPrice = BASE_RETAIL_PRICE * (1 - discount);
      if (optNames && optNames.checked) unitPrice += 8;

      const totalRetail = BASE_RETAIL_PRICE * count;
      const totalDiscounted = unitPrice * count;
      const totalSavings = Math.max(0, totalRetail - totalDiscounted);

      if (tierBadge) tierBadge.textContent = tierName;
      if (retailVal) retailVal.textContent = '$' + totalRetail.toLocaleString();
      if (setPrice) setPrice.textContent = '$' + Math.round(unitPrice) + ' / set';
      if (savingsEl) savingsEl.textContent = '$' + Math.round(totalSavings).toLocaleString();
      if (leadTime) leadTime.textContent = days;
    }

    if (slider) {
      slider.addEventListener('input', updateCalculator);
    }
    if (optEmb) optEmb.addEventListener('change', updateCalculator);
    if (optNames) optNames.addEventListener('change', updateCalculator);

    // Apply Quote to Contact Form
    const applyQuoteBtn = document.getElementById('apply-quote-btn-{{ ai_gen_id }}');
    const formTopicInput = document.getElementById('form-topic-input-{{ ai_gen_id }}');
    const formBody = document.getElementById('ContactForm-body-{{ ai_gen_id }}');

    if (applyQuoteBtn && formBody) {
      applyQuoteBtn.addEventListener('click', () => {
        const count = slider ? slider.value : '50';
        const tier = tierBadge ? tierBadge.textContent.trim() : 'Bulk Order';
        const customEmb = optEmb && optEmb.checked ? 'Yes' : 'No';
        const customNames = optNames && optNames.checked ? 'Yes' : 'No';

        const prefillText = "Hello Kapisa Concierge,\n\nI would like to request an institutional formal proposal based on the following volume calculation:\n" +
          "• Estimated Order Volume: " + count + " scrub sets\n" +
          "• Pricing Tier Applied: " + tier + "\n" +
          "• Institutional Embroidery Required: " + customEmb + "\n" +
          "• Individual Clinician Name Personalization: " + customNames + "\n\n" +
          "Please send sample fabric swatches and institutional invoice guidelines.";

        formBody.value = prefillText;
        if (formTopicInput) formTopicInput.value = 'Hospital & Bulk Procurement';

        // Select topic chip
        root.querySelectorAll('.ai-contact-hub-{{ ai_gen_id }}__topic-chip').forEach(c => {
          c.classList.toggle('is-active', c.dataset.topic.includes('Hospital'));
        });

        switchPanel('form');
        formBody.focus();
      });
    }

    // Form Topic Chips
    const topicChips = root.querySelectorAll('.ai-contact-hub-{{ ai_gen_id }}__topic-chip');
    topicChips.forEach(chip => {
      chip.addEventListener('click', () => {
        topicChips.forEach(c => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        if (formTopicInput) {
          formTopicInput.value = chip.dataset.topic;
        }
      });
    });

    // Check if form was posted successfully or has errors, if so activate form panel
    const hasAlert = root.querySelector('.ai-contact-hub-{{ ai_gen_id }}__alert');
    if (hasAlert) {
      switchPanel('form');
    }
  })();
</script>

