{% doc %}
  @prompt
    Create a premium Contact Information section for Kapisa Healthcare.
    
    Use soft blue-gray #F0F4F7 as the section background. Use warm cream #FAF7F0 for the cards. Use deep navy #0E1F3C for headings and charcoal #2B2B2E for descriptions. Use gold #C9A227 for small SVG icons.
    
    Create cards for:
    
    * Email
    * Phone
    * WhatsApp
    * Office Address
    * Google Maps / Get Directions
    
    Desktop: use a maximum width of 1200px and display the cards in a clean responsive grid. Each card should have a simple premium SVG icon, title, actual contact information, and optional action text such as “Email Us”, “Call Now”, “Chat on WhatsApp”, or “Get Directions”. Cards should have 16px rounded corners and 24px padding.
    
    Mobile: use 20px horizontal padding and display one card per row. Make each card approximately 88–100px tall. Place the icon on the left and information on the right. Make cards clickable where applicable. The interaction should feel like a native mobile app.
    
    Shopify settings:
    Make every card editable through blocks. Each block needs icon, title, information, link, and optional action text. Allow merchants to add, remove, and reorder cards.
    
    Do not invent contact details. Hide empty cards automatically.
    
    Return complete Liquid, CSS, HTML, and schema.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: #F0F4F7;
    padding: 64px 24px;
  }

  .ai-contact-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-contact-{{ ai_gen_id }}__heading {
    margin: 0 0 28px;
    color: #0E1F3C;
    font-size: 32px;
    line-height: 1.2;
    text-align: center;
  }

  .ai-contact-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-contact-{{ ai_gen_id }}__card {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 136px;
    padding: 24px;
    background: #FAF7F0;
    border-radius: 16px;
    color: #2B2B2E;
    text-decoration: none;
    box-sizing: border-box;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .ai-contact-{{ ai_gen_id }}__card:hover,
  .ai-contact-{{ ai_gen_id }}__card:focus-visible {
    box-shadow: 0 8px 24px rgba(14, 31, 60, 0.12);
    transform: translateY(-2px);
  }

  .ai-contact-{{ ai_gen_id }}__card:focus-visible {
    outline: 3px solid #0E1F3C;
    outline-offset: 3px;
  }

  .ai-contact-{{ ai_gen_id }}__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    color: #C9A227;
  }

  .ai-contact-{{ ai_gen_id }}__icon svg {
    width: 30px;
    height: 30px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-contact-{{ ai_gen_id }}__title {
    margin: 0 0 5px;
    color: #0E1F3C;
    font-size: 18px;
    line-height: 1.25;
  }

  .ai-contact-{{ ai_gen_id }}__info {
    margin: 0;
    color: #2B2B2E;
    font-size: 15px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .ai-contact-{{ ai_gen_id }}__action {
    display: inline-block;
    margin-top: 7px;
    color: #0E1F3C;
    font-size: 13px;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-contact-{{ ai_gen_id }}__heading {
      margin-bottom: 20px;
      font-size: 27px;
    }

    .ai-contact-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ai-contact-{{ ai_gen_id }}__card {
      min-height: 96px;
      padding: 18px;
    }
  }
{% endstyle %}

<div class="ai-contact-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-contact-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-contact-{{ ai_gen_id }}__grid">
      {% for i in (1..5) %}
        {% liquid
          assign title_key = 'card_' | append: i | append: '_title'
          assign info_key = 'card_' | append: i | append: '_info'
          assign link_key = 'card_' | append: i | append: '_link'
          assign action_key = 'card_' | append: i | append: '_action'
          assign icon_key = 'card_' | append: i | append: '_icon'
          assign title = block.settings[title_key]
          assign info = block.settings[info_key]
          assign link = block.settings[link_key]
          assign action = block.settings[action_key]
          assign icon = block.settings[icon_key]
        %}
        {% if title != blank and info != blank %}
          {% if link != blank %}<a class="ai-contact-{{ ai_gen_id }}__card" href="{{ link }}"{% if link contains 'http' %} target="_blank" rel="noopener"{% endif %}>{% else %}<div class="ai-contact-{{ ai_gen_id }}__card">{% endif %}
            <span class="ai-contact-{{ ai_gen_id }}__icon" aria-hidden="true">
              {% case icon %}
                {% when 'phone' %}<svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a14 14 0 0 0 5 5L15 13l5 2v4c0 1-1 2-2 2C10.3 21 3 13.7 3 5c0-1 1-2 2-2Z"/></svg>
                {% when 'location' %}<svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                {% when 'map' %}<svg viewBox="0 0 24 24"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z"/><path d="M9 3v15M15 6v15"/></svg>
                {% when 'whatsapp' %}<svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-12 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"/><path d="M9 8.5c.3 2 2 3.7 4 4l1-1 1.5.7c.3.2.4.6.2.9-.5.7-1.3 1-2.1.8-3.4-.8-5.2-2.6-6-6-.2-.8.1-1.6.8-2.1.3-.2.7-.1.9.2L10 7.5l-1 1Z"/></svg>
                {% else %}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              {% endcase %}
            </span>
            <span>
              <span class="ai-contact-{{ ai_gen_id }}__title">{{ title | escape }}</span>
              <span class="ai-contact-{{ ai_gen_id }}__info">{{ info | escape | newline_to_br }}</span>
              {% if action != blank %}<span class="ai-contact-{{ ai_gen_id }}__action">{{ action | escape }}</span>{% endif %}
            </span>
          {% if link != blank %}</a>{% else %}</div>{% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact information",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Contact Kapisa Healthcare"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Email"},
    {"type":"select","id":"card_1_icon","label":"Icon","options":[{"value":"email","label":"Email"},{"value":"phone","label":"Phone"},{"value":"whatsapp","label":"WhatsApp"},{"value":"location","label":"Location"},{"value":"map","label":"Map"}],"default":"email"},
    {"type":"text","id":"card_1_title","label":"Title","default":"Email"},{"type":"textarea","id":"card_1_info","label":"Information"},{"type":"url","id":"card_1_link","label":"Link"},{"type":"text","id":"card_1_action","label":"Action text"},
    {"type":"header","content":"Phone"},
    {"type":"select","id":"card_2_icon","label":"Icon","options":[{"value":"email","label":"Email"},{"value":"phone","label":"Phone"},{"value":"whatsapp","label":"WhatsApp"},{"value":"location","label":"Location"},{"value":"map","label":"Map"}],"default":"phone"},
    {"type":"text","id":"card_2_title","label":"Title","default":"Phone"},{"type":"textarea","id":"card_2_info","label":"Information"},{"type":"url","id":"card_2_link","label":"Link"},{"type":"text","id":"card_2_action","label":"Action text"},
    {"type":"header","content":"WhatsApp"},
    {"type":"select","id":"card_3_icon","label":"Icon","options":[{"value":"email","label":"Email"},{"value":"phone","label":"Phone"},{"value":"whatsapp","label":"WhatsApp"},{"value":"location","label":"Location"},{"value":"map","label":"Map"}],"default":"whatsapp"},
    {"type":"text","id":"card_3_title","label":"Title","default":"WhatsApp"},{"type":"textarea","id":"card_3_info","label":"Information"},{"type":"url","id":"card_3_link","label":"Link"},{"type":"text","id":"card_3_action","label":"Action text"},
    {"type":"header","content":"Office address"},
    {"type":"select","id":"card_4_icon","label":"Icon","options":[{"value":"email","label":"Email"},{"value":"phone","label":"Phone"},{"value":"whatsapp","label":"WhatsApp"},{"value":"location","label":"Location"},{"value":"map","label":"Map"}],"default":"location"},
    {"type":"text","id":"card_4_title","label":"Title","default":"Office Address"},{"type":"textarea","id":"card_4_info","label":"Information"},{"type":"url","id":"card_4_link","label":"Link"},{"type":"text","id":"card_4_action","label":"Action text"},
    {"type":"header","content":"Directions"},
    {"type":"select","id":"card_5_icon","label":"Icon","options":[{"value":"email","label":"Email"},{"value":"phone","label":"Phone"},{"value":"whatsapp","label":"WhatsApp"},{"value":"location","label":"Location"},{"value":"map","label":"Map"}],"default":"map"},
    {"type":"text","id":"card_5_title","label":"Title","default":"Google Maps / Get Directions"},{"type":"textarea","id":"card_5_info","label":"Information"},{"type":"url","id":"card_5_link","label":"Link"},{"type":"text","id":"card_5_action","label":"Action text"}
  ],
  "presets": [{"name":"Contact information"}],
  "tag": null,
  "class": "contact-information-block"
}
{% endschema %}