    },
    {
      "type": "text",
      "id": "item_two",
      "label": "Message 2",
      "default": "TONS OF STORAGE"
    },
    {
      "type": "text",
      "id": "item_three",
      "label": "Message 3",
      "default": "ANTI-DISTRACTION"
    },
    {
      "type": "text",
      "id": "item_four",
      "label": "Message 4",
      "default": "LAB TESTED"
    },
    {
      "type": "text",
      "id": "item_five",
      "label": "Message 5",
      "default": "LONG-SHIFT VERIFIED"
    },
    {
      "type": "text",
      "id": "item_six",
      "label": "Message 6",
      "default": "4-WAY STRETCH"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
