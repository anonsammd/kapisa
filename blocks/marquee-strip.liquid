    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (s)",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Marquee strip"
    }
  ],
  "tag": null,
  "class": "marquee-strip-block"
}
{% endschema %}
