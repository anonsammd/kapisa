{% doc %}
  @prompt
    Add a thin full-width marquee strip directly below the hero, continuously auto-scrolling
    horizontally (infinite loop, smooth, pause on hover). Content repeats high-trust medical
    features separated by small gold dot dividers.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent | default: 100 }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.bg_color | default: '#0E1F3C' }};
    color: {{ block.settings.text_color | default: '#FAF7F0' }};
    border-bottom: 1px solid rgba(201, 162, 39, 0.2);
  }

  .ai-marquee-{{ ai_gen_id }}__viewport {
    display: flex;
    align-items: center;
    min-height: {{ block.settings.strip_height | default: 44 }}px;
    overflow: hidden;
  }

  .ai-marquee-{{ ai_gen_id }}__track {
    display: flex;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed | default: 28 }}s linear infinite;
  }

  .ai-marquee-{{ ai_gen_id }}__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    white-space: nowrap;
  }

  .ai-marquee-{{ ai_gen_id }}__item {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 0 24px;
    font-size: {{ block.settings.text_size | default: 12 }}px;
    font-weight: 700;
    letter-spacing: {{ block.settings.letter_spacing | default: 1.5 }}px;
    text-transform: uppercase;
    line-height: 1;
  }

  .ai-marquee-{{ ai_gen_id }}__divider {
    display: inline-block;
    width: 5px;
    height: 5px;
    flex: 0 0 5px;
    border-radius: 50%;
    background: {{ block.settings.divider_color | default: '#C9A227' }};
  }

  .ai-marquee-{{ ai_gen_id }}:hover .ai-marquee-{{ ai_gen_id }}__track,
  .ai-marquee-{{ ai_gen_id }}:focus-within .ai-marquee-{{ ai_gen_id }}__track {
    animation-play-state: paused;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-{{ ai_gen_id }}__item {
      gap: 18px;
      padding: 0 18px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-marquee-{{ ai_gen_id }}__track {
      animation: none;
      transform: none;
    }

    .ai-marquee-{{ ai_gen_id }}__group:last-child {
      display: none;
    }
  }
{% endstyle %}

<marquee-strip-{{ ai_gen_id }}
  class="ai-marquee-{{ ai_gen_id }}"
  role="region"
  aria-label="{{ block.settings.accessibility_label | default: 'Store highlights' | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-{{ ai_gen_id }}__viewport">
    <div class="ai-marquee-{{ ai_gen_id }}__track">
      {% for copy in (1..3) %}
        <div class="ai-marquee-{{ ai_gen_id }}__group" {% if copy > 1 %}aria-hidden="true"{% endif %}>
          <span class="ai-marquee-{{ ai_gen_id }}__item">
            {% if block.settings.item_one != blank %}
              <span>{{ block.settings.item_one | escape }}</span>
              <span class="ai-marquee-{{ ai_gen_id }}__divider" aria-hidden="true"></span>
            {% endif %}
            {% if block.settings.item_two != blank %}
              <span>{{ block.settings.item_two | escape }}</span>
              <span class="ai-marquee-{{ ai_gen_id }}__divider" aria-hidden="true"></span>
            {% endif %}
            {% if block.settings.item_three != blank %}
              <span>{{ block.settings.item_three | escape }}</span>
              <span class="ai-marquee-{{ ai_gen_id }}__divider" aria-hidden="true"></span>
            {% endif %}
            {% if block.settings.item_four != blank %}
              <span>{{ block.settings.item_four | escape }}</span>
              <span class="ai-marquee-{{ ai_gen_id }}__divider" aria-hidden="true"></span>
            {% endif %}
            {% if block.settings.item_five != blank %}
              <span>{{ block.settings.item_five | escape }}</span>
              <span class="ai-marquee-{{ ai_gen_id }}__divider" aria-hidden="true"></span>
            {% endif %}
            {% if block.settings.item_six != blank %}
              <span>{{ block.settings.item_six | escape }}</span>
              <span class="ai-marquee-{{ ai_gen_id }}__divider" aria-hidden="true"></span>
            {% endif %}
          </span>
        </div>
      {% endfor %}
    </div>
  </div>
</marquee-strip-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeStrip{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.setAttribute('data-ready', 'true');
      }
    }
    if (!customElements.get('marquee-strip-{{ ai_gen_id }}')) {
      customElements.define('marquee-strip-{{ ai_gen_id }}', MarqueeStrip{{ ai_gen_id }});
    }
  })();
</script>

