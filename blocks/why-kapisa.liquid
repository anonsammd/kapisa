    { "type": "html", "id": "icon_one", "label": "SVG icon", "default": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 3v18M3 12h18\"/></svg>" },
    { "type": "text", "id": "title_one", "label": "Title", "default": "Thoughtful Design" },
    { "type": "textarea", "id": "description_one", "label": "Description", "default": "Considered details made for a better everyday experience." },
    { "type": "header", "content": "Feature two" },
    { "type": "html", "id": "icon_two", "label": "SVG icon", "default": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4z\"/></svg>" },
    { "type": "text", "id": "title_two", "label": "Title", "default": "Everyday Comfort" },
    { "type": "textarea", "id": "description_two", "label": "Description", "default": "Comfort-focused essentials that fit naturally into your routine." },
    { "type": "header", "content": "Feature three" },
    { "type": "html", "id": "icon_three", "label": "SVG icon", "default": "<svg viewBox=\"0 0 24 24\"><path d=\"M4 19h16M6 19V9h12v10M9 9V5h6v4\"/></svg>" },
    { "type": "text", "id": "title_three", "label": "Title", "default": "Professional Confidence" },
    { "type": "textarea", "id": "description_three", "label": "Description", "default": "Reliable choices designed to help you feel ready for the day." },
    { "type": "header", "content": "Feature four" },
    { "type": "html", "id": "icon_four", "label": "SVG icon", "default": "<svg viewBox=\"0 0 24 24\"><path d=\"M4 12a8 8 0 1 0 16 0 8 8 0 0 0-16 0zM8 12h8M12 8v8\"/></svg>" },
    { "type": "text", "id": "title_four", "label": "Title", "default": "Built for Your Routine" },
    { "type": "textarea", "id": "description_four", "label": "Description", "default": "Simple, dependable solutions that work with the way you live." }
  ],
  "presets": [{ "name": "Why Kapisa features" }],
  "tag": null,
  "class": "why-kapisa-features"
}
{% endschema %}