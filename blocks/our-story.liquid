{% doc %}
  @prompt
    Create a premium Our Story section for the Kapisa Healthcare About Us page.
    
    Use a warm cream background #FAF7F0. Use deep navy #0E1F3C for the heading and charcoal #2B2B2E for all paragraph text. Use gold #C9A227 for a small uppercase eyebrow label and a thin decorative divider. Do not use a dark background in this section.
    
    Desktop layout:
    Center the content inside a maximum width of 900px. Add a small gold eyebrow text “OUR STORY”, followed by the heading “More Than What You Wear”. Below it, display three short paragraphs explaining Kapisa’s purpose, design philosophy, and commitment to creating thoughtful healthcare apparel. Keep the text width approximately 720px for comfortable reading. Use an elegant serif heading approximately 46px and body text approximately 17px with 1.8 line height.
    
    Mobile layout:
    Use 20px horizontal padding. Make the heading 31px and body text 16px. Keep the section vertically spacious but not oversized. Each paragraph should have approximately 18px bottom spacing. The layout must feel like a premium mobile editorial page.
    
    Animation:
    Reveal the eyebrow, heading, and paragraphs with subtle upward fade animations as the user scrolls. Use a gentle stagger between paragraphs. Respect reduced-motion preferences.
    
    Shopify settings:
    Add editable eyebrow, heading, and three paragraph text settings. Keep the default copy relevant to Kapisa Healthcare.
    
    Return complete Shopify Liquid, responsive CSS, and valid schema. Do not modify other theme sections.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-our-story-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 104px 24px 108px;
    background: #FAF7F0;
    color: #2B2B2E;
  }

  .ai-our-story__inner-{{ ai_gen_id }} {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-our-story__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 22px;
    color: #C9A227;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-our-story__divider-{{ ai_gen_id }} {
    width: 56px;
    height: 1px;
    margin: 0 auto 27px;
    background: #C9A227;
  }

  .ai-our-story__heading-{{ ai_gen_id }} {
    max-width: 780px;
    margin: 0 auto 38px;
    color: #0E1F3C;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 46px;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .ai-our-story__copy-{{ ai_gen_id }} {
    max-width: 720px;
    margin: 0 auto;
    text-align: left;
  }

  .ai-our-story__paragraph-{{ ai_gen_id }} {
    margin: 0 0 18px;
    color: #2B2B2E;
    font-size: 17px;
    line-height: 1.8;
  }

  .ai-our-story__paragraph-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-our-story__reveal-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 700ms ease, transform 700ms ease;
  }

  .ai-our-story__reveal-{{ ai_gen_id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-our-story__paragraph-{{ ai_gen_id }}:nth-child(2) {
    transition-delay: 120ms;
  }

  .ai-our-story__paragraph-{{ ai_gen_id }}:nth-child(3) {
    transition-delay: 240ms;
  }

  @media screen and (max-width: 749px) {
    .ai-our-story-{{ ai_gen_id }} {
      padding: 76px 20px 82px;
    }

    .ai-our-story__eyebrow-{{ ai_gen_id }} {
      margin-bottom: 18px;
      font-size: 11px;
    }

    .ai-our-story__divider-{{ ai_gen_id }} {
      margin-bottom: 24px;
    }

    .ai-our-story__heading-{{ ai_gen_id }} {
      margin-bottom: 30px;
      font-size: 31px;
      line-height: 1.18;
    }

    .ai-our-story__paragraph-{{ ai_gen_id }} {
      font-size: 16px;
      line-height: 1.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-our-story__reveal-{{ ai_gen_id }} {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstyle %}

<our-story-{{ ai_gen_id }} class="ai-our-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-our-story__inner-{{ ai_gen_id }}">
    <p class="ai-our-story__eyebrow-{{ ai_gen_id }} ai-our-story__reveal-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
    <div class="ai-our-story__divider-{{ ai_gen_id }} ai-our-story__reveal-{{ ai_gen_id }}" aria-hidden="true"></div>
    <h2 class="ai-our-story__heading-{{ ai_gen_id }} ai-our-story__reveal-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    <div class="ai-our-story__copy-{{ ai_gen_id }}">
      <p class="ai-our-story__paragraph-{{ ai_gen_id }} ai-our-story__reveal-{{ ai_gen_id }}">{{ block.settings.paragraph_one }}</p>
      <p class="ai-our-story__paragraph-{{ ai_gen_id }} ai-our-story__reveal-{{ ai_gen_id }}">{{ block.settings.paragraph_two }}</p>
      <p class="ai-our-story__paragraph-{{ ai_gen_id }} ai-our-story__reveal-{{ ai_gen_id }}">{{ block.settings.paragraph_three }}</p>
    </div>
  </div>
</our-story-{{ ai_gen_id }}>

<script>
  (function() {
    class OurStory{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        const items = this.querySelectorAll('.ai-our-story__reveal-{{ ai_gen_id }}');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        if (!('IntersectionObserver' in window)) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries, instance) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              instance.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        items.forEach((item) => observer.observe(item));
      }
    }
    customElements.define('our-story-{{ ai_gen_id }}', OurStory{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Our story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Than What You Wear"
    },
    {
      "type": "textarea",
      "id": "paragraph_one",
      "label": "Paragraph one",
      "default": "Kapisa Healthcare was created with a simple purpose: to bring more comfort, confidence, and care to the people who spend their days caring for others."
    },
    {
      "type": "textarea",
      "id": "paragraph_two",
      "label": "Paragraph two",
      "default": "We believe healthcare apparel should support the rhythm of real work while still feeling considered and personal. Every detail is thoughtfully designed to move with you, wear beautifully, and make demanding days feel a little easier."
    },
    {
      "type": "textarea",
      "id": "paragraph_three",
      "label": "Paragraph three",
      "default": "From first sketch to final stitch, our commitment is to create dependable, thoughtfully made apparel for healthcare professionals who show up with purpose every day."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Our story"
    }
  ],
  "tag": null,
  "class": "our-story-block"
}
{% endschema %}