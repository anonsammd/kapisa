{% doc %}
  Interactive performance fabric lab with interactive garment hotspots,
  clinical shift mode switcher, live fabric metrics, and a contrasting clinical proof ribbon.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent | default: 100 }}%;
    max-width: 100%;
    background: {{ block.settings.background_color | default: '#0E1F3C' }};
    color: {{ block.settings.text_color | default: '#F8F5ED' }};
    overflow: hidden;
    position: relative;
    padding: clamp(48px, 6vw, 84px) 0 0;
    box-sizing: border-box;
  }

  /* Ambient Glow */
  .ai-features-{{ ai_gen_id }}::before {
    content: "";
    position: absolute;
    top: 10%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(201, 162, 39, 0.12) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .ai-features-{{ ai_gen_id }}__inner {
    width: min({{ block.settings.content_width | default: 1200 }}px, calc(100% - 48px));
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Section Header */
  .ai-features-{{ ai_gen_id }}__top-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 52px);
  }

  .ai-features-{{ ai_gen_id }}__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .ai-features-{{ ai_gen_id }}__eyebrow-badge {
    padding: 3px 10px;
    background: rgba(201, 162, 39, 0.15);
    border: 1px solid rgba(201, 162, 39, 0.35);
    border-radius: 999px;
  }

  .ai-features-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: {{ block.settings.text_color | default: '#F8F5ED' }};
    font-size: clamp(30px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
    max-width: 720px;
  }

  /* Shift Mode Interactive Switcher */
  .ai-features-{{ ai_gen_id }}__modes {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.06);
    padding: 6px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  .ai-features-{{ ai_gen_id }}__mode-btn {
    background: transparent;
    border: none;
    color: rgba(248, 245, 237, 0.7);
    font-size: 12px;
    font-weight: 700;
    padding: 9px 20px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ai-features-{{ ai_gen_id }}__mode-btn.is-active,
  .ai-features-{{ ai_gen_id }}__mode-btn:hover {
    background: {{ block.settings.accent_color | default: '#C9A227' }};
    color: #0E1F3C;
    box-shadow: 0 4px 16px rgba(201, 162, 39, 0.4);
    transform: translateY(-1px);
  }

  /* Grid Layout */
  .ai-features-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  /* Interactive Hotspot Garment Visual */
  .ai-features-{{ ai_gen_id }}__stage {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    background: radial-gradient(circle at 50% 30%, #1a3258 0%, #071324 100%);
    border: 1px solid rgba(201, 162, 39, 0.25);
    box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.5);
    aspect-ratio: 1 / 1.18;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-features-{{ ai_gen_id }}__stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
  }

  .ai-features-{{ ai_gen_id }}__stage-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: rgba(14, 31, 60, 0.88);
    backdrop-filter: blur(10px);
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 39, 0.35);
    font-size: 11px;
    font-weight: 700;
    color: #FAF7F0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .ai-features-{{ ai_gen_id }}__stage-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: {{ block.settings.accent_color | default: '#C9A227' }};
    box-shadow: 0 0 10px {{ block.settings.accent_color | default: '#C9A227' }};
  }

  /* Hotspot Pulsing Nodes */
  .ai-features-{{ ai_gen_id }}__hotspot {
    position: absolute;
    z-index: 3;
    transform: translate(-50%, -50%);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .ai-features-{{ ai_gen_id }}__hotspot-pin {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(201, 162, 39, 0.95);
    border: 2px solid #FFFFFF;
    box-shadow: 0 0 20px rgba(201, 162, 39, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0E1F3C;
    font-size: 11px;
    font-weight: 800;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
  }

  .ai-features-{{ ai_gen_id }}__hotspot::before {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.accent_color | default: '#C9A227' }};
    opacity: 0.8;
    animation: ai-pulse-{{ ai_gen_id }} 2s infinite cubic-bezier(0.24, 0, 0.38, 1);
  }

  @keyframes ai-pulse-{{ ai_gen_id }} {
    0% { transform: scale(0.8); opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  .ai-features-{{ ai_gen_id }}__hotspot.is-active .ai-features-{{ ai_gen_id }}__hotspot-pin,
  .ai-features-{{ ai_gen_id }}__hotspot:hover .ai-features-{{ ai_gen_id }}__hotspot-pin {
    transform: scale(1.25);
    background: #FFFFFF;
    color: #0E1F3C;
    box-shadow: 0 0 25px rgba(255, 255, 255, 0.9);
  }

  /* Hotspot Coordinates */
  .ai-features-{{ ai_gen_id }}__hotspot[data-target="1"] { top: 28%; left: 36%; }
  .ai-features-{{ ai_gen_id }}__hotspot[data-target="2"] { top: 42%; left: 52%; }
  .ai-features-{{ ai_gen_id }}__hotspot[data-target="3"] { top: 57%; left: 38%; }
  .ai-features-{{ ai_gen_id }}__hotspot[data-target="4"] { top: 67%; left: 62%; }

  /* Live Telemetry Meter inside stage */
  .ai-features-{{ ai_gen_id }}__telemetry {
    position: absolute;
    bottom: 18px;
    left: 18px;
    right: 18px;
    background: rgba(14, 31, 60, 0.92);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(201, 162, 39, 0.3);
    border-radius: 16px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    z-index: 2;
  }

  .ai-features-{{ ai_gen_id }}__telemetry-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-features-{{ ai_gen_id }}__telemetry-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94A3B8;
    font-weight: 700;
  }

  .ai-features-{{ ai_gen_id }}__telemetry-val {
    font-size: 13px;
    font-weight: 800;
    color: #FAF7F0;
    letter-spacing: -0.01em;
  }

  /* Interactive Cards Stack */
  .ai-features-{{ ai_gen_id }}__cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ai-features-{{ ai_gen_id }}__card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 20px;
    padding: 20px 24px;
    backdrop-filter: blur(14px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .ai-features-{{ ai_gen_id }}__card:hover,
  .ai-features-{{ ai_gen_id }}__card.is-active {
    background: rgba(255, 255, 255, 0.08);
    border-color: {{ block.settings.accent_color | default: '#C9A227' }};
    transform: translateX(8px);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.4);
  }

  .ai-features-{{ ai_gen_id }}__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .ai-features-{{ ai_gen_id }}__card-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .ai-features-{{ ai_gen_id }}__card-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(201, 162, 39, 0.15);
    border: 1px solid rgba(201, 162, 39, 0.3);
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .ai-features-{{ ai_gen_id }}__card:hover .ai-features-{{ ai_gen_id }}__card-icon,
  .ai-features-{{ ai_gen_id }}__card.is-active .ai-features-{{ ai_gen_id }}__card-icon {
    background: {{ block.settings.accent_color | default: '#C9A227' }};
    color: #0E1F3C;
    transform: scale(1.08);
  }

  .ai-features-{{ ai_gen_id }}__card-icon svg {
    width: 20px;
    height: 20px;
  }

  .ai-features-{{ ai_gen_id }}__card-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #FAF7F0;
    letter-spacing: -0.01em;
  }

  .ai-features-{{ ai_gen_id }}__card-stat {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(201, 162, 39, 0.12);
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    border: 1px solid rgba(201, 162, 39, 0.25);
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .ai-features-{{ ai_gen_id }}__card-desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: {{ block.settings.muted_text_color | default: '#CBD5E1' }};
    padding-left: 52px;
    transition: all 0.3s ease;
  }

  /* Clinical Proof Ribbon (New transition between features and testimonials) */
  .ai-features-{{ ai_gen_id }}__proof-ribbon {
    width: 100%;
    background: #FAF7F0;
    color: #0E1F3C;
    padding: 24px 20px;
    margin-top: 10px;
    border-top: 1px solid rgba(201, 162, 39, 0.2);
    position: relative;
    z-index: 2;
  }

  .ai-features-{{ ai_gen_id }}__proof-inner {
    width: min({{ block.settings.content_width | default: 1200 }}px, calc(100% - 32px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ai-features-{{ ai_gen_id }}__proof-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    color: #0E1F3C;
    letter-spacing: -0.01em;
  }

  .ai-features-{{ ai_gen_id }}__proof-item svg {
    width: 20px;
    height: 20px;
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    flex-shrink: 0;
  }

  .ai-features-{{ ai_gen_id }}__proof-divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 31, 60, 0.12);
  }

  @media (max-width: 991px) {
    .ai-features-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-features-{{ ai_gen_id }}__proof-divider {
      display: none;
    }

    .ai-features-{{ ai_gen_id }}__proof-inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 767px) {
    .ai-features-{{ ai_gen_id }} {
      padding: 32px 0 0;
      overflow-x: hidden;
      max-width: 100vw;
    }

    .ai-features-{{ ai_gen_id }}__inner {
      width: 100%;
      padding: 0 16px;
      box-sizing: border-box;
    }

    .ai-features-{{ ai_gen_id }}__top-bar {
      margin-bottom: 20px;
    }

    .ai-features-{{ ai_gen_id }}__heading {
      font-size: 24px;
      line-height: 1.18;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }

    /* Shift Mode Switcher: Native Touch Horizontal Scroll */
    .ai-features-{{ ai_gen_id }}__modes {
      display: flex;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      justify-content: flex-start;
      align-items: center;
      padding: 4px;
      border-radius: 999px;
      box-sizing: border-box;
      gap: 6px;
    }

    .ai-features-{{ ai_gen_id }}__modes::-webkit-scrollbar {
      display: none;
    }

    .ai-features-{{ ai_gen_id }}__mode-btn {
      flex: 0 0 auto;
      padding: 7px 15px;
      font-size: 11px;
      white-space: nowrap;
    }

    /* Interactive Garment Stage */
    .ai-features-{{ ai_gen_id }}__stage {
      aspect-ratio: 1 / 1.08;
      max-height: 420px;
      border-radius: 20px;
      margin-bottom: 16px;
      position: relative;
    }

    .ai-features-{{ ai_gen_id }}__stage-badge {
      top: 10px;
      left: 10px;
      padding: 3px 8px;
      font-size: 8px;
      gap: 4px;
      max-width: 65%;
      border-radius: 999px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ai-features-{{ ai_gen_id }}__stage-badge-dot {
      width: 4px;
      height: 4px;
      flex-shrink: 0;
    }

    .ai-features-{{ ai_gen_id }}__hotspot-pin {
      width: 24px;
      height: 24px;
      font-size: 9.5px;
    }

    /* Mobile Hotspot Coordinates (Clear of Telemetry Box) */
    .ai-features-{{ ai_gen_id }}__hotspot[data-target="1"] { top: 27%; left: 36%; }
    .ai-features-{{ ai_gen_id }}__hotspot[data-target="2"] { top: 41%; left: 52%; }
    .ai-features-{{ ai_gen_id }}__hotspot[data-target="3"] { top: 56%; left: 38%; }
    .ai-features-{{ ai_gen_id }}__hotspot[data-target="4"] { top: 66%; left: 62%; }

    /* Compact Telemetry Readout */
    .ai-features-{{ ai_gen_id }}__telemetry {
      position: absolute;
      bottom: 8px;
      left: 8px;
      right: 8px;
      padding: 7px 8px;
      border-radius: 12px;
      background: rgba(14, 31, 60, 0.95);
      border: 1px solid rgba(201, 162, 39, 0.35);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
      z-index: 2;
    }

    .ai-features-{{ ai_gen_id }}__telemetry-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1px;
    }

    .ai-features-{{ ai_gen_id }}__telemetry-label {
      font-size: 7px;
      letter-spacing: 0.06em;
      white-space: nowrap;
      color: #94A3B8;
    }

    .ai-features-{{ ai_gen_id }}__telemetry-val {
      font-size: 9.5px;
      font-weight: 800;
      line-height: 1.2;
      color: #FAF7F0;
      white-space: nowrap;
    }

    /* Cards: Horizontal swipeable track on mobile (Snap one-by-one) */
    .ai-features-{{ ai_gen_id }}__cards {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: 4px 16px 16px;
      margin: 0 -16px;
      gap: 12px;
      width: calc(100% + 32px);
      box-sizing: border-box;
    }

    .ai-features-{{ ai_gen_id }}__cards::-webkit-scrollbar {
      display: none;
    }

    .ai-features-{{ ai_gen_id }}__card {
      flex: 0 0 85%;
      max-width: 320px;
      min-width: 270px;
      scroll-snap-align: center;
      scroll-snap-stop: normal;
      padding: 16px 16px 18px;
      border-radius: 18px;
      box-sizing: border-box;
      transform: none !important;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
    }

    .ai-features-{{ ai_gen_id }}__card.is-active {
      border-color: #C9A227;
      background: rgba(201, 162, 39, 0.1);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .ai-features-{{ ai_gen_id }}__card-top {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      margin-bottom: 6px;
      width: 100%;
    }

    .ai-features-{{ ai_gen_id }}__card-left {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
    }

    .ai-features-{{ ai_gen_id }}__card-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      flex-shrink: 0;
    }

    .ai-features-{{ ai_gen_id }}__card-icon svg {
      width: 16px;
      height: 16px;
    }

    .ai-features-{{ ai_gen_id }}__card-title {
      font-size: 14.5px;
      line-height: 1.3;
      white-space: normal;
      word-break: normal;
      flex: 1 1 auto;
      color: #FAF7F0;
    }

    .ai-features-{{ ai_gen_id }}__card-stat {
      align-self: flex-start;
      margin-left: 42px;
      font-size: 9.5px;
      padding: 2.5px 8px;
      white-space: normal;
      display: inline-block;
    }

    .ai-features-{{ ai_gen_id }}__card-desc {
      padding-left: 42px;
      font-size: 11.5px;
      line-height: 1.45;
      margin-top: 4px;
    }

    .ai-features-{{ ai_gen_id }}__proof-inner {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ai-features-{{ ai_gen_id }}__proof-item {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-features-{{ ai_gen_id }}__hotspot::before {
      animation: none;
    }
    .ai-features-{{ ai_gen_id }}__card,
    .ai-features-{{ ai_gen_id }}__stage img {
      transition: none;
    }
  }
{% endstyle %}

<feature-highlights-{{ ai_gen_id }} class="ai-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-{{ ai_gen_id }}__inner">
    
    <!-- Header -->
    <div class="ai-features-{{ ai_gen_id }}__top-bar">
      <div class="ai-features-{{ ai_gen_id }}__eyebrow">
        <span class="ai-features-{{ ai_gen_id }}__eyebrow-badge">PROPRIETARY LAB KNIT</span>
        <span>{{ block.settings.eyebrow | default: 'Performance Fabric Anatomy' }}</span>
      </div>
      <h2 class="ai-features-{{ ai_gen_id }}__heading">{{ block.settings.heading | default: 'Engineered for Long Shifts' }}</h2>

      <!-- Shift Mode Switcher -->
      <div class="ai-features-{{ ai_gen_id }}__modes" role="tablist" aria-label="Clinical Shift Mode">
        <button type="button" class="ai-features-{{ ai_gen_id }}__mode-btn is-active" data-mode="icu" role="tab" aria-selected="true">
          <span>ICU & Critical Care</span>
        </button>
        <button type="button" class="ai-features-{{ ai_gen_id }}__mode-btn" data-mode="or" role="tab" aria-selected="false">
          <span>Surgical Theater</span>
        </button>
        <button type="button" class="ai-features-{{ ai_gen_id }}__mode-btn" data-mode="er" role="tab" aria-selected="false">
          <span>ER Rapid Response</span>
        </button>
      </div>
    </div>

    <!-- Main Interactive Grid -->
    <div class="ai-features-{{ ai_gen_id }}__grid">
      
      <!-- Left: Interactive Hotspot Garment Explorer -->
      <div class="ai-features-{{ ai_gen_id }}__stage">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | default: 'Kapisa Scrub Fabric Anatomy' | escape }}" loading="lazy" width="700" height="826">
        {% else %}
          <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1000&auto=format&fit=crop&q=80" alt="Scrub Anatomy" loading="lazy" width="700" height="826">
        {% endif %}

        <div class="ai-features-{{ ai_gen_id }}__stage-badge">
          <span class="ai-features-{{ ai_gen_id }}__stage-badge-dot"></span>
          <span class="ai-features-{{ ai_gen_id }}__stage-badge-text">ICU Protocol: 16-Hr Shift Active</span>
        </div>

        <!-- 4 Interactive Hotspot Pins -->
        <button type="button" class="ai-features-{{ ai_gen_id }}__hotspot is-active" data-target="1" aria-label="Inspect 4-Way Stretch">
          <span class="ai-features-{{ ai_gen_id }}__hotspot-pin">01</span>
        </button>
        <button type="button" class="ai-features-{{ ai_gen_id }}__hotspot" data-target="2" aria-label="Inspect Anti-Odor Technology">
