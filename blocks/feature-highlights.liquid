{% doc %}
  Interactive performance fabric lab with interactive garment hotspots,
  clinical shift mode switcher, live fabric metrics, and a contrasting clinical proof ribbon.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color | default: '#0E1F3C' }};
    color: {{ block.settings.text_color | default: '#F8F5ED' }};
    overflow: hidden;
    position: relative;
    padding: clamp(48px, 6vw, 84px) 0 0;
    box-sizing: border-box;
  }

  /* Ambient Glow */
  .ai-features-{{ ai_gen_id }}::before {
    content: "";
    position: absolute;
    top: 10%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(201, 162, 39, 0.12) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .ai-features-{{ ai_gen_id }}__inner {
    width: min({{ block.settings.content_width | default: 1280 }}px, calc(100% - 48px));
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Section Header */
  .ai-features-{{ ai_gen_id }}__top-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 52px);
  }

  .ai-features-{{ ai_gen_id }}__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .ai-features-{{ ai_gen_id }}__eyebrow-badge {
    padding: 3px 10px;
    background: rgba(201, 162, 39, 0.15);
    border: 1px solid rgba(201, 162, 39, 0.35);
    border-radius: 999px;
  }

  .ai-features-{{ ai_gen_id }}__heading {
    margin: 0 0 16px;
    color: {{ block.settings.text_color | default: '#F8F5ED' }};
    font-size: clamp(30px, 3.8vw, 50px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
    max-width: 720px;
  }

  /* Shift Mode Interactive Switcher */
  .ai-features-{{ ai_gen_id }}__modes {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.06);
    padding: 5px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
  }

  .ai-features-{{ ai_gen_id }}__mode-btn {
    background: transparent;
    border: none;
    color: rgba(248, 245, 237, 0.7);
    font-size: 12px;
    font-weight: 600;
    padding: 7px 18px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .ai-features-{{ ai_gen_id }}__mode-btn.is-active,
  .ai-features-{{ ai_gen_id }}__mode-btn:hover {
    background: {{ block.settings.accent_color | default: '#C9A227' }};
    color: #0E1F3C;
    box-shadow: 0 4px 14px rgba(201, 162, 39, 0.35);
  }

  /* Grid Layout */
  .ai-features-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  /* Interactive Hotspot Garment Visual */
  .ai-features-{{ ai_gen_id }}__stage {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    background: radial-gradient(circle at 50% 30%, #1a3258 0%, #071324 100%);
    border: 1px solid rgba(201, 162, 39, 0.25);
    box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.5);
    aspect-ratio: 1 / 1.18;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-features-{{ ai_gen_id }}__stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-features-{{ ai_gen_id }}__stage:hover img {
    transform: scale(1.03);
  }

  .ai-features-{{ ai_gen_id }}__stage-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: rgba(14, 31, 60, 0.85);
    backdrop-filter: blur(10px);
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 39, 0.3);
    font-size: 11px;
    font-weight: 700;
    color: #FAF7F0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 2;
  }

  .ai-features-{{ ai_gen_id }}__stage-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: {{ block.settings.accent_color | default: '#C9A227' }};
    box-shadow: 0 0 10px {{ block.settings.accent_color | default: '#C9A227' }};
  }

  /* Hotspot Pulsing Nodes */
  .ai-features-{{ ai_gen_id }}__hotspot {
    position: absolute;
    z-index: 3;
    transform: translate(-50%, -50%);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .ai-features-{{ ai_gen_id }}__hotspot-pin {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(201, 162, 39, 0.9);
    border: 2px solid #FFFFFF;
    box-shadow: 0 0 20px rgba(201, 162, 39, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0E1F3C;
    font-size: 11px;
    font-weight: 800;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
  }

  .ai-features-{{ ai_gen_id }}__hotspot::before {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.accent_color | default: '#C9A227' }};
    opacity: 0.8;
    animation: ai-pulse-{{ ai_gen_id }} 2s infinite cubic-bezier(0.24, 0, 0.38, 1);
  }

  @keyframes ai-pulse-{{ ai_gen_id }} {
    0% { transform: scale(0.8); opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  .ai-features-{{ ai_gen_id }}__hotspot.is-active .ai-features-{{ ai_gen_id }}__hotspot-pin,
  .ai-features-{{ ai_gen_id }}__hotspot:hover .ai-features-{{ ai_gen_id }}__hotspot-pin {
    transform: scale(1.25);
    background: #FFFFFF;
    color: #0E1F3C;
    box-shadow: 0 0 25px rgba(255, 255, 255, 0.9);
  }

  /* Hotspot Coordinates */
  .ai-features-{{ ai_gen_id }}__hotspot[data-target="1"] { top: 26%; left: 36%; }
  .ai-features-{{ ai_gen_id }}__hotspot[data-target="2"] { top: 40%; left: 54%; }
  .ai-features-{{ ai_gen_id }}__hotspot[data-target="3"] { top: 62%; left: 38%; }
  .ai-features-{{ ai_gen_id }}__hotspot[data-target="4"] { top: 78%; left: 62%; }

  /* Interactive Cards Stack */
  .ai-features-{{ ai_gen_id }}__cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ai-features-{{ ai_gen_id }}__card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 20px;
    padding: 20px 24px;
    backdrop-filter: blur(14px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .ai-features-{{ ai_gen_id }}__card:hover,
  .ai-features-{{ ai_gen_id }}__card.is-active {
    background: rgba(255, 255, 255, 0.08);
    border-color: {{ block.settings.accent_color | default: '#C9A227' }};
    transform: translateX(8px);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.4);
  }

  .ai-features-{{ ai_gen_id }}__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .ai-features-{{ ai_gen_id }}__card-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .ai-features-{{ ai_gen_id }}__card-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(201, 162, 39, 0.15);
    border: 1px solid rgba(201, 162, 39, 0.3);
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .ai-features-{{ ai_gen_id }}__card:hover .ai-features-{{ ai_gen_id }}__card-icon,
  .ai-features-{{ ai_gen_id }}__card.is-active .ai-features-{{ ai_gen_id }}__card-icon {
    background: {{ block.settings.accent_color | default: '#C9A227' }};
    color: #0E1F3C;
    transform: scale(1.08);
  }

  .ai-features-{{ ai_gen_id }}__card-icon svg {
    width: 20px;
    height: 20px;
  }

  .ai-features-{{ ai_gen_id }}__card-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #FAF7F0;
    letter-spacing: -0.01em;
  }

  .ai-features-{{ ai_gen_id }}__card-stat {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(201, 162, 39, 0.12);
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    border: 1px solid rgba(201, 162, 39, 0.25);
    white-space: nowrap;
  }

  .ai-features-{{ ai_gen_id }}__card-desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: {{ block.settings.muted_text_color | default: '#CBD5E1' }};
    padding-left: 52px;
  }

  /* Clinical Proof Ribbon (New transition between features and testimonials) */
  .ai-features-{{ ai_gen_id }}__proof-ribbon {
    width: 100%;
    background: #FAF7F0;
    color: #0E1F3C;
    padding: 24px 20px;
    margin-top: 10px;
    border-top: 1px solid rgba(201, 162, 39, 0.2);
    position: relative;
    z-index: 2;
  }

  .ai-features-{{ ai_gen_id }}__proof-inner {
    width: min({{ block.settings.content_width | default: 1280 }}px, calc(100% - 32px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ai-features-{{ ai_gen_id }}__proof-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    color: #0E1F3C;
    letter-spacing: -0.01em;
  }

  .ai-features-{{ ai_gen_id }}__proof-item svg {
    width: 20px;
    height: 20px;
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    flex-shrink: 0;
  }

  .ai-features-{{ ai_gen_id }}__proof-divider {
    width: 1px;
    height: 24px;
    background: rgba(14, 31, 60, 0.12);
  }

  @media (max-width: 991px) {
    .ai-features-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .ai-features-{{ ai_gen_id }}__card-desc {
      padding-left: 0;
      margin-top: 8px;
    }

    .ai-features-{{ ai_gen_id }}__proof-divider {
      display: none;
    }

    .ai-features-{{ ai_gen_id }}__proof-inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .ai-features-{{ ai_gen_id }}__proof-inner {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ai-features-{{ ai_gen_id }}__modes {
      width: 100%;
      overflow-x: auto;
      justify-content: flex-start;
      border-radius: 12px;
    }

    .ai-features-{{ ai_gen_id }}__card:hover,
    .ai-features-{{ ai_gen_id }}__card.is-active {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-features-{{ ai_gen_id }}__hotspot::before {
      animation: none;
    }
    .ai-features-{{ ai_gen_id }}__card,
    .ai-features-{{ ai_gen_id }}__stage img {
      transition: none;
    }
  }
{% endstyle %}

<feature-highlights-{{ ai_gen_id }} class="ai-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-{{ ai_gen_id }}__inner">
    
    <!-- Header -->
    <div class="ai-features-{{ ai_gen_id }}__top-bar">
      <div class="ai-features-{{ ai_gen_id }}__eyebrow">
        <span class="ai-features-{{ ai_gen_id }}__eyebrow-badge">PROPRIETARY LAB KNIT</span>
        <span>{{ block.settings.eyebrow | default: 'Performance Fabric Anatomy' }}</span>
      </div>
      <h2 class="ai-features-{{ ai_gen_id }}__heading">{{ block.settings.heading | default: 'Engineered for 16-Hour Shifts' }}</h2>

      <!-- Shift Mode Switcher -->
      <div class="ai-features-{{ ai_gen_id }}__modes" role="tablist" aria-label="Clinical Shift Mode">
        <button type="button" class="ai-features-{{ ai_gen_id }}__mode-btn is-active" data-mode="icu" role="tab" aria-selected="true">ICU & Critical Care</button>
        <button type="button" class="ai-features-{{ ai_gen_id }}__mode-btn" data-mode="or" role="tab" aria-selected="false">Surgical Theater</button>
        <button type="button" class="ai-features-{{ ai_gen_id }}__mode-btn" data-mode="er" role="tab" aria-selected="false">ER Rapid Response</button>
      </div>
    </div>

    <!-- Main Interactive Grid -->
    <div class="ai-features-{{ ai_gen_id }}__grid">
      
      <!-- Left: Interactive Hotspot Garment Explorer -->
      <div class="ai-features-{{ ai_gen_id }}__stage">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | default: 'Kapisa Scrub Fabric Anatomy' | escape }}" loading="lazy" width="700" height="826">
        {% else %}
          <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1000&auto=format&fit=crop&q=80" alt="Scrub Anatomy" loading="lazy" width="700" height="826">
        {% endif %}

        <div class="ai-features-{{ ai_gen_id }}__stage-badge">
          <span class="ai-features-{{ ai_gen_id }}__stage-badge-dot"></span>
          <span>Interactive Garment Explorer</span>
        </div>

        <!-- 4 Interactive Hotspot Pins -->
        <button type="button" class="ai-features-{{ ai_gen_id }}__hotspot is-active" data-target="1" aria-label="Inspect 4-Way Stretch">
          <span class="ai-features-{{ ai_gen_id }}__hotspot-pin">01</span>
        </button>
        <button type="button" class="ai-features-{{ ai_gen_id }}__hotspot" data-target="2" aria-label="Inspect Anti-Odor Technology">
          <span class="ai-features-{{ ai_gen_id }}__hotspot-pin">02</span>
        </button>
        <button type="button" class="ai-features-{{ ai_gen_id }}__hotspot" data-target="3" aria-label="Inspect Breathable Weave">
          <span class="ai-features-{{ ai_gen_id }}__hotspot-pin">03</span>
        </button>
        <button type="button" class="ai-features-{{ ai_gen_id }}__hotspot" data-target="4" aria-label="Inspect Fade Resistance">
          <span class="ai-features-{{ ai_gen_id }}__hotspot-pin">04</span>
        </button>
      </div>

      <!-- Right: Interactive Fabric Science Cards -->
      <div class="ai-features-{{ ai_gen_id }}__cards">
        
        <!-- Card 1 -->
        <div class="ai-features-{{ ai_gen_id }}__card is-active" data-index="1" tabindex="0">
          <div class="ai-features-{{ ai_gen_id }}__card-top">
            <div class="ai-features-{{ ai_gen_id }}__card-left">
              <div class="ai-features-{{ ai_gen_id }}__card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h16M7 8l-3 4 3 4M17 8l3 4-3 4"/><path d="M8 5h8M8 19h8"/></svg>
              </div>
              <h3 class="ai-features-{{ ai_gen_id }}__card-title">{{ block.settings.item_1_title | default: '4-Way QuadFlex™' }}</h3>
            </div>
            <span class="ai-features-{{ ai_gen_id }}__card-stat" data-stat="1">360° Omnidirectional Stretch</span>
          </div>
          <p class="ai-features-{{ ai_gen_id }}__card-desc">{{ block.settings.item_1_description | default: 'Seamless movement engineered for long rounds, patient transfers, and constant bending with zero fabric resistance.' }}</p>
        </div>

        <!-- Card 2 -->
        <div class="ai-features-{{ ai_gen_id }}__card" data-index="2" tabindex="0">
          <div class="ai-features-{{ ai_gen_id }}__card-top">
            <div class="ai-features-{{ ai_gen_id }}__card-left">
              <div class="ai-features-{{ ai_gen_id }}__card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 4.5-3 7.8-7 10-4-2.2-7-5.5-7-10V6l7-3z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <h3 class="ai-features-{{ ai_gen_id }}__card-title">{{ block.settings.item_2_title | default: 'SilverIon™ Anti-Odor' }}</h3>
            </div>
            <span class="ai-features-{{ ai_gen_id }}__card-stat" data-stat="2">99.8% Freshness Guard</span>
          </div>
          <p class="ai-features-{{ ai_gen_id }}__card-desc">{{ block.settings.item_2_description | default: 'Antimicrobial yarn infused with pure silver ions actively suppresses odor-causing bacteria shift after shift.' }}</p>
        </div>

        <!-- Card 3 -->
        <div class="ai-features-{{ ai_gen_id }}__card" data-index="3" tabindex="0">
          <div class="ai-features-{{ ai_gen_id }}__card-top">
            <div class="ai-features-{{ ai_gen_id }}__card-left">
              <div class="ai-features-{{ ai_gen_id }}__card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10c2 0 2-3 0-3H9M3 12h15c2 0 2-3 0-3h-2M3 16h10c2 0 2-3 0-3H9"/></svg>
              </div>
              <h3 class="ai-features-{{ ai_gen_id }}__card-title">{{ block.settings.item_3_title | default: 'AirBreeze™ Micro-Knit' }}</h3>
            </div>
            <span class="ai-features-{{ ai_gen_id }}__card-stat" data-stat="3">0.2s Moisture Dispersal</span>
          </div>
          <p class="ai-features-{{ ai_gen_id }}__card-desc">{{ block.settings.item_3_description | default: 'Hyper-breathable micro-pore structure regulates your body temperature under intense OR theater lighting.' }}</p>
        </div>

        <!-- Card 4 -->
        <div class="ai-features-{{ ai_gen_id }}__card" data-index="4" tabindex="0">
          <div class="ai-features-{{ ai_gen_id }}__card-top">
            <div class="ai-features-{{ ai_gen_id }}__card-left">
              <div class="ai-features-{{ ai_gen_id }}__card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 14.14 14.14"/></svg>
              </div>
              <h3 class="ai-features-{{ ai_gen_id }}__card-title">{{ block.settings.item_4_title | default: 'DuraColor™ FadeGuard' }}</h3>
            </div>
            <span class="ai-features-{{ ai_gen_id }}__card-stat" data-stat="4">100+ Autoclave Washes</span>
          </div>
          <p class="ai-features-{{ ai_gen_id }}__card-desc">{{ block.settings.item_4_description | default: 'Molecular dye lock technology preserves pristine rich color depth through industrial medical laundry cycles.' }}</p>
        </div>

      </div>

    </div>

  </div>

  <!-- Contrasting Medical Proof Ribbon (Breaks monotonous dark background & bridges seamlessly into testimonials) -->
  <div class="ai-features-{{ ai_gen_id }}__proof-ribbon">
    <div class="ai-features-{{ ai_gen_id }}__proof-inner">
      <div class="ai-features-{{ ai_gen_id }}__proof-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span>4.9/5 Doctor Satisfaction</span>
      </div>
      <div class="ai-features-{{ ai_gen_id }}__proof-divider"></div>
      <div class="ai-features-{{ ai_gen_id }}__proof-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>100+ Hospitals & Clinics Outfitted</span>
      </div>
      <div class="ai-features-{{ ai_gen_id }}__proof-divider"></div>
      <div class="ai-features-{{ ai_gen_id }}__proof-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>100 Autoclave Wash Guarantee</span>
      </div>
      <div class="ai-features-{{ ai_gen_id }}__proof-divider"></div>
      <div class="ai-features-{{ ai_gen_id }}__proof-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Tested for 16-Hour Consecutive Shifts</span>
      </div>
    </div>
  </div>
</feature-highlights-{{ ai_gen_id }}>

<script>
(function() {
  class FeatureHighlights{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      const root = this;
      const hotspots = root.querySelectorAll('.ai-features-{{ ai_gen_id }}__hotspot');
      const cards = root.querySelectorAll('.ai-features-{{ ai_gen_id }}__card');
      const modeBtns = root.querySelectorAll('.ai-features-{{ ai_gen_id }}__mode-btn');

      // Sync Hotspot & Card clicks
      function activateIndex(idx) {
        hotspots.forEach(h => h.classList.toggle('is-active', h.dataset.target === String(idx)));
        cards.forEach(c => c.classList.toggle('is-active', c.dataset.index === String(idx)));
      }

      hotspots.forEach(h => {
        h.addEventListener('click', () => activateIndex(h.dataset.target));
        h.addEventListener('mouseenter', () => activateIndex(h.dataset.target));
      });

      cards.forEach(c => {
        c.addEventListener('click', () => activateIndex(c.dataset.index));
        c.addEventListener('mouseenter', () => activateIndex(c.dataset.index));
      });

      // Shift Mode Switcher stats update
      const modeStats = {
        icu: ["360° Omnidirectional Stretch", "99.8% Freshness Guard", "0.2s Moisture Dispersal", "100+ Autoclave Washes"],
        or: ["Reinforced Chest & Flex Zone", "Sterile Theater Grade", "Anti-Fog Breathable Weave", "Chlorine & Heat Proof"],
        er: ["Instant Kinetic Recovery", "Fluid & Stain Repellent", "Zero Heat Trapping", "Double-Stitched Pockets"]
      };

      modeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          modeBtns.forEach(b => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');

          const stats = modeStats[btn.dataset.mode];
          if (stats) {
            stats.forEach((st, i) => {
              const el = root.querySelector(`[data-stat="${i+1}"]`);
              if (el) el.textContent = st;
            });
          }
        });
      });
    }
  }
  if (!customElements.get('feature-highlights-{{ ai_gen_id }}')) {
    customElements.define('feature-highlights-{{ ai_gen_id }}', FeatureHighlights{{ ai_gen_id }});
  }
})();
</script>

