{% doc %}
  @prompt
    Create a two-column feature section, navy 
    #0E1F3C background, off-white text. Left column: large image of fabric close-up or scrub detail shot. Right column: heading 'Engineered for Long Shifts' in off-white, followed by a 3–4 item icon list (e.g. '4-Way Stretch', 'Anti-Odor Technology', 'Breathable & Lightweight', 'Fade Resistant'), each with a small gold 
    #C9A227 line icon, bold short title, one-line description in lighter off-white. Add a subtle fade-up animation for each list item as it scrolls into view, staggered by 100ms. Mobile: stack image on top, text below.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-features-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    min-height: 560px;
  }

  .ai-features-{{ ai_gen_id }}__media {
    position: relative;
    min-height: 100%;
    overflow: hidden;
  }

  .ai-features-{{ ai_gen_id }}__media img,
  .ai-features-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
  }

  .ai-features-{{ ai_gen_id }}__placeholder {
    background: #1b2c49;
    color: #b9c3d2;
    position: relative;
  }

  .ai-features-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-features-{{ ai_gen_id }}__empty {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 44px);
    text-align: center;
    color: #dce2ea;
    font-size: 14px;
  }

  .ai-features-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px clamp(28px, 7vw, 88px);
  }

  .ai-features-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 16px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-features-{{ ai_gen_id }}__heading {
    margin: 0 0 36px;
    color: {{ block.settings.text_color }};
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .ai-features-{{ ai_gen_id }}__list {
    display: grid;
    gap: 24px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ai-features-{{ ai_gen_id }}__item {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 16px;
    align-items: start;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 600ms ease, transform 600ms ease;
    transition-delay: calc(var(--item-index) * 100ms);
  }

  .ai-features-{{ ai_gen_id }}__item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-features-{{ ai_gen_id }}__icon {
    width: 24px;
    height: 24px;
    color: {{ block.settings.accent_color }};
    margin-top: 1px;
  }

  .ai-features-{{ ai_gen_id }}__title {
    margin: 0 0 4px;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.25;
    font-weight: 700;
  }

  .ai-features-{{ ai_gen_id }}__description {
    margin: 0;
    color: {{ block.settings.muted_text_color }};
    font-size: 15px;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-features-{{ ai_gen_id }}__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-features-{{ ai_gen_id }}__inner {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .ai-features-{{ ai_gen_id }}__media,
    .ai-features-{{ ai_gen_id }}__media img,
    .ai-features-{{ ai_gen_id }}__placeholder {
      min-height: 360px;
      height: 360px;
    }

    .ai-features-{{ ai_gen_id }}__content {
      padding: 48px 24px 56px;
    }
  }
{% endstyle %}

<feature-highlights-{{ ai_gen_id }} class="ai-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-{{ ai_gen_id }}__inner">
    <div class="ai-features-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-features-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-features-{{ ai_gen_id }}__empty">Add a fabric close-up or scrub detail image</div>
        </div>
      {% endif %}
    </div>

    <div class="ai-features-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-features-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      <h2 class="ai-features-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
      <ul class="ai-features-{{ ai_gen_id }}__list">
        {% for i in (1..4) %}
          {% liquid
            assign title_key = 'item_' | append: i | append: '_title'
            assign description_key = 'item_' | append: i | append: '_description'
            assign icon_key = 'item_' | append: i | append: '_icon'
            assign item_title = block.settings[title_key]
            assign item_description = block.settings[description_key]
            assign item_icon = block.settings[icon_key]
          %}
          {% if item_title != blank %}
            <li class="ai-features-{{ ai_gen_id }}__item" style="--item-index: {{ forloop.index0 }};">
              <svg class="ai-features-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {% case item_icon %}
                  {% when 'stretch' %}<path d="M4 12h16M7 8l-3 4 3 4M17 8l3 4-3 4"/><path d="M8 5h8M8 19h8"/>
                  {% when 'shield' %}<path d="M12 3l7 3v5c0 4.5-3 7.8-7 10-4-2.2-7-5.5-7-10V6l7-3z"/><path d="m9 12 2 2 4-4"/>
                  {% when 'breathable' %}<path d="M3 8h10c2 0 2-3 0-3H9M3 12h15c2 0 2-3 0-3h-2M3 16h10c2 0 2-3 0-3H9"/>
                  {% else %}<path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>
                {% endcase %}
              </svg>
              <div><h3 class="ai-features-{{ ai_gen_id }}__title">{{ item_title }}</h3><p class="ai-features-{{ ai_gen_id }}__description">{{ item_description }}</p></div>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</feature-highlights-{{ ai_gen_id }}>

<script>
(function() {
  class FeatureHighlights{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      var items = this.querySelectorAll('.ai-features-{{ ai_gen_id }}__item');
      if (!('IntersectionObserver' in window)) { items.forEach(function(item) { item.classList.add('is-visible'); }); return; }
      var observer = new IntersectionObserver(function(entries, obs) {
        entries.forEach(function(entry) { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); obs.unobserve(entry.target); } });
      }, { threshold: 0.15 });
      items.forEach(function(item) { observer.observe(item); });
    }
  }
  if (!customElements.get('feature-highlights-{{ ai_gen_id }}')) customElements.define('feature-highlights-{{ ai_gen_id }}', FeatureHighlights{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Feature highlights",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Feature image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Performance fabric" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineered for Long Shifts" },
    { "type": "header", "content": "Feature 1" },
    { "type": "select", "id": "item_1_icon", "label": "Icon", "options": [{"value":"stretch","label":"Stretch"},{"value":"shield","label":"Shield"},{"value":"breathable","label":"Breathable"},{"value":"detail","label":"Detail"}], "default": "stretch" },
    { "type": "text", "id": "item_1_title", "label": "Title", "default": "4-Way Stretch" },
    { "type": "text", "id": "item_1_description", "label": "Description", "default": "Move freely through every shift." },
    { "type": "header", "content": "Feature 2" },
    { "type": "select", "id": "item_2_icon", "label": "Icon", "options": [{"value":"stretch","label":"Stretch"},{"value":"shield","label":"Shield"},{"value":"breathable","label":"Breathable"},{"value":"detail","label":"Detail"}], "default": "shield" },
    { "type": "text", "id": "item_2_title", "label": "Title", "default": "Anti-Odor Technology" },
    { "type": "text", "id": "item_2_description", "label": "Description", "default": "Stay fresh from first call to last." },
    { "type": "header", "content": "Feature 3" },
    { "type": "select", "id": "item_3_icon", "label": "Icon", "options": [{"value":"stretch","label":"Stretch"},{"value":"shield","label":"Shield"},{"value":"breathable","label":"Breathable"},{"value":"detail","label":"Detail"}], "default": "breathable" },
    { "type": "text", "id": "item_3_title", "label": "Title", "default": "Breathable & Lightweight" },
    { "type": "text", "id": "item_3_description", "label": "Description", "default": "Light comfort that works hard." },
    { "type": "header", "content": "Feature 4" },
    { "type": "select", "id": "item_4_icon", "label": "Icon", "options": [{"value":"stretch","label":"Stretch"},{"value":"shield","label":"Shield"},{"value":"breathable","label":"Breathable"},{"value":"detail","label":"Detail"}], "default": "detail" },
    { "type": "text", "id": "item_4_title", "label": "Title", "default": "Fade Resistant" },
    { "type": "text", "id": "item_4_description", "label": "Description", "default": "Keeps its polished color wear after wear." },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 800, "max": 1600, "step": 100, "unit": "px", "default": 1200 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0E1F3C" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F8F5ED" },
    { "type": "color", "id": "muted_text_color", "label": "Secondary text", "default": "#D6DCE5" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C9A227" }
  ],
  "presets": [{ "name": "Feature highlights" }],
  "tag": null,
  "class": "feature-highlights-block"
}
{% endschema %}