<script>
(function() {
  class FeatureHighlights{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      const root = this;
      const hotspots = root.querySelectorAll('.ai-features-{{ ai_gen_id }}__hotspot');
      const cards = root.querySelectorAll('.ai-features-{{ ai_gen_id }}__card');
      const modeBtns = root.querySelectorAll('.ai-features-{{ ai_gen_id }}__mode-btn');
      const stageBadgeText = root.querySelector('.ai-features-{{ ai_gen_id }}__stage-badge-text');

      const t1 = root.querySelector('[data-t1]');
      const t2 = root.querySelector('[data-t2]');
      const t3 = root.querySelector('[data-t3]');

      // Sync Hotspot & Card clicks with smooth mobile centering
      function activateIndex(idx, scrollCard = true) {
        hotspots.forEach(h => h.classList.toggle('is-active', h.dataset.target === String(idx)));
        cards.forEach(c => {
          const match = c.dataset.index === String(idx);
          c.classList.toggle('is-active', match);
          if (match && scrollCard && window.innerWidth <= 768) {
            c.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        });
      }

      // Sync mobile swipe on cards back to hotspot pins
      let scrollTimer;
      const cardsTrack = root.querySelector('.ai-features-{{ ai_gen_id }}__cards');
      if (cardsTrack) {
        cardsTrack.addEventListener('scroll', () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => {
            const trackRect = cardsTrack.getBoundingClientRect();
            const trackMid = trackRect.left + trackRect.width / 2;
            let closest = null;
            let minDiff = Infinity;
            cards.forEach(card => {
              const rect = card.getBoundingClientRect();
              const mid = rect.left + rect.width / 2;
              const diff = Math.abs(mid - trackMid);
              if (diff < minDiff) {
                minDiff = diff;
                closest = card;
              }
            });
            if (closest && closest.dataset.index) {
              activateIndex(closest.dataset.index, false);
            }
          }, 80);
        }, { passive: true });
      }

      hotspots.forEach(h => {
        h.addEventListener('click', () => activateIndex(h.dataset.target));
        h.addEventListener('mouseenter', () => activateIndex(h.dataset.target));
      });

      cards.forEach(c => {
        c.addEventListener('click', () => activateIndex(c.dataset.index));
        c.addEventListener('mouseenter', () => activateIndex(c.dataset.index));
      });

      // Shift Mode Comprehensive Dynamic Switcher
      const modeData = {
        icu: {
          badge: 'ICU Protocol: 16-Hr Shift Active',
          t1: '16.4 Hrs Continuous',
          t2: 'Grade 4A Barrier',
          t3: '99.4% Elastic Rebound',
          stats: ['360° Omnidirectional Stretch', '99.8% Freshness Guard', '0.2s Moisture Dispersal', '100+ Autoclave Washes'],
          titles: ['4-Way QuadFlex™', 'SilverIon™ Anti-Odor', 'AirBreeze™ Micro-Knit', 'DuraColor™ FadeGuard'],
          descs: [
            'Seamless movement engineered for long rounds, patient transfers, and constant bending with zero fabric resistance.',
            'Antimicrobial yarn infused with pure silver ions actively suppresses odor-causing bacteria shift after shift.',
            'Hyper-breathable micro-pore structure regulates your body temperature under intense OR theater lighting.',
            'Molecular dye lock technology preserves pristine rich color depth through industrial medical laundry cycles.'
          ]
        },
        or: {
          badge: 'Surgical Theater: Class 1 Sterile Barrier',
          t1: '12.8 Hrs Standing',
          t2: 'Impervious Saline Shield',
          t3: '0.00 kV Anti-Static',
          stats: ['Reinforced Raglan Sleeve', 'Sterile Halogen Cool', 'Fluid & Saline Shield', '134°C Steam Certified'],
          titles: ['Zero-Distraction Collar', 'Hypoallergenic Weave', 'Dual-Flow Thermal Vents', '134°C Autoclave Seal'],
          descs: [
            'Ergonomic shoulder and neck ergonomics designed to eliminate chafing under surgical masks and lead aprons.',
            'Certified non-shedding micro-fibers keep the operating theater sterile and particulate-free.',
            'Under-arm micro-perforations accelerate cooling by 4.8°C under intense high-heat surgical halogen lamps.',
            'Hospital-grade industrial steam sterilization guaranteed without thread shrinking or structural degradation.'
          ]
        },
        er: {
          badge: 'ER Rapid Response: High-Velocity Flex',
          t1: '24-Hr Readiness',
          t2: 'High-Impact Ripstop',
          t3: '< 0.1s Kinetic Recovery',
          stats: ['High-Velocity Rebound', 'Triple-Stitch Bar Tack', 'Rapid Spill Deflection', '6-Slot Tool Grid'],
          titles: ['Kinetic Recovery Flex', 'Triple-Seam Durability', 'Rapid Stain Release', 'Tactical Gear Utility'],
          descs: [
            'Instant fabric recovery allows explosive mobility during codes, CPR, and fast-paced emergency trauma care.',
            'Heavy-duty reinforced bartack stitching prevents seam blowout at pocket corners and high-friction stress points.',
            'Fluorocarbon-free hydrophobic outer finish causes blood, liquids, and medications to bead and wipe away instantly.',
            'Deep, reinforced pockets designed to comfortably carry shears, stethoscopes, pens, and hospital pagers without sagging.'
          ]
        }
      };

      modeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          modeBtns.forEach(b => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');

          const m = modeData[btn.dataset.mode];
          if (m) {
            if (stageBadgeText) stageBadgeText.textContent = m.badge;
            if (t1) t1.textContent = m.t1;
            if (t2) t2.textContent = m.t2;
            if (t3) t3.textContent = m.t3;

            m.stats.forEach((st, i) => {
              const el = root.querySelector(`[data-stat="${i+1}"]`);
              if (el) el.textContent = st;
            });
            m.titles.forEach((tit, i) => {
              const el = root.querySelector(`[data-title="${i+1}"]`);
              if (el) el.textContent = tit;
            });
            m.descs.forEach((dsc, i) => {
              const el = root.querySelector(`[data-desc="${i+1}"]`);
              if (el) el.textContent = dsc;
            });
          }
        });
      });
    }
  }
  if (!customElements.get('feature-highlights-{{ ai_gen_id }}')) {
    customElements.define('feature-highlights-{{ ai_gen_id }}', FeatureHighlights{{ ai_gen_id }});
  }
})();
</script>

