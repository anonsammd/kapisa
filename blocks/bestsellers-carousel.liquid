{% doc %}
  @prompt
    Build a modern, high-trust 'Bestsellers' / 'Shop Classic Scrubs' product carousel
    with clean aesthetic, subtitle, rating stars, color swatches, and smooth carousel navigation.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-best-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color | default: '#FAF9F6' }};
    padding: {{ block.settings.vertical_padding | default: 48 }}px 0;
    font-family: inherit;
  }

  .ai-best-{{ ai_gen_id }}__inner {
    width: min(1360px, calc(100% - 40px));
    margin: 0 auto;
  }

  .ai-best-{{ ai_gen_id }}__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .ai-best-{{ ai_gen_id }}__titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-best-{{ ai_gen_id }}__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ block.settings.gold_color | default: '#C9A227' }};
  }

  .ai-best-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color | default: '#0E1F3C' }};
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .ai-best-{{ ai_gen_id }}__sub {
    margin: 4px 0 0;
    font-size: 14px;
    color: #64748B;
    line-height: 1.4;
  }

  .ai-best-{{ ai_gen_id }}__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-best-{{ ai_gen_id }}__view {
    color: {{ block.settings.gold_color | default: '#C9A227' }};
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .ai-best-{{ ai_gen_id }}__view:hover {
    opacity: 0.8;
  }

  .ai-best-{{ ai_gen_id }}__tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-best-{{ ai_gen_id }}__arrow {
    width: 38px;
    height: 38px;
    border: 1.5px solid rgba(14, 31, 60, 0.15);
    border-radius: 50%;
    background: #FFFFFF;
    color: {{ block.settings.text_color | default: '#0E1F3C' }};
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .ai-best-{{ ai_gen_id }}__arrow:hover {
    background: {{ block.settings.text_color | default: '#0E1F3C' }};
    color: #FFFFFF;
    border-color: {{ block.settings.text_color | default: '#0E1F3C' }};
  }

  .ai-best-{{ ai_gen_id }}__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 6px 2px 16px;
  }

  .ai-best-{{ ai_gen_id }}__track::-webkit-scrollbar {
    display: none;
  }

  .ai-best-{{ ai_gen_id }}__card {
    flex: 0 0 calc((100% - 54px) / 4);
    min-width: 250px;
    background: {{ block.settings.card_color | default: '#FFFFFF' }};
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(14, 31, 60, 0.08);
    box-shadow: 0 4px 14px rgba(14, 31, 60, 0.04);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .ai-best-{{ ai_gen_id }}__card:hover {
    box-shadow: 0 12px 28px rgba(14, 31, 60, 0.12);
    transform: translateY(-3px);
  }

  .ai-best-{{ ai_gen_id }}__media {
    aspect-ratio: 4 / 5;
    background: #F4F6F8;
    position: relative;
    overflow: hidden;
    display: block;
  }

  .ai-best-{{ ai_gen_id }}__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .ai-best-{{ ai_gen_id }}__card:hover .ai-best-{{ ai_gen_id }}__media img {
    transform: scale(1.04);
  }

  .ai-best-{{ ai_gen_id }}__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #0E1F3C;
    color: #FFFFFF;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-best-{{ ai_gen_id }}__body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    position: relative;
  }

  .ai-best-{{ ai_gen_id }}__stars {
    display: flex;
    align-items: center;
    gap: 3px;
    color: #F5A623;
  }

  .ai-best-{{ ai_gen_id }}__stars svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }

  .ai-best-{{ ai_gen_id }}__rating-text {
    font-size: 11px;
    color: #64748B;
    margin-left: 4px;
    font-weight: 600;
  }

  .ai-best-{{ ai_gen_id }}__name {
    color: {{ block.settings.text_color | default: '#0E1F3C' }};
    font-size: 15px;
    line-height: 1.35;
    margin: 8px 0 4px;
    font-weight: 700;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
  }

  .ai-best-{{ ai_gen_id }}__name:hover {
    color: {{ block.settings.gold_color | default: '#C9A227' }};
  }

  .ai-best-{{ ai_gen_id }}__price {
    color: {{ block.settings.text_color | default: '#0E1F3C' }};
    font-size: 15px;
    font-weight: 700;
  }

  .ai-best-{{ ai_gen_id }}__swatches {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    min-height: 18px;
  }

  .ai-best-{{ ai_gen_id }}__swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(14, 31, 60, 0.2);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
  }

  .ai-best-{{ ai_gen_id }}__count {
    color: #64748B;
    font-size: 11px;
    margin-left: 2px;
  }

  .ai-best-{{ ai_gen_id }}__features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #F1F5F9;
  }

  .ai-best-{{ ai_gen_id }}__feature {
    text-align: center;
    color: #64748B;
    font-size: 10px;
    line-height: 1.2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .ai-best-{{ ai_gen_id }}__feature svg {
    width: 16px;
    height: 16px;
    color: {{ block.settings.gold_color | default: '#C9A227' }};
  }

  @media (max-width: 749px) {
    .ai-best-{{ ai_gen_id }} {
      padding: 36px 0;
    }

    .ai-best-{{ ai_gen_id }}__inner {
      width: 100%;
      padding: 0 16px;
    }

    .ai-best-{{ ai_gen_id }}__card {
      flex: 0 0 240px;
      min-width: 240px;
    }

    .ai-best-{{ ai_gen_id }}__tools {
      display: none;
    }
  }
{% endstyle %}

<bestsellers-{{ ai_gen_id }} class="ai-best-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-best-{{ ai_gen_id }}__inner">
    
    <div class="ai-best-{{ ai_gen_id }}__header">
      <div class="ai-best-{{ ai_gen_id }}__titles">
        {% if block.settings.eyebrow != blank %}
          <span class="ai-best-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</span>
        {% endif %}
        <h2 class="ai-best-{{ ai_gen_id }}__title">{{ block.settings.heading | default: 'Shop Classic Scrubs' | escape }}</h2>
        {% if block.settings.subtitle != blank %}
          <p class="ai-best-{{ ai_gen_id }}__sub">{{ block.settings.subtitle | escape }}</p>
        {% endif %}
      </div>

      <div class="ai-best-{{ ai_gen_id }}__actions">
        {% if block.settings.view_all_link != blank %}
          <a class="ai-best-{{ ai_gen_id }}__view" href="{{ block.settings.view_all_link }}">View all →</a>
        {% endif %}
        <div class="ai-best-{{ ai_gen_id }}__tools">
          <button class="ai-best-{{ ai_gen_id }}__arrow" data-direction="prev" aria-label="Previous products">&#8592;</button>
          <button class="ai-best-{{ ai_gen_id }}__arrow" data-direction="next" aria-label="Next products">&#8594;</button>
        </div>
      </div>
    </div>

    <div class="ai-best-{{ ai_gen_id }}__track">
      {% assign target_collection = block.settings.collection | default: collections.all %}
      {% for product in target_collection.products limit: block.settings.product_limit %}
        <article class="ai-best-{{ ai_gen_id }}__card">
          <a href="{{ product.url }}" class="ai-best-{{ ai_gen_id }}__media" aria-label="View {{ product.title | escape }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="750">
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}
            <span class="ai-best-{{ ai_gen_id }}__badge">Bestseller</span>
          </a>

          <div class="ai-best-{{ ai_gen_id }}__body">
            
            <!-- Crisp Star Rating -->
            <div class="ai-best-{{ ai_gen_id }}__stars">
              {% for s in (1..5) %}
                <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {% endfor %}
              <span class="ai-best-{{ ai_gen_id }}__rating-text">4.9 (180+)</span>
            </div>

            <a href="{{ product.url }}" class="ai-best-{{ ai_gen_id }}__name">{{ product.title | escape }}</a>
            <div class="ai-best-{{ ai_gen_id }}__price">{{ product.price | money }}</div>

            <!-- Color Swatches (Rendered only if product genuinely has colors) -->
            {%- liquid
              assign color_family_prods = product.metafields.custom.color_family_products.value
              assign color_option = blank
              for option in product.options_with_values
                assign opt_name = option.name | downcase
                if opt_name contains 'color' or opt_name contains 'colour'
                  assign color_option = option
                  break
                endif
              endfor
              assign custom_swatches = product.metafields.custom.color_swatch.value
            -%}
            {% if color_family_prods != blank %}
              <div class="ai-best-{{ ai_gen_id }}__swatches" aria-label="Available colors">
                {% for rel in color_family_prods limit: 5 %}
                  {% assign rel_c = rel.metafields.custom.color_swatch.value %}
                  {% if rel_c == blank %}
                    {% assign r_title = rel.title | downcase %}
                    {% if r_title contains 'navy' or r_title contains 'blue' %}{% assign rel_c = '#1B3B6F' %}
                    {% elsif r_title contains 'black' %}{% assign rel_c = '#18191C' %}
                    {% elsif r_title contains 'green' or r_title contains 'hunter' %}{% assign rel_c = '#1B4942' %}
                    {% elsif r_title contains 'wine' or r_title contains 'red' or r_title contains 'burgundy' %}{% assign rel_c = '#4A1525' %}
                    {% elsif r_title contains 'grey' or r_title contains 'slate' %}{% assign rel_c = '#40464D' %}
                    {% else %}{% assign rel_c = '#1E293B' %}
                    {% endif %}
                  {% endif %}
                  {% assign rel_url = '/products/' | append: rel.handle %}
                  <a href="{{ rel_url }}" class="ai-best-{{ ai_gen_id }}__swatch" style="background: {{ rel_c }}; display: inline-block;" title="{{ rel.title | escape }}" aria-label="{{ rel.title | escape }}"></a>
                {% endfor %}
                {% if color_family_prods.size > 5 %}
                  <span class="ai-best-{{ ai_gen_id }}__count">+{{ color_family_prods.size | minus: 5 }}</span>
                {% endif %}
              </div>
            {% elsif color_option != blank %}
              <div class="ai-best-{{ ai_gen_id }}__swatches" aria-label="Available colors">
                {% for val in color_option.values limit: 5 %}
                  {% assign color_clean = val | downcase | strip %}
                  {% assign bg_color = color_clean %}
                  {% if color_clean contains 'navy' %}
                    {% assign bg_color = '#1B3B6F' %}
                  {% elsif color_clean contains 'black' %}
                    {% assign bg_color = '#18191C' %}
                  {% elsif color_clean contains 'hunter' or color_clean contains 'green' %}
                    {% assign bg_color = '#1B4942' %}
                  {% elsif color_clean contains 'wine' or color_clean contains 'burgundy' or color_clean contains 'maroon' %}
                    {% assign bg_color = '#4A1525' %}
                  {% elsif color_clean contains 'grey' or color_clean contains 'gray' or color_clean contains 'slate' %}
                    {% assign bg_color = '#40464D' %}
                  {% elsif color_clean contains 'royal' or color_clean contains 'blue' %}
                    {% assign bg_color = '#2563EB' %}
                  {% elsif color_clean contains 'pastel' or color_clean contains 'lavender' or color_clean contains 'lilac' %}
                    {% assign bg_color = '#756B98' %}
                  {% endif %}
                  <span class="ai-best-{{ ai_gen_id }}__swatch" style="background: {{ bg_color }}" title="{{ val | escape }}" aria-label="{{ val | escape }}"></span>
                {% endfor %}
                {% if color_option.values.size > 5 %}
                  <span class="ai-best-{{ ai_gen_id }}__count">+{{ color_option.values.size | minus: 5 }}</span>
                {% endif %}
              </div>
            {% elsif custom_swatches != blank %}
              <div class="ai-best-{{ ai_gen_id }}__swatches" aria-label="Available colors">
                {% for swatch in custom_swatches limit: 5 %}
                  <span class="ai-best-{{ ai_gen_id }}__swatch" style="background: {{ swatch }}" aria-label="Color option"></span>
                {% endfor %}
                {% if custom_swatches.size > 5 %}
                  <span class="ai-best-{{ ai_gen_id }}__count">+{{ custom_swatches.size | minus: 5 }}</span>
                {% endif %}
              </div>
            {% endif %}

            <!-- Features Bar -->
            <div class="ai-best-{{ ai_gen_id }}__features">
              <div class="ai-best-{{ ai_gen_id }}__feature">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M6 8h12M8 16h8"/></svg>
                <span>{{ block.settings.feature_one | default: '4-Way Stretch' }}</span>
              </div>
              <div class="ai-best-{{ ai_gen_id }}__feature">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 4v16M4 12h16"/></svg>
                <span>{{ block.settings.feature_two | default: 'Breathable' }}</span>
              </div>
              <div class="ai-best-{{ ai_gen_id }}__feature">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>{{ block.settings.feature_three | default: 'Anti-Odor' }}</span>
              </div>
            </div>

          </div>
        </article>
      {% endfor %}
    </div>

  </div>
</bestsellers-{{ ai_gen_id }}>

<script>
  (function() {
    class Bestsellers{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-best-{{ ai_gen_id }}__track');
        this.querySelectorAll('[data-direction]').forEach((b) =>
          b.addEventListener('click', () =>
            this.track.scrollBy({
              left: (b.dataset.direction === 'next' ? 1 : -1) * (this.track.clientWidth * 0.75),
              behavior: 'smooth'
            })
          )
        );
      }
    }
    if (!customElements.get('bestsellers-{{ ai_gen_id }}')) {
      customElements.define('bestsellers-{{ ai_gen_id }}', Bestsellers{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Bestsellers carousel",
  "tag": null,
  "class": "bestsellers-block",
  "settings": [
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SIGNATURE COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Classic Scrubs"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Made to last with breathable & light fabric"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products count",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Product Feature Labels"
    },
    {
      "type": "text",
      "id": "feature_one",
      "label": "Feature 1",
      "default": "4-Way Stretch"
    },
    {
      "type": "text",
      "id": "feature_two",
      "label": "Feature 2",
      "default": "Breathable"
    },
    {
      "type": "text",
      "id": "feature_three",
      "label": "Feature 3",
      "default": "Anti-Odor"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & Text Color",
      "default": "#0E1F3C"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Accent Color",
      "default": "#C9A227"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical Padding (px)",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Bestsellers carousel"
    }
  ]
}
{% endschema %}
