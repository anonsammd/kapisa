{% doc %}
  @prompt
    Create a bulk order CTA banner, full-width, split into two halves: left half navy 
    #0E1F3C background with off-white heading 'Outfitting a Hospital or Clinic?' and short supporting line about bulk pricing and custom embroidery for teams, gold 
    #C9A227 button 'Enquire for Bulk Orders'. Right half: image of a group of healthcare staff in matching Kapisa scrubs. No rounded corners on this section — full-bleed edge to edge for a bold banner feel.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bulk-order-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.heading_color }};
    overflow: hidden;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: {{ block.settings.banner_height }}px;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 56px 7vw;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__heading {
    margin: 0 0 16px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
    max-width: 560px;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__text {
    margin: 0 0 28px;
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.55;
    max-width: 500px;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 13px 24px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_color }};
    border-radius: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
    transition: filter 0.2s ease;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__button:hover {
    filter: brightness(0.88);
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__media,
  .ai-bulk-order-banner-{{ ai_gen_id }}__placeholder {
    min-height: 100%;
    width: 100%;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__media {
    display: block;
    height: 100%;
    object-fit: cover;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: #d9dde3;
    color: #273142;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 480px;
    max-height: 480px;
  }

  .ai-bulk-order-banner-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 20px;
    left: 50%;
    width: calc(100% - 40px);
    transform: translateX(-50%);
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.9);
    color: #273142;
    font-size: 13px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-bulk-order-banner-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
    }

    .ai-bulk-order-banner-{{ ai_gen_id }}__content {
      min-height: 330px;
      padding: 40px 28px;
    }

    .ai-bulk-order-banner-{{ ai_gen_id }}__media,
    .ai-bulk-order-banner-{{ ai_gen_id }}__placeholder {
      min-height: 280px;
      height: 280px;
    }

    .ai-bulk-order-banner-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.78 }}px;
    }
  }
{% endstyle %}

<div class="ai-bulk-order-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bulk-order-banner-{{ ai_gen_id }}__inner">
    <div class="ai-bulk-order-banner-{{ ai_gen_id }}__content">
      {% if block.settings.heading != blank %}
        <h2 class="ai-bulk-order-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.supporting_text != blank %}
        <p class="ai-bulk-order-banner-{{ ai_gen_id }}__text">{{ block.settings.supporting_text | escape }}</p>
      {% endif %}
      {% if block.settings.button_link != blank and block.settings.button_label != blank %}
        <a class="ai-bulk-order-banner-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">
          {{ block.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
    <div>
      {% if block.settings.image != blank %}
        <img
          class="ai-bulk-order-banner-{{ ai_gen_id }}__media"
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | default: 'Healthcare staff wearing matching scrubs' | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-bulk-order-banner-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-bulk-order-banner-{{ ai_gen_id }}__empty-state">Add an image of healthcare staff in matching scrubs</div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bulk order banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Outfitting a Hospital or Clinic?"
    },
    {
      "type": "textarea",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "Get bulk pricing and custom embroidery for your healthcare team."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enquire for Bulk Orders"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Staff image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0E1F3C"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#F8F5EC"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#F8F5EC"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#C9A227"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#0E1F3C"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#F8F5EC"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Bulk order banner"
    }
  ],
  "tag": null,
  "class": "bulk-order-banner-block"
}
{% endschema %}