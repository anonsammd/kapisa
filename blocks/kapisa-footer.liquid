{% comment %}
  Kapisa Healthcare Premium Footer

  Desktop:
  Brand | Shop | Support | Company

  Mobile:
  Brand
  Social links
  Accordion navigation
  Payment methods
  Copyright
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign shop_menu = linklists[block.settings.shop_menu] %}
{% assign support_menu = linklists[block.settings.support_menu] %}
{% assign company_menu = linklists[block.settings.company_menu] %}

{% style %}

  /* =========================================================
     ROOT
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }} {
    --footer-navy: {{ block.settings.background_color }};
    --footer-surface: {{ block.settings.surface_color }};
    --footer-cream: {{ block.settings.text_color }};
    --footer-muted: {{ block.settings.muted_color }};
    --footer-gold: {{ block.settings.accent_color }};
    --footer-border: rgba(250, 247, 240, 0.12);

    width: 100%;
    background: var(--footer-navy);
    color: var(--footer-cream);
    overflow: hidden;
  }

  .kapisa-footer-{{ ai_gen_id }} *,
  .kapisa-footer-{{ ai_gen_id }} *::before,
  .kapisa-footer-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }


  /* =========================================================
     MAIN CONTAINER
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;

    padding-top: {{ block.settings.desktop_padding_top }}px;
    padding-right: {{ block.settings.desktop_padding_horizontal }}px;
    padding-bottom: {{ block.settings.desktop_padding_bottom }}px;
    padding-left: {{ block.settings.desktop_padding_horizontal }}px;
  }


  /* =========================================================
     DESKTOP TOP
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__top {
    display: grid;

    grid-template-columns:
      minmax(230px, 1.2fr)
      minmax(0, 2.8fr);

    gap: {{ block.settings.column_gap }}px;

    align-items: start;
  }


  /* =========================================================
     BRAND
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__brand {
    min-width: 0;
  }

  .kapisa-footer-{{ ai_gen_id }}__logo {
    display: block;

    width: auto;
    max-width: {{ block.settings.logo_width }}px;
    height: auto;

    margin: 0 0 20px;

    object-fit: contain;
  }

  .kapisa-footer-{{ ai_gen_id }}__brand-name {
    margin: 0 0 10px;

    color: var(--footer-cream);

    font-size: 21px;
    line-height: 1.2;
    font-weight: 700;

    letter-spacing: -0.02em;
  }

  .kapisa-footer-{{ ai_gen_id }}__description {
    max-width: 340px;

    margin: 0;

    color: var(--footer-muted);

    font-size: 14px;
    line-height: 1.75;
  }


  /* =========================================================
     SOCIALS
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 9px;

    margin-top: 24px;
  }

  .kapisa-footer-{{ ai_gen_id }}__social {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    border: 1px solid rgba(250, 247, 240, 0.13);
    border-radius: 50%;

    background: var(--footer-surface);

    color: var(--footer-cream);

    text-decoration: none;

    transition:
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .kapisa-footer-{{ ai_gen_id }}__social:hover {
    color: var(--footer-gold);

    border-color: var(--footer-gold);

    transform: translateY(-2px);
  }

  .kapisa-footer-{{ ai_gen_id }}__social:focus-visible {
    outline: 2px solid var(--footer-gold);
    outline-offset: 3px;
  }

  .kapisa-footer-{{ ai_gen_id }}__social svg {
    display: block;

    width: 17px;
    height: 17px;
  }


  /* =========================================================
     DESKTOP MENU GRID
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__desktop-nav {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: {{ block.settings.column_gap }}px;

    min-width: 0;
  }

  .kapisa-footer-{{ ai_gen_id }}__desktop-menu {
    min-width: 0;
  }

  .kapisa-footer-{{ ai_gen_id }}__desktop-title {
    margin: 0 0 19px;

    color: var(--footer-cream);

    font-size: 12px;
    line-height: 1.3;

    font-weight: 700;

    letter-spacing: 0.13em;

    text-transform: uppercase;
  }

  .kapisa-footer-{{ ai_gen_id }}__desktop-list {
    display: flex;

    flex-direction: column;

    gap: 10px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .kapisa-footer-{{ ai_gen_id }}__desktop-list li {
    margin: 0;
    padding: 0;
  }

  .kapisa-footer-{{ ai_gen_id }}__desktop-list a {
    display: inline-block;

    width: fit-content;
    max-width: 100%;

    color: var(--footer-muted);

    font-size: 14px;
    line-height: 1.5;

    text-decoration: none;

    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .kapisa-footer-{{ ai_gen_id }}__desktop-list a:hover {
    color: var(--footer-cream);

    transform: translateX(3px);
  }

  .kapisa-footer-{{ ai_gen_id }}__desktop-list a:focus-visible {
    outline: 2px solid var(--footer-gold);
    outline-offset: 3px;

    border-radius: 2px;
  }


  /* =========================================================
     EMPTY MENU
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__empty-menu {
    margin: 0;

    color: var(--footer-muted);

    font-size: 13px;
    line-height: 1.5;
  }


  /* =========================================================
     MOBILE NAVIGATION
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__mobile-nav {
    display: none;
  }


  /* =========================================================
     DIVIDER
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__divider {
    width: 100%;
    height: 1px;

    margin-top: {{ block.settings.divider_spacing }}px;
    margin-bottom: 24px;

    background: var(--footer-border);
  }


  /* =========================================================
     BOTTOM
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__bottom {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 24px;
  }

  .kapisa-footer-{{ ai_gen_id }}__copyright {
    margin: 0;

    color: var(--footer-muted);

    font-size: 12px;
    line-height: 1.6;
  }

  .kapisa-footer-{{ ai_gen_id }}__payments {
    display: flex;

    align-items: center;
    justify-content: flex-end;

    flex-wrap: wrap;

    gap: 8px;
  }

  .kapisa-footer-{{ ai_gen_id }}__payment {
    display: flex;

    align-items: center;
    justify-content: center;

    min-width: 40px;
    min-height: 25px;

    color: var(--footer-cream);
  }

  .kapisa-footer-{{ ai_gen_id }}__payment svg {
    max-width: 42px;
    max-height: 25px;
  }


  /* =========================================================
     MOBILE ACCORDION
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__details {
    width: 100%;

    border-top: 1px solid var(--footer-border);
  }

  .kapisa-footer-{{ ai_gen_id }}__details:last-child {
    border-bottom: 1px solid var(--footer-border);
  }

  .kapisa-footer-{{ ai_gen_id }}__summary {
    display: flex;

    align-items: center;
    justify-content: space-between;

    width: 100%;
    min-height: 56px;

    padding: 0;

    border: 0;

    background: transparent;

    color: var(--footer-cream);

    font-size: 14px;
    font-weight: 700;

    line-height: 1.4;

    letter-spacing: 0.02em;

    cursor: pointer;

    list-style: none;

    user-select: none;
  }

  .kapisa-footer-{{ ai_gen_id }}__summary::-webkit-details-marker {
    display: none;
  }

  .kapisa-footer-{{ ai_gen_id }}__summary::marker {
    display: none;
  }

  .kapisa-footer-{{ ai_gen_id }}__summary:focus-visible {
    outline: 2px solid var(--footer-gold);
    outline-offset: -3px;

    border-radius: 4px;
  }

  .kapisa-footer-{{ ai_gen_id }}__summary-label {
    display: block;
  }


  /* =========================================================
     MOBILE PLUS
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__plus {
    position: relative;

    width: 26px;
    height: 26px;

    flex: 0 0 26px;

    border: 1px solid rgba(250, 247, 240, 0.16);
    border-radius: 50%;

    color: var(--footer-cream);
  }

  .kapisa-footer-{{ ai_gen_id }}__plus::before,
  .kapisa-footer-{{ ai_gen_id }}__plus::after {
    content: "";

    position: absolute;

    top: 50%;
    left: 50%;

    width: 9px;
    height: 1px;

    background: currentColor;

    transform: translate(-50%, -50%);

    transition: transform 180ms ease;
  }

  .kapisa-footer-{{ ai_gen_id }}__plus::after {
    transform:
      translate(-50%, -50%)
      rotate(90deg);
  }

  .kapisa-footer-{{ ai_gen_id }}__details[open]
  .kapisa-footer-{{ ai_gen_id }}__plus {
    color: var(--footer-gold);

    border-color: var(--footer-gold);
  }

  .kapisa-footer-{{ ai_gen_id }}__details[open]
  .kapisa-footer-{{ ai_gen_id }}__plus::after {
    transform:
      translate(-50%, -50%)
      rotate(0deg);
  }


  /* =========================================================
     MOBILE CONTENT
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__mobile-content {
    padding: 0 0 17px;
  }

  .kapisa-footer-{{ ai_gen_id }}__mobile-list {
    display: flex;

    flex-direction: column;

    gap: 0;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .kapisa-footer-{{ ai_gen_id }}__mobile-list li {
    margin: 0;
    padding: 0;
  }

  .kapisa-footer-{{ ai_gen_id }}__mobile-list a {
    display: flex;

    align-items: center;

    min-height: 43px;

    padding: 7px 0;

    color: var(--footer-muted);

    font-size: 14px;
    line-height: 1.45;

    text-decoration: none;

    transition: color 180ms ease;
  }

  .kapisa-footer-{{ ai_gen_id }}__mobile-list a:hover {
    color: var(--footer-cream);
  }

  .kapisa-footer-{{ ai_gen_id }}__mobile-list a:focus-visible {
    outline: 2px solid var(--footer-gold);
    outline-offset: 2px;

    border-radius: 3px;
  }


  /* =========================================================
     MOBILE STATIC MODE
  ========================================================= */

  .kapisa-footer-{{ ai_gen_id }}__mobile-static {
    display: none;
  }

  .kapisa-footer-{{ ai_gen_id }}__mobile-static-menu {
    padding: 16px 0;

    border-top: 1px solid var(--footer-border);
  }

  .kapisa-footer-{{ ai_gen_id }}__mobile-static-menu:last-child {
    border-bottom: 1px solid var(--footer-border);
  }

  .kapisa-footer-{{ ai_gen_id }}__mobile-static-title {
    margin: 0 0 10px;

    color: var(--footer-cream);

    font-size: 13px;
    line-height: 1.4;

    font-weight: 700;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (min-width: 750px) and (max-width: 1099px) {

    .kapisa-footer-{{ ai_gen_id }}__top {
      grid-template-columns:
        minmax(190px, 1fr)
        minmax(0, 2fr);

      gap: 28px;
    }

    .kapisa-footer-{{ ai_gen_id }}__desktop-nav {
      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 20px;
    }

    .kapisa-footer-{{ ai_gen_id }}__desktop-list a {
      font-size: 13px;
    }

    .kapisa-footer-{{ ai_gen_id }}__desktop-title {
      font-size: 11px;
    }
  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 749px) {

    .kapisa-footer-{{ ai_gen_id }}__inner {
      width: 100%;
      max-width: none;

      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-right: {{ block.settings.mobile_padding_horizontal }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
      padding-left: {{ block.settings.mobile_padding_horizontal }}px;
    }

    .kapisa-footer-{{ ai_gen_id }}__top {
      display: block;
    }

    /*
      IMPORTANT:
      Desktop navigation is completely hidden on mobile.
    */

    .kapisa-footer-{{ ai_gen_id }}__desktop-nav {
      display: none !important;
    }

    .kapisa-footer-{{ ai_gen_id }}__mobile-nav {
      display: block;

      margin-top: 34px;
    }

    .kapisa-footer-{{ ai_gen_id }}__logo {
      max-width: min({{ block.settings.logo_width }}px, 72%);

      margin-bottom: 17px;
    }

    .kapisa-footer-{{ ai_gen_id }}__brand-name {
      font-size: 20px;
    }

    .kapisa-footer-{{ ai_gen_id }}__description {
      max-width: 100%;

      font-size: 13px;
      line-height: 1.7;
    }

    .kapisa-footer-{{ ai_gen_id }}__socials {
      margin-top: 20px;
    }

    .kapisa-footer-{{ ai_gen_id }}__social {
      width: 40px;
      height: 40px;

      flex-basis: 40px;
    }

    .kapisa-footer-{{ ai_gen_id }}__divider {
      margin-top: 32px;
      margin-bottom: 20px;
    }

    .kapisa-footer-{{ ai_gen_id }}__bottom {
      display: flex;

      flex-direction: column;

      align-items: flex-start;

      gap: 18px;
    }

    .kapisa-footer-{{ ai_gen_id }}__payments {
      width: 100%;

      justify-content: flex-start;
    }

    .kapisa-footer-{{ ai_gen_id }}__copyright {
      order: 2;

      font-size: 11px;
    }

    .kapisa-footer-{{ ai_gen_id }}__payments {
      order: 1;
    }
  }


  /* =========================================================
     SMALL PHONES
  ========================================================= */

  @media screen and (max-width: 360px) {

    .kapisa-footer-{{ ai_gen_id }}__inner {
      padding-left: 16px;
      padding-right: 16px;
    }

    .kapisa-footer-{{ ai_gen_id }}__brand-name {
      font-size: 19px;
    }

    .kapisa-footer-{{ ai_gen_id }}__description {
      font-size: 12.5px;
    }

    .kapisa-footer-{{ ai_gen_id }}__summary {
      min-height: 54px;

      font-size: 13px;
    }

    .kapisa-footer-{{ ai_gen_id }}__mobile-list a {
      font-size: 13px;
    }
  }


  /* =========================================================
     REDUCED MOTION
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .kapisa-footer-{{ ai_gen_id }} *,
    .kapisa-footer-{{ ai_gen_id }} *::before,
    .kapisa-footer-{{ ai_gen_id }} *::after {
      transition: none !important;
    }
  }

{% endstyle %}


<footer
  class="kapisa-footer-{{ ai_gen_id }}"
  aria-label="{{ block.settings.footer_aria_label }}"
>

  <div class="kapisa-footer-{{ ai_gen_id }}__inner">

    <!-- =====================================================
         TOP CONTENT
    ====================================================== -->

    <div class="kapisa-footer-{{ ai_gen_id }}__top">


      <!-- ===================================================
           BRAND
      ==================================================== -->

      <div class="kapisa-footer-{{ ai_gen_id }}__brand">

        {% if block.settings.logo != blank %}

          <img
            class="kapisa-footer-{{ ai_gen_id }}__logo"
            src="{{ block.settings.logo | image_url: width: 600 }}"
            alt="{{ block.settings.logo.alt | default: block.settings.brand_name }}"
            loading="lazy"
            decoding="async"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
          >

        {% else %}

          <p class="kapisa-footer-{{ ai_gen_id }}__brand-name">
            {{ block.settings.brand_name }}
          </p>

        {% endif %}


        {% if block.settings.description != blank %}

          <p class="kapisa-footer-{{ ai_gen_id }}__description">
            {{ block.settings.description }}
          </p>

        {% endif %}


        <!-- SOCIAL LINKS -->

        {% if block.settings.instagram_url != blank
          or block.settings.facebook_url != blank
          or block.settings.linkedin_url != blank
        %}

          <nav
            class="kapisa-footer-{{ ai_gen_id }}__socials"
            aria-label="Social media"
          >

            {% if block.settings.instagram_url != blank %}

              <a
                class="kapisa-footer-{{ ai_gen_id }}__social"
                href="{{ block.settings.instagram_url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >

                  <rect
                    x="3"
                    y="3"
                    width="18"
                    height="18"
                    rx="5"
                  ></rect>

                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                  ></circle>

                  <circle
                    cx="17.5"
                    cy="6.5"
                    r="1"
                    fill="currentColor"
                    stroke="none"
                  ></circle>

                </svg>

              </a>

            {% endif %}


            {% if block.settings.facebook_url != blank %}

              <a
                class="kapisa-footer-{{ ai_gen_id }}__social"
                href="{{ block.settings.facebook_url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >

                  <path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.6 1.7-1.6h1.7V3.8c-.3 0-1.4-.1-2.6-.1-2.6 0-4.3 1.6-4.3 4.4V10H7.3v3H10v8h3.5Z"/>

                </svg>

              </a>

            {% endif %}


            {% if block.settings.linkedin_url != blank %}

              <a
                class="kapisa-footer-{{ ai_gen_id }}__social"
                href="{{ block.settings.linkedin_url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >

                  <path d="M6.5 8.2A1.7 1.7 0 1 0 6.5 4.8a1.7 1.7 0 0 0 0 3.4ZM5 9.7h3v9.5H5V9.7Zm4.8 0h2.9V11c.4-.8 1.5-1.6 3.2-1.6 3.4 0 4 2.2 4 5.1v4.7H17v-4.2c0-1 0-2.4-1.5-2.4s-1.7 1.1-1.7 2.3v4.3H9.8V9.7Z"/>

                </svg>

              </a>

            {% endif %}

          </nav>

        {% endif %}

      </div>


      <!-- ===================================================
           DESKTOP MENUS
      ==================================================== -->

      <div class="kapisa-footer-{{ ai_gen_id }}__desktop-nav">


        <!-- SHOP -->

        <nav
          class="kapisa-footer-{{ ai_gen_id }}__desktop-menu"
          aria-label="{{ block.settings.shop_title }}"
        >

          <h2 class="kapisa-footer-{{ ai_gen_id }}__desktop-title">
            {{ block.settings.shop_title }}
          </h2>

          {% if shop_menu != blank and shop_menu.links.size > 0 %}

            <ul class="kapisa-footer-{{ ai_gen_id }}__desktop-list">

              {% for link in shop_menu.links %}

                <li>

                  <a
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{ link.title }}
                  </a>

                </li>

              {% endfor %}

            </ul>

          {% else %}

            <p class="kapisa-footer-{{ ai_gen_id }}__empty-menu">
              Select a shop menu in Theme Editor.
            </p>

          {% endif %}

        </nav>


        <!-- SUPPORT -->

        <nav
          class="kapisa-footer-{{ ai_gen_id }}__desktop-menu"
          aria-label="{{ block.settings.support_title }}"
        >

          <h2 class="kapisa-footer-{{ ai_gen_id }}__desktop-title">
            {{ block.settings.support_title }}
          </h2>

          {% if support_menu != blank and support_menu.links.size > 0 %}

            <ul class="kapisa-footer-{{ ai_gen_id }}__desktop-list">

              {% for link in support_menu.links %}

                <li>

                  <a
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{ link.title }}
                  </a>

                </li>

              {% endfor %}

            </ul>

          {% else %}

            <p class="kapisa-footer-{{ ai_gen_id }}__empty-menu">
              Select a support menu in Theme Editor.
            </p>

          {% endif %}

        </nav>


        <!-- COMPANY -->

        <nav
          class="kapisa-footer-{{ ai_gen_id }}__desktop-menu"
          aria-label="{{ block.settings.company_title }}"
        >

          <h2 class="kapisa-footer-{{ ai_gen_id }}__desktop-title">
            {{ block.settings.company_title }}
          </h2>

          {% if company_menu != blank and company_menu.links.size > 0 %}

            <ul class="kapisa-footer-{{ ai_gen_id }}__desktop-list">

              {% for link in company_menu.links %}

                <li>

                  <a
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{ link.title }}
                  </a>

                </li>

              {% endfor %}

            </ul>

          {% else %}

            <p class="kapisa-footer-{{ ai_gen_id }}__empty-menu">
              Select a company menu in Theme Editor.
            </p>

          {% endif %}

        </nav>

      </div>


      <!-- ===================================================
           MOBILE NAVIGATION
      ==================================================== -->

      <div class="kapisa-footer-{{ ai_gen_id }}__mobile-nav">

        {% if block.settings.mobile_accordion %}


          <!-- ===============================================
               MOBILE SHOP
          ================================================ -->

          <details class="kapisa-footer-{{ ai_gen_id }}__details">

            <summary class="kapisa-footer-{{ ai_gen_id }}__summary">

              <span class="kapisa-footer-{{ ai_gen_id }}__summary-label">
                {{ block.settings.shop_title }}
              </span>

              <span
                class="kapisa-footer-{{ ai_gen_id }}__plus"
                aria-hidden="true"
              ></span>

            </summary>


            <div class="kapisa-footer-{{ ai_gen_id }}__mobile-content">

              {% if shop_menu != blank and shop_menu.links.size > 0 %}

                <nav aria-label="{{ block.settings.shop_title }}">

                  <ul class="kapisa-footer-{{ ai_gen_id }}__mobile-list">

                    {% for link in shop_menu.links %}

                      <li>

                        <a
                          href="{{ link.url }}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title }}
                        </a>

                      </li>

                    {% endfor %}

                  </ul>

                </nav>

              {% else %}

                <p class="kapisa-footer-{{ ai_gen_id }}__empty-menu">
                  Select a shop menu in Theme Editor.
                </p>

              {% endif %}

            </div>

          </details>


          <!-- ===============================================
               MOBILE SUPPORT
          ================================================ -->

          <details class="kapisa-footer-{{ ai_gen_id }}__details">

            <summary class="kapisa-footer-{{ ai_gen_id }}__summary">

              <span class="kapisa-footer-{{ ai_gen_id }}__summary-label">
                {{ block.settings.support_title }}
              </span>

              <span
                class="kapisa-footer-{{ ai_gen_id }}__plus"
                aria-hidden="true"
              ></span>

            </summary>


            <div class="kapisa-footer-{{ ai_gen_id }}__mobile-content">

              {% if support_menu != blank and support_menu.links.size > 0 %}

                <nav aria-label="{{ block.settings.support_title }}">

                  <ul class="kapisa-footer-{{ ai_gen_id }}__mobile-list">

                    {% for link in support_menu.links %}

                      <li>

                        <a
                          href="{{ link.url }}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title }}
                        </a>

                      </li>

                    {% endfor %}

                  </ul>

                </nav>

              {% else %}

                <p class="kapisa-footer-{{ ai_gen_id }}__empty-menu">
                  Select a support menu in Theme Editor.
                </p>

              {% endif %}

            </div>

          </details>


          <!-- ===============================================
               MOBILE COMPANY
          ================================================ -->

          <details class="kapisa-footer-{{ ai_gen_id }}__details">

            <summary class="kapisa-footer-{{ ai_gen_id }}__summary">

              <span class="kapisa-footer-{{ ai_gen_id }}__summary-label">
                {{ block.settings.company_title }}
              </span>

              <span
                class="kapisa-footer-{{ ai_gen_id }}__plus"
                aria-hidden="true"
              ></span>

            </summary>


            <div class="kapisa-footer-{{ ai_gen_id }}__mobile-content">

              {% if company_menu != blank and company_menu.links.size > 0 %}

                <nav aria-label="{{ block.settings.company_title }}">

                  <ul class="kapisa-footer-{{ ai_gen_id }}__mobile-list">

                    {% for link in company_menu.links %}

                      <li>

                        <a
                          href="{{ link.url }}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title }}
                        </a>

                      </li>

                    {% endfor %}

                  </ul>

                </nav>

              {% else %}

                <p class="kapisa-footer-{{ ai_gen_id }}__empty-menu">
                  Select a company menu in Theme Editor.
                </p>

              {% endif %}

            </div>

          </details>


        {% else %}


          <!-- ===============================================
               MOBILE STATIC MENUS
          ================================================ -->

          <div class="kapisa-footer-{{ ai_gen_id }}__mobile-static"
            style="display: block;"
          >


            <!-- SHOP -->

            <nav
              class="kapisa-footer-{{ ai_gen_id }}__mobile-static-menu"
              aria-label="{{ block.settings.shop_title }}"
            >

              <h2 class="kapisa-footer-{{ ai_gen_id }}__mobile-static-title">
                {{ block.settings.shop_title }}
              </h2>

              {% if shop_menu != blank and shop_menu.links.size > 0 %}

                <ul class="kapisa-footer-{{ ai_gen_id }}__mobile-list">

                  {% for link in shop_menu.links %}

                    <li>

                      <a
                        href="{{ link.url }}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title }}
                      </a>

                    </li>

                  {% endfor %}

                </ul>

              {% endif %}

            </nav>


            <!-- SUPPORT -->

            <nav
              class="kapisa-footer-{{ ai_gen_id }}__mobile-static-menu"
              aria-label="{{ block.settings.support_title }}"
            >

              <h2 class="kapisa-footer-{{ ai_gen_id }}__mobile-static-title">
                {{ block.settings.support_title }}
              </h2>

              {% if support_menu != blank and support_menu.links.size > 0 %}

                <ul class="kapisa-footer-{{ ai_gen_id }}__mobile-list">

                  {% for link in support_menu.links %}

                    <li>

                      <a
                        href="{{ link.url }}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title }}
                      </a>

                    </li>

                  {% endfor %}

                </ul>

              {% endif %}

            </nav>


            <!-- COMPANY -->

            <nav
              class="kapisa-footer-{{ ai_gen_id }}__mobile-static-menu"
              aria-label="{{ block.settings.company_title }}"
            >

              <h2 class="kapisa-footer-{{ ai_gen_id }}__mobile-static-title">
                {{ block.settings.company_title }}
              </h2>

              {% if company_menu != blank and company_menu.links.size > 0 %}

                <ul class="kapisa-footer-{{ ai_gen_id }}__mobile-list">

                  {% for link in company_menu.links %}

                    <li>

                      <a
                        href="{{ link.url }}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title }}
                      </a>

                    </li>

                  {% endfor %}

                </ul>

              {% endif %}

            </nav>

          </div>

        {% endif %}

      </div>

    </div>


    <!-- =====================================================
         DIVIDER
    ====================================================== -->

    <div class="kapisa-footer-{{ ai_gen_id }}__divider"></div>


    <!-- =====================================================
         FOOTER BOTTOM
    ====================================================== -->

    <div class="kapisa-footer-{{ ai_gen_id }}__bottom">


      <!-- COPYRIGHT -->

      <p class="kapisa-footer-{{ ai_gen_id }}__copyright">

        {% if block.settings.copyright_text != blank %}

          {{ block.settings.copyright_text }}

        {% else %}

          © {{ 'now' | date: '%Y' }}
          {{ block.settings.brand_name }}.
          All rights reserved.

        {% endif %}

      </p>


      <!-- PAYMENT ICONS -->

      {% if block.settings.show_payment_icons %}

        {% if shop.enabled_payment_types.size > 0 %}

          <div
            class="kapisa-footer-{{ ai_gen_id }}__payments"
            aria-label="Accepted payment methods"
          >

            {% for type in shop.enabled_payment_types %}

              <span class="kapisa-footer-{{ ai_gen_id }}__payment">

                {{ type | payment_type_svg_tag }}

              </span>

            {% endfor %}

          </div>

        {% endif %}

      {% endif %}

    </div>

  </div>

</footer>


{% schema %}

{
  "name": "Kapisa Premium Footer",

  "tag": "div",

  "class": "kapisa-footer-block",

  "settings": [

    {
      "type": "header",
      "content": "Brand"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },

    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 100,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 220
    },

    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Kapisa Healthcare"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Brand description",
      "default": "Premium healthcare apparel designed for professionals who move with purpose."
    },

    {
      "type": "text",
      "id": "footer_aria_label",
      "label": "Footer accessibility label",
      "default": "Kapisa Healthcare footer"
    },


    {
      "type": "header",
      "content": "Menus"
    },

    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },

    {
      "type": "text",
      "id": "shop_title",
      "label": "Shop title",
      "default": "Shop"
    },

    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Support menu"
    },

    {
      "type": "text",
      "id": "support_title",
      "label": "Support title",
      "default": "Support"
    },

    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },

    {
      "type": "text",
      "id": "company_title",
      "label": "Company title",
      "default": "Company"
    },

    {
      "type": "checkbox",
      "id": "mobile_accordion",
      "label": "Use accordion menus on mobile",
      "default": true
    },


    {
      "type": "header",
      "content": "Social links"
    },

    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },

    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },

    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0E1F3C"
    },

    {
      "type": "color",
      "id": "surface_color",
      "label": "Surface",
      "default": "#13294A"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#FAF7F0"
    },

    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#AEBBCB"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent",
      "default": "#C9A227"
    },


    {
      "type": "header",
      "content": "Desktop layout"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1250
    },

    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop content width",
      "min": 80,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },

    {
      "type": "range",
      "id": "column_gap",
      "label": "Column spacing",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    },

    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop top padding",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },

    {
      "type": "range",
      "id": "desktop_padding_horizontal",
      "label": "Desktop horizontal padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },

    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop bottom padding",
      "min": 16,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 26
    },

    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Divider spacing",
      "min": 25,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 50
    },


    {
      "type": "header",
      "content": "Mobile layout"
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 25,
      "max": 70,
      "step": 5,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "label": "Mobile horizontal padding",
      "min": 14,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },


    {
      "type": "header",
      "content": "Payments"
    },

    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },


    {
      "type": "header",
      "content": "Copyright"
    },

    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2026 Kapisa Healthcare. All rights reserved."
    }

  ],

  "presets": [
    {
      "name": "Kapisa Premium Footer"
    }
  ]
}

{% endschema %}


