{% doc %}
  @prompt
    Create a slim trust badges strip, off-white background, thin top border in slate 
    #8FA3B8. Row of 4 icon+label pairs, evenly spaced, centered: 'Cash on Delivery', 'Easy 7-Day Exchange', '1–3 Day Express Delivery', 'Secure Checkout'. Small gold 
    #C9A227 line icons above each label, charcoal text, no background boxes — clean and minimal, single row on desktop, 2x2 grid on mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-strip-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    border-top: 1px solid {{ block.settings.border_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-trust-strip-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    justify-items: center;
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 24px;
  }

  .ai-trust-strip-{{ ai_gen_id }}__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    width: 100%;
    text-align: center;
  }

  .ai-trust-strip-{{ ai_gen_id }}__icon {
    display: flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-trust-strip-{{ ai_gen_id }}__icon svg {
    display: block;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-trust-strip-{{ ai_gen_id }}__label {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.label_size }}px;
    line-height: 1.3;
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-strip-{{ ai_gen_id }}__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 12px;
      padding: {{ block.settings.mobile_padding }}px 16px;
    }
  }
{% endstyle %}

<trust-badges-{{ ai_gen_id }}
  class="ai-trust-strip-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-trust-strip-{{ ai_gen_id }}__inner">
    <div class="ai-trust-strip-{{ ai_gen_id }}__item">
      <span class="ai-trust-strip-{{ ai_gen_id }}__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="1.5"></rect><path d="M3 10h18M7 15h3"></path><path d="M7 4v2M17 4v2"></path></svg>
      </span>
      <p class="ai-trust-strip-{{ ai_gen_id }}__label">{{ block.settings.label_one }}</p>
    </div>

    <div class="ai-trust-strip-{{ ai_gen_id }}__item">
      <span class="ai-trust-strip-{{ ai_gen_id }}__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 0 1 4"></path><path d="M20 5v6h-6"></path><path d="M8 14l2 2 5-5"></path></svg>
      </span>
      <p class="ai-trust-strip-{{ ai_gen_id }}__label">{{ block.settings.label_two }}</p>
    </div>

    <div class="ai-trust-strip-{{ ai_gen_id }}__item">
      <span class="ai-trust-strip-{{ ai_gen_id }}__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"></path><circle cx="7" cy="19" r="1.5"></circle><circle cx="18" cy="19" r="1.5"></circle><path d="M14 14h7"></path></svg>
      </span>
      <p class="ai-trust-strip-{{ ai_gen_id }}__label">{{ block.settings.label_three }}</p>
    </div>

    <div class="ai-trust-strip-{{ ai_gen_id }}__item">
      <span class="ai-trust-strip-{{ ai_gen_id }}__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 7.8-7 10-4-2.2-7-5.5-7-10V6l7-3z"></path><path d="M9 12l2 2 4-4"></path></svg>
      </span>
      <p class="ai-trust-strip-{{ ai_gen_id }}__label">{{ block.settings.label_four }}</p>
    </div>
  </div>
</trust-badges-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('trust-badges-{{ ai_gen_id }}')) {
      class TrustBadges{{ ai_gen_id }} extends HTMLElement {}
      customElements.define('trust-badges-{{ ai_gen_id }}', TrustBadges{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Trust badges strip",
  "settings": [
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "label_one",
      "label": "Badge 1",
      "default": "Cash on Delivery"
    },
    {
      "type": "text",
      "id": "label_two",
      "label": "Badge 2",
      "default": "Easy 7-Day Exchange"
    },
    {
      "type": "text",
      "id": "label_three",
      "label": "Badge 3",
      "default": "1–3 Day Express Delivery"
    },
    {
      "type": "text",
      "id": "label_four",
      "label": "Badge 4",
      "default": "Secure Checkout"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Desktop padding",
      "min": 6,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile padding",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#8FA3B8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icons",
      "default": "#C9A227"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2B2B2B"
    }
  ],
  "presets": [
    {
      "name": "Trust badges strip"
    }
  ],
  "tag": null,
  "class": "trust-badges-strip-block"
}
{% endschema %}