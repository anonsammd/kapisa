                </div>
              </div>
            </div>
          {% endif %}
        </div>

        <!-- MOBILE FOOTER CTA -->
        <div class="kapisa-filter-{{ ai_gen_id }}__mobile-footer">
          <button type="button" class="kapisa-filter-{{ ai_gen_id }}__mobile-apply-btn" data-mobile-apply>
            <span>Apply Filters</span>
            <span data-mobile-product-count>({{ collection.products_count }})</span>
          </button>
        </div>

      </div>
    </div>

    <!-- ACTIVE FILTER CHIPS -->
    <div class="kapisa-filter-{{ ai_gen_id }}__active" data-active-chips style="display: none;"></div>

  </div>
</collection-filterbar-{{ ai_gen_id }}>

<script>
(function() {
  class KapisaInlineFilter{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.panel = this.querySelector('[data-filter-panel]');
      this.toggle = this.querySelector('[data-filter-toggle]');
      this.badge = this.querySelector('[data-filter-badge]');
      this.badgeMobile = this.querySelector('[data-filter-badge-mobile]');
      this.groups = this.querySelectorAll('[data-filter-group]');
      this.sort = this.querySelector('[data-sort]');
      this.chipsContainer = this.querySelector('[data-active-chips]');
      this.mobileClose = this.querySelector('[data-mobile-close]');
      this.mobileBackdrop = this.querySelector('[data-sheet-backdrop]');
      this.mobileApply = this.querySelector('[data-mobile-apply]');
      this.mobileClear = this.querySelector('[data-mobile-clear]');

      // Sticky glass effect on scroll
      window.addEventListener('scroll', () => {
        if (window.scrollY > 80) {
          this.classList.add('is-sticky');
        } else {
          this.classList.remove('is-sticky');
        }
      }, { passive: true });

      // Open filter panel
      this.toggle?.addEventListener('click', () => {
        const isOpen = this.panel.classList.contains('is-open');
        this.togglePanel(!isOpen);
      });

      // Close mobile sheet handlers
      this.mobileClose?.addEventListener('click', () => this.togglePanel(false));
      this.mobileBackdrop?.addEventListener('click', () => this.togglePanel(false));
      this.mobileApply?.addEventListener('click', () => {
        this.togglePanel(false);
        this.syncFilters();
      });
      this.mobileClear?.addEventListener('click', () => {
        this.clearAll();
      });

      // Individual dropdown toggles (Desktop)
      this.groups.forEach(group => {
        const btn = group.querySelector('[data-group-toggle]');
        const dropdown = group.querySelector('[data-filter-dropdown]');

        btn?.addEventListener('click', (e) => {
          if (window.innerWidth <= 749) return; // on mobile, all groups are visible in sheet
          e.stopPropagation();
          const open = dropdown.classList.contains('is-open');
          this.querySelectorAll('[data-filter-dropdown].is-open').forEach(other => {
            if (other !== dropdown) other.classList.remove('is-open');
          });
          this.querySelectorAll('[data-group-toggle].is-active').forEach(otherBtn => {
            if (otherBtn !== btn) otherBtn.classList.remove('is-active');
          });
          dropdown.classList.toggle('is-open', !open);
          btn.classList.toggle('is-active', !open);
        });

        // Price Apply button inside group
        const applyPriceBtn = group.querySelector('[data-apply-price]');
        if (applyPriceBtn) {
          applyPriceBtn.addEventListener('click', () => {
            if (window.innerWidth > 749) {
              dropdown.classList.remove('is-open');
              btn.classList.remove('is-active');
            }
            this.syncFilters();
          });
        }
      });

      // Close desktop dropdowns on outside click
      document.addEventListener('click', (e) => {
        if (window.innerWidth > 749 && !this.contains(e.target)) {
          this.querySelectorAll('[data-filter-dropdown].is-open').forEach(dd => dd.classList.remove('is-open'));
          this.querySelectorAll('[data-group-toggle].is-active').forEach(b => b.classList.remove('is-active'));
        }
      });

      // Input changes
      this.querySelectorAll('input[type="checkbox"]').forEach(input => {
        input.addEventListener('change', () => this.syncFilters());
      });

      // Sort changes
      this.sort?.addEventListener('change', () => {
        const sortVal = this.sort.value;
        const url = new URL(window.location.href);
        url.searchParams.set('sort_by', sortVal);
        history.pushState({}, '', url.toString());

        window.dispatchEvent(new CustomEvent('kapisa:sort-change', {
          detail: { sort: sortVal }
        }));
      });

      // Price presets click handlers
      this.querySelectorAll('[data-price-preset]').forEach(btn => {
        btn.addEventListener('click', () => {
          const min = btn.dataset.min || '';
          const max = btn.dataset.max || '';
          const minInput = this.querySelector('[data-price-min]');
          const maxInput = this.querySelector('[data-price-max]');
          if (minInput) minInput.value = min;
          if (maxInput) maxInput.value = max;
          this.querySelectorAll('[data-price-preset]').forEach(b => b.classList.toggle('is-active', b === btn));
          this.syncFilters();
        });
      });

      // Clear filters listener from grid
      window.addEventListener('kapisa:clear-filters', () => {
        this.resetInputs();
      });

      // Popstate listener for back/forward navigation
      window.addEventListener('popstate', () => {
        this.populateFromUrl();
      });

      // Filtered state updated from grid
      window.addEventListener('kapisa:filtered-state-updated', (e) => {
        const count = e.detail ? e.detail.count : 0;
        const mobileCountEl = this.querySelector('[data-mobile-product-count]');
        if (mobileCountEl) {
          mobileCountEl.textContent = `(${count})`;
        }
      });

      // Read initial state from URL on page load
      this.populateFromUrl();
    }

    togglePanel(open) {
      if (open) {
        this.panel.classList.add('is-open');
        this.toggle.classList.add('is-active');
        this.toggle.setAttribute('aria-expanded', 'true');
        if (window.innerWidth <= 749) {
          document.body.style.overflow = 'hidden';
        }
      } else {
        this.panel.classList.remove('is-open');
        this.toggle.classList.remove('is-active');
        this.toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }

    populateFromUrl() {
      const url = new URL(window.location.href);
      const params = url.searchParams;

      // Reset checkboxes first
      this.querySelectorAll('input[type="checkbox"]').forEach(i => i.checked = false);

      // Detect color
      const colors = [];
      const checkParam = (paramName) => {
        params.forEach((val, key) => {
          if (key === paramName || key.startsWith(paramName)) {
            val.split(',').forEach(v => {
              const clean = v.trim().toLowerCase();
              if (clean && !colors.includes(clean)) colors.push(clean);
            });
          }
        });
      };

      checkParam('filter.v.option.color');
      checkParam('filter.v.option.colour');
      checkParam('filter.p.m.custom.color_family');
      checkParam('filter.p.tag');
      checkParam('color');
      checkParam('colour');

      // Detect sizes
      const sizes = [];
      const checkSizeParam = (paramName) => {
        params.forEach((val, key) => {
          if (key === paramName || key.startsWith(paramName)) {
            val.split(',').forEach(v => {
              const clean = v.trim().toLowerCase();
              if (clean && !sizes.includes(clean)) sizes.push(clean);
            });
          }
        });
      };
      checkSizeParam('filter.v.option.size');
      checkSizeParam('size');

      // Detect availability
      const inStock = params.get('filter.v.availability') === '1' || params.get('availability') === 'in_stock';

      // Check corresponding checkboxes
      this.querySelectorAll('input[type="checkbox"]').forEach(input => {
        const val = (input.value || '').trim().toLowerCase();
        const type = input.dataset.filterType;
        const name = (input.name || '').toLowerCase();
        if ((type === 'color' || name.includes('color') || name.includes('colour')) && colors.includes(val)) {
          input.checked = true;
        } else if ((type === 'size' || name.includes('size')) && sizes.includes(val)) {
          input.checked = true;
        } else if ((type === 'availability' || name.includes('availability')) && inStock && (val === 'in_stock' || val === '1')) {
          input.checked = true;
        }
      });

      // Detect price
      const minPrice = params.get('filter.v.price.gte') || params.get('min_price');
      const maxPrice = params.get('filter.v.price.lte') || params.get('max_price');
      const minInput = this.querySelector('[data-price-min]');
      const maxInput = this.querySelector('[data-price-max]');
      if (minInput) minInput.value = minPrice || '';
      if (maxInput) maxInput.value = maxPrice || '';

      // Update UI chips & badge
      this.renderChips();
    }

    syncFilters() {
      const selectedColors = [];
      const selectedSizes = [];
      let inStock = false;

      this.querySelectorAll('input[type="checkbox"]:checked').forEach(input => {
        const type = input.dataset.filterType;
        const name = (input.name || '').toLowerCase();
        const val = input.value;
        if (type === 'color' || name.includes('color') || name.includes('colour')) {
          if (!selectedColors.includes(val)) selectedColors.push(val);
        } else if (type === 'size' || name.includes('size')) {
          if (!selectedSizes.includes(val)) selectedSizes.push(val);
        } else if (type === 'availability' || name.includes('availability')) {
          if (val === 'in_stock' || val === '1') inStock = true;
        }
      });

      const minInput = this.querySelector('[data-price-min]');
      const maxInput = this.querySelector('[data-price-max]');
      const minPrice = minInput && minInput.value ? parseFloat(minInput.value) : null;
      const maxPrice = maxInput && maxInput.value ? parseFloat(maxInput.value) : null;

      // Update URL search parameters
      const url = new URL(window.location.href);
      const params = url.searchParams;

      // Remove previous filter params
      const keysToDelete = [];
      params.forEach((_, k) => {
        if (k.startsWith('filter.') || k === 'color' || k === 'colour' || k === 'size' || k === 'min_price' || k === 'max_price' || k === 'availability') {
          keysToDelete.push(k);
        }
      });
      keysToDelete.forEach(k => params.delete(k));

      // Append selected filters
      if (selectedColors.length > 0) {
        selectedColors.forEach(c => {
          params.append('filter.v.option.color', c);
          params.append('filter.p.m.custom.color_family', c);
          params.append('color', c);
        });
      }
      if (selectedSizes.length > 0) {
        selectedSizes.forEach(s => params.append('filter.v.option.size', s));
      }
      if (minPrice !== null) params.set('min_price', minPrice);
      if (maxPrice !== null) params.set('max_price', maxPrice);
      if (inStock) params.set('availability', 'in_stock');

      history.pushState({}, '', url.toString());

      // Render Chips
      this.renderChips();

      // Dispatch event to product grid
      window.dispatchEvent(new CustomEvent('kapisa:filter-change', {
        detail: {
          colors: selectedColors,
          sizes: selectedSizes,
          minPrice,
          maxPrice,
          inStock
        }
      }));
    }

    renderChips() {
      if (!this.chipsContainer) return;

      const chips = [];
      this.querySelectorAll('input[type="checkbox"]:checked').forEach(input => {
        const val = input.value;
        const type = input.dataset.filterType || 'Filter';
        chips.push({
          label: `${type === 'color' ? 'Color' : type === 'size' ? 'Size' : 'Option'}: ${val}`,
          remove: () => {
            input.checked = false;
            this.syncFilters();
          }
        });
      });

      const minInput = this.querySelector('[data-price-min]');
      const maxInput = this.querySelector('[data-price-max]');
      if ((minInput && minInput.value) || (maxInput && maxInput.value)) {
        const minVal = minInput?.value ? `₹${minInput.value}` : '₹0';
        const maxVal = maxInput?.value ? `₹${maxInput.value}` : 'Any';
        chips.push({
          label: `Price: ${minVal} – ${maxVal}`,
          remove: () => {
            if (minInput) minInput.value = '';
            if (maxInput) maxInput.value = '';
            this.syncFilters();
          }
        });
      }

      this.chipsContainer.innerHTML = '';
      if (chips.length > 0) {
        this.chipsContainer.style.display = 'flex';
        chips.forEach(chip => {
          const pill = document.createElement('span');
          pill.className = 'kapisa-filter-{{ ai_gen_id }}__chip';
          pill.innerHTML = `<span>${chip.label}</span><button type="button" class="kapisa-filter-{{ ai_gen_id }}__chip-remove" aria-label="Remove filter">×</button>`;
          pill.querySelector('button').addEventListener('click', chip.remove);
          this.chipsContainer.appendChild(pill);
        });

        const clearBtn = document.createElement('button');
        clearBtn.type = 'button';
        clearBtn.className = 'kapisa-filter-{{ ai_gen_id }}__clear';
        clearBtn.textContent = 'Clear all';
        clearBtn.addEventListener('click', () => this.clearAll());
        this.chipsContainer.appendChild(clearBtn);

        // Update badge
        if (this.badge) {
          this.badge.textContent = chips.length;
          this.badge.style.display = 'inline-flex';
        }
        if (this.badgeMobile) {
          this.badgeMobile.textContent = chips.length;
          this.badgeMobile.style.display = 'inline-flex';
        }
        if (this.toggle) this.toggle.classList.add('is-active');
      } else {
        this.chipsContainer.style.display = 'none';
        if (this.badge) this.badge.style.display = 'none';
        if (this.badgeMobile) this.badgeMobile.style.display = 'none';
        if (this.toggle) this.toggle.classList.remove('is-active');
      }
    }

    clearAll() {
      this.resetInputs();
      const url = new URL(window.location.href);
      const toDelete = [];
      url.searchParams.forEach((_, k) => {
        if (k.startsWith('filter.') || k === 'color' || k === 'colour' || k === 'size' || k === 'min_price' || k === 'max_price' || k === 'availability') {
          toDelete.push(k);
        }
      });
      toDelete.forEach(k => url.searchParams.delete(k));
      history.pushState({}, '', url.toString());

      this.renderChips();
      window.dispatchEvent(new CustomEvent('kapisa:filter-change', {
        detail: { colors: [], sizes: [], minPrice: null, maxPrice: null, inStock: false }
      }));
    }

    resetInputs() {
      this.querySelectorAll('input[type="checkbox"]').forEach(i => i.checked = false);
      const minInput = this.querySelector('[data-price-min]');
      const maxInput = this.querySelector('[data-price-max]');
      if (minInput) minInput.value = '';
      if (maxInput) maxInput.value = '';
      this.renderChips();
    }
  }

  if (!customElements.get('collection-filterbar-{{ ai_gen_id }}')) {
    customElements.define('collection-filterbar-{{ ai_gen_id }}', KapisaInlineFilter{{ ai_gen_id }});
  }
})();
</script>

