{% comment %}
  KAPISA — Inline Collection Filter & Sort
  - Interactive Filter Strip & Dropdowns
  - Native Shopify collection.filters + Intelligent Fallback filters
  - Client-side and URL synchronized filtering
  - Active filter chips with one-click remove & Clear All
  - Responsive mobile bottom-sheet styling
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .kapisa-filter-{{ ai_gen_id }} {
    width: 100%;
    background: #FAF7F0;
    color: #2B2B2E;
    border-bottom: 1px solid rgba(143, 163, 184, 0.45);
  }

  .kapisa-filter-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 18px 28px;
    box-sizing: border-box;
  }

  /* MAIN STRIP */
  .kapisa-filter-{{ ai_gen_id }}__bar {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .kapisa-filter-{{ ai_gen_id }}__left {
    display: flex;
    align-items: center;
    gap: 22px;
    min-width: 0;
  }

  /* FILTER BUTTON */
  .kapisa-filter-{{ ai_gen_id }}__filter-button {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 18px;
    border: 1px solid #8FA3B8;
    background: #FAF7F0;
    color: #2B2B2E;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
    transition: background .2s ease, border-color .2s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__filter-button:hover,
  .kapisa-filter-{{ ai_gen_id }}__filter-button.is-active {
    background: #F0EEE9;
    border-color: #C9A227;
  }

  .kapisa-filter-{{ ai_gen_id }}__filter-button svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .kapisa-filter-{{ ai_gen_id }}__active-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    background: #C9A227;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
  }

  .kapisa-filter-{{ ai_gen_id }}__count {
    color: #8FA3B8;
    font-size: 14px;
    white-space: nowrap;
    font-weight: 500;
  }

  /* SORT */
  .kapisa-filter-{{ ai_gen_id }}__sort {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    color: #8FA3B8;
    font-size: 13px;
  }

  .kapisa-filter-{{ ai_gen_id }}__sort select {
    appearance: none;
    border: 0;
    border-bottom: 1px solid #8FA3B8;
    background-color: transparent;
    color: #2B2B2E;
    padding: 8px 26px 8px 4px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    background-image:
      linear-gradient(45deg, transparent 50%, #2B2B2E 50%),
      linear-gradient(135deg, #2B2B2E 50%, transparent 50%);
    background-position:
      calc(100% - 11px) 55%,
      calc(100% - 6px) 55%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }

  /* INLINE FILTER AREA */
  .kapisa-filter-{{ ai_gen_id }}__panel {
    display: none;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(143,163,184,.35);
    animation: kapisaFilterOpen-{{ ai_gen_id }} .18s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__panel.is-open {
    display: block;
  }

  @keyframes kapisaFilterOpen-{{ ai_gen_id }} {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kapisa-filter-{{ ai_gen_id }}__filter-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* INDIVIDUAL FILTER GROUP */
  .kapisa-filter-{{ ai_gen_id }}__group {
    position: relative;
  }

  .kapisa-filter-{{ ai_gen_id }}__group-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 9px 14px;
    border: 1px solid rgba(143,163,184,.7);
    background: #FAF7F0;
    color: #2B2B2E;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
  }

  .kapisa-filter-{{ ai_gen_id }}__group-button:hover,
  .kapisa-filter-{{ ai_gen_id }}__group-button.is-active {
    border-color: #C9A227;
    background: #F0EEE9;
  }

  .kapisa-filter-{{ ai_gen_id }}__group-arrow {
    width: 6px;
    height: 6px;
    border-right: 1.5px solid #2B2B2E;
    border-bottom: 1.5px solid #2B2B2E;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s ease;
  }

  /* FILTER DROPDOWN */
  .kapisa-filter-{{ ai_gen_id }}__dropdown {
    position: absolute;
    top: calc(100% + 7px);
    left: 0;
    z-index: 60;
    width: 270px;
    max-height: 360px;
    padding: 16px;
    overflow-y: auto;
    background: #FAF7F0;
    border: 1px solid rgba(143,163,184,.55);
    border-radius: 6px;
    box-shadow: 0 10px 28px rgba(43,43,46,.12);
    display: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__dropdown.is-open {
    display: block;
  }

  .kapisa-filter-{{ ai_gen_id }}__options {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .kapisa-filter-{{ ai_gen_id }}__option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 25px;
    color: #2B2B2E;
    font-size: 13px;
    cursor: pointer;
    user-select: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__checkbox {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    border: 1px solid #8FA3B8;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FAF7F0;
    transition: all .15s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__option input:checked + .kapisa-filter-{{ ai_gen_id }}__checkbox {
    background: #C9A227;
    border-color: #C9A227;
  }

  .kapisa-filter-{{ ai_gen_id }}__option input:checked + .kapisa-filter-{{ ai_gen_id }}__checkbox::after {
    content: '✓';
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }

  /* COLOR SWATCH */
  .kapisa-filter-{{ ai_gen_id }}__color-swatch {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    border-radius: 50%;
    border: 1px solid #8FA3B8;
    background: #F0EEE9;
    transition: transform .15s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__option input:checked + .kapisa-filter-{{ ai_gen_id }}__color-swatch {
    outline: 2px solid #C9A227;
    outline-offset: 2px;
    transform: scale(1.1);
  }

  /* PRICE */
  .kapisa-filter-{{ ai_gen_id }}__price {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .kapisa-filter-{{ ai_gen_id }}__price input {
    width: 100%;
    box-sizing: border-box;
    padding: 10px;
    border: 1px solid #8FA3B8;
    background: transparent;
    color: #2B2B2E;
    font: inherit;
    font-size: 13px;
    border-radius: 3px;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-apply {
    width: 100%;
    margin-top: 10px;
    padding: 10px;
    border: 0;
    background: #0E1F3C;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 3px;
    transition: background .2s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-apply:hover {
    background: #C9A227;
  }

  /* ACTIVE FILTER CHIPS */
  .kapisa-filter-{{ ai_gen_id }}__active {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
    padding-top: 10px;
  }

  .kapisa-filter-{{ ai_gen_id }}__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: #F0EEE9;
    border: 1px solid rgba(143,163,184,.4);
    border-radius: 20px;
    color: #2B2B2E;
    font-size: 12px;
    font-weight: 600;
  }

  .kapisa-filter-{{ ai_gen_id }}__chip-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border: 0;
    padding: 0;
    background: transparent;
    color: #8FA3B8;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    transition: color .15s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__chip-remove:hover {
    color: #DC2626;
  }

  .kapisa-filter-{{ ai_gen_id }}__clear {
    padding: 6px 8px;
    border: 0;
    background: transparent;
    color: #C9A227;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__clear:hover {
    text-decoration: underline;
  }

  /* MOBILE */
  @media (max-width: 749px) {
    .kapisa-filter-{{ ai_gen_id }}__inner {
      padding: 14px 16px;
    }

    .kapisa-filter-{{ ai_gen_id }}__bar {
      min-height: 46px;
      gap: 12px;
    }

    .kapisa-filter-{{ ai_gen_id }}__filter-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .kapisa-filter-{{ ai_gen_id }}__dropdown {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 12px;
      top: auto;
      width: auto;
      max-height: 55vh;
      border-radius: 8px;
      box-shadow: 0 16px 36px rgba(0,0,0,.25);
    }
  }
{% endstyle %}

<collection-filterbar-{{ ai_gen_id }}
  class="kapisa-filter-{{ ai_gen_id }} collection-filter-bar"
  {{ block.shopify_attributes }}
>
  <div class="kapisa-filter-{{ ai_gen_id }}__inner">

    <!-- MAIN STRIP -->
    <div class="kapisa-filter-{{ ai_gen_id }}__bar">
      <div class="kapisa-filter-{{ ai_gen_id }}__left">
        <button
          type="button"
          class="kapisa-filter-{{ ai_gen_id }}__filter-button"
          data-filter-toggle
          aria-expanded="false"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 6h16M7 12h10M10 18h4"/>
          </svg>
          <span>Filter</span>
          <span class="kapisa-filter-{{ ai_gen_id }}__active-count" data-filter-badge style="display: none;">0</span>
        </button>

        <span class="kapisa-filter-{{ ai_gen_id }}__count" data-product-count>
          {{ collection.products_count }} products
        </span>
      </div>

      <!-- SORT -->
      <div class="kapisa-filter-{{ ai_gen_id }}__sort">
        <label for="kapisa-sort-{{ ai_gen_id }}">Sort</label>
        <select id="kapisa-sort-{{ ai_gen_id }}" name="sort_by" data-sort>
          {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
          <option value="best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
          <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
          <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
          <option value="created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Newest</option>
        </select>
      </div>
    </div>

    <!-- INLINE FILTER PANEL -->
    <div class="kapisa-filter-{{ ai_gen_id }}__panel" data-filter-panel>
      <div class="kapisa-filter-{{ ai_gen_id }}__filter-list">

        {% if collection.filters.size > 0 %}
          {% comment %} Native Shopify Search & Discovery Filters {% endcomment %}
          {% for filter in collection.filters %}
            <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
              <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
                <span>{{ filter.label }}</span>
                <span class="kapisa-filter-{{ ai_gen_id }}__group-arrow"></span>
              </button>

              <div class="kapisa-filter-{{ ai_gen_id }}__dropdown" data-filter-dropdown>
                {% if filter.type == 'price_range' %}
                  <div class="kapisa-filter-{{ ai_gen_id }}__price">
                    <input type="number" data-price-min placeholder="Min" min="0">
                    <input type="number" data-price-max placeholder="Max" min="0">
                  </div>
                  <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-apply" data-apply-price>Apply</button>
                {% else %}
                  <div class="kapisa-filter-{{ ai_gen_id }}__options">
                    {% assign is_color = false %}
                    {% if filter.label contains 'Color' or filter.label contains 'Colour' %}
                      {% assign is_color = true %}
                    {% endif %}
                    {% for value in filter.values %}
                      <label class="kapisa-filter-{{ ai_gen_id }}__option">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" data-filter-type="{% if is_color %}color{% else %}generic{% endif %}">
                        {% if is_color %}
                          <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: {{ value.label | downcase | escape }};"></span>
                        {% else %}
                          <span class="kapisa-filter-{{ ai_gen_id }}__checkbox"></span>
                        {% endif %}
                        <span>{{ value.label }}</span>
                      </label>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% comment %}
            Intelligent Fallback Filters for Kapisa Medical Apparel
            Ensures customer can ALWAYS filter even when Search & Discovery is unconfigured
          {% endcomment %}

          <!-- 1. Colour Filter -->
          <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
            <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
              <span>Colour</span>
              <span class="kapisa-filter-{{ ai_gen_id }}__group-arrow"></span>
            </button>
            <div class="kapisa-filter-{{ ai_gen_id }}__dropdown" data-filter-dropdown>
              <div class="kapisa-filter-{{ ai_gen_id }}__options">
                <label class="kapisa-filter-{{ ai_gen_id }}__option">
                  <input type="checkbox" data-filter-type="color" value="Black">
                  <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #18191C;"></span>
                  <span>Black</span>
                </label>
                <label class="kapisa-filter-{{ ai_gen_id }}__option">
                  <input type="checkbox" data-filter-type="color" value="Blue">
                  <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #1B3B6F;"></span>
                  <span>Navy Blue</span>
                </label>
                <label class="kapisa-filter-{{ ai_gen_id }}__option">
                  <input type="checkbox" data-filter-type="color" value="Green">
                  <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #1B4942;"></span>
                  <span>Hunter Green</span>
                </label>
                <label class="kapisa-filter-{{ ai_gen_id }}__option">
                  <input type="checkbox" data-filter-type="color" value="Red">
                  <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #4A1525;"></span>
                  <span>Burgundy / Wine</span>
                </label>
                <label class="kapisa-filter-{{ ai_gen_id }}__option">
                  <input type="checkbox" data-filter-type="color" value="Grey">
                  <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #40464D;"></span>
                  <span>Slate Grey</span>
                </label>
                <label class="kapisa-filter-{{ ai_gen_id }}__option">
                  <input type="checkbox" data-filter-type="color" value="Pastel">
                  <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #756B98;"></span>
                  <span>Pastel / Lavender</span>
                </label>
              </div>
            </div>
          </div>

          <!-- 2. Size Filter -->
          <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
            <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
              <span>Size</span>
              <span class="kapisa-filter-{{ ai_gen_id }}__group-arrow"></span>
            </button>
            <div class="kapisa-filter-{{ ai_gen_id }}__dropdown" data-filter-dropdown>
              <div class="kapisa-filter-{{ ai_gen_id }}__options">
                {% assign sizes_list = 'XS,S,M,L,XL,2XL' | split: ',' %}
                {% for sz in sizes_list %}
                  <label class="kapisa-filter-{{ ai_gen_id }}__option">
                    <input type="checkbox" data-filter-type="size" value="{{ sz }}">
                    <span class="kapisa-filter-{{ ai_gen_id }}__checkbox"></span>
                    <span>{{ sz }}</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          </div>

          <!-- 3. Price Filter -->
          <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
            <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
              <span>Price</span>
              <span class="kapisa-filter-{{ ai_gen_id }}__group-arrow"></span>
            </button>
            <div class="kapisa-filter-{{ ai_gen_id }}__dropdown" data-filter-dropdown>
              <div class="kapisa-filter-{{ ai_gen_id }}__price">
                <input type="number" data-price-min placeholder="Min" min="0">
                <input type="number" data-price-max placeholder="Max" min="0">
              </div>
              <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-apply" data-apply-price>Apply</button>
            </div>
          </div>

          <!-- 4. Availability Filter -->
          <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
            <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
              <span>Availability</span>
              <span class="kapisa-filter-{{ ai_gen_id }}__group-arrow"></span>
            </button>
            <div class="kapisa-filter-{{ ai_gen_id }}__dropdown" data-filter-dropdown>
              <div class="kapisa-filter-{{ ai_gen_id }}__options">
                <label class="kapisa-filter-{{ ai_gen_id }}__option">
                  <input type="checkbox" data-filter-type="availability" value="in_stock">
                  <span class="kapisa-filter-{{ ai_gen_id }}__checkbox"></span>
                  <span>In Stock</span>
                </label>
              </div>
            </div>
          </div>
        {% endif %}

      </div>
    </div>

    <!-- ACTIVE FILTER CHIPS -->
    <div class="kapisa-filter-{{ ai_gen_id }}__active" data-active-chips style="display: none;"></div>

  </div>
</collection-filterbar-{{ ai_gen_id }}>

<script>
(function() {
  class KapisaInlineFilter{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.panel = this.querySelector('[data-filter-panel]');
      this.toggle = this.querySelector('[data-filter-toggle]');
      this.badge = this.querySelector('[data-filter-badge]');
      this.groups = this.querySelectorAll('[data-filter-group]');
      this.sort = this.querySelector('[data-sort]');
      this.chipsContainer = this.querySelector('[data-active-chips]');

      // Open/close filter panel
      this.toggle?.addEventListener('click', () => {
        const isOpen = this.panel.classList.contains('is-open');
        this.panel.classList.toggle('is-open', !isOpen);
        this.toggle.classList.toggle('is-active', !isOpen);
        this.toggle.setAttribute('aria-expanded', String(!isOpen));
      });

      // Individual dropdown toggles
      this.groups.forEach(group => {
        const btn = group.querySelector('[data-group-toggle]');
        const dropdown = group.querySelector('[data-filter-dropdown]');

        btn?.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = dropdown.classList.contains('is-open');
          this.querySelectorAll('[data-filter-dropdown].is-open').forEach(other => {
            if (other !== dropdown) other.classList.remove('is-open');
          });
          dropdown.classList.toggle('is-open', !open);
          btn.classList.toggle('is-active', !open);
        });

        // Price Apply button inside group
        const applyPriceBtn = group.querySelector('[data-apply-price]');
        if (applyPriceBtn) {
          applyPriceBtn.addEventListener('click', () => {
            dropdown.classList.remove('is-open');
            btn.classList.remove('is-active');
            this.syncFilters();
          });
        }
      });

      // Close dropdowns on outside click
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target)) {
          this.querySelectorAll('[data-filter-dropdown].is-open').forEach(dd => dd.classList.remove('is-open'));
          this.querySelectorAll('[data-group-toggle].is-active').forEach(b => b.classList.remove('is-active'));
        }
      });

      // Input changes
      this.querySelectorAll('input[type="checkbox"]').forEach(input => {
        input.addEventListener('change', () => this.syncFilters());
      });

      // Sort changes
      this.sort?.addEventListener('change', () => {
        const sortVal = this.sort.value;
        const url = new URL(window.location.href);
        url.searchParams.set('sort_by', sortVal);
        history.pushState({}, '', url.toString());

        window.dispatchEvent(new CustomEvent('kapisa:sort-change', {
          detail: { sort: sortVal }
        }));
      });

      // Clear filters listener from grid
      window.addEventListener('kapisa:clear-filters', () => {
        this.resetInputs();
      });

      // Read initial state from URL on page load
      this.populateFromUrl();
    }

    populateFromUrl() {
      const url = new URL(window.location.href);
      const params = url.searchParams;

      // Detect color
      const colors = [];
      const checkParam = (paramName) => {
        params.forEach((val, key) => {
          if (key === paramName || key.startsWith(paramName)) {
            val.split(',').forEach(v => {
              const clean = v.trim().toLowerCase();
              if (clean && !colors.includes(clean)) colors.push(clean);
            });
          }
        });
      };

      checkParam('filter.v.option.color');
      checkParam('filter.v.option.colour');
      checkParam('filter.p.m.custom.color_family');
      checkParam('filter.p.tag');
      checkParam('color');
      checkParam('colour');

      // Check corresponding checkboxes
      this.querySelectorAll('input[type="checkbox"]').forEach(input => {
        const val = (input.value || '').trim().toLowerCase();
        const type = input.dataset.filterType;
        if (type === 'color' && colors.includes(val)) {
          input.checked = true;
        }
      });

      // Detect price
      const minPrice = params.get('filter.v.price.gte') || params.get('min_price');
      const maxPrice = params.get('filter.v.price.lte') || params.get('max_price');
      const minInput = this.querySelector('[data-price-min]');
      const maxInput = this.querySelector('[data-price-max]');
      if (minInput && minPrice) minInput.value = minPrice;
      if (maxInput && maxPrice) maxInput.value = maxPrice;

      // Update UI chips & badge
      this.renderChips();
    }

    syncFilters() {
      const selectedColors = [];
      const selectedSizes = [];
      let inStock = false;

      this.querySelectorAll('input[type="checkbox"]:checked').forEach(input => {
        const type = input.dataset.filterType;
        const val = input.value;
        if (type === 'color') selectedColors.push(val);
        else if (type === 'size') selectedSizes.push(val);
        else if (type === 'availability' && val === 'in_stock') inStock = true;
        else if (input.name && input.name.includes('color')) selectedColors.push(val);
      });

      const minInput = this.querySelector('[data-price-min]');
      const maxInput = this.querySelector('[data-price-max]');
      const minPrice = minInput && minInput.value ? parseFloat(minInput.value) : null;
      const maxPrice = maxInput && maxInput.value ? parseFloat(maxInput.value) : null;

      // Update URL search parameters
      const url = new URL(window.location.href);
      const params = url.searchParams;

      // Remove previous filter params
      const keysToDelete = [];
      params.forEach((_, k) => {
        if (k.startsWith('filter.') || k === 'color' || k === 'colour' || k === 'size' || k === 'min_price' || k === 'max_price' || k === 'availability') {
          keysToDelete.push(k);
        }
      });
      keysToDelete.forEach(k => params.delete(k));

      // Append selected filters
      if (selectedColors.length > 0) {
        selectedColors.forEach(c => {
          params.append('filter.v.option.color', c);
          params.append('filter.p.m.custom.color_family', c);
          params.append('color', c);
        });
      }
      if (selectedSizes.length > 0) {
        selectedSizes.forEach(s => params.append('filter.v.option.size', s));
      }
      if (minPrice !== null) params.set('min_price', minPrice);
      if (maxPrice !== null) params.set('max_price', maxPrice);
      if (inStock) params.set('availability', 'in_stock');

      history.pushState({}, '', url.toString());

      // Render Chips
      this.renderChips();

      // Dispatch event to product grid
      window.dispatchEvent(new CustomEvent('kapisa:filter-change', {
        detail: {
          colors: selectedColors,
          sizes: selectedSizes,
          minPrice,
          maxPrice,
          inStock
        }
      }));
    }

    renderChips() {
      if (!this.chipsContainer) return;

      const chips = [];
      this.querySelectorAll('input[type="checkbox"]:checked').forEach(input => {
        const val = input.value;
        const type = input.dataset.filterType || 'Filter';
        chips.push({
          label: `${type === 'color' ? 'Color' : type === 'size' ? 'Size' : 'Option'}: ${val}`,
          remove: () => {
            input.checked = false;
            this.syncFilters();
          }
        });
      });

      const minInput = this.querySelector('[data-price-min]');
      const maxInput = this.querySelector('[data-price-max]');
      if ((minInput && minInput.value) || (maxInput && maxInput.value)) {
        const minVal = minInput?.value ? `$${minInput.value}` : '$0';
        const maxVal = maxInput?.value ? `$${maxInput.value}` : 'Any';
        chips.push({
          label: `Price: ${minVal} – ${maxVal}`,
          remove: () => {
            if (minInput) minInput.value = '';
            if (maxInput) maxInput.value = '';
            this.syncFilters();
          }
        });
      }

      this.chipsContainer.innerHTML = '';
      if (chips.length > 0) {
        this.chipsContainer.style.display = 'flex';
        chips.forEach(chip => {
          const pill = document.createElement('span');
          pill.className = 'kapisa-filter-{{ ai_gen_id }}__chip';
          pill.innerHTML = `<span>${chip.label}</span><button type="button" class="kapisa-filter-{{ ai_gen_id }}__chip-remove" aria-label="Remove filter">×</button>`;
          pill.querySelector('button').addEventListener('click', chip.remove);
          this.chipsContainer.appendChild(pill);
        });

        const clearBtn = document.createElement('button');
        clearBtn.type = 'button';
        clearBtn.className = 'kapisa-filter-{{ ai_gen_id }}__clear';
        clearBtn.textContent = 'Clear all';
        clearBtn.addEventListener('click', () => this.clearAll());
        this.chipsContainer.appendChild(clearBtn);

        // Update badge
        if (this.badge) {
          this.badge.textContent = chips.length;
          this.badge.style.display = 'inline-flex';
        }
        if (this.toggle) this.toggle.classList.add('is-active');
      } else {
        this.chipsContainer.style.display = 'none';
        if (this.badge) this.badge.style.display = 'none';
        if (this.toggle) this.toggle.classList.remove('is-active');
      }
    }

    clearAll() {
      this.resetInputs();
      const url = new URL(window.location.href);
      const toDelete = [];
      url.searchParams.forEach((_, k) => {
        if (k.startsWith('filter.') || k === 'color' || k === 'colour' || k === 'size' || k === 'min_price' || k === 'max_price' || k === 'availability') {
          toDelete.push(k);
        }
      });
      toDelete.forEach(k => url.searchParams.delete(k));
      history.pushState({}, '', url.toString());

      this.renderChips();
      window.dispatchEvent(new CustomEvent('kapisa:filter-change', {
        detail: { colors: [], sizes: [], minPrice: null, maxPrice: null, inStock: false }
      }));
    }

    resetInputs() {
      this.querySelectorAll('input[type="checkbox"]').forEach(i => i.checked = false);
      const minInput = this.querySelector('[data-price-min]');
      const maxInput = this.querySelector('[data-price-max]');
      if (minInput) minInput.value = '';
      if (maxInput) maxInput.value = '';
      this.renderChips();
    }
  }

  if (!customElements.get('collection-filterbar-{{ ai_gen_id }}')) {
    customElements.define('collection-filterbar-{{ ai_gen_id }}', KapisaInlineFilter{{ ai_gen_id }});
  }
})();
</script>

