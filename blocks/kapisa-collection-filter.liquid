            </div>

            <!-- 3. Price Filter -->
            <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
              <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
                <span>Price</span>
                <svg class="kapisa-filter-{{ ai_gen_id }}__group-arrow" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div class="kapisa-filter-{{ ai_gen_id }}__dropdown" data-filter-dropdown>
                <div class="kapisa-filter-{{ ai_gen_id }}__price">
                  <div class="kapisa-filter-{{ ai_gen_id }}__price-presets">
                    <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-chip" data-price-preset data-min="" data-max="2000">Under ₹2k</button>
                    <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-chip" data-price-preset data-min="2000" data-max="3500">₹2k–₹3.5k</button>
                    <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-chip" data-price-preset data-min="3500" data-max="5000">₹3.5k–₹5k</button>
                    <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-chip" data-price-preset data-min="5000" data-max="">₹5k+</button>
                  </div>
                  <div class="kapisa-filter-{{ ai_gen_id }}__price-inputs">
                    <div class="kapisa-filter-{{ ai_gen_id }}__price-input-wrap">
                      <span>₹</span>
                      <input type="number" data-price-min placeholder="Min" min="0" aria-label="Minimum price">
                    </div>
                    <div class="kapisa-filter-{{ ai_gen_id }}__price-input-wrap">
                      <span>₹</span>
                      <input type="number" data-price-max placeholder="Max" min="0" aria-label="Maximum price">
                    </div>
                  </div>
                </div>
                <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-apply" data-apply-price>Apply Price</button>
              </div>
            </div>

            <!-- 4. Availability Filter -->
            <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
              <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
                <span>Availability</span>
                <svg class="kapisa-filter-{{ ai_gen_id }}__group-arrow" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div class="kapisa-filter-{{ ai_gen_id }}__dropdown" data-filter-dropdown>
                <div class="kapisa-filter-{{ ai_gen_id }}__options">
                  <label class="kapisa-filter-{{ ai_gen_id }}__option">
                    <input type="checkbox" data-filter-type="availability" value="in_stock">
                    <span class="kapisa-filter-{{ ai_gen_id }}__checkbox"></span>
                    <span>In Stock</span>
