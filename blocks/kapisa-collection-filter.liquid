            {% endcomment %}

            <!-- 1. Colour Filter -->
            <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
              <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
                <span>Colour</span>
