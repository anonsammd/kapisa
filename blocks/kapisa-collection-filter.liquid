                        <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-chip" data-price-preset data-min="" data-max="2000">Under ₹2k</button>
                        <button type="button" class="kapisa-filter-{{ ai_gen_id }}__price-chip" data-price-preset data-min="2000" data-max="3500">₹2k–₹3.5k</button>
