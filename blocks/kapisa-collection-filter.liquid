                  <label class="kapisa-filter-{{ ai_gen_id }}__option">
                    <input type="checkbox" data-filter-type="color" value="Blue">
                    <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #1B3B6F;"></span>
                    <span>Navy Blue</span>
                  </label>
                  <label class="kapisa-filter-{{ ai_gen_id }}__option">
                    <input type="checkbox" data-filter-type="color" value="Green">
                    <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #1B4942;"></span>
                    <span>Hunter Green</span>
                  </label>
                  <label class="kapisa-filter-{{ ai_gen_id }}__option">
                    <input type="checkbox" data-filter-type="color" value="Red">
                    <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #4A1525;"></span>
                    <span>Burgundy</span>
                  </label>
                  <label class="kapisa-filter-{{ ai_gen_id }}__option">
                    <input type="checkbox" data-filter-type="color" value="Grey">
                    <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #40464D;"></span>
                    <span>Slate Grey</span>
                  </label>
                  <label class="kapisa-filter-{{ ai_gen_id }}__option">
                    <input type="checkbox" data-filter-type="color" value="Pastel">
                    <span class="kapisa-filter-{{ ai_gen_id }}__color-swatch" style="background-color: #756B98;"></span>
                    <span>Pastel Lavender</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- 2. Size Filter -->
            <div class="kapisa-filter-{{ ai_gen_id }}__group" data-filter-group>
              <button type="button" class="kapisa-filter-{{ ai_gen_id }}__group-button" data-group-toggle>
                <span>Size</span>
                <svg class="kapisa-filter-{{ ai_gen_id }}__group-arrow" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div class="kapisa-filter-{{ ai_gen_id }}__dropdown" data-filter-dropdown>
                <div class="kapisa-filter-{{ ai_gen_id }}__options">
                  {% assign sizes_list = 'XS,S,M,L,XL,2XL' | split: ',' %}
                  {% for sz in sizes_list %}
                    <label class="kapisa-filter-{{ ai_gen_id }}__option">
                      <input type="checkbox" data-filter-type="size" value="{{ sz }}">
                      <span class="kapisa-filter-{{ ai_gen_id }}__checkbox"></span>
                      <span>{{ sz }}</span>
