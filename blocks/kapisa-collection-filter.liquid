{% comment %}
  KAPISA — Luxury Inline Collection Filter & Mobile Native Sheet
  - Modern sticky app-like filter bar with pill active badges
  - Native bottom-sheet drawer on mobile with swipe/drag aesthetics
  - Full client-side & URL-synchronized filtering
  - Preserves all standard Shopify faceted and fallback filtering hooks
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .kapisa-filter-{{ ai_gen_id }} {
    width: 100%;
    background: #FAF7F0;
    color: #0E1F3C;
    border-bottom: 1px solid rgba(14, 31, 60, 0.08);
    position: sticky;
    top: 0;
    z-index: 45;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}.is-sticky {
    background: rgba(250, 247, 240, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(14, 31, 60, 0.06);
  }

  .kapisa-filter-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 14px 28px;
    box-sizing: border-box;
  }

  /* MAIN STRIP */
  .kapisa-filter-{{ ai_gen_id }}__bar {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .kapisa-filter-{{ ai_gen_id }}__left {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  /* FILTER BUTTON */
  .kapisa-filter-{{ ai_gen_id }}__filter-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid rgba(14, 31, 60, 0.16);
    background: #FFFFFF;
    color: #0E1F3C;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(14, 31, 60, 0.04);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kapisa-filter-{{ ai_gen_id }}__filter-button:hover,
  .kapisa-filter-{{ ai_gen_id }}__filter-button.is-active {
    background: #0E1F3C;
    color: #FAF7F0;
    border-color: #0E1F3C;
    box-shadow: 0 4px 12px rgba(14, 31, 60, 0.12);
  }

  .kapisa-filter-{{ ai_gen_id }}__filter-button svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: #C9A227;
  }

  .kapisa-filter-{{ ai_gen_id }}__filter-button.is-active svg {
    color: #FAF7F0;
  }

  .kapisa-filter-{{ ai_gen_id }}__active-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: #C9A227;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
  }

  .kapisa-filter-{{ ai_gen_id }}__count {
    color: #64748B;
    font-size: 13px;
    white-space: nowrap;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* SORT */
  .kapisa-filter-{{ ai_gen_id }}__sort {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    color: #64748B;
    font-size: 13px;
    font-weight: 600;
  }

  .kapisa-filter-{{ ai_gen_id }}__sort-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .kapisa-filter-{{ ai_gen_id }}__sort select {
    appearance: none;
    -webkit-appearance: none;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 999px;
    background-color: #FFFFFF;
    color: #0E1F3C;
    padding: 8px 30px 8px 14px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(14, 31, 60, 0.03);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__sort select:focus {
    outline: none;
    border-color: #C9A227;
    box-shadow: 0 0 0 2px rgba(201, 162, 39, 0.2);
  }

  .kapisa-filter-{{ ai_gen_id }}__sort-arrow {
    position: absolute;
    right: 12px;
    pointer-events: none;
    width: 10px;
    height: 10px;
    color: #64748B;
  }

  /* DESKTOP INLINE FILTER PANEL */
  .kapisa-filter-{{ ai_gen_id }}__panel {
    display: none;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(14, 31, 60, 0.08);
    animation: kapisaFilterOpen-{{ ai_gen_id }} 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kapisa-filter-{{ ai_gen_id }}__panel.is-open {
    display: block;
  }

  @keyframes kapisaFilterOpen-{{ ai_gen_id }} {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kapisa-filter-{{ ai_gen_id }}__filter-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* INDIVIDUAL FILTER GROUP */
  .kapisa-filter-{{ ai_gen_id }}__group {
    position: relative;
  }

  .kapisa-filter-{{ ai_gen_id }}__group-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 8px 14px;
    border: 1px solid rgba(14, 31, 60, 0.12);
    background: #FFFFFF;
    color: #0E1F3C;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__group-button:hover,
  .kapisa-filter-{{ ai_gen_id }}__group-button.is-active {
    border-color: #C9A227;
    background: #FFFFFF;
    box-shadow: 0 3px 10px rgba(14, 31, 60, 0.06);
  }

  .kapisa-filter-{{ ai_gen_id }}__group-arrow {
    width: 8px;
    height: 8px;
    color: #64748B;
    transition: transform 0.2s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__group-button.is-active .kapisa-filter-{{ ai_gen_id }}__group-arrow {
    transform: rotate(180deg);
  }

  /* FILTER DROPDOWN (DESKTOP) */
  .kapisa-filter-{{ ai_gen_id }}__dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 60;
    width: 280px;
    max-height: 380px;
    padding: 16px;
    overflow-y: auto;
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.08);
    border-radius: 16px;
    box-shadow: 0 16px 38px rgba(14, 31, 60, 0.12);
    display: none;
    animation: kapisaDropdownFade-{{ ai_gen_id }} 0.18s ease;
  }

  @keyframes kapisaDropdownFade-{{ ai_gen_id }} {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kapisa-filter-{{ ai_gen_id }}__dropdown.is-open {
    display: block;
  }

  .kapisa-filter-{{ ai_gen_id }}__options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kapisa-filter-{{ ai_gen_id }}__option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 28px;
    color: #0E1F3C;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__checkbox {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border: 1.5px solid #CBD5E1;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    transition: all 0.15s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__option input:checked + .kapisa-filter-{{ ai_gen_id }}__checkbox {
    background: #0E1F3C;
    border-color: #0E1F3C;
  }

  .kapisa-filter-{{ ai_gen_id }}__option input:checked + .kapisa-filter-{{ ai_gen_id }}__checkbox::after {
    content: '';
    width: 5px;
    height: 9px;
    border: solid #FFFFFF;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) translate(-1px, -1px);
  }

  /* COLOR SWATCH */
  .kapisa-filter-{{ ai_gen_id }}__color-swatch {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgba(14, 31, 60, 0.15);
    background: #F1F5F9;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__option input:checked + .kapisa-filter-{{ ai_gen_id }}__color-swatch {
    outline: 2px solid #C9A227;
    outline-offset: 2px;
    transform: scale(1.12);
  }

  /* PRICE */
  .kapisa-filter-{{ ai_gen_id }}__price {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-chip {
    padding: 5px 9px;
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    color: #0E1F3C;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-chip:hover,
  .kapisa-filter-{{ ai_gen_id }}__price-chip.is-active {
    background: #0E1F3C;
    color: #FAF7F0;
    border-color: #0E1F3C;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-input-wrap span {
    position: absolute;
    left: 10px;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
    pointer-events: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__price input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 8px 8px 24px;
    border: 1px solid rgba(14, 31, 60, 0.15);
    background: #F8FAFC;
    color: #0E1F3C;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
  }

  .kapisa-filter-{{ ai_gen_id }}__price input:focus {
    outline: none;
    border-color: #C9A227;
    background: #FFFFFF;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-apply {
    width: 100%;
    margin-top: 4px;
    padding: 9px;
    border: 0;
    background: #0E1F3C;
    color: #FAF7F0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__price-apply:hover {
    background: #C9A227;
    color: #0E1F3C;
  }

  /* ACTIVE FILTER CHIPS */
  .kapisa-filter-{{ ai_gen_id }}__active {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    padding-top: 10px;
  }

  .kapisa-filter-{{ ai_gen_id }}__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 999px;
    color: #0E1F3C;
    font-size: 12px;
    font-weight: 600;
    box-shadow: 0 2px 5px rgba(14, 31, 60, 0.04);
  }

  .kapisa-filter-{{ ai_gen_id }}__chip-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border: 0;
    padding: 0;
    background: rgba(14, 31, 60, 0.06);
    border-radius: 50%;
    color: #64748B;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__chip-remove:hover {
    background: #DC2626;
    color: #FFFFFF;
  }

  .kapisa-filter-{{ ai_gen_id }}__clear {
    padding: 4px 8px;
    border: 0;
    background: transparent;
    color: #C9A227;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .kapisa-filter-{{ ai_gen_id }}__clear:hover {
    color: #0E1F3C;
    text-decoration: underline;
  }

  /* MOBILE NATIVE BOTTOM SHEET */
  .kapisa-filter-{{ ai_gen_id }}__mobile-backdrop {
    display: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__mobile-head {
    display: none;
  }

  .kapisa-filter-{{ ai_gen_id }}__mobile-footer {
    display: none;
  }

  @media (max-width: 749px) {
    .kapisa-filter-{{ ai_gen_id }}__inner {
      padding: 10px 16px;
    }

    .kapisa-filter-{{ ai_gen_id }}__bar {
      min-height: 40px;
      gap: 10px;
    }

    .kapisa-filter-{{ ai_gen_id }}__count {
      font-size: 12px;
    }

    .kapisa-filter-{{ ai_gen_id }}__sort label {
      display: none;
    }

    .kapisa-filter-{{ ai_gen_id }}__sort select {
      padding: 6px 26px 6px 12px;
      font-size: 12px;
    }

    /* Transform Panel into Native iOS / Android Sheet */
    .kapisa-filter-{{ ai_gen_id }}__panel {
      position: fixed;
      inset: 0;
      z-index: 99999;
      display: none;
      flex-direction: column;
      justify-content: flex-end;
      background: rgba(14, 31, 60, 0.45);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      margin: 0;
      padding: 0;
      border: 0;
    }

    .kapisa-filter-{{ ai_gen_id }}__panel.is-open {
      display: flex;
    }

    .kapisa-filter-{{ ai_gen_id }}__mobile-backdrop {
      display: block;
      position: absolute;
      inset: 0;
    }

    .kapisa-filter-{{ ai_gen_id }}__sheet-container {
      position: relative;
      z-index: 2;
      width: 100%;
      max-height: 82vh;
      background: #FAF7F0;
      border-radius: 24px 24px 0 0;
      box-shadow: 0 -12px 40px rgba(14, 31, 60, 0.22);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      animation: kapisaSheetUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes kapisaSheetUp {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }

    /* Top Drag Handle Notch */
    .kapisa-filter-{{ ai_gen_id }}__drag-handle {
      width: 40px;
      height: 4px;
      border-radius: 999px;
      background: #CBD5E1;
      margin: 10px auto 4px;
    }

    .kapisa-filter-{{ ai_gen_id }}__mobile-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 20px 14px;
      border-bottom: 1px solid rgba(14, 31, 60, 0.08);
    }

    .kapisa-filter-{{ ai_gen_id }}__mobile-title {
      margin: 0;
      font-size: 16px;
      font-weight: 700;
      color: #0E1F3C;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .kapisa-filter-{{ ai_gen_id }}__mobile-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .kapisa-filter-{{ ai_gen_id }}__mobile-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 0;
      background: rgba(14, 31, 60, 0.06);
      color: #0E1F3C;
      cursor: pointer;
    }

    .kapisa-filter-{{ ai_gen_id }}__filter-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 16px 20px;
      overflow-y: auto;
      max-height: calc(82vh - 150px);
      -webkit-overflow-scrolling: touch;
    }

    .kapisa-filter-{{ ai_gen_id }}__group {
      width: 100%;
      border-bottom: 1px solid rgba(14, 31, 60, 0.06);
      padding-bottom: 14px;
    }

    .kapisa-filter-{{ ai_gen_id }}__group-button {
      width: 100%;
      justify-content: space-between;
      border: 0;
      background: transparent;
      padding: 6px 0;
      font-size: 14px;
      font-weight: 700;
    }

    .kapisa-filter-{{ ai_gen_id }}__dropdown {
      position: static;
      display: block !important;
      width: 100%;
      max-height: none;
      padding: 10px 0 4px;
      border: 0;
      box-shadow: none;
      background: transparent;
    }

    .kapisa-filter-{{ ai_gen_id }}__options {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .kapisa-filter-{{ ai_gen_id }}__option {
      min-height: 36px;
      padding: 6px 10px;
      background: #FFFFFF;
      border: 1px solid rgba(14, 31, 60, 0.08);
      border-radius: 8px;
    }

    /* Mobile Sheet Footer CTA */
    .kapisa-filter-{{ ai_gen_id }}__mobile-footer {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 20px calc(14px + env(safe-area-inset-bottom, 0px));
      background: #FFFFFF;
      border-top: 1px solid rgba(14, 31, 60, 0.08);
      box-shadow: 0 -4px 16px rgba(14, 31, 60, 0.04);
    }

    .kapisa-filter-{{ ai_gen_id }}__mobile-apply-btn {
      flex: 1;
      height: 48px;
      border: 0;
      background: #0E1F3C;
      color: #FAF7F0;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.04em;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
    }

    .kapisa-filter-{{ ai_gen_id }}__mobile-apply-btn:active {
      transform: scale(0.98);
    }
  }
{% endstyle %}

<collection-filterbar-{{ ai_gen_id }}
  class="kapisa-filter-{{ ai_gen_id }} collection-filter-bar"
  {{ block.shopify_attributes }}
>
  <div class="kapisa-filter-{{ ai_gen_id }}__inner">

    <!-- MAIN STRIP -->
    <div class="kapisa-filter-{{ ai_gen_id }}__bar">
      <div class="kapisa-filter-{{ ai_gen_id }}__left">
        <button
          type="button"
          class="kapisa-filter-{{ ai_gen_id }}__filter-button"
          data-filter-toggle
          aria-expanded="false"
          aria-label="Open filter menu"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
            <line x1="11" y1="18" x2="13" y2="18"></line>
          </svg>
          <span>Filters</span>
          <span class="kapisa-filter-{{ ai_gen_id }}__active-count" data-filter-badge style="display: none;">0</span>
        </button>

        <span class="kapisa-filter-{{ ai_gen_id }}__count" data-product-count>
          {{ collection.products_count }} products
        </span>
      </div>

      <!-- SORT -->
      <div class="kapisa-filter-{{ ai_gen_id }}__sort">
        <label for="kapisa-sort-{{ ai_gen_id }}">Sort by</label>
        <div class="kapisa-filter-{{ ai_gen_id }}__sort-wrap">
          <select id="kapisa-sort-{{ ai_gen_id }}" name="sort_by" data-sort aria-label="Sort products">
            {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
            <option value="best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Newest</option>
          </select>
          <svg class="kapisa-filter-{{ ai_gen_id }}__sort-arrow" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- FILTER PANEL (DESKTOP INLINE / MOBILE NATIVE BOTTOM SHEET) -->
    <div class="kapisa-filter-{{ ai_gen_id }}__panel" data-filter-panel>
      <div class="kapisa-filter-{{ ai_gen_id }}__mobile-backdrop" data-sheet-backdrop></div>
      
      <div class="kapisa-filter-{{ ai_gen_id }}__sheet-container">
        <div class="kapisa-filter-{{ ai_gen_id }}__drag-handle"></div>

        <div class="kapisa-filter-{{ ai_gen_id }}__mobile-head">
          <h3 class="kapisa-filter-{{ ai_gen_id }}__mobile-title">
            <span>Filter & Refine</span>
            <span class="kapisa-filter-{{ ai_gen_id }}__active-count" data-filter-badge-mobile style="display: none;">0</span>
          </h3>
          <div class="kapisa-filter-{{ ai_gen_id }}__mobile-actions">
            <button type="button" class="kapisa-filter-{{ ai_gen_id }}__clear" data-mobile-clear>Reset</button>
            <button type="button" class="kapisa-filter-{{ ai_gen_id }}__mobile-close" data-mobile-close aria-label="Close filters">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
