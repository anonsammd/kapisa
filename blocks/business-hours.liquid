{% doc %}
  @prompt
    Create a premium Business Hours section for Kapisa Healthcare.
    
    Use warm cream #FAF7F0 as the background. Use deep navy #0E1F3C for the heading and charcoal #2B2B2E for the schedule. Use gold #C9A227 for a small clock SVG icon and accent line.
    
    Desktop: create a centered card with maximum width 700px. Add the heading “When You Can Reach Us” and display the weekly business hours in a clean two-column layout: day on the left and hours on the right. Use 16px rounded corners and 28px padding.
    
    Mobile: use 20px horizontal padding. Make the card full width and use 22px padding. Keep each day approximately 48px tall so it is easy to read on a phone.
    
    Add a small optional note below the schedule for holidays or special closures.
    
    Shopify settings:
    Allow merchants to edit the heading, seven daily schedules, and optional note.
    
    Animation:
    Use a subtle fade-up reveal. Respect reduced-motion preferences.
    
    Return complete Shopify Liquid, responsive CSS, accessible HTML, and valid schema.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hours-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: #FAF7F0;
    padding: 56px 20px;
  }

  .ai-hours-{{ ai_gen_id }}__card {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 700px;
    margin: 0 auto;
    padding: 28px;
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 16px;
    box-shadow: 0 12px 30px rgba(14, 31, 60, 0.08);
    color: #2B2B2E;
    opacity: 0;
    transform: translateY(16px);
    animation: ai-hours-reveal-{{ ai_gen_id }} 700ms ease-out 100ms forwards;
  }

  .ai-hours-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 18px;
    border-bottom: 2px solid #C9A227;
  }

  .ai-hours-{{ ai_gen_id }}__icon {
    width: 25px;
    height: 25px;
    flex: 0 0 25px;
    color: #C9A227;
  }

  .ai-hours-{{ ai_gen_id }}__heading {
    margin: 0;
    color: #0E1F3C;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-hours-{{ ai_gen_id }}__schedule {
    margin: 10px 0 0;
  }

  .ai-hours-{{ ai_gen_id }}__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid rgba(14, 31, 60, 0.1);
    font-size: 16px;
    line-height: 1.4;
  }

  .ai-hours-{{ ai_gen_id }}__row:last-child {
    border-bottom: 0;
  }

  .ai-hours-{{ ai_gen_id }}__day {
    font-weight: 700;
    color: #0E1F3C;
  }

  .ai-hours-{{ ai_gen_id }}__time {
    text-align: right;
    color: #2B2B2E;
  }

  .ai-hours-{{ ai_gen_id }}__note {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid rgba(14, 31, 60, 0.1);
    color: #2B2B2E;
    font-size: 14px;
    line-height: 1.5;
  }

  @keyframes ai-hours-reveal-{{ ai_gen_id }} {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-hours-{{ ai_gen_id }}__card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hours-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-hours-{{ ai_gen_id }}__card {
      width: 100%;
      padding: 22px;
    }

    .ai-hours-{{ ai_gen_id }}__heading {
      font-size: 24px;
    }
  }
{% endstyle %}

<div class="ai-hours-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hours-{{ ai_gen_id }}__card">
    <div class="ai-hours-{{ ai_gen_id }}__header">
      <svg class="ai-hours-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
      <h2 class="ai-hours-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    </div>
    <div class="ai-hours-{{ ai_gen_id }}__schedule" role="list" aria-label="Business hours">
      {% assign days = 'monday,tuesday,wednesday,thursday,friday,saturday,sunday' | split: ',' %}
      {% assign labels = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ',' %}
      {% for day in days %}
        {% assign day_index = forloop.index0 %}
        {% assign day_label = labels[day_index] %}
        {% assign hours_key = day | append: '_hours' %}
        <div class="ai-hours-{{ ai_gen_id }}__row" role="listitem">
          <span class="ai-hours-{{ ai_gen_id }}__day">{{ day_label }}</span>
          <span class="ai-hours-{{ ai_gen_id }}__time">{{ block.settings[hours_key] | escape }}</span>
        </div>
      {% endfor %}
    </div>
    {% if block.settings.note != blank %}
      <p class="ai-hours-{{ ai_gen_id }}__note">{{ block.settings.note | escape | newline_to_br }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Business hours",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"When You Can Reach Us"},
    {"type":"header","content":"Daily schedule"},
    {"type":"text","id":"monday_hours","label":"Monday","default":"9:00 AM – 5:00 PM"},
    {"type":"text","id":"tuesday_hours","label":"Tuesday","default":"9:00 AM – 5:00 PM"},
    {"type":"text","id":"wednesday_hours","label":"Wednesday","default":"9:00 AM – 5:00 PM"},
    {"type":"text","id":"thursday_hours","label":"Thursday","default":"9:00 AM – 5:00 PM"},
    {"type":"text","id":"friday_hours","label":"Friday","default":"9:00 AM – 5:00 PM"},
    {"type":"text","id":"saturday_hours","label":"Saturday","default":"Closed"},
    {"type":"text","id":"sunday_hours","label":"Sunday","default":"Closed"},
    {"type":"textarea","id":"note","label":"Note","default":"Hours may vary on holidays. Please contact us for special closures."},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}
  ],
  "presets": [{"name":"Business hours"}],
  "tag": null,
  "class": "business-hours-block"
}
{% endschema %}