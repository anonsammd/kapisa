{% doc %}
  Elevated Business Hours section for Kapisa Healthcare.
  Features real-time clinic status radar (Open/After-Hours), interactive multi-timezone switcher
  (EST, CST, PST, GMT), emergency priority line footnote, and responsive clinical luxury styling.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hours-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: #FAF7F0;
    padding: clamp(56px, 6vw, 92px) 24px;
    position: relative;
    overflow: hidden;
  }

  .ai-hours-{{ ai_gen_id }}__card {
    width: {{ block.settings.desktop_width_percent | default: 100 }}%;
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 44px);
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.1);
    border-radius: 20px;
    box-shadow: 0 16px 40px rgba(14, 31, 60, 0.06);
    color: #2B2B2E;
    box-sizing: border-box;
    position: relative;
  }

  /* Live Radar Status Beacon */
  .ai-hours-{{ ai_gen_id }}__status-beacon {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #FAF7F0;
    border: 1px solid rgba(14, 31, 60, 0.08);
    border-radius: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-hours-{{ ai_gen_id }}__status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #0E1F3C;
    letter-spacing: 0.04em;
  }

  .ai-hours-{{ ai_gen_id }}__beacon-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #059669;
    box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.25);
    animation: ai-hours-pulse-{{ ai_gen_id }} 2s infinite;
  }

  .ai-hours-{{ ai_gen_id }}__beacon-dot.is-closed {
    background: #D97706;
    box-shadow: 0 0 0 2px rgba(217, 119, 6, 0.25);
  }

  .ai-hours-{{ ai_gen_id }}__local-clock {
    font-size: 11px;
    font-weight: 600;
    color: #64748B;
  }

  /* Header */
  .ai-hours-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 20px;
    border-bottom: 2px solid #C9A227;
    margin-bottom: 20px;
  }

  .ai-hours-{{ ai_gen_id }}__icon {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    color: #C9A227;
  }

  .ai-hours-{{ ai_gen_id }}__heading {
    margin: 0;
    color: #0E1F3C;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 2.5vw, 30px);
    line-height: 1.2;
    font-weight: 400;
  }

  /* Timezone Switcher */
  .ai-hours-{{ ai_gen_id }}__tz-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .ai-hours-{{ ai_gen_id }}__tz-label {
    font-size: 12px;
    font-weight: 700;
    color: #0E1F3C;
    margin-right: 4px;
  }

  .ai-hours-{{ ai_gen_id }}__tz-btn {
    background: #FAF7F0;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .ai-hours-{{ ai_gen_id }}__tz-btn.is-active,
  .ai-hours-{{ ai_gen_id }}__tz-btn:hover {
    background: #0E1F3C;
    color: #FAF7F0;
    border-color: #0E1F3C;
  }

  /* Schedule Table */
  .ai-hours-{{ ai_gen_id }}__schedule {
    margin: 0;
  }

  .ai-hours-{{ ai_gen_id }}__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid rgba(14, 31, 60, 0.08);
    font-size: 15px;
    line-height: 1.4;
    transition: background 150ms ease;
    padding: 0 8px;
    border-radius: 6px;
  }

  .ai-hours-{{ ai_gen_id }}__row:hover {
    background: rgba(14, 31, 60, 0.02);
  }

  .ai-hours-{{ ai_gen_id }}__row.is-today {
    background: rgba(201, 162, 39, 0.08);
    font-weight: 700;
  }

  .ai-hours-{{ ai_gen_id }}__day {
    font-weight: 700;
    color: #0E1F3C;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-hours-{{ ai_gen_id }}__today-pill {
    font-size: 9px;
    font-weight: 800;
    background: #C9A227;
    color: #0E1F3C;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .ai-hours-{{ ai_gen_id }}__time {
    text-align: right;
    color: #475569;
  }

  .ai-hours-{{ ai_gen_id }}__note {
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 1px solid rgba(14, 31, 60, 0.1);
    font-size: 13px;
    color: #64748B;
    line-height: 1.6;
  }

  .ai-hours-{{ ai_gen_id }}__emergency-callout {
    margin-top: 16px;
    padding: 12px 16px;
    background: rgba(14, 31, 60, 0.03);
    border-left: 3px solid #C9A227;
    border-radius: 4px;
    font-size: 13px;
    color: #0E1F3C;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-hours-{{ ai_gen_id }}__emergency-link {
    font-weight: 700;
    color: #0E1F3C;
    text-decoration: underline;
  }

  @keyframes ai-hours-pulse-{{ ai_gen_id }} {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.5); }
    70% { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(5, 150, 105, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
  }

  @media screen and (max-width: 749px) {
    .ai-hours-{{ ai_gen_id }} {
      padding: 44px 20px;
    }
    .ai-hours-{{ ai_gen_id }}__card {
      padding: 22px 16px;
    }
  }
{% endstyle %}

<section class="ai-hours-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hours-{{ ai_gen_id }}__card">
    
    <!-- Live Clinic Concierge Status -->
    <div class="ai-hours-{{ ai_gen_id }}__status-beacon">
      <div class="ai-hours-{{ ai_gen_id }}__status-indicator">
        <span class="ai-hours-{{ ai_gen_id }}__beacon-dot" id="hours-beacon-{{ ai_gen_id }}" aria-hidden="true"></span>
        <span id="hours-status-text-{{ ai_gen_id }}">Concierge Desk Open Now</span>
      </div>
      <div class="ai-hours-{{ ai_gen_id }}__local-clock" id="hours-clock-display-{{ ai_gen_id }}">
        HQ Time (Eastern): --:-- --
      </div>
    </div>

    <!-- Header -->
    <div class="ai-hours-{{ ai_gen_id }}__header">
      <svg class="ai-hours-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <h2 class="ai-hours-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    </div>

    <!-- Interactive Timezone Switcher -->
    <div class="ai-hours-{{ ai_gen_id }}__tz-bar">
      <span class="ai-hours-{{ ai_gen_id }}__tz-label">Timezone:</span>
      <button type="button" class="ai-hours-{{ ai_gen_id }}__tz-btn is-active" data-tz="EST" data-diff="0">EST (New York)</button>
      <button type="button" class="ai-hours-{{ ai_gen_id }}__tz-btn" data-tz="CST" data-diff="-1">CST (Chicago)</button>
      <button type="button" class="ai-hours-{{ ai_gen_id }}__tz-btn" data-tz="PST" data-diff="-3">PST (Los Angeles)</button>
      <button type="button" class="ai-hours-{{ ai_gen_id }}__tz-btn" data-tz="GMT" data-diff="5">GMT (London)</button>
    </div>

    <!-- Schedule Table -->
    <div class="ai-hours-{{ ai_gen_id }}__schedule" role="table" aria-label="Business Hours">
      
      <div class="ai-hours-{{ ai_gen_id }}__row" data-day="1" role="row">
        <div class="ai-hours-{{ ai_gen_id }}__day" role="cell">Monday</div>
        <div class="ai-hours-{{ ai_gen_id }}__time" id="day-mon-{{ ai_gen_id }}" role="cell">{{ block.settings.monday_hours | escape }}</div>
      </div>

      <div class="ai-hours-{{ ai_gen_id }}__row" data-day="2" role="row">
        <div class="ai-hours-{{ ai_gen_id }}__day" role="cell">Tuesday</div>
        <div class="ai-hours-{{ ai_gen_id }}__time" id="day-tue-{{ ai_gen_id }}" role="cell">{{ block.settings.tuesday_hours | escape }}</div>
      </div>

      <div class="ai-hours-{{ ai_gen_id }}__row" data-day="3" role="row">
        <div class="ai-hours-{{ ai_gen_id }}__day" role="cell">Wednesday</div>
        <div class="ai-hours-{{ ai_gen_id }}__time" id="day-wed-{{ ai_gen_id }}" role="cell">{{ block.settings.wednesday_hours | escape }}</div>
      </div>

      <div class="ai-hours-{{ ai_gen_id }}__row" data-day="4" role="row">
        <div class="ai-hours-{{ ai_gen_id }}__day" role="cell">Thursday</div>
        <div class="ai-hours-{{ ai_gen_id }}__time" id="day-thu-{{ ai_gen_id }}" role="cell">{{ block.settings.thursday_hours | escape }}</div>
      </div>

      <div class="ai-hours-{{ ai_gen_id }}__row" data-day="5" role="row">
        <div class="ai-hours-{{ ai_gen_id }}__day" role="cell">Friday</div>
        <div class="ai-hours-{{ ai_gen_id }}__time" id="day-fri-{{ ai_gen_id }}" role="cell">{{ block.settings.friday_hours | escape }}</div>
      </div>

      <div class="ai-hours-{{ ai_gen_id }}__row" data-day="6" role="row">
        <div class="ai-hours-{{ ai_gen_id }}__day" role="cell">Saturday</div>
        <div class="ai-hours-{{ ai_gen_id }}__time" id="day-sat-{{ ai_gen_id }}" role="cell">{{ block.settings.saturday_hours | escape }}</div>
      </div>

      <div class="ai-hours-{{ ai_gen_id }}__row" data-day="0" role="row">
        <div class="ai-hours-{{ ai_gen_id }}__day" role="cell">Sunday</div>
        <div class="ai-hours-{{ ai_gen_id }}__time" id="day-sun-{{ ai_gen_id }}" role="cell">{{ block.settings.sunday_hours | escape }}</div>
      </div>

    </div>

    {% if block.settings.note != blank %}
      <p class="ai-hours-{{ ai_gen_id }}__note">{{ block.settings.note | escape }}</p>
    {% endif %}

    <!-- Urgent Hospital Surgery Order Priority -->
    <div class="ai-hours-{{ ai_gen_id }}__emergency-callout">
      <span>Urgent hospital or surgical team order?</span>
      <a href="https://wa.me/18001234567" target="_blank" rel="noopener" class="ai-hours-{{ ai_gen_id }}__emergency-link">
        Chat with On-Call Concierge &rarr;
      </a>
    </div>

  </div>
</section>

<script>
  (function() {
    const root = document.querySelector('.ai-hours-{{ ai_gen_id }}');
    if (!root) return;

    // Highlight today
    const now = new Date();
    const currentDay = now.getDay();
    const rows = root.querySelectorAll('.ai-hours-{{ ai_gen_id }}__row');
    rows.forEach(r => {
      if (parseInt(r.dataset.day, 10) === currentDay) {
        r.classList.add('is-today');
        const dayCell = r.querySelector('.ai-hours-{{ ai_gen_id }}__day');
        if (dayCell && !dayCell.querySelector('.ai-hours-{{ ai_gen_id }}__today-pill')) {
          const pill = document.createElement('span');
          pill.className = 'ai-hours-{{ ai_gen_id }}__today-pill';
          pill.textContent = 'Today';
          dayCell.appendChild(pill);
        }
      }
    });

    // Live clock and status in EST
    const clockDisplay = document.getElementById('hours-clock-display-{{ ai_gen_id }}');
    const beacon = document.getElementById('hours-beacon-{{ ai_gen_id }}');
    const statusText = document.getElementById('hours-status-text-{{ ai_gen_id }}');

    function updateLiveClock() {
      const options = { timeZone: 'America/New_York', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
      const estTimeStr = new Intl.DateTimeFormat([], options).format(new Date());
      if (clockDisplay) clockDisplay.textContent = 'HQ Time (Eastern): ' + estTimeStr;

      // Check weekday 9am to 5pm in EST
      const estHours = parseInt(new Intl.DateTimeFormat([], { timeZone: 'America/New_York', hour: 'numeric', hour12: false }).format(new Date()), 10);
      const estDay = new Date(new Date().toLocaleString("en-US", { timeZone: "America/New_York" })).getDay();

      const isOpen = (estDay >= 1 && estDay <= 5) && (estHours >= 9 && estHours < 17);
      if (beacon) {
        beacon.classList.toggle('is-closed', !isOpen);
      }
      if (statusText) {
        statusText.textContent = isOpen ? 'Concierge Desk Open Now' : 'After-Hours (Inquiries Monitored)';
      }
    }

    updateLiveClock();
    setInterval(updateLiveClock, 30000);

    // Timezone conversion simulation
    const tzBtns = root.querySelectorAll('.ai-hours-{{ ai_gen_id }}__tz-btn');
    const tzData = {
      EST: { weekday: "9:00 AM – 5:00 PM", weekend: "Closed" },
      CST: { weekday: "8:00 AM – 4:00 PM", weekend: "Closed" },
      PST: { weekday: "6:00 AM – 2:00 PM", weekend: "Closed" },
      GMT: { weekday: "2:00 PM – 10:00 PM", weekend: "Closed" }
    };

    // Cache merchant configured hours on load so EST restores exact customizer settings
    const baseHours = {
      mon: document.getElementById('day-mon-{{ ai_gen_id }}') ? document.getElementById('day-mon-{{ ai_gen_id }}').textContent.trim() : '9:00 AM – 5:00 PM',
      tue: document.getElementById('day-tue-{{ ai_gen_id }}') ? document.getElementById('day-tue-{{ ai_gen_id }}').textContent.trim() : '9:00 AM – 5:00 PM',
      wed: document.getElementById('day-wed-{{ ai_gen_id }}') ? document.getElementById('day-wed-{{ ai_gen_id }}').textContent.trim() : '9:00 AM – 5:00 PM',
      thu: document.getElementById('day-thu-{{ ai_gen_id }}') ? document.getElementById('day-thu-{{ ai_gen_id }}').textContent.trim() : '9:00 AM – 5:00 PM',
      fri: document.getElementById('day-fri-{{ ai_gen_id }}') ? document.getElementById('day-fri-{{ ai_gen_id }}').textContent.trim() : '9:00 AM – 5:00 PM',
      sat: document.getElementById('day-sat-{{ ai_gen_id }}') ? document.getElementById('day-sat-{{ ai_gen_id }}').textContent.trim() : 'Closed',
      sun: document.getElementById('day-sun-{{ ai_gen_id }}') ? document.getElementById('day-sun-{{ ai_gen_id }}').textContent.trim() : 'Closed'
    };

    tzBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tzBtns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const tz = btn.dataset.tz;
        if (tz === 'EST') {
          // Restore exact merchant configured values
          ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'].forEach(d => {
            const el = document.getElementById('day-' + d + '-{{ ai_gen_id }}');
            if (el && baseHours[d]) el.textContent = baseHours[d];
          });
        } else if (tzData[tz]) {
          ['mon', 'tue', 'wed', 'thu', 'fri'].forEach(d => {
            const el = document.getElementById('day-' + d + '-{{ ai_gen_id }}');
            if (el) {
              const orig = baseHours[d].toLowerCase();
              if (orig === 'closed') {
                el.textContent = 'Closed';
              } else {
                el.textContent = tzData[tz].weekday;
              }
            }
          });
          ['sat', 'sun'].forEach(d => {
            const el = document.getElementById('day-' + d + '-{{ ai_gen_id }}');
            if (el) {
              const orig = baseHours[d].toLowerCase();
              if (orig === 'closed') {
                el.textContent = 'Closed';
              } else {
                el.textContent = baseHours[d] + ' (' + tz + ')';
              }
            }
          });
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Business hours",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "When You Can Reach Us" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Schedule" },
    { "type": "text", "id": "monday_hours", "label": "Monday", "default": "9:00 AM – 5:00 PM" },
    { "type": "text", "id": "tuesday_hours", "label": "Tuesday", "default": "9:00 AM – 5:00 PM" },
    { "type": "text", "id": "wednesday_hours", "label": "Wednesday", "default": "9:00 AM – 5:00 PM" },
    { "type": "text", "id": "thursday_hours", "label": "Thursday", "default": "9:00 AM – 5:00 PM" },
    { "type": "text", "id": "friday_hours", "label": "Friday", "default": "9:00 AM – 5:00 PM" },
    { "type": "text", "id": "saturday_hours", "label": "Saturday", "default": "Closed" },
    { "type": "text", "id": "sunday_hours", "label": "Sunday", "default": "Closed" },
    { "type": "header", "content": "Note" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Hours may vary on holidays. Please contact us for special closures." }
  ],
  "presets": [{ "name": "Business hours" }],
  "tag": null,
  "class": "business-hours-block"
}
{% endschema %}