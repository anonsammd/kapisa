{% doc %}
  @prompt
    Build a premium, responsive **Shopify collection product grid** for KAPISA.
    Matches homepage luxury card UI with signature fit badge and Shopify review summaries,
    hover flip image, interactive swatches, clinical fabric pills, and Quick Add.
    Includes instant client-side color & facet filtering, seamless URL synchronization.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .kapisa-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: #FAF7F0;
    color: #0E1F3C;
    padding: 36px 24px 64px;
    box-sizing: border-box;
  }

  .kapisa-collection-{{ ai_gen_id }}__grid {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 24px;
  }

  /* LUXURY PRODUCT CARD */
  .kapisa-product-{{ ai_gen_id }} {
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(14, 31, 60, 0.08);
    box-shadow: 0 10px 30px -10px rgba(14, 31, 60, 0.05);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
  }

  .kapisa-product-{{ ai_gen_id }}:hover {
    transform: translateY(-6px);
    box-shadow: 0 22px 45px -12px rgba(14, 31, 60, 0.12);
    border-color: rgba(201, 162, 39, 0.4);
  }

  /* MEDIA WRAPPER & HOVER FLIP */
  .kapisa-product-{{ ai_gen_id }}__media-wrap {
    position: relative;
    width: 100%;
    background: #FFFFFF;
    overflow: hidden;
  }

  .kapisa-product-{{ ai_gen_id }}__media {
    position: relative;
    aspect-ratio: 1 / 1.15;
    overflow: hidden;
    background: #F8FAFC;
    border-radius: 20px 20px 0 0;
    display: block;
    width: 100%;
  }

  .kapisa-product-{{ ai_gen_id }}__image,
  .kapisa-product-{{ ai_gen_id }}__hover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  .kapisa-product-{{ ai_gen_id }}__hover-image {
    opacity: 0;
  }

  .kapisa-product-{{ ai_gen_id }}:hover .kapisa-product-{{ ai_gen_id }}__image {
    transform: scale(1.05);
  }

  .kapisa-product-{{ ai_gen_id }}:hover .kapisa-product-{{ ai_gen_id }}__hover-image {
    opacity: 1;
    transform: scale(1.05);
  }

  .kapisa-product-{{ ai_gen_id }}__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* SIGNATURE FIT BADGE */
  .kapisa-product-{{ ai_gen_id }}__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: rgba(14, 31, 60, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #FAF7F0;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid rgba(201, 162, 39, 0.35);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .kapisa-product-{{ ai_gen_id }}__badge-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #C9A227;
    box-shadow: 0 0 6px rgba(201, 162, 39, 0.8);
  }

  /* SALE / BESTSELLER BADGE */
  .kapisa-product-{{ ai_gen_id }}__badge-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    background: #C9A227;
    color: #0E1F3C;
    padding: 3.5px 8px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* QUICK VIEW HOVER PILL */
  .kapisa-product-{{ ai_gen_id }}__quick-view {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    opacity: 0;
    visibility: hidden;
    background: #FFFFFF;
    color: #0E1F3C;
    border: 1px solid rgba(14, 31, 60, 0.12);
    border-radius: 999px;
    padding: 7px 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 0 8px 24px rgba(14, 31, 60, 0.15);
    white-space: nowrap;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 3;
    pointer-events: none;
    text-decoration: none;
  }

  .kapisa-product-{{ ai_gen_id }}:hover .kapisa-product-{{ ai_gen_id }}__quick-view {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* QUICK ADD BUTTON */
  .kapisa-product-{{ ai_gen_id }}__quick-add {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    z-index: 4;
    padding: 10px 14px;
    border: 0;
    background: #0E1F3C;
    color: #FAF7F0;
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.22s ease, transform 0.22s ease, background 0.2s ease;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(14, 31, 60, 0.18);
  }

  .kapisa-product-{{ ai_gen_id }}__quick-add:hover {
    background: #C9A227;
    color: #0E1F3C;
  }

  .kapisa-product-{{ ai_gen_id }}:hover .kapisa-product-{{ ai_gen_id }}__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  /* CARD BODY */
  .kapisa-product-{{ ai_gen_id }}__body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* RATING METRIC ROW */
  .kapisa-product-{{ ai_gen_id }}__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }

  .kapisa-product-{{ ai_gen_id }}__stars {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: rgba(245, 166, 35, 0.08);
    padding: 2.5px 7px;
    border-radius: 999px;
    color: #D97706;
  }

  .kapisa-product-{{ ai_gen_id }}__stars svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .kapisa-product-{{ ai_gen_id }}__rating-text {
    font-size: 11px;
    color: #475569;
    font-weight: 700;
    margin-left: 2px;
  }

  .kapisa-product-{{ ai_gen_id }}__review-count {
    font-size: 11px;
    color: #94A3B8;
    font-weight: 600;
  }

  /* TITLE */
  .kapisa-product-{{ ai_gen_id }}__title {
    margin: 2px 0 6px;
    color: #0E1F3C;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.015em;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .kapisa-product-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .kapisa-product-{{ ai_gen_id }}__title a:hover {
    color: #C9A227;
  }

  /* PRICE & SWATCHES ROW */
  .kapisa-product-{{ ai_gen_id }}__price-swatch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 4px;
  }

  .kapisa-product-{{ ai_gen_id }}__price {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: baseline;
    color: #0E1F3C;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .kapisa-product-{{ ai_gen_id }}__compare {
    color: #8FA3B8;
    text-decoration: line-through;
    font-weight: 500;
    font-size: 13px;
  }

  /* COLOR SWATCHES */
  .kapisa-product-{{ ai_gen_id }}__swatches {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 18px;
  }

  .kapisa-product-{{ ai_gen_id }}__swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(14, 31, 60, 0.15);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
    display: inline-block;
  }

  .kapisa-product-{{ ai_gen_id }}__swatch:hover {
    transform: scale(1.22);
    box-shadow: 0 0 0 2px #C9A227;
  }

  .kapisa-product-{{ ai_gen_id }}__more-swatches {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    margin-left: 1px;
  }

  /* CLINICAL FEATURE PILLS */
  .kapisa-product-{{ ai_gen_id }}__features {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #F1F5F9;
    flex-wrap: wrap;
  }

  .kapisa-product-{{ ai_gen_id }}__pill {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 7px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 600;
    color: #475569;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .kapisa-product-{{ ai_gen_id }}__pill svg {
    width: 10px;
    height: 10px;
    color: #C9A227;
    flex-shrink: 0;
  }

  /* LOAD MORE BUTTON */
  .kapisa-collection-{{ ai_gen_id }}__more-wrap {
    display: flex;
    justify-content: center;
    padding-top: 48px;
  }

  .kapisa-collection-{{ ai_gen_id }}__more {
    padding: 13px 32px;
    border: 1.5px solid #0E1F3C;
    background: transparent;
    color: #0E1F3C;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(14, 31, 60, 0.04);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kapisa-collection-{{ ai_gen_id }}__more:hover {
    background: #0E1F3C;
    color: #FAF7F0;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(14, 31, 60, 0.12);
  }

  .kapisa-collection-{{ ai_gen_id }}__more[hidden] {
    display: none;
  }

  /* EMPTY STATE */
  .kapisa-collection-{{ ai_gen_id }}__empty {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 380px;
    padding: 80px 20px;
    text-align: center;
    width: 100%;
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px dashed rgba(14, 31, 60, 0.15);
  }

  .kapisa-collection-{{ ai_gen_id }}__empty-icon {
    width: 52px;
    height: 52px;
    margin-bottom: 20px;
    color: #8FA3B8;
  }

  .kapisa-collection-{{ ai_gen_id }}__empty-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .kapisa-collection-{{ ai_gen_id }}__empty-title {
    margin: 0;
    color: #0E1F3C;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
  }

  .kapisa-collection-{{ ai_gen_id }}__empty-text {
    margin: 8px 0 24px;
    color: #64748B;
    font-size: 14px;
    line-height: 1.5;
  }

  .kapisa-collection-{{ ai_gen_id }}__clear {
    padding: 11px 24px;
    border: 1px solid #C9A227;
    background: #C9A227;
    color: #0E1F3C;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    cursor: pointer;
    text-decoration: none;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .kapisa-collection-{{ ai_gen_id }}__clear:hover {
    background: #0E1F3C;
    color: #FAF7F0;
    border-color: #0E1F3C;
  }

  /* RESPONSIVE LAYOUTS */
  @media (max-width: 1200px) {
    .kapisa-collection-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px 18px;
    }
  }

  @media (max-width: 749px) {
    .kapisa-collection-{{ ai_gen_id }} {
      padding: 16px 12px 48px;
    }

    .kapisa-collection-{{ ai_gen_id }}__grid {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 10px;
    }

    .kapisa-product-{{ ai_gen_id }} {
      border-radius: 14px;
    }

    .kapisa-product-{{ ai_gen_id }}__media {
      border-radius: 14px 14px 0 0;
      aspect-ratio: 1 / 1.18;
    }

    .kapisa-product-{{ ai_gen_id }}__badge {
      top: 8px;
      left: 8px;
      padding: 3px 7px;
      font-size: 8px;
    }

    .kapisa-product-{{ ai_gen_id }}__body {
      padding: 10px 10px 12px;
    }

    .kapisa-product-{{ ai_gen_id }}__title {
      font-size: 13px;
      margin: 2px 0 4px;
    }

    .kapisa-product-{{ ai_gen_id }}__price {
      font-size: 13px;
    }

    .kapisa-product-{{ ai_gen_id }}__features {
      display: none; /* Keep mobile cards clean and compact */
    }

    .kapisa-product-{{ ai_gen_id }}__quick-view {
      display: none;
    }

    .kapisa-product-{{ ai_gen_id }}__quick-add {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kapisa-product-{{ ai_gen_id }},
    .kapisa-product-{{ ai_gen_id }}__image,
    .kapisa-product-{{ ai_gen_id }}__hover-image,
    .kapisa-product-{{ ai_gen_id }}__quick-add,
    .kapisa-product-{{ ai_gen_id }}__quick-view {
      transition: none !important;
    }
  }
{% endstyle %}

<kapisa-collection-grid-{{ ai_gen_id }} class="kapisa-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }} data-section-id="{{ section.id }}">
  {% paginate collection.products by block.settings.products_per_page %}
    <div class="kapisa-collection-{{ ai_gen_id }}__empty" data-empty-state style="display: {% if collection.products_count == 0 %}flex{% else %}none{% endif %};">
      <div class="kapisa-collection-{{ ai_gen_id }}__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="21" cy="21" r="12"></circle>
          <path d="m30 30 9 9M16 21h10"></path>
        </svg>
      </div>
      <h2 class="kapisa-collection-{{ ai_gen_id }}__empty-title">No scrubs match your current filters</h2>
      <p class="kapisa-collection-{{ ai_gen_id }}__empty-text">Try removing some filter choices or adjusting your criteria.</p>
      <a class="kapisa-collection-{{ ai_gen_id }}__clear" href="{{ collection.url }}" data-clear-filters>Clear All Filters</a>
    </div>

    <div class="kapisa-collection-{{ ai_gen_id }}__grid" data-grid style="display: {% if collection.products_count == 0 %}none{% else %}grid{% endif %};">
      {% for product in collection.products %}
        {%- liquid
          assign first_image = product.images | first
          assign second_image = product.images[1]
          assign badge = blank
          if product.tags contains 'Bestseller' or product.tags contains 'bestseller'
            assign badge = 'Bestseller'
          elsif product.tags contains 'New' or product.tags contains 'new'
            assign badge = 'New'
          endif

          assign prod_colors = ''
          for option in product.options_with_values
            assign opt_name = option.name | downcase
            if opt_name contains 'color' or opt_name contains 'colour'
              for val in option.values
                assign val_clean = val | downcase | strip
                assign prod_colors = prod_colors | append: val_clean | append: ','
              endfor
            endif
          endfor

          assign prod_sizes = ''
          for option in product.options_with_values
            assign opt_name = option.name | downcase
            if opt_name contains 'size'
              for val in option.values
                assign val_clean = val | downcase | strip
                assign prod_sizes = prod_sizes | append: val_clean | append: ','
              endfor
            endif
          endfor

          assign prod_tags = product.tags | join: ',' | downcase
          assign title_down = product.title | downcase
        -%}
        <article
          class="kapisa-product-{{ ai_gen_id }}"
          data-product-card
          data-product-id="{{ product.id }}"
          data-colors="{{ prod_colors | escape }}"
          data-sizes="{{ prod_sizes | escape }}"
          data-tags="{{ prod_tags | escape }}"
          data-title="{{ title_down | escape }}"
          data-price="{{ product.price }}"
          data-available="{{ product.available }}"
        >
          <div class="kapisa-product-{{ ai_gen_id }}__media-wrap">
            <a href="{{ product.url }}" class="kapisa-product-{{ ai_gen_id }}__media" aria-label="View {{ product.title | escape }}">
              {% if first_image %}
                <img class="kapisa-product-{{ ai_gen_id }}__image" src="{{ first_image | image_url: width: 720 }}" alt="{{ first_image.alt | default: product.title | escape }}" loading="lazy" width="720" height="828">
              {% else %}
                <div class="kapisa-product-{{ ai_gen_id }}__image">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
              {% if second_image %}
                <img class="kapisa-product-{{ ai_gen_id }}__hover-image" src="{{ second_image | image_url: width: 720 }}" alt="{{ second_image.alt | default: product.title | escape }}" loading="lazy" width="720" height="828">
              {% endif %}

              <!-- SIGNATURE FIT BADGE -->
              <span class="kapisa-product-{{ ai_gen_id }}__badge">
                <span class="kapisa-product-{{ ai_gen_id }}__badge-dot"></span>
                Signature Fit
              </span>

              <!-- TAG / DISCOUNT BADGE -->
              {% if product.compare_at_price > product.price %}
                {% assign save_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                <span class="kapisa-product-{{ ai_gen_id }}__badge-tag">SAVE {{ save_percent }}%</span>
              {% elsif badge != blank %}
                <span class="kapisa-product-{{ ai_gen_id }}__badge-tag">{{ badge }}</span>
              {% endif %}

              <!-- QUICK VIEW HOVER PILL -->
              <span class="kapisa-product-{{ ai_gen_id }}__quick-view">Quick View →</span>
            </a>

            <!-- QUICK ADD FORM -->
            {% if product.available %}
              <form method="post" action="{{ routes.cart_add_url }}" data-quick-add-form>
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button class="kapisa-product-{{ ai_gen_id }}__quick-add" type="submit">Quick Add</button>
              </form>
            {% endif %}
          </div>

          <div class="kapisa-product-{{ ai_gen_id }}__body">
            {% assign product_rating = product.metafields.reviews.rating.value %}
            {% assign product_review_count = product.metafields.reviews.rating_count.value | default: 0 %}
            {% if product_rating != blank and product_review_count > 0 %}
            {% assign product_rating_stars = product_rating.rating | floor %}
            <!-- Shopify review summary -->
            <div class="kapisa-product-{{ ai_gen_id }}__meta-row">
              <div class="kapisa-product-{{ ai_gen_id }}__stars" role="img" aria-label="{{ product_rating.rating | round: 1 }} out of {{ product_rating.scale_max }} stars">
                {% for s in (1..product_rating_stars) %}
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                {% endfor %}
                <span class="kapisa-product-{{ ai_gen_id }}__rating-text">{{ product_rating.rating | round: 1 }}</span>
              </div>
              <span class="kapisa-product-{{ ai_gen_id }}__review-count">{{ product_review_count }} reviews</span>
            </div>
            {% endif %}

            <!-- PRODUCT TITLE -->
            <h2 class="kapisa-product-{{ ai_gen_id }}__title">
              <a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title }}</a>
            </h2>

            <!-- PRICE & COLOR SWATCHES ROW -->
            <div class="kapisa-product-{{ ai_gen_id }}__price-swatch-row">
              <div class="kapisa-product-{{ ai_gen_id }}__price">
                <span>{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="kapisa-product-{{ ai_gen_id }}__compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>

              {%- liquid
                assign rel_color_prods = product.metafields.custom.color_family_products.value
                assign card_self_swatch = product.metafields.custom.color_swatch.value | default: product.metafields.custom.color_swatch
              -%}
              {% if rel_color_prods != blank %}
                <div class="kapisa-product-{{ ai_gen_id }}__swatches" aria-label="Available colors">
                  {% for rel in rel_color_prods limit: 4 %}
                    {% assign rel_c = rel.metafields.custom.color_swatch.value | default: rel.metafields.custom.color_swatch %}
                    {% if rel_c == blank %}
                      {% assign r_title = rel.title | downcase %}
                      {% if r_title contains 'navy' or r_title contains 'blue' %}{% assign rel_c = '#0E1F3C' %}
                      {% elsif r_title contains 'black' %}{% assign rel_c = '#18191C' %}
                      {% elsif r_title contains 'olive' or r_title contains 'sage' %}{% assign rel_c = '#556B2F' %}
                      {% elsif r_title contains 'green' or r_title contains 'hunter' %}{% assign rel_c = '#1B4942' %}
                      {% elsif r_title contains 'wine' or r_title contains 'red' or r_title contains 'burgundy' %}{% assign rel_c = '#4A1525' %}
                      {% elsif r_title contains 'grey' or r_title contains 'slate' %}{% assign rel_c = '#5A626A' %}
                      {% elsif r_title contains 'ceil' %}{% assign rel_c = '#6BA4B8' %}
                      {% else %}{% assign rel_c = '#0E1F3C' %}
                      {% endif %}
                    {% endif %}
                    {% assign rel_url = rel.url %}
                    {% if rel_url == blank %}
                      {% assign rel_url = '/products/' | append: rel.handle %}
                    {% endif %}
                    <a href="{{ rel_url }}" class="kapisa-product-{{ ai_gen_id }}__swatch" title="{{ rel.title | escape }}" style="background-color: {{ rel_c }};" aria-label="{{ rel.title | escape }}"></a>
                  {% endfor %}
                  {% if rel_color_prods.size > 4 %}
                    <span class="kapisa-product-{{ ai_gen_id }}__more-swatches">+{{ rel_color_prods.size | minus: 4 }}</span>
                  {% endif %}
                </div>
              {% else %}
                {% assign found_opt = false %}
                {% for option in product.options_with_values %}
                  {% assign opt_name = option.name | downcase %}
                  {% if opt_name contains 'color' or opt_name contains 'colour' %}
                    {% assign found_opt = true %}
                    <div class="kapisa-product-{{ ai_gen_id }}__swatches" aria-label="Available colors">
                      {% for value in option.values limit: 4 %}
                        {% assign color_clean = value | downcase | strip %}
                        {% assign bg_color = '#0E1F3C' %}
                        {% if color_clean contains 'olive' or color_clean contains 'sage' %}{% assign bg_color = '#556B2F' %}
                        {% elsif color_clean contains 'navy' or color_clean contains 'blue' %}{% assign bg_color = '#0E1F3C' %}
                        {% elsif color_clean contains 'black' %}{% assign bg_color = '#18191C' %}
                        {% elsif color_clean contains 'hunter' or color_clean contains 'green' %}{% assign bg_color = '#1B4942' %}
                        {% elsif color_clean contains 'wine' or color_clean contains 'burgundy' %}{% assign bg_color = '#4A1525' %}
                        {% elsif color_clean contains 'grey' or color_clean contains 'slate' %}{% assign bg_color = '#5A626A' %}
                        {% elsif color_clean contains 'ceil' %}{% assign bg_color = '#6BA4B8' %}
                        {% elsif color_clean contains 'pastel' or color_clean contains 'lavender' %}{% assign bg_color = '#756B98' %}
                        {% endif %}
                        <span class="kapisa-product-{{ ai_gen_id }}__swatch" title="{{ value | escape }}" style="background-color: {{ bg_color }};" aria-label="{{ value | escape }}"></span>
                      {% endfor %}
                      {% if option.values.size > 4 %}
                        <span class="kapisa-product-{{ ai_gen_id }}__more-swatches">+{{ option.values.size | minus: 4 }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
                {% unless found_opt %}
                  {% if card_self_swatch != blank %}
                    <div class="kapisa-product-{{ ai_gen_id }}__swatches" aria-label="Available colors">
                      <span class="kapisa-product-{{ ai_gen_id }}__swatch" title="{{ product.title | escape }}" style="background-color: {{ card_self_swatch }};" aria-label="{{ product.title | escape }}"></span>
                    </div>
                  {% endif %}
                {% endunless %}
              {% endif %}
            </div>

            <!-- CLINICAL PERFORMANCE PILLS -->
            <div class="kapisa-product-{{ ai_gen_id }}__features">
              <span class="kapisa-product-{{ ai_gen_id }}__pill">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
                4-Way Stretch
              </span>
              <span class="kapisa-product-{{ ai_gen_id }}__pill">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
                Fluid Repellent
              </span>
              <span class="kapisa-product-{{ ai_gen_id }}__pill">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
                Anti-Odor
              </span>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    {% assign has_next = paginate.next %}
  {% endpaginate %}
  
  <div class="kapisa-collection-{{ ai_gen_id }}__more-wrap">
    <button class="kapisa-collection-{{ ai_gen_id }}__more" type="button" data-load-more {% unless has_next %}hidden{% endunless %}>Load more products</button>
  </div>
</kapisa-collection-grid-{{ ai_gen_id }}>

<script>
(function() {
  const COLOR_FAMILIES = {
    black: ['black', 'noir', 'onyx', 'midnight', 'dark'],
    blue: ['blue', 'navy', 'royal', 'ceil', 'teal', 'cyan', 'sky', 'indigo'],
    green: ['green', 'hunter', 'olive', 'sage', 'mint', 'emerald', 'forest'],
    red: ['red', 'burgundy', 'wine', 'maroon', 'crimson', 'berry', 'ruby'],
    pastel: ['pastel', 'lavender', 'lilac', 'blush', 'peach', 'rose', 'mauve', 'soft', 'pink'],
    grey: ['grey', 'gray', 'slate', 'heather', 'charcoal', 'silver', 'ash'],
    gray: ['grey', 'gray', 'slate', 'heather', 'charcoal', 'silver', 'ash']
  };

  class KapisaCollectionGrid{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.grid = this.querySelector('[data-grid]');
      this.emptyState = this.querySelector('[data-empty-state]');
      this.button = this.querySelector('[data-load-more]');
      this.initialCards = Array.from(this.querySelectorAll('[data-product-card]'));
      this.page = 1;

      if (this.button) {
        this.button.addEventListener('click', () => this.loadMore());
      }

      const clearBtn = this.querySelector('[data-clear-filters]');
      if (clearBtn) {
        clearBtn.addEventListener('click', (e) => {
          e.preventDefault();
          this.clearAllFilters();
        });
      }

      // Quick add form AJAX handling
      this.bindQuickAdd();

      // External event listeners from filter bar
      window.addEventListener('kapisa:filter-change', (e) => {
        this.applyActiveFilters(e.detail);
      });
      window.addEventListener('kapisa:sort-change', (e) => {
        this.applySort(e.detail ? e.detail.sort : 'best-selling');
      });
      window.addEventListener('popstate', () => {
        this.filterFromUrl();
      });

      // Filter immediately on initial page load
      this.filterFromUrl();
    }

    bindQuickAdd() {
      this.querySelectorAll('[data-quick-add-form]').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = form.querySelector('button');
          if (btn.disabled) return;
          const origText = btn.textContent;
          btn.disabled = true;
          btn.textContent = 'Adding...';

          try {
            const formData = new FormData(form);
            const res = await fetch('/cart/add.js', {
              method: 'POST',
              body: formData,
              headers: { 'Accept': 'application/json' }
            });
            if (res.ok) {
              btn.textContent = 'Added ✓';
              // Trigger cart update event across theme
              document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
              window.dispatchEvent(new CustomEvent('kapisa:cart-updated'));
              setTimeout(() => {
                btn.textContent = origText;
                btn.disabled = false;
              }, 1500);
            } else {
              throw new Error('Add failed');
            }
          } catch (err) {
            btn.textContent = 'Error';
            setTimeout(() => {
              btn.textContent = origText;
              btn.disabled = false;
            }, 1500);
          }
        });
      });
    }

    getCards() {
      return Array.from(this.querySelectorAll('[data-product-card]'));
    }

    filterFromUrl() {
      const url = new URL(window.location.href);
      const params = url.searchParams;

      const colors = [];
      const checkParam = (paramName) => {
        params.forEach((val, key) => {
          if (key === paramName || key.startsWith(paramName)) {
            val.split(',').forEach(v => {
              const clean = v.trim().toLowerCase();
              if (clean && !colors.includes(clean)) colors.push(clean);
            });
          }
        });
      };

      checkParam('filter.v.option.color');
      checkParam('filter.v.option.colour');
      checkParam('filter.p.m.custom.color_family');
      checkParam('filter.p.tag');
      checkParam('color');
      checkParam('colour');

      const sizes = [];
      const checkSizeParam = (paramName) => {
        params.forEach((val, key) => {
          if (key === paramName || key.startsWith(paramName)) {
            val.split(',').forEach(v => {
              const clean = v.trim().toLowerCase();
              if (clean && !sizes.includes(clean)) sizes.push(clean);
            });
          }
        });
      };
      checkSizeParam('filter.v.option.size');
      checkSizeParam('size');

      const minPrice = params.get('filter.v.price.gte') || params.get('min_price');
      const maxPrice = params.get('filter.v.price.lte') || params.get('max_price');
      const inStock = params.get('filter.v.availability') === '1' || params.get('availability') === 'in_stock';

      this.applyActiveFilters({
        colors,
        sizes,
        minPrice: minPrice ? parseFloat(minPrice) : null,
        maxPrice: maxPrice ? parseFloat(maxPrice) : null,
        inStock
      });

      const sortBy = params.get('sort_by');
      if (sortBy) {
        this.applySort(sortBy);
      }
    }

    applyActiveFilters(filters = {}) {
      const cards = this.getCards();
      if (!cards.length) return;

      const { colors = [], sizes = [], minPrice = null, maxPrice = null, inStock = false } = filters;
      const hasFilters = (colors && colors.length > 0) || (sizes && sizes.length > 0) || minPrice !== null || maxPrice !== null || inStock;

      let visibleCount = 0;

      cards.forEach(card => {
        let matches = true;

        // 1. Color matching
        if (colors.length > 0) {
          const cardColors = (card.dataset.colors || '').toLowerCase();
          const cardTags = (card.dataset.tags || '').toLowerCase();
          const cardTitle = (card.dataset.title || '').toLowerCase();

          const colorMatches = colors.some(targetColor => {
            let cleanTarget = targetColor.toLowerCase().replace(/all\s+/i, '').trim();
            if (cleanTarget.endsWith('s') && !['burgundy'].includes(cleanTarget)) {
              cleanTarget = cleanTarget.slice(0, -1);
            }
            const family = COLOR_FAMILIES[cleanTarget] || [cleanTarget];

            return family.some(k => 
              cardColors.includes(k) || cardTags.includes(k) || cardTitle.includes(k)
            );
          });

          if (!colorMatches) {
            matches = false;
          }
        }

        // 2. Size matching
        if (matches && sizes.length > 0) {
          const cardSizes = (card.dataset.sizes || '').toLowerCase();
          const availableSizes = cardSizes.split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
          const sizeMatches = sizes.some(targetSize => {
            const clean = targetSize.toLowerCase().trim();
            return availableSizes.includes(clean);
          });
          if (!sizeMatches) {
            matches = false;
          }
        }

        // 3. Price matching
        if (matches && (minPrice !== null || maxPrice !== null)) {
          // Dataset price is in minor units (cents)
          const priceCents = parseFloat(card.dataset.price || '0');
          const priceUnits = priceCents / 100;
          if (minPrice !== null && priceUnits < minPrice) matches = false;
          if (maxPrice !== null && priceUnits > maxPrice) matches = false;
        }

        // 4. In Stock matching
        if (matches && inStock) {
          if (card.dataset.available !== 'true') matches = false;
        }

        if (matches) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Toggle Empty State vs Grid
      if (visibleCount === 0 && hasFilters) {
        if (this.emptyState) this.emptyState.style.display = 'flex';
        if (this.grid) this.grid.style.display = 'none';
        if (this.button) this.button.hidden = true;
      } else {
        if (this.emptyState) this.emptyState.style.display = 'none';
        if (this.grid) this.grid.style.display = 'grid';
      }

      // Update count text across page
      const countString = `${visibleCount} product${visibleCount === 1 ? '' : 's'}`;
      document.querySelectorAll('.kapisa-filter-count, [data-product-count], .collection-filter-bar [class*="__count"]').forEach(el => {
        el.textContent = countString;
      });

      // Notify Filter Bar
      window.dispatchEvent(new CustomEvent('kapisa:filtered-state-updated', {
        detail: { count: visibleCount, hasFilters, filters }
      }));
    }

    applySort(sortBy) {
      if (!this.grid) return;
      const cards = this.getCards();
      if (!cards.length) return;

      if (sortBy === 'price-ascending') {
        cards.sort((a, b) => parseFloat(a.dataset.price || '0') - parseFloat(b.dataset.price || '0'));
      } else if (sortBy === 'price-descending') {
        cards.sort((a, b) => parseFloat(b.dataset.price || '0') - parseFloat(a.dataset.price || '0'));
      } else {
        // Return to natural collection order
        cards.sort((a, b) => this.initialCards.indexOf(a) - this.initialCards.indexOf(b));
      }

      cards.forEach(card => this.grid.appendChild(card));
    }

    clearAllFilters() {
      const url = new URL(window.location.href);
      const toDelete = [];
      url.searchParams.forEach((_, k) => {
        if (k.startsWith('filter.') || k === 'color' || k === 'colour' || k === 'size' || k === 'min_price' || k === 'max_price') {
          toDelete.push(k);
        }
      });
      toDelete.forEach(k => url.searchParams.delete(k));
      history.pushState({}, '', url.toString());

      this.applyActiveFilters({ colors: [], sizes: [], minPrice: null, maxPrice: null, inStock: false });
      window.dispatchEvent(new CustomEvent('kapisa:clear-filters'));
    }

    async loadMore() {
      if (!this.grid || this.button.disabled) return;
      this.button.disabled = true;
      const url = new URL(window.location.href);
      url.searchParams.set('page', this.page + 1);
      url.searchParams.set('section_id', this.dataset.sectionId);
      try {
        const response = await fetch(url);
        const parsed = new DOMParser().parseFromString(await response.text(), 'text/html');
        const nextGrid = parsed.querySelector('[data-grid]');
        if (!nextGrid || !nextGrid.children.length) {
          this.button.hidden = true;
          return;
        }
        Array.from(nextGrid.children).forEach(card => {
          this.grid.appendChild(card);
          this.initialCards.push(card);
        });
        this.page++;
        this.bindQuickAdd();
        this.filterFromUrl();
        const nextButton = parsed.querySelector('[data-load-more]');
        if (!nextButton || nextButton.hasAttribute('hidden')) this.button.hidden = true;
      } catch (error) {
      } finally {
        this.button.disabled = false;
      }
    }
  }

  if (!customElements.get('kapisa-collection-grid-{{ ai_gen_id }}')) {
    customElements.define('kapisa-collection-grid-{{ ai_gen_id }}', KapisaCollectionGrid{{ ai_gen_id }});
  }
})();
</script>

{% schema %}
{
  "name": "Kapisa collection grid",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 40,
      "step": 4,
      "default": 16
    },
    {
      "type": "paragraph",
      "content": "Products are loaded automatically from the current collection."
    }
  ],
  "presets": [
    {
      "name": "Kapisa collection grid"
    }
  ],
  "tag": null,
  "class": "kapisa-collection-grid-block"
}
{% endschema %}
