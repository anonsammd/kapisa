{% doc %}
  @prompt
    Build a premium, responsive **Shopify collection product grid** for KAPISA.
    Includes instant client-side color & facet filtering, seamless URL synchronization,
    and fallback support for when Search & Discovery is unconfigured.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.kapisa-collection-{{ ai_gen_id }}{display:block;width:100%;background:#FAF7F0;color:#2B2B2E;padding:32px 20px 56px}
.kapisa-collection-{{ ai_gen_id }}__grid{width:{{ block.settings.desktop_width_percent }}%;max-width:1600px;margin:0 auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:42px 20px}
.kapisa-product-{{ ai_gen_id }}{min-width:0;display:flex;flex-direction:column}
.kapisa-product-{{ ai_gen_id }}__media{position:relative;aspect-ratio:4/5;overflow:hidden;background:#F0EEE9;border-radius:4px}
.kapisa-product-{{ ai_gen_id }}__image,.kapisa-product-{{ ai_gen_id }}__hover-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 320ms ease,opacity 280ms ease}
.kapisa-product-{{ ai_gen_id }}__hover-image{opacity:0}
.kapisa-product-{{ ai_gen_id }}:hover .kapisa-product-{{ ai_gen_id }}__image{transform:scale(1.035)}
.kapisa-product-{{ ai_gen_id }}:hover .kapisa-product-{{ ai_gen_id }}__hover-image{opacity:0;transform:scale(1.035)}
.kapisa-product-{{ ai_gen_id }}__image svg{width:100%;height:100%;object-fit:cover}
.kapisa-product-{{ ai_gen_id }}__badge{position:absolute;top:12px;left:12px;z-index:2;padding:5px 8px;background:#C9A227;color:#2B2B2E;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-radius:2px}
.kapisa-product-{{ ai_gen_id }}__quick-add{position:absolute;right:12px;bottom:12px;left:12px;z-index:2;padding:11px 14px;border:0;background:#0E1F3C;color:#fff;font:inherit;font-size:12px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;opacity:0;transform:translateY(12px);transition:opacity 220ms ease,transform 220ms ease;border-radius:2px}
.kapisa-product-{{ ai_gen_id }}:hover .kapisa-product-{{ ai_gen_id }}__quick-add{opacity:1;transform:translateY(0)}
.kapisa-product-{{ ai_gen_id }}__info{padding-top:13px;flex:1 0 auto;display:flex;flex-direction:column}
.kapisa-product-{{ ai_gen_id }}__title{display:-webkit-box;overflow:hidden;margin:0 0 6px;color:#2B2B2E;font-size:14px;font-weight:600;line-height:1.35;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.kapisa-product-{{ ai_gen_id }}__title a{color:inherit;text-decoration:none}
.kapisa-product-{{ ai_gen_id }}__title a:hover{color:#C9A227}
.kapisa-product-{{ ai_gen_id }}__price{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;color:#0E1F3C;font-size:14px;font-weight:700}
.kapisa-product-{{ ai_gen_id }}__compare{color:#8FA3B8;text-decoration:line-through;font-weight:400}
.kapisa-product-{{ ai_gen_id }}__swatches{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}
.kapisa-product-{{ ai_gen_id }}__swatch{width:13px;height:13px;border:1px solid rgba(43,43,46,.35);border-radius:50%}
.kapisa-product-{{ ai_gen_id }}__more{color:#8FA3B8;font-size:11px;line-height:13px}
.kapisa-collection-{{ ai_gen_id }}__more-wrap{display:flex;justify-content:center;padding-top:52px}
.kapisa-collection-{{ ai_gen_id }}__more{padding:13px 28px;border:1px solid #0E1F3C;background:transparent;color:#0E1F3C;font:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:all .2s ease}
.kapisa-collection-{{ ai_gen_id }}__more:hover{background:#0E1F3C;color:#FFFFFF}
.kapisa-collection-{{ ai_gen_id }}__more[hidden]{display:none}
.kapisa-collection-{{ ai_gen_id }}__empty{display:none;flex-direction:column;align-items:center;justify-content:center;min-height:360px;padding:80px 20px;text-align:center;width:100%}
.kapisa-collection-{{ ai_gen_id }}__empty-icon{width:48px;height:48px;margin-bottom:24px;color:#8FA3B8}
.kapisa-collection-{{ ai_gen_id }}__empty-icon svg{display:block;width:48px;height:48px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.5}
.kapisa-collection-{{ ai_gen_id }}__empty-title{margin:0;color:#2B2B2E;font-size:18px;font-weight:700;line-height:1.4}
.kapisa-collection-{{ ai_gen_id }}__empty-text{margin:8px 0 24px;color:#8FA3B8;font-size:14px;line-height:1.5}
.kapisa-collection-{{ ai_gen_id }}__clear{padding:12px 22px;border:1px solid #C9A227;background:transparent;color:#2B2B2E;font:inherit;font-size:12px;font-weight:600;letter-spacing:.06em;cursor:pointer;text-decoration:none;transition:background .2s ease}
.kapisa-collection-{{ ai_gen_id }}__clear:hover{background:#C9A227;color:#FFFFFF}
@media(max-width:989px){.kapisa-collection-{{ ai_gen_id }}__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:749px){.kapisa-collection-{{ ai_gen_id }}{padding:24px 12px 44px}.kapisa-collection-{{ ai_gen_id }}__grid{width:100%;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 12px}.kapisa-product-{{ ai_gen_id }}__quick-add{display:none}.kapisa-product-{{ ai_gen_id }}__badge{top:8px;left:8px}.kapisa-collection-{{ ai_gen_id }}__empty{min-height:300px;padding:80px 12px}.kapisa-collection-{{ ai_gen_id }}__empty-title{font-size:17px}}
@media(prefers-reduced-motion:reduce){.kapisa-product-{{ ai_gen_id }}__image,.kapisa-product-{{ ai_gen_id }}__hover-image,.kapisa-product-{{ ai_gen_id }}__quick-add{transition:none}}
{% endstyle %}

<kapisa-collection-grid-{{ ai_gen_id }} class="kapisa-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }} data-section-id="{{ section.id }}">
  {% paginate collection.products by block.settings.products_per_page %}
    <div class="kapisa-collection-{{ ai_gen_id }}__empty" data-empty-state style="display: {% if collection.products_count == 0 %}flex{% else %}none{% endif %};">
      <div class="kapisa-collection-{{ ai_gen_id }}__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48"><circle cx="21" cy="21" r="12"></circle><path d="m30 30 9 9M16 21h10"></path></svg>
      </div>
      <h2 class="kapisa-collection-{{ ai_gen_id }}__empty-title">No products match your filters</h2>
      <p class="kapisa-collection-{{ ai_gen_id }}__empty-text">Try adjusting or clearing your filters.</p>
      <a class="kapisa-collection-{{ ai_gen_id }}__clear" href="{{ collection.url }}" data-clear-filters>Clear All Filters</a>
    </div>

    <div class="kapisa-collection-{{ ai_gen_id }}__grid" data-grid style="display: {% if collection.products_count == 0 %}none{% else %}grid{% endif %};">
      {% for product in collection.products %}
        {%- liquid
          assign first_image = product.images | first
          assign second_image = product.images[1]
          assign badge = blank
          if product.tags contains 'Bestseller' or product.tags contains 'bestseller'
            assign badge = 'Bestseller'
          elsif product.tags contains 'New' or product.tags contains 'new'
            assign badge = 'New'
          endif

          assign prod_colors = ''
          for option in product.options_with_values
            assign opt_name = option.name | downcase
            if opt_name contains 'color' or opt_name contains 'colour'
              for val in option.values
                assign val_clean = val | downcase | strip
                assign prod_colors = prod_colors | append: val_clean | append: ','
              endfor
            endif
          endfor

          assign prod_sizes = ''
          for option in product.options_with_values
            assign opt_name = option.name | downcase
            if opt_name contains 'size'
              for val in option.values
                assign val_clean = val | downcase | strip
                assign prod_sizes = prod_sizes | append: val_clean | append: ','
              endfor
            endif
          endfor

          assign prod_tags = product.tags | join: ',' | downcase
          assign title_down = product.title | downcase
        -%}
        <article
          class="kapisa-product-{{ ai_gen_id }}"
          data-product-card
          data-product-id="{{ product.id }}"
          data-colors="{{ prod_colors | escape }}"
          data-sizes="{{ prod_sizes | escape }}"
          data-tags="{{ prod_tags | escape }}"
          data-title="{{ title_down | escape }}"
          data-price="{{ product.price }}"
          data-available="{{ product.available }}"
        >
          <div class="kapisa-product-{{ ai_gen_id }}__media">
            <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if first_image %}
                <img class="kapisa-product-{{ ai_gen_id }}__image" src="{{ first_image | image_url: width: 900 }}" alt="{{ first_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="1125">
              {% else %}
                <div class="kapisa-product-{{ ai_gen_id }}__image">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
              {% if second_image %}
                <img class="kapisa-product-{{ ai_gen_id }}__hover-image" src="{{ second_image | image_url: width: 900 }}" alt="{{ second_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="1125">
              {% endif %}
            </a>
            {% if badge != blank %}
              <span class="kapisa-product-{{ ai_gen_id }}__badge">{{ badge }}</span>
            {% endif %}
            {% if product.available %}
              <form method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button class="kapisa-product-{{ ai_gen_id }}__quick-add" type="submit">Quick add</button>
              </form>
            {% endif %}
          </div>
          <div class="kapisa-product-{{ ai_gen_id }}__info">
            <h2 class="kapisa-product-{{ ai_gen_id }}__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h2>
            <div class="kapisa-product-{{ ai_gen_id }}__price">
              <span>{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="kapisa-product-{{ ai_gen_id }}__compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
            {%- liquid
              assign rel_color_prods = product.metafields.custom.color_family_products.value
            -%}
            {% if rel_color_prods != blank %}
              <div class="kapisa-product-{{ ai_gen_id }}__swatches" aria-label="Available colors">
                {% for rel in rel_color_prods limit: 5 %}
                  {% assign rel_c = rel.metafields.custom.color_swatch.value %}
                  {% if rel_c == blank %}
                    {% assign r_title = rel.title | downcase %}
                    {% if r_title contains 'navy' or r_title contains 'blue' %}{% assign rel_c = '#1B3B6F' %}
                    {% elsif r_title contains 'black' %}{% assign rel_c = '#18191C' %}
                    {% elsif r_title contains 'green' or r_title contains 'hunter' %}{% assign rel_c = '#1B4942' %}
                    {% elsif r_title contains 'wine' or r_title contains 'red' or r_title contains 'burgundy' %}{% assign rel_c = '#4A1525' %}
                    {% elsif r_title contains 'grey' or r_title contains 'slate' %}{% assign rel_c = '#40464D' %}
                    {% else %}{% assign rel_c = '#1E293B' %}
                    {% endif %}
                  {% endif %}
                  <span class="kapisa-product-{{ ai_gen_id }}__swatch" title="{{ rel.title | escape }}" style="background-color: {{ rel_c }};"></span>
                {% endfor %}
                {% if rel_color_prods.size > 5 %}
                  <span class="kapisa-product-{{ ai_gen_id }}__more">+{{ rel_color_prods.size | minus: 5 }}</span>
                {% endif %}
              </div>
            {% else %}
              {% for option in product.options_with_values %}
                {% assign opt_name = option.name | downcase %}
                {% if opt_name contains 'color' or opt_name contains 'colour' %}
                  <div class="kapisa-product-{{ ai_gen_id }}__swatches" aria-label="Available colors">
                    {% for value in option.values limit: 5 %}
                      <span class="kapisa-product-{{ ai_gen_id }}__swatch" title="{{ value | escape }}" style="background-color: {{ value | escape }};"></span>
                    {% endfor %}
                    {% if option.values.size > 5 %}
                      <span class="kapisa-product-{{ ai_gen_id }}__more">+{{ option.values.size | minus: 5 }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% assign has_next = paginate.next %}
  {% endpaginate %}
  
  <div class="kapisa-collection-{{ ai_gen_id }}__more-wrap">
    <button class="kapisa-collection-{{ ai_gen_id }}__more" type="button" data-load-more {% unless has_next %}hidden{% endunless %}>Load more</button>
  </div>
</kapisa-collection-grid-{{ ai_gen_id }}>

<script>
(function() {
  const COLOR_FAMILIES = {
    black: ['black', 'noir', 'onyx', 'midnight', 'dark'],
    blue: ['blue', 'navy', 'royal', 'ceil', 'teal', 'cyan', 'sky', 'indigo'],
    green: ['green', 'hunter', 'olive', 'sage', 'mint', 'emerald', 'forest'],
    red: ['red', 'burgundy', 'wine', 'maroon', 'crimson', 'berry', 'ruby'],
    pastel: ['pastel', 'lavender', 'lilac', 'blush', 'peach', 'rose', 'mauve', 'soft', 'pink'],
    grey: ['grey', 'gray', 'slate', 'heather', 'charcoal', 'silver', 'ash'],
    gray: ['grey', 'gray', 'slate', 'heather', 'charcoal', 'silver', 'ash']
  };

  class KapisaCollectionGrid{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.grid = this.querySelector('[data-grid]');
      this.emptyState = this.querySelector('[data-empty-state]');
      this.button = this.querySelector('[data-load-more]');
      this.initialCards = Array.from(this.querySelectorAll('[data-product-card]'));
      this.page = 1;

      if (this.button) {
        this.button.addEventListener('click', () => this.loadMore());
      }

      const clearBtn = this.querySelector('[data-clear-filters]');
      if (clearBtn) {
        clearBtn.addEventListener('click', (e) => {
          e.preventDefault();
          this.clearAllFilters();
        });
      }

      // External event listeners from filter bar
      window.addEventListener('kapisa:filter-change', (e) => {
        this.applyActiveFilters(e.detail);
      });
      window.addEventListener('kapisa:sort-change', (e) => {
        this.applySort(e.detail ? e.detail.sort : 'best-selling');
      });
      window.addEventListener('popstate', () => {
        this.filterFromUrl();
      });

      // Filter immediately on initial page load
      this.filterFromUrl();
    }

    getCards() {
      return Array.from(this.querySelectorAll('[data-product-card]'));
    }

    filterFromUrl() {
      const url = new URL(window.location.href);
      const params = url.searchParams;

      const colors = [];
      const checkParam = (paramName) => {
        params.forEach((val, key) => {
          if (key === paramName || key.startsWith(paramName)) {
            val.split(',').forEach(v => {
              const clean = v.trim().toLowerCase();
              if (clean && !colors.includes(clean)) colors.push(clean);
            });
          }
        });
      };

      checkParam('filter.v.option.color');
      checkParam('filter.v.option.colour');
      checkParam('filter.p.m.custom.color_family');
      checkParam('filter.p.tag');
      checkParam('color');
      checkParam('colour');

      const sizes = [];
      const checkSizeParam = (paramName) => {
        params.forEach((val, key) => {
          if (key === paramName || key.startsWith(paramName)) {
            val.split(',').forEach(v => {
              const clean = v.trim().toLowerCase();
              if (clean && !sizes.includes(clean)) sizes.push(clean);
            });
          }
        });
      };
      checkSizeParam('filter.v.option.size');
      checkSizeParam('size');

      const minPrice = params.get('filter.v.price.gte') || params.get('min_price');
      const maxPrice = params.get('filter.v.price.lte') || params.get('max_price');
      const inStock = params.get('filter.v.availability') === '1' || params.get('availability') === 'in_stock';

      this.applyActiveFilters({
        colors,
        sizes,
        minPrice: minPrice ? parseFloat(minPrice) : null,
        maxPrice: maxPrice ? parseFloat(maxPrice) : null,
        inStock
      });

      const sortBy = params.get('sort_by');
      if (sortBy) {
        this.applySort(sortBy);
      }
    }

    applyActiveFilters(filters = {}) {
      const cards = this.getCards();
      if (!cards.length) return;

      const { colors = [], sizes = [], minPrice = null, maxPrice = null, inStock = false } = filters;
      const hasFilters = (colors && colors.length > 0) || (sizes && sizes.length > 0) || minPrice !== null || maxPrice !== null || inStock;

      let visibleCount = 0;

      cards.forEach(card => {
        let matches = true;

        // 1. Color matching
        if (colors.length > 0) {
          const cardColors = (card.dataset.colors || '').toLowerCase();
          const cardTags = (card.dataset.tags || '').toLowerCase();
          const cardTitle = (card.dataset.title || '').toLowerCase();

          const colorMatches = colors.some(targetColor => {
            let cleanTarget = targetColor.toLowerCase().replace(/all\s+/i, '').trim();
            if (cleanTarget.endsWith('s') && !['burgundy'].includes(cleanTarget)) {
              cleanTarget = cleanTarget.slice(0, -1);
            }
            const family = COLOR_FAMILIES[cleanTarget] || [cleanTarget];

            return family.some(k => 
              cardColors.includes(k) || cardTags.includes(k) || cardTitle.includes(k)
            );
          });

          if (!colorMatches) {
            matches = false;
          }
        }

        // 2. Size matching
        if (matches && sizes.length > 0) {
          const cardSizes = (card.dataset.sizes || '').toLowerCase();
          const sizeMatches = sizes.some(targetSize => {
            const clean = targetSize.toLowerCase().trim();
            return cardSizes.includes(clean + ',') || cardSizes.includes(',' + clean) || cardSizes === clean;
          });
          if (!sizeMatches) {
            matches = false;
          }
        }

        // 3. Price matching
        if (matches && (minPrice !== null || maxPrice !== null)) {
          // Dataset price is in minor units (cents)
          const priceCents = parseFloat(card.dataset.price || '0');
          const priceUnits = priceCents / 100;
          if (minPrice !== null && priceUnits < minPrice) matches = false;
          if (maxPrice !== null && priceUnits > maxPrice) matches = false;
        }

        // 4. In Stock matching
        if (matches && inStock) {
          if (card.dataset.available !== 'true') matches = false;
        }

        if (matches) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Toggle Empty State vs Grid
      if (visibleCount === 0 && hasFilters) {
        if (this.emptyState) this.emptyState.style.display = 'flex';
        if (this.grid) this.grid.style.display = 'none';
        if (this.button) this.button.hidden = true;
      } else {
        if (this.emptyState) this.emptyState.style.display = 'none';
        if (this.grid) this.grid.style.display = 'grid';
      }

      // Update count text across page
      const countString = `${visibleCount} product${visibleCount === 1 ? '' : 's'}`;
      document.querySelectorAll('.kapisa-filter-count, [data-product-count], .collection-filter-bar [class*="__count"]').forEach(el => {
        el.textContent = countString;
      });

      // Notify Filter Bar
      window.dispatchEvent(new CustomEvent('kapisa:filtered-state-updated', {
        detail: { count: visibleCount, hasFilters, filters }
      }));
    }

    applySort(sortBy) {
      if (!this.grid) return;
      const cards = this.getCards();
      if (!cards.length) return;

      if (sortBy === 'price-ascending') {
        cards.sort((a, b) => parseFloat(a.dataset.price || '0') - parseFloat(b.dataset.price || '0'));
      } else if (sortBy === 'price-descending') {
        cards.sort((a, b) => parseFloat(b.dataset.price || '0') - parseFloat(a.dataset.price || '0'));
      } else {
        // Return to natural collection order
        cards.sort((a, b) => this.initialCards.indexOf(a) - this.initialCards.indexOf(b));
      }

      cards.forEach(card => this.grid.appendChild(card));
    }

    clearAllFilters() {
      const url = new URL(window.location.href);
      const toDelete = [];
      url.searchParams.forEach((_, k) => {
        if (k.startsWith('filter.') || k === 'color' || k === 'colour' || k === 'size' || k === 'min_price' || k === 'max_price') {
          toDelete.push(k);
        }
      });
      toDelete.forEach(k => url.searchParams.delete(k));
      history.pushState({}, '', url.toString());

      this.applyActiveFilters({ colors: [], sizes: [], minPrice: null, maxPrice: null, inStock: false });
      window.dispatchEvent(new CustomEvent('kapisa:clear-filters'));
    }

    async loadMore() {
      if (!this.grid || this.button.disabled) return;
      this.button.disabled = true;
      const url = new URL(window.location.href);
      url.searchParams.set('page', this.page + 1);
      url.searchParams.set('section_id', this.dataset.sectionId);
      try {
        const response = await fetch(url);
        const parsed = new DOMParser().parseFromString(await response.text(), 'text/html');
        const nextGrid = parsed.querySelector('[data-grid]');
        if (!nextGrid || !nextGrid.children.length) {
          this.button.hidden = true;
          return;
        }
        Array.from(nextGrid.children).forEach(card => {
          this.grid.appendChild(card);
          this.initialCards.push(card);
        });
        this.page++;
        this.filterFromUrl();
        const nextButton = parsed.querySelector('[data-load-more]');
        if (!nextButton || nextButton.hasAttribute('hidden')) this.button.hidden = true;
      } catch (error) {
      } finally {
        this.button.disabled = false;
      }
    }
  }

  if (!customElements.get('kapisa-collection-grid-{{ ai_gen_id }}')) {
    customElements.define('kapisa-collection-grid-{{ ai_gen_id }}', KapisaCollectionGrid{{ ai_gen_id }});
  }
})();
</script>

{% schema %}
{
  "name": "Kapisa collection grid",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 40,
      "step": 4,
      "default": 16
    },
    {
      "type": "paragraph",
      "content": "Products are loaded automatically from the current collection."
    }
  ],
  "presets": [
    {
      "name": "Kapisa collection grid"
    }
  ],
  "tag": null,
  "class": "kapisa-collection-grid-block"
}
{% endschema %}
