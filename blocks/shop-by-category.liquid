{% doc %}
  Kapisa Healthcare - Shop by Category
{% enddoc %}

{% assign id = block.id | replace: '_', '' | downcase %}

{% style %}
  .kapisa-cat-{{ id }} {
    background: {{ block.settings.background }};
    color: {{ block.settings.heading_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .kapisa-cat-inner-{{ id }} {
    width: min(1400px, calc(100% - 40px));
    margin: 0 auto;
  }

  .kapisa-cat-heading-{{ id }} {
    text-align: {{ block.settings.heading_align }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .kapisa-cat-eyebrow-{{ id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: {{ block.settings.accent_color }};
  }

  .kapisa-cat-eyebrow-{{ id }}::before,
  .kapisa-cat-eyebrow-{{ id }}::after {
    content: "";
    width: 24px;
    height: 1px;
    background: {{ block.settings.accent_color }};
  }

  .kapisa-cat-title-{{ id }} {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -.035em;
    font-weight: 500;
  }

  .kapisa-cat-description-{{ id }} {
    max-width: 560px;
    margin: 14px auto 0;
    font-size: 14px;
    line-height: 1.7;
    opacity: .65;
  }

  .kapisa-cat-heading-{{ id }}[data-align="left"] .kapisa-cat-description-{{ id }} {
    margin-left: 0;
  }

  .kapisa-cat-heading-{{ id }}[data-align="right"] .kapisa-cat-description-{{ id }} {
    margin-right: 0;
  }

  .kapisa-cat-grid-{{ id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .kapisa-cat-card-{{ id }} {
    position: relative;
    display: block;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: #dfe3e6;
    border-radius: {{ block.settings.radius }}px;
    aspect-ratio:
      {% case block.settings.card_ratio %}
        {% when 'square' %}1 / 1
        {% when 'portrait' %}4 / 5
        {% else %}3 / 4
      {% endcase %};
  }

  .kapisa-cat-image-{{ id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
    transition: transform .65s cubic-bezier(.2,.65,.2,1);
  }

  .kapisa-cat-overlay-{{ id }} {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(14,31,60,{{ block.settings.overlay | divided_by: 100.0 }}) 0%,
        rgba(14,31,60,.18) 45%,
        rgba(14,31,60,0) 75%
      );
  }

  .kapisa-cat-content-{{ id }} {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px;
    z-index: 2;
  }

  .kapisa-cat-name-{{ id }} {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: {{ block.settings.label_size }}px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -.015em;
  }

  .kapisa-cat-arrow-{{ id }} {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,.45);
    border-radius: 50%;
    font-size: 14px;
    transition: transform .3s ease, background .3s ease;
  }

  .kapisa-cat-line-{{ id }} {
    width: 0;
    height: 2px;
    margin-top: 10px;
    background: {{ block.settings.accent_color }};
    transition: width .35s ease;
  }

  .kapisa-cat-card-{{ id }}:hover .kapisa-cat-image-{{ id }} {
    transform: scale(1.06);
  }

  .kapisa-cat-card-{{ id }}:hover .kapisa-cat-arrow-{{ id }} {
    transform: translateX(4px);
    background: rgba(255,255,255,.12);
  }

  .kapisa-cat-card-{{ id }}:hover .kapisa-cat-line-{{ id }} {
    width: 42px;
  }

  @media screen and (max-width: 989px) {
    .kapisa-cat-grid-{{ id }} {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .kapisa-cat-{{ id }} {
      padding-top: {{ block.settings.mobile_padding }}px;
      padding-bottom: {{ block.settings.mobile_padding }}px;
    }

    .kapisa-cat-inner-{{ id }} {
      width: calc(100% - 28px);
    }

    .kapisa-cat-grid-{{ id }} {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .kapisa-cat-content-{{ id }} {
      padding: 16px;
    }

    .kapisa-cat-name-{{ id }} {
      font-size: 15px;
    }

    .kapisa-cat-arrow-{{ id }} {
      width: 24px;
      height: 24px;
      font-size: 12px;
    }

    .kapisa-cat-description-{{ id }} {
      font-size: 13px;
      line-height: 1.6;
    }
  }
{% endstyle %}

<section
  class="kapisa-cat-{{ id }}"
  {{ block.shopify_attributes }}
>
  <div class="kapisa-cat-inner-{{ id }}">

    {% if block.settings.show_heading %}
      <div
        class="kapisa-cat-heading-{{ id }}"
        data-align="{{ block.settings.heading_align }}"
      >
        {% if block.settings.eyebrow != blank %}
          <div class="kapisa-cat-eyebrow-{{ id }}">
            {{ block.settings.eyebrow }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="kapisa-cat-title-{{ id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="kapisa-cat-description-{{ id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="kapisa-cat-grid-{{ id }}">

      {% for i in (1..6) %}

        {% liquid
          assign enabled_key = 'category_' | append: i | append: '_enabled'
          assign image_key = 'category_' | append: i | append: '_image'
          assign name_key = 'category_' | append: i | append: '_name'
          assign link_key = 'category_' | append: i | append: '_link'

          assign enabled = block.settings[enabled_key]
          assign image = block.settings[image_key]
          assign name = block.settings[name_key]
          assign link = block.settings[link_key]
        %}

        {% if enabled %}
          <a
            href="{{ link | default: '#' }}"
            class="kapisa-cat-card-{{ id }}"
            {% if name != blank %}
              aria-label="{{ name | escape }}"
            {% endif %}
          >

            {% if image != blank %}

              <img
                src="{{ image | image_url: width: 1200 }}"
                srcset="
                  {{ image | image_url: width: 400 }} 400w,
                  {{ image | image_url: width: 600 }} 600w,
                  {{ image | image_url: width: 800 }} 800w,
                  {{ image | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 749px) 50vw, 25vw"
                alt="{{ name | escape }}"
                loading="lazy"
                class="kapisa-cat-image-{{ id }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >

            {% else %}

              {{ 'image' | placeholder_svg_tag: 'kapisa-cat-image-' | append: id }}

            {% endif %}

            <div class="kapisa-cat-overlay-{{ id }}"></div>

            <div class="kapisa-cat-content-{{ id }}">

              {% if name != blank %}
                <div class="kapisa-cat-name-{{ id }}">
                  <span>{{ name }}</span>
                  <span class="kapisa-cat-arrow-{{ id }}">↗</span>
                </div>

                <div class="kapisa-cat-line-{{ id }}"></div>
              {% endif %}

            </div>

          </a>
        {% endif %}

      {% endfor %}

    </div>

  </div>
</section>

