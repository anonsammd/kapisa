{% doc %}
  @prompt
    Kapisa Healthcare - Shop by Category (Knya Med Style)
    A clean, high-conversion horizontal pill card & grid category discovery section
    with model photos, category names, badges, and responsive carousel navigation.
{% enddoc %}

{% assign id = block.id | replace: '_', '' | downcase %}

{% style %}
  .kapisa-cat-section-{{ id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background | default: '#FAF9F6' }};
    padding: {{ block.settings.padding_top | default: 48 }}px 0 {{ block.settings.padding_bottom | default: 48 }}px;
    font-family: inherit;
    color: {{ block.settings.heading_color | default: '#0E1F3C' }};
  }

  .kapisa-cat-inner-{{ id }} {
    width: min(1360px, calc(100% - 40px));
    margin: 0 auto;
  }

  .kapisa-cat-heading-{{ id }} {
    margin-bottom: {{ block.settings.heading_spacing | default: 24 }}px;
    text-align: {{ block.settings.heading_align | default: 'left' }};
  }

  .kapisa-cat-eyebrow-{{ id }} {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ block.settings.accent_color | default: '#C9A227' }};
    margin-bottom: 6px;
  }

  .kapisa-cat-title-{{ id }} {
    margin: 0;
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 700;
    line-height: 1.2;
    color: {{ block.settings.heading_color | default: '#0E1F3C' }};
    letter-spacing: -0.02em;
  }

  .kapisa-cat-desc-{{ id }} {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: #64748B;
  }

  /* Pill Cards Row (Knya Med Style) */
  .kapisa-cat-pills-{{ id }} {
    display: flex;
    align-items: center;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 6px;
  }

  .kapisa-cat-pills-{{ id }}::-webkit-scrollbar {
    display: none;
  }

  .kapisa-cat-pill-{{ id }} {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.08);
    border-radius: 12px;
    padding: 8px 18px 8px 10px;
    text-decoration: none;
    color: {{ block.settings.heading_color | default: '#0E1F3C' }};
    box-shadow: 0 2px 8px rgba(14, 31, 60, 0.04);
    transition: all 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    scroll-snap-align: start;
    cursor: pointer;
  }

  .kapisa-cat-pill-{{ id }}:hover {
    transform: translateY(-2px);
    border-color: rgba(14, 31, 60, 0.2);
    box-shadow: 0 6px 16px rgba(14, 31, 60, 0.09);
  }

  .kapisa-cat-pill-img-{{ id }} {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    overflow: hidden;
    background: #F1F5F9;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kapisa-cat-pill-img-{{ id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .kapisa-cat-pill-info-{{ id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .kapisa-cat-pill-name-{{ id }} {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .kapisa-cat-badge-{{ id }} {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: #DC2626;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .kapisa-cat-section-{{ id }} {
      padding: {{ block.settings.mobile_padding | default: 32 }}px 0;
    }

    .kapisa-cat-inner-{{ id }} {
      width: 100%;
      padding: 0 16px;
    }

    .kapisa-cat-pill-{{ id }} {
      padding: 6px 14px 6px 8px;
      gap: 10px;
    }

    .kapisa-cat-pill-img-{{ id }} {
      width: 38px;
      height: 38px;
    }

    .kapisa-cat-pill-name-{{ id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

<section class="kapisa-cat-section-{{ id }}" {{ block.shopify_attributes }}>
  <div class="kapisa-cat-inner-{{ id }}">
    
    {% if block.settings.show_heading %}
      <div class="kapisa-cat-heading-{{ id }}">
        {% if block.settings.eyebrow != blank %}
          <span class="kapisa-cat-eyebrow-{{ id }}">{{ block.settings.eyebrow | escape }}</span>
        {% endif %}
        {% if block.settings.heading != blank %}
          <h2 class="kapisa-cat-title-{{ id }}">{{ block.settings.heading | escape }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <p class="kapisa-cat-desc-{{ id }}">{{ block.settings.description | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Horizontal Category Pills -->
    <div class="kapisa-cat-pills-{{ id }}">

      {% for i in (1..8) %}
        {% liquid
          assign enabled_key = 'category_' | append: i | append: '_enabled'
          assign image_key = 'category_' | append: i | append: '_image'
          assign name_key = 'category_' | append: i | append: '_name'
          assign link_key = 'category_' | append: i | append: '_link'
          assign badge_key = 'category_' | append: i | append: '_badge'

          assign enabled = block.settings[enabled_key]
          assign image = block.settings[image_key]
          assign name = block.settings[name_key]
          assign link = block.settings[link_key]
          assign badge = block.settings[badge_key]
        %}

        {% if enabled and name != blank %}
          <a href="{{ link | default: '/collections/all' }}" class="kapisa-cat-pill-{{ id }}" aria-label="{{ name | escape }}">
            <div class="kapisa-cat-pill-img-{{ id }}">
              {% if image != blank %}
                <img src="{{ image | image_url: width: 120 }}" alt="{{ name | escape }}" loading="lazy" width="120" height="120">
              {% else %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.accent_color | default: '#C9A227' }}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10a2 2 0 002 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
                </svg>
              {% endif %}
            </div>
            <div class="kapisa-cat-pill-info-{{ id }}">
              <span class="kapisa-cat-pill-name-{{ id }}">{{ name | escape }}</span>
              {% if badge != blank %}
                <span class="kapisa-cat-badge-{{ id }}">{{ badge | escape }}</span>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}

    </div>

  </div>
</section>

