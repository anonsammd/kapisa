{% assign accordion_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* Make the entire Shopify section use the same off-white background */
  .shopify-section:has(.kapisa-details-{{ accordion_id }}) {
    background: #FAF7F0;
    margin: 0 !important;
    padding: 0 !important;
  }

  .kapisa-details-{{ accordion_id }} {
    display: block;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(36px, 4vw, 56px) 24px;
    background: #FAF7F0;
    color: #2B2B2E;
    box-sizing: border-box;
  }

  .kapisa-details-{{ accordion_id }}__heading {
    margin: 0 0 24px;
    color: #0E1F3C;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .kapisa-details-{{ accordion_id }}__item {
    border-top: 1px solid rgba(14, 31, 60, 0.12);
  }

  .kapisa-details-{{ accordion_id }}__item:last-child {
    border-bottom: 1px solid rgba(14, 31, 60, 0.12);
  }

  .kapisa-details-{{ accordion_id }}__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 64px;
    padding: 18px 0;
    border: 0;
    background: transparent;
    color: #2B2B2E;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .kapisa-details-{{ accordion_id }}__button:focus-visible {
    outline: 2px solid #C9A227;
    outline-offset: 4px;
  }

  .kapisa-details-{{ accordion_id }}__icon {
    position: relative;
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    border: 1px solid #C9A227;
    border-radius: 50%;
  }

  .kapisa-details-{{ accordion_id }}__icon::before,
  .kapisa-details-{{ accordion_id }}__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1px;
    background: #C9A227;
    transform: translate(-50%, -50%);
    transition: transform 180ms ease;
  }

  .kapisa-details-{{ accordion_id }}__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .kapisa-details-{{ accordion_id }}__item.is-open
  .kapisa-details-{{ accordion_id }}__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .kapisa-details-{{ accordion_id }}__panel {
    height: 0;
    overflow: hidden;
    transition: height 240ms ease;
  }

  .kapisa-details-{{ accordion_id }}__content {
    padding: 0 38px 22px 0;
    color: #2B2B2E;
    font-size: 14px;
    line-height: 1.7;
  }

  .kapisa-details-{{ accordion_id }}__content p {
    margin: 0 0 12px;
  }

  .kapisa-details-{{ accordion_id }}__content p:last-child {
    margin-bottom: 0;
  }

  .kapisa-details-{{ accordion_id }}__content ul,
  .kapisa-details-{{ accordion_id }}__content ol {
    margin: 0 0 12px;
    padding-left: 20px;
  }

  @media screen and (max-width: 749px) {
    .kapisa-details-{{ accordion_id }} {
      margin: 0 auto;
      padding: 22px 16px;
    }

    .kapisa-details-{{ accordion_id }}__heading {
      font-size: 21px;
    }

    .kapisa-details-{{ accordion_id }}__button {
      min-height: 58px;
      padding: 16px 0;
      font-size: 14px;
    }

    .kapisa-details-{{ accordion_id }}__content {
      padding-right: 30px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kapisa-details-{{ accordion_id }}__panel,
    .kapisa-details-{{ accordion_id }}__icon::before,
    .kapisa-details-{{ accordion_id }}__icon::after {
      transition: none;
    }
  }
{% endstyle %}

<div
  class="kapisa-details-{{ accordion_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="kapisa-details-{{ accordion_id }}__heading">
      {{ block.settings.heading | escape }}
    </h2>
  {% endif %}

  {% assign sections = 'fabric,care,fit,shipping' | split: ',' %}

  {% for section_key in sections %}
    {% assign title_key = section_key | append: '_title' %}
    {% assign content_key = section_key | append: '_content' %}
    {% assign title = block.settings[title_key] %}
    {% assign content = block.settings[content_key] %}
    {% if section_key == 'fabric' and product.metafields.custom.fabric_details != blank %}
      {% assign content = product.metafields.custom.fabric_details.value | default: product.metafields.custom.fabric_details %}
    {% elsif section_key == 'care' and product.metafields.custom.care_instructions != blank %}
      {% assign content = product.metafields.custom.care_instructions.value | default: product.metafields.custom.care_instructions %}
    {% elsif section_key == 'fit' and product.metafields.custom.fit_guide != blank %}
      {% assign content = product.metafields.custom.fit_guide.value | default: product.metafields.custom.fit_guide %}
    {% elsif section_key == 'shipping' and product.metafields.custom.shipping_returns != blank %}
      {% assign content = product.metafields.custom.shipping_returns.value | default: product.metafields.custom.shipping_returns %}
    {% endif %}

    {% if title != blank and content != blank %}
      <div class="kapisa-details-{{ accordion_id }}__item">

        <button
          type="button"
          class="kapisa-details-{{ accordion_id }}__button"
          aria-expanded="false"
        >
          <span>{{ title | escape }}</span>

          <span
            class="kapisa-details-{{ accordion_id }}__icon"
            aria-hidden="true"
          ></span>
        </button>

        <div class="kapisa-details-{{ accordion_id }}__panel">
          <div class="kapisa-details-{{ accordion_id }}__content">
            {{ content }}
          </div>
        </div>

      </div>
    {% endif %}
  {% endfor %}
</div>

<script>
  (() => {
    const root = document.querySelector(
      '.kapisa-details-{{ accordion_id }}'
    );

    if (!root || root.dataset.ready === 'true') return;

    root.dataset.ready = 'true';

    const items = root.querySelectorAll(
      '.kapisa-details-{{ accordion_id }}__item'
    );

    items.forEach((item) => {
      const button = item.querySelector('button');
      const panel = item.querySelector(
        '.kapisa-details-{{ accordion_id }}__panel'
      );

      if (!button || !panel) return;

      button.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        items.forEach((otherItem) => {
          const otherButton = otherItem.querySelector('button');
          const otherPanel = otherItem.querySelector(
            '.kapisa-details-{{ accordion_id }}__panel'
          );

          otherItem.classList.remove('is-open');

          if (otherButton) {
            otherButton.setAttribute('aria-expanded', 'false');
          }

          if (otherPanel) {
            otherPanel.style.height = '0px';
          }
        });

        if (!isOpen) {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
          panel.style.height = panel.scrollHeight + 'px';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product details accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product details"
    },
    {
      "type": "text",
      "id": "fabric_title",
      "label": "Fabric title",
      "default": "Fabric & technology"
    },
    {
      "type": "richtext",
      "id": "fabric_content",
      "label": "Fabric content",
      "default": "<p>Describe the fabric, comfort, stretch and construction.</p>"
    },
    {
      "type": "text",
      "id": "care_title",
      "label": "Care title",
      "default": "Care instructions"
    },
    {
      "type": "richtext",
      "id": "care_content",
      "label": "Care content",
      "default": "<p>Follow the recommended washing and care instructions.</p>"
    },
    {
      "type": "text",
      "id": "fit_title",
      "label": "Fit title",
      "default": "Fit & size guide"
    },
    {
      "type": "richtext",
      "id": "fit_content",
      "label": "Fit content",
      "default": "<p>Use the size guide to find your best fit.</p>"
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping title",
      "default": "Shipping & returns"
    },
    {
      "type": "richtext",
      "id": "shipping_content",
      "label": "Shipping content",
      "default": "<p>Add your shipping and return information here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Product details accordion"
    }
  ]
}
{% endschema %}