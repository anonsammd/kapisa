{% doc %}
  @prompt
    Create a 'Complete the Look' section below the Fabric & Care accordion, off-white 
    #FAF7F0 background, section heading 'Complete the Look' in bold charcoal 
    #2B2B2E, 'You May Also Like' as an automatic fallback heading if no direct pairing exists. Below the heading, a horizontally scrollable row of product cards (peek the next card at the edge on mobile, no wrap to a new line). Each card, fixed width ~240px: product image on top with a light gray 
    #F0EEE9 placeholder background, aspect ratio 4:5, object-fit cover so the image never stretches or distorts. Below the image: product name in charcoal 
    #2B2B2E, bold, font-size 14px, limited to a maximum of 2 lines with text truncated using ellipsis if longer (use line-clamp: 2, overflow hidden) so long names never push the card taller or overflow. Price below the name in navy 
    #0E1F3C, bold, 14px. Below price, a row of small circular color swatch dots (10px each, using the same swatch color values as the product's color options), max 5 dots shown with a '+2' style counter if more exist. Card corners rounded 8px, soft shadow only on hover, no border by default. Ensure every card in the row has the same fixed height regardless of text length (set a fixed card height, vertically align content with flexbox, do not let content overflow outside the card boundary). Left/right scroll arrows appear on hover on desktop, circular, semi-transparent, gold 
    #C9A227 icon color; on mobile, rely on native touch swipe instead of arrows
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign direct_products = block.settings.direct_products %}
{% assign fallback_collection = block.settings.fallback_collection %}
{% assign has_direct_products = false %}
{% if direct_products != blank and direct_products.size > 0 %}
  {% assign has_direct_products = true %}
{% endif %}

{% style %}
  .ai-look-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.section_spacing }}px auto;
    padding: {{ block.settings.section_padding }}px;
    background: #FAF7F0;
    color: #2B2B2E;
    box-sizing: border-box;
  }
  .ai-look__heading-{{ ai_gen_id }} {
    margin: 0 0 20px;
    color: #2B2B2E;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 700;
  }
  .ai-look__viewport-{{ ai_gen_id }} {
    position: relative;
  }
  .ai-look__row-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    padding: 2px 2px 10px;
    scroll-snap-type: x proximity;
  }
  .ai-look__row-{{ ai_gen_id }}::-webkit-scrollbar { height: 6px; }
  .ai-look__row-{{ ai_gen_id }}::-webkit-scrollbar-thumb { background: #C9A227; border-radius: 10px; }
  .ai-look__card-{{ ai_gen_id }} {
    flex: 0 0 240px;
    width: 240px;
    height: 374px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #FFFFFF;
    border-radius: 8px;
    color: #2B2B2E;
    text-decoration: none;
    scroll-snap-align: start;
    transition: box-shadow .2s ease;
  }
  .ai-look__card-{{ ai_gen_id }}:hover { box-shadow: 0 7px 18px rgba(43,43,46,.14); }
  .ai-look__image-{{ ai_gen_id }}, .ai-look__placeholder-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 300px;
    flex: 0 0 300px;
    object-fit: cover;
    background: #F0EEE9;
  }
  .ai-look__placeholder-{{ ai_gen_id }} { display: flex; align-items: center; justify-content: center; }
  .ai-look__placeholder-{{ ai_gen_id }} svg { width: 55%; height: 55%; color: #8C8880; }
  .ai-look__details-{{ ai_gen_id }} {
    min-height: 74px;
    padding: 10px 12px 12px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
  }
  .ai-look__name-{{ ai_gen_id }} {
    margin: 0 0 5px;
    color: #2B2B2E;
    font-size: 14px;
    line-height: 18px;
    font-weight: 700;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .ai-look__price-{{ ai_gen_id }} { margin: 0; color: #0E1F3C; font-size: 14px; line-height: 18px; font-weight: 700; }
  .ai-look__swatches-{{ ai_gen_id }} { display: flex; align-items: center; gap: 5px; height: 15px; margin-top: 6px; }
  .ai-look__swatch-{{ ai_gen_id }} { width: 10px; height: 10px; flex: 0 0 10px; border-radius: 50%; border: 1px solid rgba(43,43,46,.28); }
  .ai-look__more-{{ ai_gen_id }} { color: #2B2B2E; font-size: 11px; font-weight: 700; }
  .ai-look__arrow-{{ ai_gen_id }} {
    position: absolute; top: 50%; z-index: 2; width: 38px; height: 38px; border: 0; border-radius: 50%;
    background: rgba(255,255,255,.82); color: #C9A227; box-shadow: 0 2px 8px rgba(43,43,46,.12);
    font-size: 25px; line-height: 35px; cursor: pointer; opacity: 0; pointer-events: none; transform: translateY(-50%);
  }
  .ai-look__viewport-{{ ai_gen_id }}:hover .ai-look__arrow-{{ ai_gen_id }} { opacity: 1; pointer-events: auto; }
  .ai-look__arrow--left-{{ ai_gen_id }} { left: -15px; }
  .ai-look__arrow--right-{{ ai_gen_id }} { right: -15px; }
  @media screen and (max-width: 749px) {
    .ai-look-{{ ai_gen_id }} { padding: {{ block.settings.mobile_padding }}px 0 {{ block.settings.mobile_padding }}px {{ block.settings.mobile_padding }}px; }
    .ai-look__heading-{{ ai_gen_id }} { padding-right: {{ block.settings.mobile_padding }}px; }
    .ai-look__row-{{ ai_gen_id }} { gap: 12px; padding-right: {{ block.settings.mobile_padding }}px; }
    .ai-look__card-{{ ai_gen_id }} { flex-basis: 240px; }
    .ai-look__arrow-{{ ai_gen_id }} { display: none; }
  }
{% endstyle %}

<complete-look-{{ ai_gen_id }} class="ai-look-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-look__heading-{{ ai_gen_id }}">{% if has_direct_products %}{{ block.settings.heading }}{% else %}{{ block.settings.fallback_heading }}{% endif %}</h2>
  <div class="ai-look__viewport-{{ ai_gen_id }}">
    <button class="ai-look__arrow-{{ ai_gen_id }} ai-look__arrow--left-{{ ai_gen_id }}" type="button" aria-label="Previous products">&#8249;</button>
    <div class="ai-look__row-{{ ai_gen_id }}" data-look-row>
      {% if has_direct_products %}
        {% assign products_to_show = direct_products %}
      {% elsif fallback_collection != blank %}
        {% assign products_to_show = fallback_collection.products %}
      {% else %}
        {% assign products_to_show = collections.all.products %}
      {% endif %}
      {% if products_to_show != blank %}
        {% for product in products_to_show limit: block.settings.product_limit %}
          <a class="ai-look__card-{{ ai_gen_id }}" href="{{ product.url }}">
            {% if product.featured_image %}
              <img class="ai-look__image-{{ ai_gen_id }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="750">
            {% else %}
              <div class="ai-look__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <div class="ai-look__details-{{ ai_gen_id }}">
              <p class="ai-look__name-{{ ai_gen_id }}">{{ product.title }}</p>
              <p class="ai-look__price-{{ ai_gen_id }}">{{ product.price | money }}</p>
              {%- liquid
                assign card_color_prods = product.metafields.custom.color_family_products.value
                assign card_color_opt = blank
                for option in product.options_with_values
                  assign opt_name_l = option.name | downcase
                  if opt_name_l contains 'color' or opt_name_l contains 'colour'
                    assign card_color_opt = option
                    break
                  endif
                endfor
                assign card_self_swatch = product.metafields.custom.color_swatch.value | default: product.metafields.custom.color_swatch
              -%}

              {% if card_color_prods != blank %}
                <div class="ai-look__swatches-{{ ai_gen_id }}" aria-label="Available colors">
                  {% for rel in card_color_prods limit: 5 %}
                    {% assign rel_c = rel.metafields.custom.color_swatch.value | default: rel.metafields.custom.color_swatch %}
                    {% if rel_c == blank %}
                      {% assign r_title = rel.title | downcase %}
                      {% if r_title contains 'navy' or r_title contains 'blue' %}{% assign rel_c = '#0E1F3C' %}
                      {% elsif r_title contains 'black' %}{% assign rel_c = '#18191C' %}
                      {% elsif r_title contains 'olive' or r_title contains 'sage' %}{% assign rel_c = '#556B2F' %}
                      {% elsif r_title contains 'green' or r_title contains 'hunter' %}{% assign rel_c = '#1B4942' %}
                      {% elsif r_title contains 'wine' or r_title contains 'burgundy' %}{% assign rel_c = '#4A1525' %}
                      {% elsif r_title contains 'grey' or r_title contains 'slate' %}{% assign rel_c = '#5A626A' %}
                      {% elsif r_title contains 'ceil' %}{% assign rel_c = '#6BA4B8' %}
                      {% else %}{% assign rel_c = '#0E1F3C' %}
                      {% endif %}
                    {% endif %}
                    <span class="ai-look__swatch-{{ ai_gen_id }}" style="background-color: {{ rel_c }};" title="{{ rel.title | escape }}"></span>
                  {% endfor %}
                  {% if card_color_prods.size > 5 %}
                    <span class="ai-look__more-{{ ai_gen_id }}">+{{ card_color_prods.size | minus: 5 }}</span>
                  {% endif %}
                </div>
              {% elsif card_color_opt != blank %}
                <div class="ai-look__swatches-{{ ai_gen_id }}" aria-label="Available colors">
                  {% for color in card_color_opt.values limit: 5 %}
                    {% assign color_clean = color | downcase | strip %}
                    {% assign bg_c = '#0E1F3C' %}
                    {% if color_clean contains 'olive' or color_clean contains 'sage' %}{% assign bg_c = '#556B2F' %}
                    {% elsif color_clean contains 'navy' or color_clean contains 'blue' %}{% assign bg_c = '#0E1F3C' %}
                    {% elsif color_clean contains 'black' %}{% assign bg_c = '#18191C' %}
                    {% elsif color_clean contains 'hunter' or color_clean contains 'green' %}{% assign bg_c = '#1B4942' %}
                    {% elsif color_clean contains 'wine' or color_clean contains 'burgundy' %}{% assign bg_c = '#4A1525' %}
                    {% elsif color_clean contains 'grey' or color_clean contains 'slate' %}{% assign bg_c = '#5A626A' %}
                    {% elsif color_clean contains 'ceil' %}{% assign bg_c = '#6BA4B8' %}
                    {% endif %}
                    <span class="ai-look__swatch-{{ ai_gen_id }}" style="background-color: {{ bg_c }}" title="{{ color | escape }}"></span>
                  {% endfor %}
                  {% if card_color_opt.values.size > 5 %}<span class="ai-look__more-{{ ai_gen_id }}">+{{ card_color_opt.values.size | minus: 5 }}</span>{% endif %}
                </div>
              {% elsif card_self_swatch != blank %}
                <div class="ai-look__swatches-{{ ai_gen_id }}" aria-label="Available colors">
                  <span class="ai-look__swatch-{{ ai_gen_id }}" style="background-color: {{ card_self_swatch }};" title="{{ product.title | escape }}"></span>
                </div>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
    <button class="ai-look__arrow-{{ ai_gen_id }} ai-look__arrow--right-{{ ai_gen_id }}" type="button" aria-label="Next products">&#8250;</button>
  </div>
</complete-look-{{ ai_gen_id }}>

<script>
(function() {
  class CompleteLook{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      const row = this.querySelector('[data-look-row]');
      const left = this.querySelector('.ai-look__arrow--left-{{ ai_gen_id }}');
      const right = this.querySelector('.ai-look__arrow--right-{{ ai_gen_id }}');
      if (!row || !left || !right) return;
      left.addEventListener('click', function() { row.scrollBy({ left: -256, behavior: 'smooth' }); });
      right.addEventListener('click', function() { row.scrollBy({ left: 256, behavior: 'smooth' }); });
    }
  }
  if (!customElements.get('complete-look-{{ ai_gen_id }}')) customElements.define('complete-look-{{ ai_gen_id }}', CompleteLook{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Complete the look",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the Look" },
    { "type": "text", "id": "fallback_heading", "label": "Fallback heading", "default": "You May Also Like" },
    { "type": "product_list", "id": "direct_products", "label": "Paired products", "limit": 12 },
    { "type": "collection", "id": "fallback_collection", "label": "Fallback collection" },
    { "type": "range", "id": "product_limit", "label": "Products shown", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "section_padding", "label": "Section padding", "min": 12, "max": 60, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 12, "max": 32, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_spacing", "label": "Section spacing", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Complete the look" }],
  "tag": null,
  "class": "complete-look-block"
}
{% endschema %}