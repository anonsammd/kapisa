<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script>

(function () {

  'use strict';


  /* ========================================================
     BASIC ELEMENTS
     ======================================================== */

  const header =
    document.querySelector('[data-kapisa-header]');

  if (!header) return;


  const spacer =
    document.querySelector(
      '.kapisa-header-spacer-{{ ai_gen_id }}'
    );


  const root =
    document.documentElement;


  const headerIsFixed =
    header.classList.contains(
      'kapisa-header--fixed'
    );


  /* ========================================================
     ANNOUNCEMENT BAR
     ======================================================== */

  function getAnnouncementElement() {

    return document.querySelector(
      '[data-kapisa-announcement]'
    );

  }


  let announcementEl =
    getAnnouncementElement();


  function getAnnouncementBottom() {

    if (!announcementEl) return 0;


    const styles =
      window.getComputedStyle(
        announcementEl
      );


    if (
      styles.display === 'none' ||
      styles.visibility === 'hidden'
    ) {
      return 0;
    }


    const rect =
      announcementEl.getBoundingClientRect();


    return Math.max(
      0,
      Math.ceil(rect.bottom)
    );

  }


  function getAnnouncementReservedHeight() {

    if (!announcementEl) return 0;


    const styles =
      window.getComputedStyle(
        announcementEl
      );


    if (
      styles.display === 'none' ||
      styles.visibility === 'hidden'
    ) {
      return 0;
    }


    if (styles.position !== 'fixed' && styles.position !== 'sticky') {
      return 0;
    }


    const rect =
      announcementEl.getBoundingClientRect();


    return Math.max(
      0,
      Math.ceil(rect.height)
    );

  }


  /* ========================================================
     DYNAMIC HEADER HEIGHT
     ======================================================== */

  function getHeaderHeight() {

    return Math.ceil(
      header.getBoundingClientRect().height
    );

  }


  function updateHeaderHeight() {

    const headerHeight =
      getHeaderHeight();


    const announcementHeight =
      getAnnouncementReservedHeight();


    const spacerHeight =
      announcementHeight +
      (
        headerIsFixed
          ? headerHeight
          : 0
      );


    root.style.setProperty(
      '--kapisa-header-height',
      headerHeight + 'px'
    );


    root.style.setProperty(
      '--kapisa-header-spacer-height',
      spacerHeight + 'px'
    );


    root.style.setProperty(
      '--kapisa-header-total-height',
      spacerHeight + 'px'
    );


    if (spacer) {

      spacer.style.height =
        spacerHeight + 'px';

    }

  }


  function updateHeaderPosition() {

    const announcementBottom =
      getAnnouncementBottom();


    root.style.setProperty(
      '--kapisa-header-top',
      announcementBottom + 'px'
    );


    /*
      Scrolled state is intentionally based on page scroll,
      not announcement presence.
    */

    if (window.scrollY > 8) {

      header.classList.add(
        'is-scrolled'
      );

    } else {

      header.classList.remove(
        'is-scrolled'
      );

    }

  }


  function updateLayout() {

    announcementEl =
      getAnnouncementElement();

    updateHeaderHeight();

    updateHeaderPosition();

  }


  updateLayout();


  /* ========================================================
     SCROLL
     ======================================================== */

  let scrollTicking = false;


  window.addEventListener(
    'scroll',
    function () {

      if (scrollTicking) return;


      scrollTicking = true;


      window.requestAnimationFrame(
        function () {

          updateHeaderPosition();

          scrollTicking = false;

        }
      );

    },
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    function () {

      updateLayout();

    }
  );


  if (
    document.fonts &&
    document.fonts.ready
  ) {

    document.fonts.ready.then(
      updateLayout
    );

  }


  if (
    window.ResizeObserver &&
    announcementEl
  ) {

    const observer =
      new ResizeObserver(
        function () {

          updateLayout();

        }
      );


    observer.observe(
      announcementEl
    );

  }


  /* ========================================================
     SEARCH
     ======================================================== */

  const desktopSearch =
    header.querySelector(
      '[data-desktop-search]'
    );


  const desktopToggle =
    header.querySelector(
      '[data-desktop-search-toggle]'
    );


  const desktopInput =
    header.querySelector(
      '[data-desktop-search-input]'
    );


  const desktopResults =
    header.querySelector(
      '[data-desktop-results]'
    );


  const mobileSearch =
    header.querySelector(
      '[data-mobile-search="{{ ai_gen_id }}"]'
    );


  const mobileInput =
    header.querySelector(
      '[data-mobile-search-input]'
    );


  const mobileResults =
    header.querySelector(
      '[data-mobile-results]'
    );


  const mobileSearchOpen =
    header.querySelector(
      '[data-mobile-search-open="{{ ai_gen_id }}"]'
    );


  let searchTimer = null;

  let searchRequestId = 0;


  function escapeHtml(value) {

    const div =
      document.createElement('div');

    div.textContent =
      value || '';

    return div.innerHTML;

  }


  function performSearch(
    query,
    resultsContainer
  ) {

    if (!resultsContainer) return;


    const currentRequest =
      ++searchRequestId;


    if (query.length < 2) {

      resultsContainer.classList.remove(
        'is-visible'
      );

      resultsContainer.innerHTML = '';

      return;

    }


    const url =
      '/search/suggest.json' +
      '?q=' +
      encodeURIComponent(query) +
      '&resources[type]=product' +
      '&resources[limit]=5';


    fetch(url, {
      credentials: 'same-origin'
    })

      .then(function (response) {

        if (!response.ok) {

          throw new Error(
            'Search failed'
          );

        }

        return response.json();

      })

      .then(function (data) {

        /*
          Ignore an older response if the
          user has already typed another query.
        */

        if (
          currentRequest !==
          searchRequestId
        ) {
          return;
        }


        const products =
          data &&
          data.resources &&
          data.resources.results &&
          data.resources.results.products
            ? data.resources.results.products
            : [];


        resultsContainer.innerHTML = '';


        products
          .slice(0, 5)
          .forEach(function (product) {

            const link =
              document.createElement('a');


            link.className =
              'kapisa-header-{{ ai_gen_id }}__result';


            link.href =
              product.url || '#';


            if (product.image) {

              const image =
                document.createElement('img');


              image.className =
                'kapisa-header-{{ ai_gen_id }}__result-image';


              image.src =
                product.image;


              image.alt =
                product.title || '';


              image.loading =
                'lazy';


              link.appendChild(
                image
              );

            }


            const info =
              document.createElement('span');


            info.className =
              'kapisa-header-{{ ai_gen_id }}__result-info';


            const title =
              document.createElement('span');


            title.className =
              'kapisa-header-{{ ai_gen_id }}__result-title';


            title.textContent =
              product.title ||
              'Product';


            const price =
              document.createElement('span');


            price.className =
              'kapisa-header-{{ ai_gen_id }}__result-price';


            price.textContent =
              product.price ||
              '';


            info.appendChild(title);

            info.appendChild(price);

            link.appendChild(info);


            resultsContainer.appendChild(
              link
            );

          });


        if (products.length === 0) {

          const empty =
            document.createElement('div');


          empty.style.padding =
            '18px';


          empty.style.textAlign =
            'center';


          empty.style.fontSize =
            '12px';


          empty.style.color =
            '#747983';


          empty.textContent =
            'No products found';


          resultsContainer.appendChild(
            empty
          );

        }


        const viewAll =
          document.createElement('a');


        viewAll.className =
          'kapisa-header-{{ ai_gen_id }}__view-results';


        viewAll.href =
          '{{ routes.search_url }}?q=' +
          encodeURIComponent(query);


        viewAll.textContent =
          '{{ block.settings.view_all_results_text | escape }}';


        resultsContainer.appendChild(
          viewAll
        );


        resultsContainer.classList.add(
          'is-visible'
        );

      })

      .catch(function () {

        if (
          currentRequest !==
          searchRequestId
        ) {
          return;
        }


        resultsContainer.classList.remove(
          'is-visible'
        );

      });

  }


  function queueSearch(
    input,
    results
  ) {

    if (!input || !results) return;


    clearTimeout(
      searchTimer
    );


    const query =
      input.value.trim();


    if (query.length < 2) {

      results.classList.remove(
        'is-visible'
      );

      results.innerHTML = '';

      return;

    }


    searchTimer =
      setTimeout(
        function () {

          performSearch(
            query,
            results
          );

        },
        180
      );

  }


  if (
    desktopToggle &&
    desktopSearch
  ) {

    desktopToggle.addEventListener(
      'click',
      function (event) {

        event.stopPropagation();


        const open =
          desktopSearch.classList.toggle(
            'is-open'
          );


        desktopToggle.setAttribute(
          'aria-expanded',
          open
            ? 'true'
            : 'false'
        );


        if (open) {

          setTimeout(
            function () {

              if (desktopInput) {

                desktopInput.focus();

              }

            },
            100
          );

        } else if (
          desktopResults
        ) {

          desktopResults.classList.remove(
            'is-visible'
          );

        }

      }
    );

  }


  if (desktopInput) {

    desktopInput.addEventListener(
      'input',
      function () {

        queueSearch(
          desktopInput,
          desktopResults
        );

      }
    );

  }


  function openMobileSearch() {

    if (!mobileSearch) return;


    mobileSearch.classList.add(
      'is-open'
    );


    if (mobileSearchOpen) {

      mobileSearchOpen.setAttribute(
        'aria-expanded',
        'true'
      );

    }


    setTimeout(
      function () {

        if (mobileInput) {

          mobileInput.focus();

        }

      },
      100
    );

  }


  function closeMobileSearch() {

    if (!mobileSearch) return;


    mobileSearch.classList.remove(
      'is-open'
    );


    if (mobileSearchOpen) {

      mobileSearchOpen.setAttribute(
        'aria-expanded',
        'false'
      );

    }


    if (mobileResults) {

      mobileResults.classList.remove(
        'is-visible'
      );

    }

  }


  if (mobileSearchOpen) {

    mobileSearchOpen.addEventListener(
      'click',
      function (event) {

        event.stopPropagation();

        openMobileSearch();

      }
    );

  }


  if (mobileInput) {

    mobileInput.addEventListener(
      'input',
      function () {

        queueSearch(
          mobileInput,
          mobileResults
        );

      }
    );

  }


  /* ========================================================
     MOBILE DRAWER
     ======================================================== */

  const drawer =
    document.querySelector(
      '[data-mobile-drawer="{{ ai_gen_id }}"]'
    );


  const drawerOpen =
    header.querySelector(
      '[data-mobile-menu-open="{{ ai_gen_id }}"]'
    );


  const drawerClose =
    document.querySelector(
      '[data-mobile-menu-close="{{ ai_gen_id }}"]'
    );


  let previousBodyOverflow = '';


  function openDrawer() {

    if (!drawer) return;


    drawer.classList.add(
      'is-open'
    );


    drawer.setAttribute(
      'aria-hidden',
      'false'
    );


    if (drawerOpen) {

      drawerOpen.setAttribute(
        'aria-expanded',
        'true'
      );

    }


    previousBodyOverflow =
      document.body.style.overflow;


    document.body.style.overflow =
      'hidden';


    document.documentElement.style.overflow =
      'hidden';

  }


  function closeDrawer() {

    if (!drawer) return;


    drawer.classList.remove(
      'is-open'
    );


    drawer.setAttribute(
      'aria-hidden',
      'true'
    );


    if (drawerOpen) {

      drawerOpen.setAttribute(
        'aria-expanded',
        'false'
      );

    }


    document.body.style.overflow =
      previousBodyOverflow;


    document.documentElement.style.overflow =
      '';

  }


  if (drawerOpen) {

    drawerOpen.addEventListener(
      'click',
      function (event) {

        event.preventDefault();

        event.stopPropagation();

        openDrawer();

      }
    );

  }


  if (drawerClose) {

    drawerClose.addEventListener(
      'click',
      function (event) {

        event.preventDefault();

        event.stopPropagation();

        closeDrawer();

      }
    );

  }


  if (drawer) {

    drawer.addEventListener(
      'click',
      function (event) {

        if (
          event.target === drawer
        ) {

          closeDrawer();

        }

      }
    );

  }


  /* ========================================================
     MOBILE MENU ACCORDIONS
     ======================================================== */

  const expandButtons =
    document.querySelectorAll(
      '[data-mobile-expand]'
    );


  expandButtons.forEach(
    function (button) {

      button.addEventListener(
        'click',
        function (event) {

          event.preventDefault();

          event.stopPropagation();


          const item =
            button.closest(
              '[data-mobile-menu-item]'
            );


          if (!item) return;


          const isExpanded =
            item.classList.toggle(
              'is-expanded'
            );


          button.setAttribute(
            'aria-expanded',
            isExpanded
              ? 'true'
              : 'false'
          );

        }
      );

    }
  );


  /* ========================================================
     WISHLIST
     ======================================================== */

  const WISHLIST_KEY =
    'kapisa_wishlist_v1';


  function readWishlist() {

    try {

      const raw =
        window.localStorage.getItem(
          WISHLIST_KEY
        );


      if (!raw) return [];


      const parsed =
        JSON.parse(raw);


      if (!Array.isArray(parsed)) {

        return [];

      }


      return parsed.filter(
        function (item) {

          return (
            typeof item === 'string' &&
            item.length > 0
          );

        }
      );

    } catch (error) {

      return [];

    }

  }


  function writeWishlist(items) {

    try {

      window.localStorage.setItem(
        WISHLIST_KEY,
        JSON.stringify(items)
      );

    } catch (error) {

      /*
        localStorage can be disabled
        by privacy settings.
        Header continues working normally.
      */

    }

  }


  function updateWishlistUI() {

    const wishlist =
      readWishlist();


    const count =
      wishlist.length;


    const desktopBadges =
      document.querySelectorAll(
        '[data-wishlist-count]'
      );


    desktopBadges.forEach(
      function (badge) {

        badge.textContent =
          count;


        badge.hidden =
          count === 0;

      }
    );


    const mobileBadges =
      document.querySelectorAll(
        '[data-mobile-wishlist-count]'
      );


    mobileBadges.forEach(
      function (badge) {

        badge.textContent =
          count;


        badge.hidden =
          count === 0;

      }
    );

  }


  updateWishlistUI();


  /*
    Other theme sections can call:

    window.KapisaWishlist.add(productHandle)

    window.KapisaWishlist.remove(productHandle)

    window.KapisaWishlist.toggle(productHandle)

    window.KapisaWishlist.has(productHandle)

    window.KapisaWishlist.getAll()
  */

  window.KapisaWishlist = {

    getAll: function () {

      return readWishlist();

    },


    has: function (handle) {

      if (!handle) return false;


      return readWishlist().indexOf(
        String(handle)
      ) !== -1;

    },


    add: function (handle) {

      if (!handle) return;


      const normalized =
        String(handle);


      const items =
        readWishlist();


      if (
        items.indexOf(normalized) === -1
      ) {

        items.push(
          normalized
        );

        writeWishlist(items);

      }


      updateWishlistUI();


      window.dispatchEvent(
        new CustomEvent(
          'kapisa:wishlist:updated',
          {
            detail: {
              items: items
            }
          }
        )
      );

    },


    remove: function (handle) {

      if (!handle) return;


      const normalized =
        String(handle);


      const items =
        readWishlist().filter(
          function (item) {

            return item !== normalized;

          }
        );


      writeWishlist(items);


      updateWishlistUI();


      window.dispatchEvent(
        new CustomEvent(
          'kapisa:wishlist:updated',
          {
            detail: {
              items: items
            }
          }
        )
      );

    },


    toggle: function (handle) {

      if (!handle) return;


      if (
        this.has(handle)
      ) {

        this.remove(handle);

      } else {

        this.add(handle);

      }

    }

  };


  /* ========================================================
     SYNC WISHLIST BETWEEN TABS
     ======================================================== */

  window.addEventListener(
    'storage',
    function (event) {

      if (
        event.key === WISHLIST_KEY
      ) {

        updateWishlistUI();

      }

    }
  );


  /* ========================================================
     ACTIVE BOTTOM NAV
     ======================================================== */

  function normalizePath(path) {

    if (!path) return '/';


    const clean =
      path.split('?')[0]
        .split('#')[0];


    if (
      clean.length > 1 &&
      clean.endsWith('/')
    ) {

      return clean.slice(
        0,
        -1
      );

    }


    return clean;

  }


  const currentPath =
    normalizePath(
      window.location.pathname
    );


  const bottomLinks =
    document.querySelectorAll(
      '.kapisa-header-{{ ai_gen_id }}__bottom-link'
    );


  bottomLinks.forEach(
    function (link) {

      try {

        const linkUrl =
          new URL(
            link.href,
            window.location.origin
          );


        const linkPath =
          normalizePath(
            linkUrl.pathname
          );


        if (
          linkPath === currentPath
        ) {

          link.classList.add(
            'is-active'
          );

        }

      } catch (error) {}

    }
  );


  /* ========================================================
     GLOBAL ESCAPE
     ======================================================== */

  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key !== 'Escape'
      ) {
        return;
      }


      closeDrawer();

      closeMobileSearch();


      if (desktopSearch) {

        desktopSearch.classList.remove(
          'is-open'
        );

      }


      if (desktopToggle) {

        desktopToggle.setAttribute(
          'aria-expanded',
          'false'
        );

      }


      if (desktopResults) {

        desktopResults.classList.remove(
          'is-visible'
        );

      }

    }
  );


  /* ========================================================
     CLICK OUTSIDE
     ======================================================== */

  document.addEventListener(
    'click',
    function (event) {


      /* Desktop search */

      if (
        desktopSearch &&
        !desktopSearch.contains(
          event.target
        ) &&
        desktopToggle &&
        !desktopToggle.contains(
          event.target
        )
      ) {

        desktopSearch.classList.remove(
          'is-open'
        );


        if (desktopToggle) {

          desktopToggle.setAttribute(
            'aria-expanded',
            'false'
          );

        }


        if (desktopResults) {

          desktopResults.classList.remove(
            'is-visible'
          );

        }

      }


      /* Mobile search */

      if (
        mobileSearch &&
        !mobileSearch.contains(
          event.target
        ) &&
        mobileSearchOpen &&
        !mobileSearchOpen.contains(
          event.target
        )
      ) {

        closeMobileSearch();

      }

    }
  );


  /* ========================================================
     SHOPIFY SECTION RELOAD
     ======================================================== */

  document.addEventListener(
    'shopify:section:load',
    function () {

      announcementEl =
        getAnnouncementElement();


      setTimeout(
        updateLayout,
        80
      );


      setTimeout(
        updateWishlistUI,
        100
      );

    }
  );


})();

</script>


