{% comment %}
  @prompt
    Build a premium production-ready Kapisa Healthcare ecommerce header.

    Requirements:
    - Keep announcement bar completely separate.
    - Fixed/static header support.
    - Desktop navigation with nested dropdowns.
    - Desktop search.
    - Desktop wishlist.
    - Desktop customer account/login/register.
    - Desktop cart.
    - Mobile native-app style header.
    - Mobile hamburger drawer.
    - Mobile search only in top header.
    - Mobile bottom navigation: Home, Shop, Wishlist, Cart, Account.
    - Do not duplicate search or cart on mobile.
    - Mobile logo must be clearly visible and larger.
    - No old arrow style in mobile drawer.
    - Use modern plus buttons for expandable menu groups.
    - Dynamic header height and spacer so page content never hides underneath header.
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

  /* =========================================================
     KAPISA HEADER — DESIGN TOKENS
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }} {
    --kapisa-cream: #FAF7F0;
    --kapisa-cream-2: #FFFDF9;
    --kapisa-navy: #0E1F3C;
    --kapisa-charcoal: #2B2B2E;
    --kapisa-gold: #C9A227;
    --kapisa-slate: #8FA3B8;
    --kapisa-border: rgba(143,163,184,.25);

    width: 100% !important;
    z-index: 99990 !important;
    color: var(--kapisa-charcoal);
    background: rgba(250,247,240,.98);
    border-bottom: 1px solid var(--kapisa-border);
    box-shadow: 0 3px 18px rgba(14,31,60,.035);

    transition:
      top .24s cubic-bezier(.2,.7,.2,1),
      background .3s ease,
      box-shadow .3s ease;
  }

  .kapisa-header-{{ ai_gen_id }}.kapisa-header--fixed {
    position: fixed !important;
    top: var(--kapisa-header-top, 34px) !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 99990 !important;
  }

  .kapisa-header-{{ ai_gen_id }}.kapisa-header--static {
    position: relative !important;
  }

  .kapisa-header-{{ ai_gen_id }}.is-scrolled {
    background: rgba(250,247,240,.94);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
    box-shadow: 0 8px 35px rgba(14,31,60,.09);
  }

  /* Dynamic spacer - hidden when sticky to avoid extra gap */
  .kapisa-header-spacer-{{ ai_gen_id }} {
    display: none !important;
  }

  /* =========================================================
     DESKTOP MAIN
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__main {
    width: 100%;
    max-width: 1480px;
    min-height: 76px;
    margin: 0 auto;
    padding: 0 34px;

    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto minmax(300px, 1fr);
    align-items: center;

    column-gap: 28px;

    transition:
      min-height .32s cubic-bezier(.2,.7,.2,1),
      padding .32s cubic-bezier(.2,.7,.2,1);
  }

  .kapisa-header-{{ ai_gen_id }}.is-scrolled
  .kapisa-header-{{ ai_gen_id }}__main {
    min-height: 64px;
    padding-left: 30px;
    padding-right: 30px;
  }

  /* =========================================================
     BRAND
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__brand {
    justify-self: start;

    display: inline-flex;
    align-items: center;

    min-width: 0;

    color: var(--kapisa-navy);
    text-decoration: none;
    line-height: 0;
  }

  .kapisa-header-{{ ai_gen_id }}__logo {
    display: block;

    width: {{ block.settings.logo_width }}px;
    max-width: 100%;
    height: auto;

    object-fit: contain;

    transition:
      width .32s cubic-bezier(.2,.7,.2,1),
      transform .25s ease;
  }

  .kapisa-header-{{ ai_gen_id }}.is-scrolled
  .kapisa-header-{{ ai_gen_id }}__logo {
    width: calc({{ block.settings.logo_width }}px * .86);
  }

  .kapisa-header-{{ ai_gen_id }}__wordmark {
    color: var(--kapisa-navy);
    font-size: 20px;
    font-weight: 750;
    letter-spacing: .16em;
    text-transform: lowercase;
    white-space: nowrap;
  }

  /* =========================================================
     DESKTOP NAV
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__desktop-nav {
    justify-self: center;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 3px;
    height: 100%;
  }

  .kapisa-header-{{ ai_gen_id }}__menu-item {
    position: relative;

    height: 100%;

    display: flex;
    align-items: center;
  }

  .kapisa-header-{{ ai_gen_id }}__menu-link {
    position: relative;

    display: inline-flex;
    align-items: center;

    gap: 6px;

    height: 42px;
    padding: 0 13px;

    color: var(--kapisa-charcoal);
    text-decoration: none;

    font-size: 13px;
    font-weight: 500;
    letter-spacing: .015em;

    border-radius: 10px;

    transition:
      color .2s ease,
      background .2s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__menu-link:hover {
    color: var(--kapisa-navy);
    background: rgba(14,31,60,.045);
  }

  .kapisa-header-{{ ai_gen_id }}__menu-link::after {
    content: "";

    position: absolute;

    left: 50%;
    bottom: 2px;

    width: 0;
    height: 2px;

    border-radius: 999px;

    background: var(--kapisa-gold);

    transform: translateX(-50%);

    transition: width .25s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__menu-link:hover::after {
    width: 28px;
  }

  .kapisa-header-{{ ai_gen_id }}__chevron {
    width: 11px;
    height: 11px;

    flex: 0 0 11px;

    transition: transform .2s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__menu-item:hover
  .kapisa-header-{{ ai_gen_id }}__chevron {
    transform: rotate(180deg);
  }

  /* =========================================================
     DESKTOP DROPDOWN
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__dropdown {
    position: absolute;

    top: calc(100% - 1px);
    left: 50%;

    min-width: 225px;

    padding: 9px;

    background: rgba(250,247,240,.99);

    border: 1px solid rgba(143,163,184,.25);
    border-radius: 14px;

    box-shadow: 0 20px 55px rgba(14,31,60,.14);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translate(-50%,-7px);

    transition:
      opacity .2s ease,
      transform .22s ease,
      visibility .2s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__menu-item:hover >
  .kapisa-header-{{ ai_gen_id }}__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translate(-50%,0);
  }

  .kapisa-header-{{ ai_gen_id }}__dropdown-item {
    position: relative;
  }

  .kapisa-header-{{ ai_gen_id }}__dropdown-link {
    min-height: 40px;

    padding: 0 12px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    color: var(--kapisa-charcoal);
    text-decoration: none;

    font-size: 12px;

    border-radius: 9px;

    transition:
      color .18s ease,
      background .18s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__dropdown-link:hover {
    color: var(--kapisa-navy);
    background: rgba(14,31,60,.05);
  }

  .kapisa-header-{{ ai_gen_id }}__dropdown-item >
  .kapisa-header-{{ ai_gen_id }}__dropdown {
    top: -10px;
    left: calc(100% + 7px);

    transform: translateX(-7px);
  }

  .kapisa-header-{{ ai_gen_id }}__dropdown-item:hover >
  .kapisa-header-{{ ai_gen_id }}__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateX(0);
  }

  /* =========================================================
     DESKTOP ACTIONS
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__actions {
    justify-self: end;

    display: flex;
    align-items: center;

    gap: 4px;
  }

  .kapisa-header-{{ ai_gen_id }}__action {
    position: relative;

    width: 42px;
    height: 42px;

    padding: 0;

    border: 0;
    border-radius: 50%;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    color: var(--kapisa-navy);

    background: transparent;

    cursor: pointer;
    text-decoration: none;

    transition:
      background .2s ease,
      transform .2s ease,
      color .2s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__action:hover {
    background: rgba(14,31,60,.055);
    transform: translateY(-1px);
  }

  .kapisa-header-{{ ai_gen_id }}__action svg,
  .kapisa-header-{{ ai_gen_id }}__mobile-icon svg,
  .kapisa-header-{{ ai_gen_id }}__bottom-link svg {
    width: 20px;
    height: 20px;

    fill: none;

    stroke: currentColor;
    stroke-width: 1.65;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* =========================================================
     BADGES
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__cart-badge,
  .kapisa-header-{{ ai_gen_id }}__wishlist-badge {
    position: absolute;

    top: 1px;
    right: -1px;

    min-width: 17px;
    height: 17px;

    padding: 0 4px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 999px;

    background: var(--kapisa-gold);
    color: var(--kapisa-navy);

    border: 2px solid var(--kapisa-cream);

    font-size: 9px;
    font-weight: 800;
    line-height: 1;
  }

  .kapisa-header-{{ ai_gen_id }}__wishlist-badge {
    background: var(--kapisa-navy);
    color: var(--kapisa-cream);
  }

  /* =========================================================
     ACCOUNT DESKTOP
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__account-wrap {
    position: relative;
  }

  .kapisa-header-{{ ai_gen_id }}__account-menu {
    position: absolute;

    top: calc(100% + 8px);
    right: 0;

    width: 220px;

    padding: 9px;

    background: rgba(250,247,240,.99);

    border: 1px solid rgba(143,163,184,.25);
    border-radius: 15px;

    box-shadow: 0 20px 55px rgba(14,31,60,.14);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-7px);

    transition:
      opacity .2s ease,
      transform .2s ease,
      visibility .2s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__account-wrap:hover
  .kapisa-header-{{ ai_gen_id }}__account-menu,
  .kapisa-header-{{ ai_gen_id }}__account-wrap:focus-within
  .kapisa-header-{{ ai_gen_id }}__account-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .kapisa-header-{{ ai_gen_id }}__account-heading {
    padding: 10px 12px 8px;

    color: var(--kapisa-navy);

    font-size: 11px;
    font-weight: 750;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .kapisa-header-{{ ai_gen_id }}__account-link {
    min-height: 40px;

    padding: 0 12px;

    display: flex;
    align-items: center;
    gap: 10px;

    color: var(--kapisa-charcoal);

    text-decoration: none;

    font-size: 12px;

    border-radius: 9px;

    transition:
      color .18s ease,
      background .18s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__account-link:hover {
    color: var(--kapisa-navy);
    background: rgba(14,31,60,.05);
  }

  .kapisa-header-{{ ai_gen_id }}__account-divider {
    height: 1px;
    margin: 7px 4px;

    background: rgba(143,163,184,.22);
  }

  /* =========================================================
     DESKTOP SEARCH
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__search-wrap {
    position: relative;

    display: flex;
    align-items: center;

    width: 0;

    opacity: 0;

    overflow: visible;
    pointer-events: none;

    transition:
      width .3s cubic-bezier(.2,.7,.2,1),
      opacity .2s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__search-wrap.is-open {
    width: 255px;

    opacity: 1;
    pointer-events: auto;
  }

  .kapisa-header-{{ ai_gen_id }}__search-input {
    width: 100%;
    height: 40px;

    padding: 0 16px;

    border: 1px solid rgba(143,163,184,.45);
    border-radius: 999px;

    outline: none;

    background: rgba(255,255,255,.62);

    color: var(--kapisa-charcoal);

    font-family: inherit;
    font-size: 12px;
  }

  .kapisa-header-{{ ai_gen_id }}__search-input:focus {
    border-color: var(--kapisa-gold);

    box-shadow: 0 0 0 3px rgba(201,162,39,.10);
  }

  .kapisa-header-{{ ai_gen_id }}__search-results {
    position: absolute;

    top: calc(100% + 11px);
    right: 0;

    width: 350px;
    max-height: 430px;

    overflow-y: auto;

    background: rgba(250,247,240,.99);

    border: 1px solid rgba(143,163,184,.28);
    border-radius: 17px;

    box-shadow: 0 22px 65px rgba(14,31,60,.16);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-6px);

    transition:
      opacity .2s ease,
      transform .2s ease,
      visibility .2s ease;
  }

  .kapisa-header-{{ ai_gen_id }}__search-results.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0);
  }

  .kapisa-header-{{ ai_gen_id }}__result {
    display: flex;
    align-items: center;

    gap: 12px;

    padding: 11px 13px;

    color: var(--kapisa-charcoal);
    text-decoration: none;

    border-bottom: 1px solid rgba(143,163,184,.17);
  }

  .kapisa-header-{{ ai_gen_id }}__result-image {
    width: 47px;
    height: 47px;

    flex: 0 0 47px;

    border-radius: 10px;

    object-fit: cover;

    background: #ece8df;
  }

  .kapisa-header-{{ ai_gen_id }}__result-info {
    min-width: 0;
    flex: 1;
  }

  .kapisa-header-{{ ai_gen_id }}__result-title {
    display: block;

    overflow: hidden;

    color: var(--kapisa-charcoal);

    font-size: 12px;
    font-weight: 500;

    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .kapisa-header-{{ ai_gen_id }}__result-price {
    display: block;

    margin-top: 3px;

    color: var(--kapisa-navy);

    font-size: 11px;
    font-weight: 700;
  }

  .kapisa-header-{{ ai_gen_id }}__view-results {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 46px;

    color: var(--kapisa-gold);

    text-decoration: none;

    font-size: 11px;
    font-weight: 750;
  }

  /* =========================================================
     MOBILE BASE
     ========================================================= */

  .kapisa-header-{{ ai_gen_id }}__mobile-controls,
  .kapisa-header-{{ ai_gen_id }}__mobile-search,
  .kapisa-header-{{ ai_gen_id }}__bottom-nav {
    display: none;
  }

  html {
    scroll-padding-top: var(--kapisa-header-height, 76px);
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 980px) and (min-width: 750px) {

    .kapisa-header-{{ ai_gen_id }}__main {
      padding-left: 20px;
      padding-right: 20px;
    }

    .kapisa-header-{{ ai_gen_id }}__desktop-nav {
      gap: 0;
    }

    .kapisa-header-{{ ai_gen_id }}__menu-link {
      padding-left: 8px;
      padding-right: 8px;
      font-size: 12px;
    }

    .kapisa-header-{{ ai_gen_id }}__search-wrap.is-open {
      width: 210px;
    }
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 749px) {

    .kapisa-header-{{ ai_gen_id }} {
      background: rgba(250,247,240,.98);

      box-shadow:
        0 4px 20px rgba(14,31,60,.07);
    }

    /* ---------------------------------------------
       MAIN MOBILE HEADER
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__main,
    .kapisa-header-{{ ai_gen_id }}.is-scrolled
    .kapisa-header-{{ ai_gen_id }}__main {

      position: relative;

      width: 100%;

      min-height: 68px;
      height: 68px;

      padding: 0 9px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 8px;

      box-sizing: border-box;
    }

    /* ---------------------------------------------
       MOBILE BRAND
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__brand,
    .kapisa-header-{{ ai_gen_id }}.is-scrolled
    .kapisa-header-{{ ai_gen_id }}__brand {

      position: absolute;

      top: 50%;
      left: 50%;

      z-index: 2;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 150px;
      max-width: 45vw;

      height: 68px;

      margin: 0;
      padding: 0;

      line-height: 0;

      transform: translate(-50%, -50%);
    }

    .kapisa-header-{{ ai_gen_id }}__logo,
    .kapisa-header-{{ ai_gen_id }}.is-scrolled
    .kapisa-header-{{ ai_gen_id }}__logo {

      display: block;

      width: min({{ block.settings.mobile_logo_width }}px, 145px);

      max-width: 145px;

      min-width: 92px;

      max-height: 54px;

      height: auto;

      object-fit: contain;
      object-position: center;

      transform: none;
    }

    .kapisa-header-{{ ai_gen_id }}__wordmark {

      font-size: 19px;

      letter-spacing: .12em;

      white-space: nowrap;

      transform: none;
    }

    /* ---------------------------------------------
       HIDE DESKTOP
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__desktop-nav,
    .kapisa-header-{{ ai_gen_id }}__actions {
      display: none;
    }

    /* ---------------------------------------------
       MOBILE TOP CONTROLS
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__mobile-controls {

      position: relative;

      z-index: 4;

      display: flex;

      align-items: center;
      justify-content: space-between;

      width: 100%;

      height: 68px;
      min-height: 68px;

      margin: 0;
      padding: 0;

      pointer-events: none;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-left,
    .kapisa-header-{{ ai_gen_id }}__mobile-right {

      display: flex;

      align-items: center;

      gap: 2px;

      height: 68px;

      pointer-events: auto;
    }

    /* ---------------------------------------------
       MOBILE ICON
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__mobile-icon {

      position: relative;

      width: 44px;
      height: 44px;

      flex: 0 0 44px;

      margin: 0;
      padding: 0;

      border: 0;
      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      background: transparent;

      color: var(--kapisa-navy);

      cursor: pointer;

      -webkit-tap-highlight-color: transparent;

      transition:
        background .18s ease,
        transform .18s ease;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-icon:active {
      background: rgba(14,31,60,.08);

      transform: scale(.94);
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-icon svg {

      width: 21px;
      height: 21px;

      display: block;

      fill: none;

      stroke: currentColor;

      stroke-width: 1.65;

      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ---------------------------------------------
       MOBILE SEARCH
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__mobile-search {

      position: absolute;

      top: calc(100% + 8px);

      left: 9px;
      right: 9px;

      z-index: 100000;

      display: block;

      padding: 10px;

      background: rgba(250,247,240,.99);

      border: 1px solid rgba(143,163,184,.25);

      border-radius: 17px;

      box-shadow: 0 20px 55px rgba(14,31,60,.14);

      opacity: 0;

      visibility: hidden;

      pointer-events: none;

      transform: translateY(-7px);

      transition:
        opacity .22s ease,
        transform .22s ease,
        visibility .22s ease;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-search.is-open {

      opacity: 1;

      visibility: visible;

      pointer-events: auto;

      transform: translateY(0);
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-search-input {

      width: 100%;
      height: 48px;

      box-sizing: border-box;

      padding: 0 16px;

      border: 1px solid rgba(143,163,184,.40);

      border-radius: 13px;

      outline: none;

      background: #FFFDF9;

      color: var(--kapisa-charcoal);

      font-family: inherit;

      font-size: 14px;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-search-input:focus {

      border-color: var(--kapisa-gold);

      box-shadow:
        0 0 0 3px rgba(201,162,39,.10);
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-results {

      max-height: 55vh;

      overflow-y: auto;

      margin-top: 7px;
    }

    /* ---------------------------------------------
       MOBILE DRAWER
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__drawer {

      position: fixed !important;

      inset: 0 !important;

      width: 100vw !important;
      height: 100dvh !important;

      z-index: 100100 !important;

      display: block;

      background: rgba(14,31,60,.48);

      opacity: 0;
      visibility: hidden;
      pointer-events: none;

      transition:
        opacity .25s ease,
        visibility .25s ease;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer.is-open {

      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-panel {

      position: absolute !important;

      top: 0 !important;
      bottom: 0 !important;
      left: 0 !important;

      width: min(88vw, 390px);

      height: 100dvh !important;

      overflow-y: auto;

      overscroll-behavior: contain;

      box-sizing: border-box;

      background: #FAF7F0 !important;

      color: var(--kapisa-charcoal);

      padding:
        calc(18px + env(safe-area-inset-top))
        22px
        calc(105px + env(safe-area-inset-bottom));

      transform: translate3d(-105%,0,0);

      transition:
        transform .35s cubic-bezier(.2,.75,.2,1);

      box-shadow:
        18px 0 55px rgba(14,31,60,.20);
    }

    .kapisa-header-{{ ai_gen_id }}__drawer.is-open
    .kapisa-header-{{ ai_gen_id }}__drawer-panel {

      transform: translate3d(0,0,0);
    }

    /* ---------------------------------------------
       DRAWER HEADER
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__drawer-head {

      min-height: 56px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 24px;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-brand {

      color: var(--kapisa-navy);

      font-size: 19px;

      font-weight: 750;

      letter-spacing: .14em;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-close {

      width: 42px;
      height: 42px;

      border: 0;

      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      background: rgba(14,31,60,.07);

      color: var(--kapisa-navy);

      cursor: pointer;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-close svg {

      width: 19px;
      height: 19px;

      fill: none;

      stroke: currentColor;

      stroke-width: 1.6;

      stroke-linecap: round;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-label {

      margin: 0 0 8px;

      color: var(--kapisa-gold);

      font-size: 10px;

      font-weight: 800;

      letter-spacing: .12em;

      text-transform: uppercase;
    }

    /* ---------------------------------------------
       MOBILE DRAWER QUICK JUMP PILLS
       --------------------------------------------- */
    .kapisa-header-{{ ai_gen_id }}__drawer-pills {
      display: flex;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      margin: 0 -22px 18px;
      padding: 4px 22px 10px;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-pills::-webkit-scrollbar {
      display: none;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      background: #FFFFFF;
      border: 1px solid rgba(14, 31, 60, 0.12);
      border-radius: 999px;
      color: var(--kapisa-navy);
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      box-shadow: 0 2px 6px rgba(14, 31, 60, 0.04);
      transition: all 0.2s ease;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-pill:active {
      transform: scale(0.95);
      background: var(--kapisa-navy);
      color: #FAF7F0;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-pill.is-gold {
      background: rgba(201, 162, 39, 0.12);
      border-color: rgba(201, 162, 39, 0.4);
      color: #997300;
    }

    /* ---------------------------------------------
       DRAWER LIVE CONCIERGE CARD
       --------------------------------------------- */
    .kapisa-header-{{ ai_gen_id }}__drawer-concierge {
      margin-top: 22px;
      padding: 16px;
      border-radius: 16px;
      background: #FFFFFF;
      border: 1px solid rgba(14, 31, 60, 0.08);
      box-shadow: 0 4px 14px rgba(14, 31, 60, 0.04);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-concierge-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-concierge-title {
      font-size: 13px;
      font-weight: 750;
      color: var(--kapisa-navy);
      margin: 0;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-concierge-status {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 10px;
      font-weight: 700;
      color: #059669;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-concierge-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 6px #10B981;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-concierge-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 10px;
      background: #0E1F3C;
      color: #FAF7F0;
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-concierge-btn:active {
      transform: scale(0.97);
    }

    /* ---------------------------------------------
       MOBILE MENU
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__mobile-menu {

      list-style: none;

      margin: 0;
      padding: 0;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-item {

      border-bottom: 1px solid rgba(143,163,184,.22);
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-row {

      min-height: 57px;

      display: flex;
      align-items: center;

      gap: 8px;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-link {

      min-height: 57px;

      flex: 1;

      display: flex;
      align-items: center;

      color: var(--kapisa-navy);

      text-decoration: none;

      font-size: 16px;

      font-weight: 550;

      transition:
        color .18s ease;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-link:hover {

      color: var(--kapisa-gold);
    }

    /* Modern PLUS instead of arrows */

    .kapisa-header-{{ ai_gen_id }}__mobile-expand {

      width: 38px;
      height: 38px;

      flex: 0 0 38px;

      border: 0;

      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      background: rgba(14,31,60,.045);

      color: var(--kapisa-navy);

      cursor: pointer;

      transition:
        transform .2s ease,
        background .2s ease;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-expand:hover {

      background: rgba(14,31,60,.08);
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-expand svg {

      width: 17px;
      height: 17px;

      fill: none;

      stroke: currentColor;

      stroke-width: 1.6;

      stroke-linecap: round;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-item.is-expanded
    .kapisa-header-{{ ai_gen_id }}__mobile-expand {

      transform: rotate(45deg);
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-submenu {

      display: none;

      list-style: none;

      margin: 0 0 10px;

      padding: 0 0 0 13px;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-item.is-expanded >
    .kapisa-header-{{ ai_gen_id }}__mobile-submenu {

      display: block;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-submenu a {

      min-height: 43px;

      display: flex;
      align-items: center;

      color: #60646b;

      text-decoration: none;

      font-size: 13px;

      padding-left: 12px;

      border-left: 1px solid rgba(201,162,39,.35);
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-submenu a:hover {

      color: var(--kapisa-navy);
    }

    /* ---------------------------------------------
       MOBILE ACCOUNT AREA IN DRAWER
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__drawer-account {

      margin-top: 25px;

      padding: 15px;

      border-radius: 15px;

      background: rgba(14,31,60,.045);

      border: 1px solid rgba(143,163,184,.20);
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-account-title {

      color: var(--kapisa-navy);

      font-size: 13px;

      font-weight: 700;

      margin-bottom: 10px;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-account-links {

      display: grid;

      gap: 4px;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-account-link {

      min-height: 40px;

      display: flex;
      align-items: center;

      color: var(--kapisa-charcoal);

      text-decoration: none;

      font-size: 12px;
    }

    .kapisa-header-{{ ai_gen_id }}__drawer-account-link:hover {

      color: var(--kapisa-gold);
    }

    /* ---------------------------------------------
       MOBILE BOTTOM NAV
       --------------------------------------------- */

    .kapisa-header-{{ ai_gen_id }}__bottom-nav {

      position: fixed;

      left: 10px;
      right: 10px;

      bottom: calc(8px + env(safe-area-inset-bottom));

      z-index: 99980;

      height: 66px;

      display: grid;

      grid-template-columns: repeat(5, 1fr);

      align-items: center;

      padding: 4px;

      box-sizing: border-box;

      background: rgba(250,247,240,.95);

      backdrop-filter: blur(20px) saturate(130%);
      -webkit-backdrop-filter: blur(20px) saturate(130%);

      border: 1px solid rgba(143,163,184,.25);

      border-radius: 21px;

      box-shadow:
        0 12px 42px rgba(14,31,60,.15);
    }

    .kapisa-header-{{ ai_gen_id }}__bottom-link {

      position: relative;

      height: 57px;

      display: flex;

      flex-direction: column;

      align-items: center;
      justify-content: center;

      gap: 3px;

      color: #747983;

      text-decoration: none;

      font-size: 8.5px;

      font-weight: 650;

      border-radius: 16px;

      border: 0;

      background: transparent;

      cursor: pointer;

      font-family: inherit;

      -webkit-tap-highlight-color: transparent;

      transition:
        color .18s ease,
        background .18s ease,
        transform .18s ease;
    }

    .kapisa-header-{{ ai_gen_id }}__bottom-link:active {

      transform: scale(.93);
    }

    .kapisa-header-{{ ai_gen_id }}__bottom-link.is-active {

      color: var(--kapisa-navy);

      background: rgba(14,31,60,.055);
    }

    .kapisa-header-{{ ai_gen_id }}__bottom-link svg {

      width: 20px;
      height: 20px;

      fill: none;

      stroke: currentColor;

      stroke-width: 1.65;

      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-badge {

      position: absolute;

      top: 3px;

      right: calc(50% - 18px);

      min-width: 15px;
      height: 15px;

      padding: 0 3px;

      box-sizing: border-box;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 999px;

      background: var(--kapisa-gold);

      color: var(--kapisa-navy);

      border: 2px solid var(--kapisa-cream);

      font-size: 8px;

      font-weight: 800;
    }

    .kapisa-header-{{ ai_gen_id }}__mobile-wishlist-badge {

      background: var(--kapisa-navy);

      color: var(--kapisa-cream);
    }

    /* Bottom nav account avatar */

    .kapisa-header-{{ ai_gen_id }}__account-dot {

      width: 20px;
      height: 20px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background: var(--kapisa-navy);

      color: var(--kapisa-cream);

      font-size: 9px;
      font-weight: 750;
    }

    /* Mobile page room for bottom nav */

    body {

      padding-bottom:
        calc(91px + env(safe-area-inset-bottom));
    }
  }

  /* =========================================================
     DESKTOP ONLY HIDE MOBILE
     ========================================================= */

  @media (min-width: 750px) {

    .kapisa-header-{{ ai_gen_id }}__drawer,
    .kapisa-header-{{ ai_gen_id }}__bottom-nav {

      display: none !important;
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .kapisa-header-{{ ai_gen_id }},
    .kapisa-header-{{ ai_gen_id }} *,
    .kapisa-header-{{ ai_gen_id }}__bottom-nav {

      transition: none !important;
      animation: none !important;
    }
  }

{% endstyle %}


<!-- =========================================================
     HEADER SPACER
     ========================================================= -->

<div
  class="kapisa-header-spacer-{{ ai_gen_id }}"
  aria-hidden="true"
></div>


<!-- =========================================================
     MAIN HEADER
     ========================================================= -->

<header
  class="
    kapisa-header-{{ ai_gen_id }}
    {% if block.settings.always_visible %}
      kapisa-header--fixed
    {% else %}
      kapisa-header--static
    {% endif %}
  "
  data-kapisa-header="true"
  data-always-visible="{{ block.settings.always_visible }}"
  {{ block.shopify_attributes }}
>

  <div class="kapisa-header-{{ ai_gen_id }}__main">

    <!-- =====================================================
         LOGO
         ===================================================== -->

    <a
      class="kapisa-header-{{ ai_gen_id }}__brand"
      href="{{ routes.root_url }}"
      aria-label="{{ shop.name | escape }}"
    >

      {% if block.settings.logo != blank %}

        <img
          class="kapisa-header-{{ ai_gen_id }}__logo"
          src="{{ block.settings.logo | image_url: width: 700 }}"
          alt="{{ shop.name | escape }}"
          loading="eager"
          width="{{ block.settings.logo_width }}"
          height="auto"
        >

      {% else %}

        <span class="kapisa-header-{{ ai_gen_id }}__wordmark">
          {{ block.settings.brand_name | default: shop.name | escape }}
        </span>

      {% endif %}

    </a>


    <!-- =====================================================
         DESKTOP NAVIGATION
         ===================================================== -->

    <nav
      class="kapisa-header-{{ ai_gen_id }}__desktop-nav"
      aria-label="{{ block.settings.menu_aria_label | escape }}"
    >

      {% assign main_menu = block.settings.main_menu %}

      {% if main_menu != blank %}

        {% for link in main_menu.links %}

          <div class="kapisa-header-{{ ai_gen_id }}__menu-item">

            <a
              class="kapisa-header-{{ ai_gen_id }}__menu-link"
              href="{{ link.url }}"
            >

              {{ link.title | escape }}

              {% if link.links != blank %}

                <svg
                  class="kapisa-header-{{ ai_gen_id }}__chevron"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  aria-hidden="true"
                >
                  <path d="m2.5 4 3.5 3.5L9.5 4"/>
                </svg>

              {% endif %}

            </a>


            {% if link.links != blank %}

              <div class="kapisa-header-{{ ai_gen_id }}__dropdown">

                {% for child_link in link.links %}

                  <div class="kapisa-header-{{ ai_gen_id }}__dropdown-item">

                    <a
                      class="kapisa-header-{{ ai_gen_id }}__dropdown-link"
                      href="{{ child_link.url }}"
                    >

                      <span>
                        {{ child_link.title | escape }}
                      </span>

                      {% if child_link.links != blank %}
                        <span aria-hidden="true">→</span>
                      {% endif %}

                    </a>


                    {% if child_link.links != blank %}

                      <div class="kapisa-header-{{ ai_gen_id }}__dropdown">

                        {% for grandchild_link in child_link.links %}

                          <a
                            class="kapisa-header-{{ ai_gen_id }}__dropdown-link"
                            href="{{ grandchild_link.url }}"
                          >
                            {{ grandchild_link.title | escape }}
                          </a>

                        {% endfor %}

                      </div>

                    {% endif %}

                  </div>

                {% endfor %}

              </div>

            {% endif %}

          </div>

        {% endfor %}

      {% else %}

        <a
          class="kapisa-header-{{ ai_gen_id }}__menu-link"
          href="{{ routes.all_products_collection_url }}"
        >
          Shop
        </a>

        <a
          class="kapisa-header-{{ ai_gen_id }}__menu-link"
          href="/pages/about"
        >
          About
        </a>

        <a
          class="kapisa-header-{{ ai_gen_id }}__menu-link"
          href="/pages/contact"
        >
          Contact
        </a>

      {% endif %}

    </nav>


    <!-- =====================================================
         DESKTOP ACTIONS
         Search / Wishlist / Account / Cart
         ===================================================== -->

    <div class="kapisa-header-{{ ai_gen_id }}__actions">


      <!-- SEARCH -->

      {% if block.settings.enable_search %}

        <div
          class="kapisa-header-{{ ai_gen_id }}__search-wrap"
          data-desktop-search
        >

          <input
            class="kapisa-header-{{ ai_gen_id }}__search-input"
            type="search"
            placeholder="{{ block.settings.search_placeholder | escape }}"
            autocomplete="off"
            aria-label="{{ block.settings.search_aria_label | escape }}"
            data-desktop-search-input
          >

          <div
            class="kapisa-header-{{ ai_gen_id }}__search-results"
            data-desktop-results
          ></div>

        </div>

        <button
          class="kapisa-header-{{ ai_gen_id }}__action"
          type="button"
          aria-label="{{ block.settings.search_button_label | escape }}"
          aria-expanded="false"
          data-desktop-search-toggle
        >

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.3"></circle>
            <path d="m15.5 15.5 5 5"></path>
          </svg>

        </button>

      {% endif %}


      <!-- WISHLIST -->

      {% if block.settings.enable_wishlist %}

        <a
          class="kapisa-header-{{ ai_gen_id }}__action"
          href="{{ block.settings.wishlist_page_url | default: '/pages/wishlist' }}"
          aria-label="Wishlist"
        >

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.8 8.8c0 5.5-8.8 10.2-8.8 10.2S3.2 14.3 3.2 8.8A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 8.8 2.7Z"></path>
          </svg>

          <span
            class="kapisa-header-{{ ai_gen_id }}__wishlist-badge"
            data-wishlist-count
            hidden
          >
            0
          </span>

        </a>

      {% endif %}


      <!-- ACCOUNT -->

      <div class="kapisa-header-{{ ai_gen_id }}__account-wrap">

        <a
          class="kapisa-header-{{ ai_gen_id }}__action"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          aria-label="{% if customer %}My account{% else %}Login or register{% endif %}"
        >

          <svg viewBox="0 0 24 24" aria-hidden="true">

            {% if customer %}

              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5.5 20c.8-3.4 3-5.1 6.5-5.1s5.7 1.7 6.5 5.1"></path>

            {% else %}

              <circle cx="12" cy="8" r="3"></circle>
              <path d="M5 20c.7-3.2 3-5 7-5s6.3 1.8 7 5"></path>

            {% endif %}

          </svg>

        </a>


        <!-- Account dropdown -->

        <div class="kapisa-header-{{ ai_gen_id }}__account-menu">

          {% if customer %}

            <div class="kapisa-header-{{ ai_gen_id }}__account-heading">
              {{ customer.first_name | default: 'My account' | escape }}
            </div>

            <a
              class="kapisa-header-{{ ai_gen_id }}__account-link"
              href="{{ routes.account_url }}"
            >
              My account
            </a>

            <a
              class="kapisa-header-{{ ai_gen_id }}__account-link"
              href="{{ routes.account_url }}#orders"
            >
              My orders
            </a>

            <a
              class="kapisa-header-{{ ai_gen_id }}__account-link"
              href="{{ routes.account_addresses_url }}"
            >
              Addresses
            </a>

            <a
              class="kapisa-header-{{ ai_gen_id }}__account-link"
              href="{{ block.settings.wishlist_page_url | default: '/pages/wishlist' }}"
            >
              Wishlist
            </a>

            <div class="kapisa-header-{{ ai_gen_id }}__account-divider"></div>

            <a
              class="kapisa-header-{{ ai_gen_id }}__account-link"
              href="{{ routes.account_logout_url }}"
            >
              Log out
            </a>

          {% else %}

            <div class="kapisa-header-{{ ai_gen_id }}__account-heading">
              Welcome to Kapisa
            </div>

            <a
              class="kapisa-header-{{ ai_gen_id }}__account-link"
              href="{{ routes.account_login_url }}"
            >
              Log in
            </a>

            <a
              class="kapisa-header-{{ ai_gen_id }}__account-link"
              href="{{ routes.account_register_url }}"
            >
              Create account
            </a>

            <a
              class="kapisa-header-{{ ai_gen_id }}__account-link"
              href="{{ block.settings.wishlist_page_url | default: '/pages/wishlist' }}"
            >
              Wishlist
            </a>

          {% endif %}

        </div>

      </div>


      <!-- CART -->

      {% if block.settings.show_cart %}

        <a
          class="kapisa-header-{{ ai_gen_id }}__action"
          href="{{ routes.cart_url }}"
          aria-label="Cart with {{ cart.item_count }} items"
        >

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 5h2l1.6 10h9.9L20 8H7"></path>
            <circle cx="9" cy="19" r="1"></circle>
            <circle cx="17" cy="19" r="1"></circle>
          </svg>

          {% if block.settings.show_cart_count and cart.item_count > 0 %}

            <span class="kapisa-header-{{ ai_gen_id }}__cart-badge">
              {{ cart.item_count }}
            </span>

          {% endif %}

        </a>

      {% endif %}

    </div>


    <!-- =====================================================
         MOBILE TOP CONTROLS
         Hamburger + Search
         ===================================================== -->

    <div class="kapisa-header-{{ ai_gen_id }}__mobile-controls">

      <div class="kapisa-header-{{ ai_gen_id }}__mobile-left">

        <button
          class="kapisa-header-{{ ai_gen_id }}__mobile-icon"
          type="button"
          aria-label="{{ block.settings.mobile_menu_label | escape }}"
          aria-expanded="false"
          data-mobile-menu-open="{{ ai_gen_id }}"
        >

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 17h16"></path>
          </svg>

        </button>

      </div>


      <div class="kapisa-header-{{ ai_gen_id }}__mobile-right">

        {% if block.settings.enable_search %}

          <button
            class="kapisa-header-{{ ai_gen_id }}__mobile-icon"
            type="button"
            aria-label="{{ block.settings.search_button_label | escape }}"
            aria-expanded="false"
            data-mobile-search-open="{{ ai_gen_id }}"
          >

            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10.8" cy="10.8" r="6.3"></circle>
              <path d="m15.5 15.5 5 5"></path>
            </svg>

          </button>

        {% endif %}

      </div>

    </div>

  </div>


  <!-- =======================================================
       MOBILE SEARCH
       ======================================================= -->

  {% if block.settings.enable_search %}

    <div
      class="kapisa-header-{{ ai_gen_id }}__mobile-search"
      data-mobile-search="{{ ai_gen_id }}"
    >

      <input
        class="kapisa-header-{{ ai_gen_id }}__mobile-search-input"
        type="search"
        placeholder="{{ block.settings.mobile_search_placeholder | escape }}"
        autocomplete="off"
        aria-label="{{ block.settings.search_aria_label | escape }}"
        data-mobile-search-input
      >

      <div
        class="kapisa-header-{{ ai_gen_id }}__mobile-results"
        data-mobile-results
      ></div>

    </div>

  {% endif %}

</header>


<!-- =========================================================
     MOBILE DRAWER
     ========================================================= -->

<div
  class="kapisa-header-{{ ai_gen_id }}__drawer"
  data-mobile-drawer="{{ ai_gen_id }}"
  aria-hidden="true"
>

