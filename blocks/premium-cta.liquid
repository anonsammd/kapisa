{% doc %}
  Elevated final Call-to-Action section for the Kapisa Healthcare About Us page.
  Features luxury clinical typography, dual action triggers (Shop + Hospital Concierge),
  clinical assurance badges, and responsive native-app mobile layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign cta_link = block.settings.button_link | default: '/collections/all' %}

{% style %}
  .ai-cta-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: #0E1F3C;
    color: #FAF7F0;
    padding: clamp(72px, 8vw, 116px) 24px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  /* Subtle ambient radial glow */
  .ai-cta-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    bottom: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 300px;
    background: radial-gradient(circle, rgba(201, 162, 39, 0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .ai-cta-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent | default: 100 }}%;
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .ai-cta-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 16px;
    color: #C9A227;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ai-cta-{{ ai_gen_id }}__line {
    width: 48px;
    height: 2px;
    margin: 0 auto 24px;
    background: #C9A227;
  }

  .ai-cta-{{ ai_gen_id }}__heading {
    margin: 0;
    color: #FAF7F0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 4.2vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 400;
  }

  .ai-cta-{{ ai_gen_id }}__description {
    max-width: 640px;
    margin: 20px auto 36px;
    color: rgba(250, 247, 240, 0.85);
    font-size: clamp(16px, 1.1vw, 18px);
    line-height: 1.7;
  }

  .ai-cta-{{ ai_gen_id }}__buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .ai-cta-{{ ai_gen_id }}__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 34px;
    border: 1px solid #FAF7F0;
    border-radius: 4px;
    background: #FAF7F0;
    color: #0E1F3C;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 220ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .ai-cta-{{ ai_gen_id }}__button:hover,
  .ai-cta-{{ ai_gen_id }}__button:focus-visible {
    background: #C9A227;
    border-color: #C9A227;
    color: #0E1F3C;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(201, 162, 39, 0.4);
  }

  .ai-cta-{{ ai_gen_id }}__button--secondary {
    background: transparent;
    border-color: rgba(250, 247, 240, 0.35);
    color: #FAF7F0;
    box-shadow: none;
  }

  .ai-cta-{{ ai_gen_id }}__button--secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: #FAF7F0;
    color: #FAF7F0;
    box-shadow: none;
  }

  /* Trust Badges Strip */
  .ai-cta-{{ ai_gen_id }}__badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 36px);
    flex-wrap: wrap;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ai-cta-{{ ai_gen_id }}__badge-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: rgba(250, 247, 240, 0.8);
    letter-spacing: 0.04em;
  }

  .ai-cta-{{ ai_gen_id }}__badge-item svg {
    color: #C9A227;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-cta-{{ ai_gen_id }} {
      padding: 56px 20px 64px;
    }
    .ai-cta-{{ ai_gen_id }}__buttons {
      flex-direction: column;
      width: 100%;
    }
    .ai-cta-{{ ai_gen_id }}__button {
      width: 100%;
    }
    .ai-cta-{{ ai_gen_id }}__badges {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
      max-width: 280px;
      margin: 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-cta-{{ ai_gen_id }}__button {
      transition: none !important;
      transform: none !important;
    }
  }
{% endstyle %}

<section class="ai-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }} aria-labelledby="cta-heading-{{ ai_gen_id }}">
  <div class="ai-cta-{{ ai_gen_id }}__inner">
    
    <div class="ai-cta-{{ ai_gen_id }}__eyebrow">
      <span>&#10022;</span>
      Enterprise Clinical Comfort
    </div>

    <div class="ai-cta-{{ ai_gen_id }}__line" aria-hidden="true"></div>

    <h2 id="cta-heading-{{ ai_gen_id }}" class="ai-cta-{{ ai_gen_id }}__heading">
      {{ block.settings.heading | default: "Designed for Your Everyday Care" | escape }}
    </h2>

    <p class="ai-cta-{{ ai_gen_id }}__description">
      {{ block.settings.description | default: "Thoughtfully designed scrubs to support your comfort, confidence, and care every day." | escape }}
    </p>

    <div class="ai-cta-{{ ai_gen_id }}__buttons">
      <a class="ai-cta-{{ ai_gen_id }}__button" href="{{ cta_link }}">
        {{ block.settings.button_label | default: "Shop All Scrubs" | escape }}
      </a>
      <a class="ai-cta-{{ ai_gen_id }}__button ai-cta-{{ ai_gen_id }}__button--secondary" href="/pages/contact">
        Hospital &amp; Bulk Orders &rarr;
      </a>
    </div>

    <div class="ai-cta-{{ ai_gen_id }}__badges">
      <div class="ai-cta-{{ ai_gen_id }}__badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        30-Day Clinical Wear Trial
      </div>
      <div class="ai-cta-{{ ai_gen_id }}__badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        Complimentary Fabric Swatches
      </div>
      <div class="ai-cta-{{ ai_gen_id }}__badge-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        Expedited Hospital Delivery
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About us CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for Your Everyday Care"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thoughtfully designed scrubs to support your comfort, confidence, and care every day."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop All Scrubs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "About us CTA"
    }
  ],
  "tag": null,
  "class": "premium-cta-block"
}
{% endschema %}