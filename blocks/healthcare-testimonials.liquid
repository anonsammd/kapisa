{% doc %}
  Ultra-modern clinician social proof showcase featuring interactive specialty filters,
  3-up elevated review cards, verified doctor badges, and luxury typography.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent | default: 100 }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: clamp(52px, 6vw, 84px) 24px;
    background: #FAF9F6;
    color: #0E1F3C;
    box-sizing: border-box;
    position: relative;
  }

  .ai-testimonials-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Header */
  .ai-testimonials-{{ ai_gen_id }}__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(36px, 4vw, 48px);
  }

  .ai-testimonials-{{ ai_gen_id }}__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #C9A227;
    margin-bottom: 8px;
  }

  .ai-testimonials-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    color: #0E1F3C;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .ai-testimonials-{{ ai_gen_id }}__subtitle {
    margin: 0;
    color: #64748B;
    font-size: 15px;
    line-height: 1.6;
  }

  /* Specialty Filter Tabs */
  .ai-testimonials-{{ ai_gen_id }}__filters {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .ai-testimonials-{{ ai_gen_id }}__filter-btn {
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.12);
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 20px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 8px rgba(14, 31, 60, 0.04);
  }

  .ai-testimonials-{{ ai_gen_id }}__filter-btn.is-active,
  .ai-testimonials-{{ ai_gen_id }}__filter-btn:hover {
    background: #0E1F3C;
    color: #FAF7F0;
    border-color: #0E1F3C;
    box-shadow: 0 6px 18px rgba(14, 31, 60, 0.2);
    transform: translateY(-2px);
  }

  /* Multi-Card Elevated Showcase */
  .ai-testimonials-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .ai-testimonials-{{ ai_gen_id }}__card {
    background: #FFFFFF;
    border: 1px solid rgba(14, 31, 60, 0.08);
    border-radius: 24px;
    padding: clamp(24px, 3vw, 32px);
    box-shadow: 0 12px 35px -10px rgba(14, 31, 60, 0.06);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, opacity 0.3s ease;
  }

  .ai-testimonials-{{ ai_gen_id }}__card:hover {
    transform: translateY(-8px);
    border-color: rgba(201, 162, 39, 0.4);
    box-shadow: 0 25px 50px -15px rgba(14, 31, 60, 0.12);
  }

  .ai-testimonials-{{ ai_gen_id }}__card.is-hidden {
    display: none !important;
  }

  .ai-testimonials-{{ ai_gen_id }}__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .ai-testimonials-{{ ai_gen_id }}__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(5, 150, 105, 0.08);
    color: #059669;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-testimonials-{{ ai_gen_id }}__badge svg {
    width: 12px;
    height: 12px;
  }

  .ai-testimonials-{{ ai_gen_id }}__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: #D97706;
  }

  .ai-testimonials-{{ ai_gen_id }}__stars svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }

  .ai-testimonials-{{ ai_gen_id }}__quote {
    color: #1E293B;
    font-size: 15px;
    line-height: 1.65;
    font-weight: 500;
    margin: 0 0 24px;
    flex: 1;
    position: relative;
  }

  .ai-testimonials-{{ ai_gen_id }}__quote::before {
    content: "“";
    font-family: Georgia, serif;
    font-size: 38px;
    color: rgba(201, 162, 39, 0.25);
    line-height: 1;
    position: absolute;
    top: -12px;
    left: -10px;
  }

  .ai-testimonials-{{ ai_gen_id }}__author-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid #F1F5F9;
    margin-top: auto;
  }

  .ai-testimonials-{{ ai_gen_id }}__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0E1F3C, #1E3A8A);
    color: #C9A227;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.05em;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(14, 31, 60, 0.15);
    border: 2px solid #FAF7F0;
  }

  .ai-testimonials-{{ ai_gen_id }}__author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-testimonials-{{ ai_gen_id }}__name {
    color: #0E1F3C;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .ai-testimonials-{{ ai_gen_id }}__role {
    color: #64748B;
    font-size: 11px;
    line-height: 1.35;
    font-weight: 600;
  }

  .ai-testimonials-{{ ai_gen_id }}__dept-pill {
    display: inline-block;
    color: #C9A227;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  @media (max-width: 1024px) {
    .ai-testimonials-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-testimonials-{{ ai_gen_id }}__card:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-testimonials-{{ ai_gen_id }}__card,
    .ai-testimonials-{{ ai_gen_id }}__filter-btn {
      transition: none;
    }
  }
{% endstyle %}

<healthcare-testimonials-{{ ai_gen_id }} class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
