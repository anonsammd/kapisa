    </div>

  </div>
</healthcare-testimonials-{{ ai_gen_id }}>

<script>
(function() {
  class HealthcareTestimonials{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      const root = this;
      const buttons = root.querySelectorAll('.ai-testimonials-{{ ai_gen_id }}__filter-btn');
      const cards = root.querySelectorAll('.ai-testimonials-{{ ai_gen_id }}__card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');

          const cat = btn.dataset.cat;

          cards.forEach(card => {
            const cardCat = card.dataset.cat || '';
            const match = (cat === 'all' || cardCat.includes(cat));

            if (match) {
              card.classList.remove('is-hidden');
              requestAnimationFrame(() => {
                card.style.opacity = '1';
                card.style.transform = 'translateY(0) scale(1)';
              });
            } else {
              card.style.opacity = '0';
              card.style.transform = 'translateY(12px) scale(0.96)';
              setTimeout(() => {
                if (!match) {
                  card.classList.add('is-hidden');
                }
              }, 250);
            }
          });
        });
      });
    }
  }
  if (!customElements.get('healthcare-testimonials-{{ ai_gen_id }}')) {
    customElements.define('healthcare-testimonials-{{ ai_gen_id }}', HealthcareTestimonials{{ ai_gen_id }});
  }
})();
</script>

