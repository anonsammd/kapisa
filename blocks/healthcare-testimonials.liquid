{% doc %}
  @prompt
    Design a modern, modern-luxury 'Loved by Healthcare Heroes' testimonial section built with tight content scaling and balanced proportions.
    
    Colors & Background:
    
    Background: Deep Navy (#0E1F3C).
    
    Text Accent & Icons: Warm Gold (#C9A227).
    
    Body Text & Subtitles: Crisp Off-White (#F9F9F6).
    
    Sizing, Width & Padding Constraints (Fix Full-Screen Oversizing):
    
    Section Vertical Padding: Medium padding (60px top/bottom on desktop, 40px on mobile). Do not span full screen height.
    
    Max Content Width: Constrain the entire text block and heading inner content to a centered max-width of 760px (max-width: 760px; margin: 0 auto;).
    
    Content & Typography Hierarchy:
    
    Title: Centered heading 'Loved by Healthcare Heroes' (32px font size, clean bold sans-serif).
    
    Subtitle: Small off-white subtitle below the title (15px, 70% opacity): 'Real stories from professionals on the front lines.'
    
    Quote Icon: Small, elegant gold double-quote mark (#C9A227) placed above the stars.
    
    Star Rating: Neat horizontal row of 5 gold vector stars, scaled to 18px.
    
    Quote Text: Centered quote in off-white (20px to 22px font size, relaxed line-height of 1.5, semi-bold).
    
    Author Info: Reviewer name and title (e.g., 'DR. ADITI SHARMA, CARDIOLOGIST') in small gold text (#C9A227, 13px, uppercase with letter-spacing: 1.5px).
    
    Carousel Controls & Animation:
    
    Fade Transition: Smooth cross-fade animation every 6 seconds.
    
    Active Dot Navigation: Small circular dots centered at the bottom. Active dot expands into a 24px wide gold pill (#C9A227), inactive dots stay small 8px transparent gold rings."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 60px 24px;
    background: #0E1F3C;
    color: #F9F9F6;
    box-sizing: border-box;
  }

  .ai-testimonials-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-testimonials-{{ ai_gen_id }}__heading {
    margin: 0;
    color: #F9F9F6;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ai-testimonials-{{ ai_gen_id }}__subtitle {
    margin: 10px 0 0;
    color: #F9F9F6;
    opacity: 0.7;
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-testimonials-{{ ai_gen_id }}__slides {
    position: relative;
    min-height: 245px;
    margin-top: 28px;
  }

  .ai-testimonials-{{ ai_gen_id }}__slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms ease, visibility 500ms ease;
  }

  .ai-testimonials-{{ ai_gen_id }}__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .ai-testimonials-{{ ai_gen_id }}__quote-mark {
    margin-bottom: 10px;
    color: #C9A227;
    font-family: Georgia, serif;
    font-size: 42px;
    line-height: 0.7;
  }

  .ai-testimonials-{{ ai_gen_id }}__stars {
    display: flex;
    gap: 4px;
    color: #C9A227;
  }

  .ai-testimonials-{{ ai_gen_id }}__star {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .ai-testimonials-{{ ai_gen_id }}__quote {
    max-width: 680px;
    margin: 20px auto 0;
    color: #F9F9F6;
    font-size: 21px;
    line-height: 1.5;
    font-weight: 600;
  }

  .ai-testimonials-{{ ai_gen_id }}__author {
    margin: 22px 0 0;
    color: #C9A227;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .ai-testimonials-{{ ai_gen_id }}__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
  }

  .ai-testimonials-{{ ai_gen_id }}__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 1px solid #C9A227;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .ai-testimonials-{{ ai_gen_id }}__dot.is-active {
    width: 24px;
    border-radius: 20px;
    background: #C9A227;
  }

  .ai-testimonials-{{ ai_gen_id }}__dot:focus-visible {
    outline: 2px solid #F9F9F6;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-testimonials-{{ ai_gen_id }}__heading {
      font-size: 28px;
    }

    .ai-testimonials-{{ ai_gen_id }}__quote {
      font-size: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-testimonials-{{ ai_gen_id }}__slide {
      transition: none;
    }
  }
{% endstyle %}

<healthcare-testimonials-{{ ai_gen_id }} class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-{{ ai_gen_id }}__inner">
    <h2 class="ai-testimonials-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
    <p class="ai-testimonials-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle }}</p>

    <div class="ai-testimonials-{{ ai_gen_id }}__slides" aria-live="polite">
      {% assign active_slide = true %}
      {% for i in (1..3) %}
        {% liquid
          assign enabled_key = 'testimonial_' | append: i | append: '_enabled'
          assign quote_key = 'testimonial_' | append: i | append: '_quote'
          assign author_key = 'testimonial_' | append: i | append: '_author'
          assign enabled = block.settings[enabled_key]
          assign quote = block.settings[quote_key]
          assign author = block.settings[author_key]
        %}
        {% if enabled and quote != blank and author != blank %}
          <article class="ai-testimonials-{{ ai_gen_id }}__slide{% if active_slide %} is-active{% endif %}" data-slide="{{ i }}" {% unless active_slide %}aria-hidden="true"{% endunless %}>
            <div class="ai-testimonials-{{ ai_gen_id }}__quote-mark" aria-hidden="true">“</div>
            <div class="ai-testimonials-{{ ai_gen_id }}__stars" aria-label="5 out of 5 stars">
              {% for star in (1..5) %}
                <svg class="ai-testimonials-{{ ai_gen_id }}__star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.56L12 17.52l-5.88 3.1 1.12-6.56-4.76-4.64 6.58-.96L12 2.5z"/></svg>
              {% endfor %}
            </div>
            <p class="ai-testimonials-{{ ai_gen_id }}__quote">{{ quote }}</p>
            <p class="ai-testimonials-{{ ai_gen_id }}__author">{{ author }}</p>
          </article>
          {% assign active_slide = false %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-testimonials-{{ ai_gen_id }}__dots" role="tablist" aria-label="Testimonial navigation">
      {% assign dot_index = 0 %}
      {% for i in (1..3) %}
        {% assign enabled_key = 'testimonial_' | append: i | append: '_enabled' %}
        {% assign quote_key = 'testimonial_' | append: i | append: '_quote' %}
        {% assign author_key = 'testimonial_' | append: i | append: '_author' %}
        {% if block.settings[enabled_key] and block.settings[quote_key] != blank and block.settings[author_key] != blank %}
          {% assign dot_index = dot_index | plus: 1 %}
          <button class="ai-testimonials-{{ ai_gen_id }}__dot{% if dot_index == 1 %} is-active{% endif %}" type="button" role="tab" aria-label="Show testimonial {{ dot_index }}" aria-selected="{% if dot_index == 1 %}true{% else %}false{% endif %}" data-target="{{ i }}"></button>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</healthcare-testimonials-{{ ai_gen_id }}>

<script>
  (function() {
    class HealthcareTestimonials{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('[data-slide]'));
        this.dots = Array.from(this.querySelectorAll('[data-target]'));
        this.current = 0;
        this.dots.forEach((dot, index) => dot.addEventListener('click', () => this.show(index)));
        if (this.slides.length > 1) {
          this.timer = window.setInterval(() => this.show((this.current + 1) % this.slides.length), 6000);
        }
      }

      show(index) {
        this.slides[this.current].classList.remove('is-active');
        this.slides[this.current].setAttribute('aria-hidden', 'true');
        this.dots[this.current].classList.remove('is-active');
        this.dots[this.current].setAttribute('aria-selected', 'false');
        this.current = index;
        this.slides[this.current].classList.add('is-active');
        this.slides[this.current].removeAttribute('aria-hidden');
        this.dots[this.current].classList.add('is-active');
        this.dots[this.current].setAttribute('aria-selected', 'true');
      }
    }
    if (!customElements.get('healthcare-testimonials-{{ ai_gen_id }}')) {
      customElements.define('healthcare-testimonials-{{ ai_gen_id }}', HealthcareTestimonials{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Healthcare testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Healthcare Heroes" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Real stories from professionals on the front lines." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Testimonial 1" },
    { "type": "checkbox", "id": "testimonial_1_enabled", "label": "Show testimonial 1", "default": true },
    { "type": "text", "id": "testimonial_1_quote", "label": "Quote 1", "default": "The thoughtful design makes every long shift feel a little more supported." },
    { "type": "text", "id": "testimonial_1_author", "label": "Author 1", "default": "DR. ADITI SHARMA, CARDIOLOGIST" },
    { "type": "header", "content": "Testimonial 2" },
    { "type": "checkbox", "id": "testimonial_2_enabled", "label": "Show testimonial 2", "default": true },
    { "type": "text", "id": "testimonial_2_quote", "label": "Quote 2", "default": "Reliable, refined, and made for the people who care for others every day." },
    { "type": "text", "id": "testimonial_2_author", "label": "Author 2", "default": "MAYA LEWIS, ICU NURSE" },
    { "type": "header", "content": "Testimonial 3" },
    { "type": "checkbox", "id": "testimonial_3_enabled", "label": "Show testimonial 3", "default": true },
    { "type": "text", "id": "testimonial_3_quote", "label": "Quote 3", "default": "A beautiful daily reminder that comfort and professionalism can go hand in hand." },
    { "type": "text", "id": "testimonial_3_author", "label": "Author 3", "default": "JORDAN REED, PARAMEDIC" }
  ],
  "presets": [{ "name": "Healthcare testimonials" }],
  "tag": null,
  "class": "healthcare-testimonials-block"
}
{% endschema %}