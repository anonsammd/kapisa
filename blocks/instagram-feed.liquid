{% doc %}
  @prompt
    Create an Instagram feed section, off-white background. Heading '@kapisa_scrub — Join the Community' centered, with a small Instagram icon. Below, a horizontally scrollable (or grid on desktop, 6 columns) set of square image tiles with a subtle navy overlay and white Instagram icon appearing on hover, scale-up 105% on hover. Add a gold-outlined 'Follow Us' button below the grid, centered.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-instagram-feed-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-instagram-feed__inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
  }

  .ai-instagram-feed__heading-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin: 0 0 28px;
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 600;
    text-align: center;
  }

  .ai-instagram-feed__heading-icon-{{ ai_gen_id }} {
    display: inline-flex;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
  }

  .ai-instagram-feed__heading-icon-{{ ai_gen_id }} svg,
  .ai-instagram-feed__tile-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-instagram-feed__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: {{ block.settings.tile_gap }}px;
  }

  .ai-instagram-feed__tile-{{ ai_gen_id }} {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #e7e4dc;
  }

  .ai-instagram-feed__tile-{{ ai_gen_id }} img,
  .ai-instagram-feed__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .ai-instagram-feed__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-instagram-feed__placeholder-{{ ai_gen_id }} svg {
    color: #6a6d72;
  }

  .ai-instagram-feed__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(12, 30, 58, 0.58);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .ai-instagram-feed__tile-{{ ai_gen_id }}:hover img,
  .ai-instagram-feed__tile-{{ ai_gen_id }}:focus-within img {
    transform: scale(1.05);
  }

  .ai-instagram-feed__tile-{{ ai_gen_id }}:hover .ai-instagram-feed__overlay-{{ ai_gen_id }},
  .ai-instagram-feed__tile-{{ ai_gen_id }}:focus-within .ai-instagram-feed__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-instagram-feed__tile-icon-{{ ai_gen_id }} {
    width: 30px;
    height: 30px;
    color: #ffffff;
  }

  .ai-instagram-feed__button-wrap-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 30px;
  }

  .ai-instagram-feed__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 130px;
    padding: 12px 25px;
    border: 1px solid {{ block.settings.accent_color }};
    color: {{ block.settings.accent_color }};
    background: transparent;
    font-family: {{ block.settings.body_font.family }};
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .ai-instagram-feed__button-{{ ai_gen_id }}:hover,
  .ai-instagram-feed__button-{{ ai_gen_id }}:focus-visible {
    background: {{ block.settings.accent_color }};
    color: #121212;
  }

  .ai-instagram-feed__button-{{ ai_gen_id }}:focus-visible,
  .ai-instagram-feed__tile-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-instagram-feed-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-instagram-feed__heading-{{ ai_gen_id }} {
      margin-bottom: 22px;
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-instagram-feed__grid-{{ ai_gen_id }} {
      display: flex;
      gap: {{ block.settings.tile_gap }}px;
      overflow-x: auto;
      padding-bottom: 6px;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
    }

    .ai-instagram-feed__tile-{{ ai_gen_id }} {
      flex: 0 0 42vw;
      max-width: 190px;
      scroll-snap-align: start;
    }
  }
{% endstyle %}

<instagram-feed-{{ ai_gen_id }} class="ai-instagram-feed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-instagram-feed__inner-{{ ai_gen_id }}">
    <h2 class="ai-instagram-feed__heading-{{ ai_gen_id }}">
      <span class="ai-instagram-feed__heading-icon-{{ ai_gen_id }}" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
      </span>
      {{ block.settings.heading | escape }}
    </h2>

    <div class="ai-instagram-feed__grid-{{ ai_gen_id }}" aria-label="Instagram community images">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        <a class="ai-instagram-feed__tile-{{ ai_gen_id }}" href="{{ block.settings.instagram_link }}" aria-label="View Instagram post {{ i }}">
          {% if image != blank %}
            <img src="{{ image | image_url: width: 600 }}" alt="{{ image.alt | escape }}" loading="lazy" width="600" height="600">
          {% else %}
            <div class="ai-instagram-feed__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
          <span class="ai-instagram-feed__overlay-{{ ai_gen_id }}" aria-hidden="true">
            <span class="ai-instagram-feed__tile-icon-{{ ai_gen_id }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
            </span>
          </span>
        </a>
      {% endfor %}
    </div>

    <div class="ai-instagram-feed__button-wrap-{{ ai_gen_id }}">
      <a class="ai-instagram-feed__button-{{ ai_gen_id }}" href="{{ block.settings.instagram_link }}">{{ block.settings.button_label | escape }}</a>
    </div>
  </div>
</instagram-feed-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Instagram feed",
  "tag": null,
  "class": "instagram-feed-block",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@kapisa_scrub — Join the Community" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow Us" },
    { "type": "url", "id": "instagram_link", "label": "Instagram link" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "image_picker", "id": "image_6", "label": "Image 6" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 800, "max": 1600, "step": 100, "unit": "px", "default": 1200 },
    { "type": "range", "id": "section_padding", "label": "Section spacing", "min": 20, "max": 100, "step": 10, "unit": "px", "default": 60 },
    { "type": "range", "id": "tile_gap", "label": "Tile gap", "min": 4, "max": 24, "step": 4, "unit": "px", "default": 8 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F5EF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B18A3D" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 14, "max": 28, "step": 2, "unit": "px", "default": 18 }
  ],
  "presets": [{ "name": "Instagram feed" }]
}
{% endschema %}