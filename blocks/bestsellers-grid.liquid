{% doc %}
  @prompt
    Build a 'Bestsellers' product carousel section. Off-white background, section title left-aligned with a 'View All' text link (gold 
    #C9A227) right-aligned on the same row. Horizontally scrollable row of product cards (peek next card at edge on mobile), each card: clean product image with light gray placeholder background, product name in charcoal, price below, small color swatch dots row (pulling from the color_swatch metafield) under the price. On hover, show a subtle gold-outlined 'Quick Add' button sliding up from the bottom of the image. Card corners slightly rounded, no heavy borders, soft shadow only on hover. Add left/right scroll arrows that appear on hover, gold color, circular, semi-transparent background.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bestsellers-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-bestsellers__inner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-bestsellers__header-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .ai-bestsellers__title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
  }

  .ai-bestsellers__view-all-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .ai-bestsellers__viewport-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-bestsellers__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 4px 4px 12px;
  }

  .ai-bestsellers__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-bestsellers__card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.columns_desktop }});
    min-width: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-bestsellers__media-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1.12;
    overflow: hidden;
    border-radius: 8px;
    background: #e7e5e0;
  }

  .ai-bestsellers__media-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-bestsellers__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #77736b;
  }

  .ai-bestsellers__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-bestsellers__quick-add-{{ ai_gen_id }} {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    transform: translateY(18px);
    opacity: 0;
    padding: 10px 14px;
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.94);
    color: #5b4810;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .ai-bestsellers__card-{{ ai_gen_id }}:hover .ai-bestsellers__quick-add-{{ ai_gen_id }},
  .ai-bestsellers__card-{{ ai_gen_id }}:focus-within .ai-bestsellers__quick-add-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-bestsellers__name-{{ ai_gen_id }} {
    display: block;
    margin-top: 14px;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.35;
    text-decoration: none;
  }

  .ai-bestsellers__price-{{ ai_gen_id }} {
    margin-top: 6px;
    font-size: 14px;
  }

  .ai-bestsellers__swatches-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 9px;
  }

  .ai-bestsellers__swatch-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border: 1px solid rgba(18, 18, 18, 0.3);
    border-radius: 50%;
  }

  .ai-bestsellers__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 45%;
    z-index: 2;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: rgba(201, 162, 39, 0.85);
    color: #332805;
    cursor: pointer;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .ai-bestsellers__viewport-{{ ai_gen_id }}:hover .ai-bestsellers__arrow-{{ ai_gen_id }},
  .ai-bestsellers__arrow-{{ ai_gen_id }}:focus-visible {
    opacity: 1;
  }

  .ai-bestsellers__arrow--left-{{ ai_gen_id }} { left: -18px; }
  .ai-bestsellers__arrow--right-{{ ai_gen_id }} { right: -18px; }

  .ai-bestsellers__arrow-{{ ai_gen_id }}:focus-visible,
  .ai-bestsellers__view-all-{{ ai_gen_id }}:focus-visible,
  .ai-bestsellers__name-{{ ai_gen_id }}:focus-visible,
  .ai-bestsellers__quick-add-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #332805;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-bestsellers__inner-{{ ai_gen_id }} { width: 100%; padding: 0 16px; }
    .ai-bestsellers__card-{{ ai_gen_id }} { flex-basis: 78%; }
    .ai-bestsellers__arrow-{{ ai_gen_id }} { display: none; }
    .ai-bestsellers__title-{{ ai_gen_id }} { font-size: {{ block.settings.title_size | times: 0.85 }}px; }
  }
{% endstyle %}

<bestsellers-carousel-{{ ai_gen_id }} class="ai-bestsellers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bestsellers__inner-{{ ai_gen_id }}">
    <div class="ai-bestsellers__header-{{ ai_gen_id }}">
      <h2 class="ai-bestsellers__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% if block.settings.view_all_link != blank %}<a class="ai-bestsellers__view-all-{{ ai_gen_id }}" href="{{ block.settings.view_all_link }}">{{ block.settings.view_all_label }}</a>{% endif %}
    </div>
    {% assign target_collection = block.settings.collection | default: collections.all %}
    {% if target_collection.products != blank %}
      <div class="ai-bestsellers__viewport-{{ ai_gen_id }}">
        <button class="ai-bestsellers__arrow-{{ ai_gen_id }} ai-bestsellers__arrow--left-{{ ai_gen_id }}" type="button" aria-label="Scroll products left">&#8592;</button>
        <div class="ai-bestsellers__track-{{ ai_gen_id }}" data-track>
          {% for product in target_collection.products limit: block.settings.product_limit %}
            <article class="ai-bestsellers__card-{{ ai_gen_id }}">
              <div class="ai-bestsellers__media-{{ ai_gen_id }}">
                <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                  {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="1008">{% else %}<div class="ai-bestsellers__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
                </a>
                {% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="ai-bestsellers__quick-add-{{ ai_gen_id }}" type="submit"{% unless product.available %} disabled{% endunless %}>{% if product.available %}{{ block.settings.quick_add_label }}{% else %}Sold out{% endif %}</button>{% endform %}
              </div>
              <a class="ai-bestsellers__name-{{ ai_gen_id }}" href="{{ product.url }}">{{ product.title }}</a>
              <div class="ai-bestsellers__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
              {% assign swatches = product.metafields.custom.color_swatch.value %}
              {% if swatches != blank %}<div class="ai-bestsellers__swatches-{{ ai_gen_id }}" aria-label="Available colors">{% for swatch in swatches %}<span class="ai-bestsellers__swatch-{{ ai_gen_id }}" style="background-color: {{ swatch.value | default: swatch }};" title="{{ swatch.label | default: swatch | escape }}"></span>{% endfor %}</div>{% endif %}
            </article>
          {% endfor %}
        </div>
        <button class="ai-bestsellers__arrow-{{ ai_gen_id }} ai-bestsellers__arrow--right-{{ ai_gen_id }}" type="button" aria-label="Scroll products right">&#8594;</button>
      </div>
    {% else %}<p>Select a collection to display products.</p>{% endif %}
  </div>
</bestsellers-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class BestsellersCarousel{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        var track = this.querySelector('[data-track]');
        var left = this.querySelector('.ai-bestsellers__arrow--left-{{ ai_gen_id }}');
        var right = this.querySelector('.ai-bestsellers__arrow--right-{{ ai_gen_id }}');
        if (!track || !left || !right) return;
        left.addEventListener('click', function() { track.scrollBy({ left: -track.clientWidth * 0.8, behavior: 'smooth' }); });
        right.addEventListener('click', function() { track.scrollBy({ left: track.clientWidth * 0.8, behavior: 'smooth' }); });
      }
    }
    customElements.define('bestsellers-carousel-{{ ai_gen_id }}', BestsellersCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Bestsellers carousel",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "title", "label": "Title", "default": "Bestsellers" },
    { "type": "text", "id": "view_all_label", "label": "Link label", "default": "View All" },
    { "type": "url", "id": "view_all_link", "label": "Link" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 4, "max": 24, "step": 1, "default": 8 },
    { "type": "text", "id": "quick_add_label", "label": "Quick add label", "default": "Quick Add" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "columns_desktop", "label": "Cards on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 32, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_padding", "label": "Section padding", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 28 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F6F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2C2C2C" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C9A227" }
  ],
  "presets": [{ "name": "Bestsellers carousel" }],
  "tag": null,
  "class": "bestsellers-carousel-block"
}
{% endschema %}