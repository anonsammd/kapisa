{% comment %}
  Single hanger + garment on the Kapisa Virtual Rack.
  Params: uid, href, title, price, front, back, attrs, button_text, show_price
{% endcomment %}
<a
  href="{{ href }}"
  class="ai-rack__item"
  data-title="{{ title | escape }}"
  data-url="{{ href }}"
  data-price="{% if show_price and price != blank %}{{ price | money }}{% endif %}"
  data-front="{{ front | image_url: width: 900 }}"
  data-back="{% if back != blank %}{{ back | image_url: width: 900 }}{% endif %}"
  aria-label="{{ title | escape }}"
  {{ attrs }}
>
  <svg class="ai-rack__hanger" viewBox="0 0 100 56" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="rk-h-{{ uid }}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#9aa0aa"/>
        <stop offset="1" stop-color="#3a3f48"/>
      </linearGradient>
    </defs>
    <path d="M50 30 L50 22 C50 14 61 12 61 6 C61 1 54 0 51.5 4" fill="none" stroke="#7b818b" stroke-width="2.6" stroke-linecap="round"/>
    <path d="M50 28 L6 50 Q3 52 6 53 L94 53 Q97 52 94 50 Z" fill="url(#rk-h-{{ uid }})"/>
    <path d="M50 31 L12 50" stroke="rgba(255,255,255,.25)" stroke-width="1" fill="none"/>
  </svg>
  <span class="ai-rack__garment">
    <img src="{{ front | image_url: width: 480 }}" alt="{{ title | escape }}" loading="lazy" draggable="false">
  </span>
  <span class="ai-rack__pill">{{ button_text }}{% if show_price and price != blank %} <em>· {{ price | money }}</em>{% endif %}</span>
</a>
